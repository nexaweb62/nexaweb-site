---
/**
 * G2 — QUI A UN SITE, PAR SECTEUR
 *
 * Barres horizontales triées : toutes grises sauf le secteur de la page,
 * en or ; « Ensemble des secteurs » reste à sa place dans le tri, dans un
 * gris plus soutenu, comme repère. Valeur au bout de chaque barre.
 *
 * Props
 *   secteur  'construction' | 'commerce' | 'restauration'  (obligatoire)
 *            La barre de ce secteur passe en or et le titre en parle.
 *
 * Les textes portent des clés « gr-sect-… » ; leurs traductions sont
 * livrées à part (scratchpad/i18n/graphes-b.json) pour être fusionnées
 * dans public/i18n.js.
 */
export interface Props {
  secteur: 'construction' | 'commerce' | 'restauration';
}
const { secteur } = Astro.props;

/* ── LES DONNÉES ─────────────────────────────────────────────────────
   Source S02 (sources.json) : Insee, enquête TIC-TPE 2022, Insee
   Résultats publié le 1er février 2024, figure 3. Part des
   microentreprises (moins de 10 personnes occupées) AYANT ACCÈS À
   INTERNET qui possèdent un site web, par secteur. Valeurs recopiées
   telles quelles du champ « ventilation » ; aucune n'est arrondie ni
   déduite. */
const SOURCE_URL = 'https://www.insee.fr/fr/statistiques/7758708?sommaire=7656565';
const SECTEURS = [
  { cle: 'inf',  v: 48, fr: 'Information-communication' },
  { cle: 'heb',  v: 45, fr: 'Hébergement-restauration' },
  { cle: 'ind',  v: 44, fr: 'Industrie' },
  { cle: 'com',  v: 42, fr: 'Commerce' },
  { cle: 'act',  v: 39, fr: 'Activités spécialisées, scientifiques et techniques' },
  { cle: 'adm',  v: 31, fr: 'Services administratifs et de soutien' },
  { cle: 'cons', v: 23, fr: 'Construction' },
  { cle: 'tra',  v: 16, fr: 'Transports et entreposage' },
];
const ENSEMBLE = { cle: 'ens', v: 37, fr: 'Ensemble des secteurs' };

/* Le secteur de la page, et la façon d'en parler dans le titre. */
const PAGE = {
  construction: { cle: 'cons', dans: 'Dans la construction' },
  commerce:     { cle: 'com',  dans: 'Dans le commerce' },
  restauration: { cle: 'heb',  dans: "Dans l'hébergement-restauration" },
} as const;
const cible = PAGE[secteur];
if (!cible) throw new Error(`Secteurs : secteur inconnu « ${secteur} »`);
const vCible = SECTEURS.find((s) => s.cle === cible.cle)!.v;

/* Espace fine insécable avant « % » : « 23 % » ne se coupe jamais. */
const pct = (v: number) => `${v} %`;

/* ── LE TITRE, CALCULÉ ───────────────────────────────────────────────
   Une fraction simple (« moins d'une sur quatre ») n'est employée que si
   la valeur est JUSTE en dessous (3 points au plus) : 23 % devient
   « moins d'une sur quatre », 42 % reste « 42 % » — « moins d'une sur
   deux » serait vrai mais flou. Sinon, le pourcentage exact. */
const FRACTIONS = [[2, 'deux'], [3, 'trois'], [4, 'quatre'], [5, 'cinq']] as const;
const fraction = FRACTIONS.find(([n]) => vCible < 100 / n && 100 / n - vCible <= 3);
const titre = fraction
  ? `${cible.dans}, moins d'une très petite entreprise sur ${fraction[1]} a un site`
  : `${cible.dans}, ${pct(vCible)} des très petites entreprises ont un site`;

/* Tri décroissant ; l'ensemble prend sa place parmi les secteurs. */
const lignes = [...SECTEURS, ENSEMBLE].sort((a, b) => b.v - a.v);
const iDepart = lignes.findIndex((l) => l.cle === cible.cle);
const idT = `gr-sect-${secteur}-t`;
const TICKS = [0, 25, 50, 75, 100];
---
<figure class="gs" data-gr-secteurs aria-labelledby={idT}>
  <h3 class="gs-titre" id={idT} data-i18n={`gr-sect-t-${secteur}`}>{titre}</h3>
  <p class="gs-champ" data-i18n="gr-sect-champ">Entreprises de moins de 10 personnes ayant accès à Internet, France, 2022.</p>

  <div class="gs-plot">
    <ol class="gs-barres">
      {lignes.map((l, i) => (
        <li
          class:list={['gs-l', { 'gs-or': l.cle === cible.cle, 'gs-ens': l.cle === 'ens' }]}
          tabindex={i === iDepart ? 0 : -1}
          data-v={l.v}
          data-ecart={l.v - ENSEMBLE.v}
          data-ens={l.cle === 'ens' ? '' : undefined}
        >
          <span class="gs-lib" data-i18n={`gr-sect-l-${l.cle}`}>{l.fr}</span>
          <span class="gs-piste">
            <span class="gs-barre" style={`--v:${l.v}`}></span>
            <span class="gs-val" data-gr-pct={l.v}>{pct(l.v)}</span>
          </span>
        </li>
      ))}
    </ol>

    <div class="gs-axe" aria-hidden="true">
      {TICKS.map((t) => <span class="gs-tick" style={`--t:${t}`} data-gr-pct={t}>{pct(t)}</span>)}
    </div>

    <div class="gs-bulle" hidden aria-hidden="true">
      <span class="gs-b-val"></span>
      <span class="gs-b-lib"></span>
      <span class="gs-b-ecart"></span>
    </div>
  </div>

  <div class="gs-pied">
    {secteur === 'construction' && (
      <p class="gs-note" data-i18n="gr-sect-note-cons">« Construction » est la catégorie de l'Insee la plus proche des artisans du bâtiment, sans se confondre avec eux.</p>
    )}
    <p class="gs-src"><span data-i18n="gr-b-src">Source :</span> <a href={SOURCE_URL} data-i18n="gr-sect-src-lien">Insee, enquête TIC-TPE 2022</a><span data-i18n="gr-sect-src-fin">, publiée en 2024 (figure 3).</span></p>
  </div>

  <details class="gs-chiffres">
    <summary class="plq plq-sm gs-voir" data-i18n="gr-b-voir">Voir les chiffres</summary>
    <table class="gs-table">
      <caption class="sr-only" data-i18n="gr-sect-cap">Part des entreprises de moins de 10 personnes ayant accès à Internet qui ont un site, par secteur, France, 2022</caption>
      <thead>
        <tr>
          <th scope="col" data-i18n="gr-sect-th-sec">Secteur</th>
          <th scope="col" class="gs-num" data-i18n="gr-sect-th-part">Ont un site</th>
        </tr>
      </thead>
      <tbody>
        {lignes.map((l) => (
          <tr class:list={{ 'gs-t-or': l.cle === cible.cle }}>
            <th scope="row" data-i18n={`gr-sect-l-${l.cle}`}>{l.fr}</th>
            <td class="gs-num" data-gr-pct={l.v}>{pct(l.v)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </details>
</figure>

<style>
  .gs {
    --val-w: 3rem;          /* place réservée à droite pour la valeur */
    --ep: 16px;             /* épaisseur d'une barre (≤ 24 px) */
    margin: 0;
    min-width: 0;
    font-family: var(--font);
    color: var(--text);
  }
  .gs-titre {
    margin: 0 0 var(--sp-2);
    font-size: var(--fs-sub);
    line-height: var(--lh-sub);
    letter-spacing: var(--ls-sub);
    text-wrap: balance;
  }
  .gs-champ {
    margin: 0 0 var(--sp-5);
    font-size: 14px;
    line-height: 1.45;
    color: var(--text-muted);
  }

  .gs-plot { position: relative; }
  .gs-barres {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--sp-1);
  }

  /* Une ligne : le libellé au-dessus, la barre et sa valeur dessous.
     Le libellé au-dessus tient à 320 px même pour « Activités
     spécialisées, scientifiques et techniques ». */
  .gs-l {
    display: grid;
    gap: 2px;
    padding: var(--sp-1) 0;
    border-radius: var(--radius-block);
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
  }
  .gs-lib {
    font-size: 14px;
    line-height: 1.3;
    color: var(--text-muted);
  }
  .gs-piste {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    min-height: 20px;
  }
  /* Bout de donnée arrondi à 4 px, carré côté ligne de base. */
  .gs-barre {
    flex: none;
    height: var(--ep);
    width: calc((100% - var(--val-w)) * var(--v) / 100);
    background: var(--border-strong);
    border-radius: 0 4px 4px 0;
  }
  .gs-val {
    font-size: 14px;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    color: var(--text);
    white-space: nowrap;
  }

  /* La mise en avant : une seule barre en or. */
  .gs-or .gs-barre { background: var(--accent); }
  .gs-or .gs-lib { color: var(--text); font-weight: var(--w-semi); }
  .gs-or .gs-val { font-weight: var(--w-semi); }
  /* Le repère : l'ensemble des secteurs, dans un gris plus soutenu. */
  .gs-ens .gs-barre { background: var(--text-muted); }
  .gs-ens .gs-lib { color: var(--text); }

  /* Survol (souris seulement) et focus clavier : la barre se détache. */
  @media (hover: hover) and (pointer: fine) {
    .gs-l:hover .gs-barre { outline: 1px solid var(--text); outline-offset: 1px; }
    .gs-l:hover .gs-lib { color: var(--text); }
  }
  .gs-l:focus-visible .gs-barre { outline: 1px solid var(--text); outline-offset: 1px; }
  .gs-l:focus-visible .gs-lib { color: var(--text); }

  /* L'axe : un filet d'1 px, des graduations au quart. */
  .gs-axe {
    position: relative;
    width: calc(100% - var(--val-w));
    height: 22px;
    margin-top: var(--sp-2);
    border-top: 1px solid var(--border);
    font-size: var(--fs-caption);
    line-height: 1;
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }
  .gs-tick {
    position: absolute;
    top: 6px;
    left: calc(var(--t) * 1%);
    transform: translateX(-50%);
    white-space: nowrap;
  }
  .gs-tick::before {
    content: '';
    position: absolute;
    left: 50%;
    top: -7px;
    width: 1px;
    height: 4px;
    background: var(--border);
  }
  .gs-tick:first-child { transform: none; }
  .gs-tick:first-child::before { left: 0; }
  .gs-tick:last-child { transform: translateX(-100%); }
  .gs-tick:last-child::before { left: auto; right: 0; }

  /* L'infobulle : la valeur d'abord, le libellé ensuite. */
  .gs-bulle {
    position: absolute;
    z-index: 2;
    top: 0;
    left: 0;
    display: grid;
    gap: 2px;
    max-width: min(18rem, 100%);
    padding: var(--sp-2) var(--sp-3);
    background: var(--surface-2);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-block);
    pointer-events: none;
  }
  .gs-bulle[hidden] { display: none; }
  .gs-b-val {
    font-size: 16px;
    font-weight: var(--w-semi);
    font-variant-numeric: tabular-nums;
    color: var(--text);
  }
  .gs-b-lib, .gs-b-ecart {
    font-size: 13px;
    line-height: 1.35;
    color: var(--text-muted);
  }
  .gs-b-ecart { color: var(--text); }

  .gs-pied { margin-top: var(--sp-4); display: grid; gap: var(--sp-1); }
  .gs-note, .gs-src {
    margin: 0;
    font-size: var(--fs-caption);
    line-height: var(--lh-caption);
    letter-spacing: var(--ls-caption);
    color: var(--text-muted);
  }
  .gs-src a {
    color: var(--text);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
  }

  /* La vue tableau. Le résumé est cliquable : c'est une plaque. */
  .gs-chiffres { margin-top: var(--sp-4); }
  .gs-voir {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    padding: 0 var(--sp-4);
    font-size: 14px;
    font-weight: var(--w-semi);
    color: var(--text);
    cursor: pointer;
    list-style: none;
  }
  .gs-voir::-webkit-details-marker { display: none; }
  .gs-voir::marker { content: ''; }
  .gs-table {
    width: 100%;
    margin-top: var(--sp-3);
    border-collapse: collapse;
    font-size: 14px;
    line-height: 1.4;
  }
  .gs-table th, .gs-table td {
    padding: var(--sp-2) 0;
    border-bottom: 1px solid var(--border);
    text-align: left;
    vertical-align: top;
    font-weight: var(--w-reg);
  }
  .gs-table thead th { color: var(--text-muted); font-weight: var(--w-semi); }
  .gs-table .gs-num {
    text-align: right;
    padding-left: var(--sp-4);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .gs-t-or th, .gs-t-or td { font-weight: var(--w-semi); }
</style>

<script>
  /* L'interaction, et seulement elle : sans JavaScript le graphique,
     ses valeurs et son tableau sont déjà là. */
  const FINE = ' ';
  const pct = (v: number, l: string) => (l === 'en' ? `${v}%` : `${v}${FINE}%`);

  function ecart(d: number, l: string): string {
    const n = Math.abs(d);
    const s = n > 1 ? 's' : '';
    if (l === 'en') {
      if (d === 0) return 'Same as all sectors';
      return `${n} point${s} ${d < 0 ? 'below' : 'above'} all sectors`;
    }
    if (d === 0) return "Autant que l'ensemble des secteurs";
    return `${n} point${s} de ${d < 0 ? 'moins' : 'plus'} que l'ensemble des secteurs`;
  }

  document.querySelectorAll<HTMLElement>('[data-gr-secteurs]').forEach((fig) => {
    const plot = fig.querySelector<HTMLElement>('.gs-plot')!;
    const bulle = fig.querySelector<HTMLElement>('.gs-bulle')!;
    const rows = [...fig.querySelectorAll<HTMLElement>('.gs-l')];
    let langue = document.documentElement.lang === 'en' ? 'en' : 'fr';
    let active: HTMLElement | null = null;

    function remplir(row: HTMLElement) {
      const v = Number(row.dataset.v);
      const d = Number(row.dataset.ecart);
      bulle.querySelector('.gs-b-val')!.textContent = pct(v, langue);
      bulle.querySelector('.gs-b-lib')!.textContent = row.querySelector('.gs-lib')!.textContent;
      bulle.querySelector('.gs-b-ecart')!.textContent = row.hasAttribute('data-ens')
        ? (langue === 'en' ? 'All sectors combined' : 'Tous secteurs confondus')
        : ecart(d, langue);
    }

    function montrer(row: HTMLElement) {
      active = row;
      remplir(row);
      bulle.hidden = false;
      const pr = plot.getBoundingClientRect();
      const br = row.querySelector('.gs-barre')!.getBoundingClientRect();
      const rr = row.getBoundingClientRect();
      const w = bulle.offsetWidth;
      const h = bulle.offsetHeight;
      const x = Math.min(Math.max(0, br.right - pr.left - w / 2), Math.max(0, pr.width - w));
      let y = rr.top - pr.top - h - 4;
      if (y < 0) y = rr.bottom - pr.top + 4;
      bulle.style.transform = `translate(${Math.round(x)}px, ${Math.round(y)}px)`;
    }
    function cacher() {
      active = null;
      bulle.hidden = true;
    }

    rows.forEach((row) => {
      row.addEventListener('pointerenter', () => montrer(row));
      row.addEventListener('pointerleave', () => {
        if (document.activeElement !== row) cacher();
      });
      row.addEventListener('focus', () => montrer(row));
      row.addEventListener('blur', cacher);
    });

    /* Un seul arrêt de tabulation ; les flèches parcourent les barres. */
    fig.querySelector('.gs-barres')!.addEventListener('keydown', (e) => {
      const ev = e as KeyboardEvent;
      const i = rows.indexOf(document.activeElement as HTMLElement);
      if (i < 0) return;
      let j = i;
      if (ev.key === 'ArrowDown' || ev.key === 'ArrowRight') j = Math.min(rows.length - 1, i + 1);
      else if (ev.key === 'ArrowUp' || ev.key === 'ArrowLeft') j = Math.max(0, i - 1);
      else if (ev.key === 'Home') j = 0;
      else if (ev.key === 'End') j = rows.length - 1;
      else if (ev.key === 'Escape') { cacher(); return; }
      else return;
      ev.preventDefault();
      rows[i].tabIndex = -1;
      rows[j].tabIndex = 0;
      rows[j].focus();
    });

    /* La langue : les nombres changent de forme (« 23 % » / « 23% »). */
    function appliquer(l: string) {
      langue = l === 'en' ? 'en' : 'fr';
      fig.querySelectorAll<HTMLElement>('[data-gr-pct]').forEach((el) => {
        el.textContent = pct(Number(el.dataset.grPct), langue);
      });
      if (active) montrer(active);
    }
    document.addEventListener('nw-lang', (e) => appliquer((e as CustomEvent).detail));
    document.addEventListener('nw-lang-applied', (e) => appliquer((e as CustomEvent).detail));
    appliquer(langue);
  });
</script>
