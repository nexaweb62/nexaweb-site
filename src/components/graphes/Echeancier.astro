---
/* G3 — L'ÉCHÉANCIER : LE MÊME PRIX, EN 1, 3 OU 4 FOIS.

   Trois barres de même longueur : le total de la formule. Chacune est
   découpée en autant de segments que de versements, chaque segment
   proportionnel à son montant, séparés par 2 px de vide (le fond de la
   page passe au travers). Le premier versement est en or : c'est ce qui
   sort de la caisse en premier, et c'est ce qui change d'une barre à
   l'autre. Les suivants sont en gris.

   Tous les montants viennent de src/data/formules.ts : le total, le
   découpage (PAIEMENTS) et l'arrondi (parMois, au supérieur ; le dernier
   versement absorbe la différence). Rien n'est recopié ici. Quand le
   dernier versement diffère des autres, l'étiquette le dit
   (« 3 × 250 € + 249 € ») : « 4 × 250 € » ferait 1 000 €, pas 999 €. */
import { FORMULES, PAIEMENTS, REFONTE, VITRINE, ENTREPRISE, parMois, prix } from '../../data/formules';

type Cle = 'refonte' | 'vitrine' | 'entreprise';
export interface Props {
  /** La formule dont on montre l'échéancier. */
  formule?: Cle;
  /** Préfixe des id, si deux échéanciers partagent une page. */
  id?: string;
}
const { formule = 'vitrine', id = 'gech' } = Astro.props;

const MONTANT: Record<Cle, number> = {
  refonte: REFONTE.prixDepart,
  vitrine: VITRINE.prix,
  entreprise: ENTREPRISE.prixDepart,
};
const f = FORMULES.find((x) => x.cle === formule) ?? FORMULES[1];
const total = MONTANT[f.cle as Cle];

/* La mensualité est celle que calcule formules.ts, lue dans sa chaîne
   (« 333 € ») : si l'arrondi change là-bas, il change ici. */
const plans = PAIEMENTS.map((pl) => {
  const m = Number(parMois(total, pl.n).replace(/\D/g, ''));
  const derniere = total - m * (pl.n - 1);
  const segs = Array.from({ length: pl.n }, (_, i) => (i === pl.n - 1 ? derniere : m));
  return { ...pl, m, derniere, segs, egaux: derniere === m };
});
const colonnes = Math.max(...plans.map((pl) => pl.n));
---
<div class="gech" data-gech-root>
  <h3 class="gech-h" data-i18n="gr-ech-h">Le même prix, en 1, 3 ou 4 fois</h3>
  <p class="gech-sous"><span data-i18n="gr-ech-formule">Formule :</span> <span data-i18n={`gr-f-${f.cle}`}>{f.nom}</span></p>

  <ul class="gech-leg" role="list">
    <li><span class="gech-cle gech-cle-or" aria-hidden="true"></span><span data-i18n="gr-ech-leg-1">Premier versement</span></li>
    <li><span class="gech-cle" aria-hidden="true"></span><span data-i18n="gr-ech-leg-2">Versements suivants</span></li>
  </ul>

  <p class="sr-only" id={`${id}-aide`} data-i18n="gr-ech-aide">Flèches gauche et droite pour lire chaque versement.</p>
  <div class="gech-barres">
    {plans.map((pl) => (
      <div class="gech-ligne">
        <p class="gech-tete" id={`${id}-t${pl.n}`}>
          <span class="gech-nom" data-i18n={`trf-paie-${pl.n}`}>{pl.n === 1 ? 'En une fois' : `En ${pl.n} fois`}</span>
          <span class="gech-val">
            {pl.egaux
              ? <>{pl.n} × <span data-i18n-prix>{prix(pl.m)}</span></>
              : <>{pl.n - 1} × <span data-i18n-prix>{prix(pl.m)}</span> + <span data-i18n-prix>{prix(pl.derniere)}</span></>}
          </span>
        </p>
        <div class="gech-barre" tabindex="0" role="group" aria-labelledby={`${id}-t${pl.n}`} aria-describedby={`${id}-aide`}>
          {pl.segs.map((v, i) => (
            <span class:list={['gech-seg', { 'gech-seg-or': i === 0 }]} data-v={v} style={`flex:${v} 1 0`}></span>
          ))}
        </div>
      </div>
    ))}
    <div class="gech-tip" aria-hidden="true">
      <p><b class="gech-tip-v" data-n="v">0</b></p>
      <p><span data-t="u" data-i18n="gr-ech-tt-u">versement unique</span><span data-t="k"><span data-i18n="gr-ech-tt">versement</span> <span data-n="i">1</span> <span data-i18n="gr-ech-sur">sur</span> <span data-n="n">3</span></span></p>
    </div>
    <p class="sr-only" aria-live="polite" data-gech-sr></p>
  </div>

  <p class="gech-total"><span data-i18n="gr-ech-total">Total :</span> {f.pre && <><span data-i18n={f.preCle}>{f.pre}</span> </>}<strong data-i18n-prix>{f.total}</strong> <span data-i18n="gr-ech-total-2">dans les trois cas, sans frais.</span></p>
  {f.pre && <p class="gech-dep" data-i18n="gr-ech-dep">Calcul fait sur le prix de départ de la formule : le total final suit votre devis.</p>}
  <p class="gech-src"><span data-i18n="gr-src">Source :</span> <a href="/tarifs" data-i18n="gr-ech-src">tarifs Nexa Web (2026)</a></p>

  <details class="gech-det">
    <summary class="gech-sum plq plq-sm" data-i18n="gr-voir">Voir les chiffres</summary>
    <div class="gech-tab-w">
      <table class="gech-tab">
        <caption class="sr-only" data-i18n="gr-ech-cap">Montant de chaque versement, selon le mode de paiement</caption>
        <thead>
          <tr>
            <th scope="col" data-i18n="gr-ech-th-mode">Paiement</th>
            {Array.from({ length: colonnes }, (_, i) => <th scope="col"><span data-i18n="gr-ech-th-v">Versement</span> {i + 1}</th>)}
            <th scope="col" data-i18n="gr-ech-th-total">Total</th>
          </tr>
        </thead>
        <tbody>
          {plans.map((pl) => (
            <tr>
              <th scope="row" data-i18n={`trf-paie-${pl.n}`}>{pl.n === 1 ? 'En une fois' : `En ${pl.n} fois`}</th>
              {Array.from({ length: colonnes }, (_, i) => (
                i < pl.n ? <td data-i18n-prix>{prix(pl.segs[i])}</td> : <td>—</td>
              ))}
              <td data-i18n-prix>{prix(pl.segs.reduce((a, b) => a + b, 0))}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </details>
</div>

<style>
.gech{container:gech / inline-size;color:var(--text)}
.gech [hidden]{display:none !important}
.gech-h{font-size:var(--fs-sub);letter-spacing:var(--ls-sub);line-height:var(--lh-sub);text-wrap:balance}
.gech-sous{margin-top:var(--sp-2);font-size:15px;color:var(--text-muted)}

/* La légende reprend la forme des marques : un carré pour une barre. */
.gech-leg{display:flex;flex-wrap:wrap;gap:var(--sp-2) var(--sp-5);margin:var(--sp-5) 0;font-size:13px;color:var(--text-muted)}
.gech-leg li{display:inline-flex;align-items:center;gap:var(--sp-2)}
.gech-cle{width:12px;height:12px;border-radius:var(--radius-tag);background:var(--border-strong)}
.gech-cle-or{background:var(--accent)}

.gech-barres{position:relative;display:flex;flex-direction:column;gap:var(--sp-5)}
.gech-tete{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:baseline;gap:var(--sp-1) var(--sp-3);margin-bottom:var(--sp-2);font-size:15px;line-height:1.35}
.gech-nom{color:var(--text)}
.gech-val{font-weight:600;font-variant-numeric:tabular-nums;white-space:nowrap}

/* La barre : 24 px, droite côté ligne de base (à gauche), arrondie de
   4 px côté valeur (le bout droit du dernier segment). Les segments ne
   se touchent pas : 2 px de vide, le fond passe entre eux. */
.gech-barre{display:flex;gap:2px;height:24px;cursor:default;outline-offset:4px}
.gech-seg{display:block;min-width:2px;height:100%;background:var(--border-strong);transition:background-color 125ms var(--ease-out)}
.gech-seg-or{background:var(--accent)}
.gech-seg:last-child{border-radius:0 4px 4px 0}
.gech-seg.on{background:var(--field-border)}
.gech-seg-or.on{background:var(--accent-hover)}

.gech-tip{
  position:absolute;top:0;left:0;z-index:2;padding:8px 12px;
  background:var(--surface-2);border:1px solid var(--border-strong);border-radius:var(--radius-block);
  font-size:12px;line-height:1.4;color:var(--text-muted);white-space:nowrap;
  pointer-events:none;opacity:0;visibility:hidden;transform:translateY(calc(-100% - 6px));
  transition:opacity 125ms var(--ease-out),visibility 0s linear 125ms;
}
.gech-tip.on{opacity:1;visibility:visible;transition:opacity 125ms var(--ease-out),visibility 0s}
.gech-tip-v{font-size:16px;font-weight:600;color:var(--text);font-variant-numeric:tabular-nums}

.gech-total{margin-top:var(--sp-6);font-size:16px}
.gech-total strong{font-weight:600}
.gech-dep{margin-top:var(--sp-1);font-size:14px;color:var(--text-muted);max-width:62ch}
.gech-src{margin-top:var(--sp-2);font-size:12px;line-height:1.5;color:var(--text-muted)}
.gech-src a{text-decoration:underline;text-decoration-thickness:1px;text-underline-offset:3px}
@media (hover:hover) and (pointer:fine){ .gech-src a:hover{color:var(--text)} }

.gech-det{margin-top:var(--sp-4)}
.gech-sum{
  display:inline-flex;align-items:center;min-height:36px;padding:0 14px;
  font-size:14px;font-weight:500;color:var(--text);cursor:pointer;list-style:none;
}
.gech-sum::-webkit-details-marker{display:none}
.gech-tab-w{overflow-x:auto;margin-top:var(--sp-3)}
.gech-tab{width:100%;border-collapse:collapse;font-size:14px;font-variant-numeric:tabular-nums}
.gech-tab th,.gech-tab td{padding:6px 10px;border-bottom:1px solid var(--border);text-align:right;white-space:nowrap}
.gech-tab th:first-child{text-align:left}
.gech-tab thead th{font-weight:600;color:var(--text-muted)}
.gech-tab tbody th{font-weight:400;color:var(--text)}
.gech-tab td:last-child{font-weight:600}

@media (prefers-reduced-motion:reduce){
  .gech-seg,.gech-tip,.gech-tip.on{transition:none}
}
</style>

<script>
  import { prix } from '../../data/formules';

  const absolu = (n: number) => {
    const a = Math.abs(Math.round(n));
    return document.documentElement.lang === 'en' ? '€' + a.toLocaleString('en-US') : prix(a);
  };

  function init(root: HTMLElement) {
    const zone = root.querySelector<HTMLElement>('.gech-barres')!;
    const tip = root.querySelector<HTMLElement>('.gech-tip')!;
    const sr = root.querySelector<HTMLElement>('[data-gech-sr]')!;
    const barres = Array.from(root.querySelectorAll<HTMLElement>('.gech-barre'));
    let actif: { barre: HTMLElement; i: number } | null = null;

    function montrer(barre: HTMLElement, i: number, clavier = false) {
      const segs = Array.from(barre.querySelectorAll<HTMLElement>('.gech-seg'));
      const seg = segs[i];
      if (!seg) return;
      actif = { barre, i };
      barres.forEach((b) => b.querySelectorAll('.gech-seg').forEach((s) => s.classList.remove('on')));
      seg.classList.add('on');

      const n = segs.length;
      tip.querySelector<HTMLElement>('[data-t="u"]')!.hidden = n !== 1;
      tip.querySelector<HTMLElement>('[data-t="k"]')!.hidden = n === 1;
      tip.querySelector('[data-n="i"]')!.textContent = String(i + 1);
      tip.querySelector('[data-n="n"]')!.textContent = String(n);
      tip.querySelector('[data-n="v"]')!.textContent = absolu(Number(seg.dataset.v));

      /* Au-dessus du segment, centrée, mais jamais hors du graphique. */
      const rz = zone.getBoundingClientRect();
      const rs = seg.getBoundingClientRect();
      const w = tip.offsetWidth;
      const cx = rs.left - rz.left + rs.width / 2;
      tip.style.left = Math.max(0, Math.min(rz.width - w, cx - w / 2)) + 'px';
      tip.style.top = rs.top - rz.top + 'px';
      tip.classList.add('on');
      if (clavier) sr.textContent = tip.innerText.split('\n').map((s) => s.trim()).filter(Boolean).join(', ');
    }
    function cacher() {
      actif = null;
      tip.classList.remove('on');
      barres.forEach((b) => b.querySelectorAll('.gech-seg').forEach((s) => s.classList.remove('on')));
    }

    barres.forEach((barre) => {
      const segs = Array.from(barre.querySelectorAll<HTMLElement>('.gech-seg'));
      segs.forEach((seg, i) => {
        seg.addEventListener('pointerenter', () => montrer(barre, i));
        seg.addEventListener('pointerdown', () => montrer(barre, i));
      });
      barre.addEventListener('pointerleave', (e) => {
        if (e.pointerType === 'mouse' && document.activeElement !== barre) cacher();
      });
      barre.addEventListener('focus', () => montrer(barre, actif?.barre === barre ? actif.i : 0, true));
      barre.addEventListener('blur', cacher);
      barre.addEventListener('keydown', (e) => {
        const i = actif?.barre === barre ? actif.i : 0;
        let j = i;
        if (e.key === 'ArrowRight') j = Math.min(segs.length - 1, i + 1);
        else if (e.key === 'ArrowLeft') j = Math.max(0, i - 1);
        else if (e.key === 'Home') j = 0;
        else if (e.key === 'End') j = segs.length - 1;
        else if (e.key === 'Escape') { cacher(); return; }
        else return;
        e.preventDefault();
        montrer(barre, j, true);
      });
    });
    document.addEventListener('pointerdown', (e) => {
      if (actif && !zone.contains(e.target as Node) && !barres.includes(document.activeElement as HTMLElement)) cacher();
    });
    const relire = () => { if (actif) montrer(actif.barre, actif.i); };
    document.addEventListener('nw-lang', relire);
    document.addEventListener('nw-lang-applied', relire);
  }

  document.querySelectorAll<HTMLElement>('[data-gech-root]').forEach(init);
</script>
