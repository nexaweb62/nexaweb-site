---
import { SITE, CALENDLY, AREA } from '../config/site';
import { METIERS } from '../config/metiers';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-row">
      <a class="logo" href="/" aria-label="Nexa Web — accueil">
        <img src="/assets/logo.svg" alt="" width="52" height="52" />
      </a>

      <nav class="footer-links" aria-label="Pied de page">
        <a href="/#offre">L'offre</a>
        <a href="/#tarifs">Tarifs</a>
        <a href="/#faq">Questions</a>
        <a href="/equipe">L'équipe</a>
        <a href={CALENDLY} target="_blank" rel="noopener">Rendez-vous</a>
        <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
        <a href={SITE.phoneHref}>{SITE.phone}</a>
      </nav>
    </div>

    <nav class="footer-metiers" aria-label="Par métier">
      {METIERS.map((m) => <a href={`/${m.slug}`}>{m.nav}</a>)}
    </nav>

    <p class="footer-area">
      Création de sites internet à {AREA.slice(0, -1).join(', ')} et {AREA.at(-1)} —
      et partout ailleurs dans les {SITE.region}.
    </p>

    <p class="footer-legal">
      © {year} {SITE.name} — {SITE.city}, {SITE.region}.{' '}
      <a href="/mentions-legales">Mentions légales</a> ·{' '}
      <a href="/politique-confidentialite">Politique de confidentialité</a>
    </p>
  </div>
</footer>
