---
/**
 * LE FOND DE LA PAGE TARIFS — des traces qui coulent.
 *
 * Reprend l'effet « Background Paths » de magicui, mais REECRIT : le
 * composant d'origine est du React + Tailwind + shadcn + framer-motion.
 * Ce site est en Astro et CSS pur, et on n'installe pas React pour un
 * fond. Ici : aucun JavaScript, aucune dependance.
 *
 * COMMENT L'ANIMATION TIENT SANS JAVASCRIPT. framer-motion animait
 * « pathLength » et « pathOffset », qu'il calcule courbe par courbe.
 * L'attribut SVG pathLength="1" fait le meme travail gratuitement : il
 * NORMALISE la longueur de chaque trace a 1. Verifie dans le navigateur
 * — deux courbes de 1583 et 797 unites rendent toutes deux un
 * stroke-dasharray de « 0.3px, 1px ». Une seule regle CSS anime donc les
 * 72 courbes, quelles que soient leurs longueurs.
 *
 * LES COULEURS SONT CELLES DU SITE. L'original trace du bleu ardoise sur
 * blanc ; ici c'est l'or de la marque sur l'aplat du theme. Le clair
 * prend un or plus profond, sans quoi les traces disparaitraient sur le
 * creme.
 *
 * LE MOUVEMENT S'ARRETE DE LUI-MEME quand le visiteur demande moins
 * d'animation, et quand le site passe en mode leger faute d'images par
 * seconde. Dans les deux cas les traces restent dessinees : le fond ne
 * disparait pas, il se fige.
 */

/* Les 36 courbes d'une direction, telles que les dessine l'original.
   Calculees ici, au build : rien n'est genere chez le visiteur. */
function traces(sens: number) {
  return Array.from({ length: 36 }, (_, i) => {
    const dx = i * 5 * sens;
    const d = `M${-(380 - dx)} ${-(189 + i * 6)}`
            + `C${-(380 - dx)} ${-(189 + i * 6)} ${-(312 - dx)} ${216 - i * 6} ${152 - dx} ${343 - i * 6}`
            + `C${616 - dx} ${470 - i * 6} ${684 - dx} ${875 - i * 6} ${684 - dx} ${875 - i * 6}`;
    return {
      d,
      /* L'epaisseur et l'opacite croissent avec le rang, comme dans
         l'original. Les valeurs, elles, ont ete reglees A LA MESURE :
         l'original trace du bleu ardoise SUR BLANC, a fort contraste,
         et ses reglages ne transposent pas. Trop bas, on ne voyait rien
         — 0,7 % de l'ecran touche. Trop haut, les traces passaient
         devant le texte — 18 %. Ici on vise un FOND : present, jamais
         premier plan. */
      trait: (0.9 + i * 0.05).toFixed(2),
      opacite: Math.min(0.055 + i * 0.007, 0.185).toFixed(3),
      /* Une duree propre a chaque courbe, DETERMINISTE : un Math.random
         au build donnerait un rendu different a chaque mise en ligne,
         pour rien. Les durees restent premieres entre elles, donc le
         motif ne se repete jamais a l'oeil. */
      duree: (19 + ((i * 7) % 11) + (sens > 0 ? 0 : 1.5)).toFixed(1),
      retard: (-(i * 1.7) % 23).toFixed(1),
    };
  });
}
const sens = [traces(1), traces(-1)];
---

<div class="fond-tarifs" aria-hidden="true" role="presentation">
  {sens.map(groupe => (
    <svg class="ft-svg" viewBox="0 0 696 316" fill="none"
         preserveAspectRatio="none">
      {groupe.map(t => (
        <path d={t.d} pathLength="1" stroke="currentColor"
              stroke-width={t.trait}
              style={`--o:${t.opacite};--d:${t.duree}s;--r:${t.retard}s`} />
      ))}
    </svg>
  ))}
</div>

<style>
  /* Fixe derriere toute la page, le contenu passe au-dessus : <main>
     porte deja position:relative et z-index:1. */
  .fond-tarifs{
    position:fixed;inset:0;z-index:0;pointer-events:none;overflow:hidden;
    background:var(--bg);
    color:var(--raw-gold-400);
    /* La force des traces, par theme. Une seule opacite ne peut pas
       servir les deux : sur le quasi-noir, l'or ressort a 18 % ; sur le
       creme, le meme reglage disparait — mesure, 3,2 % de l'ecran touche
       en sombre contre presque rien en clair. Ce coefficient multiplie
       l'opacite de chaque trace. */
    --ft-k:1;
  }
  /* Sur le creme : un or plus profond, et nettement plus affirme. */
  :root[data-theme="light"] .fond-tarifs{color:var(--raw-gold-600);--ft-k:3.6}
  @media (prefers-color-scheme: light){
    :root:not([data-theme="dark"]) .fond-tarifs{color:var(--raw-gold-600);--ft-k:3.6}
  }

  .ft-svg{position:absolute;inset:0;width:100%;height:100%}

  .ft-svg path{
    fill:none;
    /* LA COURBE EST LARGEMENT DESSINEE, pas reduite a un tiret.
       L'original fait croitre « pathLength » de 0,3 a 1 : la courbe
       finit donc entiere, et c'est ce tissage continu qu'on voit. Avec
       un tiret fixe de 30 % je n'obtenais que des segments epars —
       mesure, 9 000 pixels dores sur 1,3 million. Ici 62 % de chaque
       courbe est tracee, et le vide qui reste la parcourt : le tissage
       tient, et le mouvement se lit. */
    stroke-dasharray:.62 .38;
    opacity:calc(var(--o) * var(--ft-k));
    animation:ftCoule var(--d) linear var(--r) infinite,
              ftRespire var(--d) ease-in-out var(--r) infinite;
  }
  @keyframes ftCoule{ to{ stroke-dashoffset:-1 } }
  @keyframes ftRespire{
    0%,100%{ opacity:calc(var(--o) * var(--ft-k) * .55) }
    50%    { opacity:calc(var(--o) * var(--ft-k)) }
  }

  /* On fige les traces, on ne les efface pas. */
  @media (prefers-reduced-motion:reduce){
    .ft-svg path{animation:none}
  }
  :global(body.lite) .ft-svg path{animation:none}
</style>
