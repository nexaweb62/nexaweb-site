---
import Logo from './Logo.astro';

export interface Props {
  cta?: string;
  ctaHref?: string;
  back?: boolean;
}
import InteractiveButton from './ui/InteractiveButton.astro';
const { cta = 'Démarrer un projet', ctaHref = '/devis', back = true } = Astro.props;
---
<header class="hdr" id="hdr">
  {/* .hdr-in remplace .wrap : c'est lui qui s'étire au défilement, de
      900 px à toute la largeur. .wrap a une largeur fixe pour tout le
      site et n'avait pas à apprendre ce tour-là. */}
  <div class="hdr-in">
    <nav class="nav" aria-label="Navigation principale">
      <a href="/" class="nav-logo" aria-label="NEXAWEB — Accueil">
        <Logo class="nav-logo-mk lg-compact" largeur={30} trait={2.2} texte={true} tailleNom={13} tailleSous={7} />
      </a>
      <ul class="nav-links" role="list">
        <li><a href="/#accueil"  class="nav-link" data-i18n="hdr-nav-home">Accueil</a></li>
        <li><a href="/services" class="nav-link" data-i18n="hdr-nav-services">Services</a></li>
        <li><a href="/#apropos"  class="nav-link" data-i18n="hdr-nav-about">À propos</a></li>
        <li><a href="/tarifs"    class="nav-link" data-i18n="hdr-nav-pricing">Tarifs</a></li>
        <li><a href="/#faq"     class="nav-link" data-i18n="hdr-nav-faq">FAQ</a></li>
        <li><a href="/contact"  class="nav-link" data-i18n="hdr-nav-contact">Localisation</a></li>
      </ul>
      <div class="nav-r">
        <div class="lang-sel" role="group" aria-label="Language">
          <button class="lang-opt" data-lang="fr">FR</button>
          <button class="lang-opt" data-lang="en">EN</button>
        </div>

        <!-- Bouton Menu. Il ouvre la navigation plein ecran, et sur
             telephone c'est la SEULE facon d'atteindre les pages : il ne
             doit jamais disparaitre. Il a ete emporte une fois par un
             retrait du selecteur de theme voisin — d'ou le garde-fou qui
             le reclame desormais sur chaque page. -->
        <button class="menu-btn" id="menu-btn"
          aria-label="Menu — ouvrir la navigation" aria-expanded="false">
          <svg viewBox="0 0 24 24" aria-hidden="true"><line x1="3" y1="7" x2="21" y2="7"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="17" x2="21" y2="17"/></svg>
          <span class="hdr-btn-lbl">Menu</span>
        </button>

<!-- Bouton Retour -->
        {back && (
          <InteractiveButton text="Retour" class="hdr-back" id="hdr-back"
                             aria-label="Retour — page précédente" data-i18n="hdr-back" />
        )}

        <InteractiveButton text={cta} href={ctaHref} variant="gold" data-i18n="hdr-cta" />
      </div>
    </nav>
  </div>
</header>

<!-- CIRCULAR NAV OVERLAY -->
<div class="cnav" id="cnav" role="dialog" aria-modal="true" aria-label="Navigation" inert>
  <div class="cnav-ring" id="cnav-ring">
    <button class="cnav-close" id="cnav-close" aria-label="Fermer la navigation">
      <svg viewBox="0 0 24 24" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
    <div class="cnav-item">
      <a href="/" class="cnav-link">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
        <span class="cnav-name" data-i18n="hdr-nav-home">Accueil</span>
      </a>
    </div>
    <div class="cnav-item">
      <a href="/services" class="cnav-link">
        <svg viewBox="0 0 24 24" aria-hidden="true"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>
        <span class="cnav-name" data-i18n="hdr-nav-services">Services</span>
      </a>
    </div>
    <div class="cnav-item">
      <a href="/#apropos" class="cnav-link">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        <span class="cnav-name" data-i18n="hdr-nav-about">À propos</span>
      </a>
    </div>
    <div class="cnav-item">
      <a href="/tarifs" class="cnav-link">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>
        <span class="cnav-name" data-i18n="hdr-nav-pricing">Tarifs</span>
      </a>
    </div>
    <div class="cnav-item">
      <a href="/#faq" class="cnav-link">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
        <span class="cnav-name" data-i18n="hdr-nav-faq">FAQ</span>
      </a>
    </div>
    <div class="cnav-item">
      <a href="/contact" class="cnav-link">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
        <span class="cnav-name" data-i18n="hdr-nav-contact">Localisation</span>
      </a>
    </div>
    <div class="cnav-item">
      <a href="/rendez-vous" class="cnav-link">
        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
        <span class="cnav-name" data-i18n="hdr-nav-rdv">RDV</span>
      </a>
    </div>
    <div class="cnav-item">
      <a href="/equipe" class="cnav-link">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        <span class="cnav-name" data-i18n="hdr-nav-team">Équipe</span>
      </a>
    </div>
    <div class="cnav-item">
      <a href="/avis" class="cnav-link">
        <svg viewBox="0 0 24 24" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
        <span class="cnav-name" data-i18n="hdr-nav-reviews">Avis</span>
      </a>
    </div>
  </div>

  <!-- Langue et thème, sur mobile uniquement.
       Dans la barre ils écrasaient le logo et repoussaient le bouton
       Retour dans le coin, sans son libellé. Ici ils ont la place.
       Le même JS pilote les deux exemplaires. -->
  <div class="cnav-tools">
    <div class="lang-sel" role="group" aria-label="Langue">
      <button class="lang-opt" data-lang="fr">FR</button>
      <button class="lang-opt" data-lang="en">EN</button>
    </div>
  </div>
</div>

<script is:inline>
(function(){
  'use strict';

  var root = document.documentElement;

  /* LE SELECTEUR DE THEME A ETE RETIRE, MARQUAGE ET SCRIPT.
     Le site suit desormais le reglage du systeme, via les media queries
     de tokens.css : rien a cliquer, et l'apparence par defaut ne change
     pas. Les ecouteurs « nw-theme » ailleurs dans le site restent en
     place : ils ne coutent rien, et servent encore aux pages qui posent
     elles-memes data-theme (connexion, inscription). */


  /* ── Retour ──────────────────────────────────────────────────────────
     Le nom accessible annonce « page précédente » : le bouton doit le
     faire. Il ne revient en arrière que si la page précédente appartient
     bien à ce site — sinon on renverrait le visiteur vers Google ou vers
     le lien qui l'a amené. Arrivée directe : retour à l'accueil. */
  var backBtn = document.getElementById('hdr-back');
  if(backBtn) backBtn.addEventListener('click', function(){
    var interne = (parseInt(root.dataset.vues || '0', 10) || 0) > 0;
    if(!interne){
      try{
        interne = !!document.referrer && new URL(document.referrer).origin === location.origin;
      }catch(e){}
    }
    if(interne && history.length > 1) history.back();
    else window.location.href = '/';
  });

  /* ── Langue FR/EN ── */
  var savedLang = 'fr';
  try{ savedLang = localStorage.getItem('nw-lang') || 'fr'; }catch(e){}
  document.querySelectorAll('.lang-opt').forEach(function(b){
    var isOn = b.getAttribute('data-lang') === savedLang;
    b.classList.toggle('active', isOn);
    b.setAttribute('aria-pressed', isOn ? 'true' : 'false');
    b.addEventListener('click', function(){
      var lang = b.getAttribute('data-lang');
      try{ localStorage.setItem('nw-lang', lang); }catch(e){}
      document.querySelectorAll('.lang-opt').forEach(function(x){
        var on = x.getAttribute('data-lang') === lang;
        x.classList.toggle('active', on);
        x.setAttribute('aria-pressed', on ? 'true' : 'false');
      });
      document.dispatchEvent(new CustomEvent('nw-lang', { detail: lang }));
    });
  });

  /* ═══════════════════════════════════════════════════════════════════
     NAVIGATION PLEIN ÉCRAN — fond opaque, scroll verrouillé, focus piégé
     ═══════════════════════════════════════════════════════════════════ */
  var overlay = document.getElementById('cnav');
  var ring    = document.getElementById('cnav-ring');
  var menuBtn = document.getElementById('menu-btn');
  var closeBtn= document.getElementById('cnav-close');
  if(!overlay || !ring || !menuBtn) return;

  var items = Array.prototype.slice.call(ring.querySelectorAll('.cnav-item'));
  var n = items.length;
  var scrollY = 0;

  function positionItems(){
    var r = ring.offsetWidth * 0.368;
    items.forEach(function(item, i){
      var a = ((360 / n) * i - 90) * Math.PI / 180;
      item.style.transform = 'translate(calc(-50% + ' + (Math.cos(a) * r).toFixed(1) + 'px), calc(-50% + ' + (Math.sin(a) * r).toFixed(1) + 'px))';
    });
  }

  function focusables(){
    /* tabIndex < 0 : les radios non cochées du sélecteur de thème. Les
       inclure ferait boucler le piège sur un élément que la touche
       Tabulation n'atteint jamais. */
    return Array.prototype.slice.call(
      overlay.querySelectorAll('a[href],button:not([disabled])')
    ).filter(function(el){ return el.offsetParent !== null && el.tabIndex >= 0; });
  }

  function openNav(){
    scrollY = window.scrollY;
    overlay.removeAttribute('inert');
    overlay.classList.add('open');
    menuBtn.setAttribute('aria-expanded', 'true');
    // Verrouillage du scroll sans saut de page (iOS compris).
    document.body.classList.add('nav-open');
    document.body.style.top = (-scrollY) + 'px';
    positionItems();
    closeBtn.focus();
  }

  function closeNav(){
    overlay.classList.remove('open');
    overlay.setAttribute('inert', '');
    menuBtn.setAttribute('aria-expanded', 'false');
    document.body.classList.remove('nav-open');
    document.body.style.top = '';
    window.scrollTo(0, scrollY);
    menuBtn.focus();
  }

  menuBtn.addEventListener('click', openNav);
  closeBtn.addEventListener('click', closeNav);
  overlay.addEventListener('click', function(e){ if(e.target === overlay) closeNav(); });

  document.addEventListener('keydown', function(e){
    if(!overlay.classList.contains('open')) return;
    if(e.key === 'Escape'){ closeNav(); return; }
    if(e.key !== 'Tab') return;
    // Piège de focus : la tabulation tourne en boucle dans l'overlay.
    var f = focusables();
    if(!f.length) return;
    var first = f[0], last = f[f.length - 1];
    if(e.shiftKey && document.activeElement === first){ e.preventDefault(); last.focus(); }
    else if(!e.shiftKey && document.activeElement === last){ e.preventDefault(); first.focus(); }
  });

  ring.querySelectorAll('.cnav-link').forEach(function(l){ l.addEventListener('click', closeNav); });
  window.addEventListener('resize', function(){ if(overlay.classList.contains('open')) positionItems(); }, { passive:true });

  /* ── Infobulles au toucher ── */
  document.querySelectorAll('.hdr-tip').forEach(function(el){
    el.addEventListener('touchstart', function(){ el.classList.add('tip-active'); }, { passive:true });
    el.addEventListener('touchend',   function(){ setTimeout(function(){ el.classList.remove('tip-active'); }, 700); });
    el.addEventListener('touchcancel',function(){ el.classList.remove('tip-active'); });
  });
})();
</script>
