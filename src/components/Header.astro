---
import Logo from './Logo.astro';

export interface Props {
  /* false retire completement l'appel a l'action de la barre. */
  cta?: string | false;
  ctaHref?: string;
  back?: boolean;
}
import InteractiveButton from './ui/InteractiveButton.astro';
const { cta = 'Demander un devis', ctaHref = '/devis', back = true } = Astro.props;

/* LES TROIS ÉTATS DU THÈME, écrits une seule fois : la barre et le menu
   plein écran en portent chacun un exemplaire, et deux listes séparées
   finiraient par diverger. */
const THEMES = [
  { cle: 'system', nom: 'Thème du système', cleI18n: 'theme-systeme',
    svg: '<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8.4"/>' +
         '<path d="M12 3.6a8.4 8.4 0 0 0 0 16.8z" fill="currentColor" stroke="none"/></svg>' },
  { cle: 'light', nom: 'Mode clair', cleI18n: 'theme-clair',
    svg: '<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4.2"/>' +
         '<path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.2 5.2l1.4 1.4M17.4 17.4l1.4 1.4' +
         'M18.8 5.2l-1.4 1.4M6.6 17.4l-1.4 1.4"/></svg>' },
  { cle: 'dark', nom: 'Mode sombre', cleI18n: 'theme-sombre',
    svg: '<svg viewBox="0 0 24 24" aria-hidden="true">' +
         '<path d="M20 14.2A8.2 8.2 0 0 1 9.8 4a8.4 8.4 0 1 0 10.2 10.2z"/></svg>' },
];
---
<header class="hdr" id="hdr">
  {/* .hdr-in remplace .wrap : c'est lui qui s'étire au défilement, de
      900 px à toute la largeur. .wrap a une largeur fixe pour tout le
      site et n'avait pas à apprendre ce tour-là. */}
  <div class="hdr-in">
    <nav class="nav" aria-label="Navigation principale" data-i18n-aria="a11y-nav-main">
      <a href="/" class="nav-logo" aria-label="NEXAWEB — Accueil" data-i18n-aria="a11y-logo">
        <Logo class="nav-logo-mk lg-compact" largeur={30} trait={2.2} texte={true} tailleNom={13} sous={false} />
      </a>
      <ul class="nav-links" role="list">
        <li><a href="/#accueil"  class="nav-link" data-i18n="hdr-nav-home">Accueil</a></li>
        <li><a href="/services" class="nav-link" data-i18n="hdr-nav-services">Services</a></li>
        <li><a href="/#apropos"  class="nav-link" data-i18n="hdr-nav-about">À propos</a></li>
        <li><a href="/tarifs"    class="nav-link" data-i18n="hdr-nav-pricing">Tarifs</a></li>
        <li><a href="/#faq"     class="nav-link" data-i18n="hdr-nav-faq">FAQ</a></li>
        <li><a href="/contact"  class="nav-link" data-i18n="hdr-nav-contact">Contact</a></li>
      </ul>
      <div class="nav-r">
        <div class="lang-sel plq plq-fixe" role="group" aria-label="Langue" data-i18n-aria="a11y-langue">
          <button class="lang-opt plq" data-lang="fr">FR</button>
          <button class="lang-opt plq" data-lang="en">EN</button>
        </div>

        <!-- SÉLECTEUR DE THÈME — système / clair / sombre.
             role=radiogroup : un choix parmi trois, pas trois bascules.

             IL A ÉTÉ SUPPRIMÉ UNE FOIS, ET LE SITE S'EST RETROUVÉ ENFERMÉ.
             Le script de démarrage de BaseLayout applique le choix gardé
             dans localStorage ; sans ce groupe, plus rien ne pouvait le
             changer. Mesuré : « nw-theme=dark » en mémoire + système en
             clair = fond noir, et zéro contrôle sur la page pour en
             sortir. Tant que le démarrage lit une préférence, une
             commande doit pouvoir la réécrire — c'est désormais vérifié
             par check:header.

             D'où aussi le troisième état. À deux options on pouvait
             choisir clair ou sombre, jamais revenir à « suis mon
             téléphone » : le choix était définitif par construction. -->
        <div class="theme-sel plq plq-fixe" id="theme-sel" role="radiogroup" aria-label="Thème d'affichage" data-i18n-aria="a11y-theme">
          {THEMES.map(o => (
            <button type="button" class="theme-opt plq" role="radio" data-theme-opt={o.cle}
                    aria-checked="false" tabindex="-1"
                    title={o.nom} data-i18n-title={o.cleI18n}>
              <Fragment set:html={o.svg} />
              <span class="sr-only" data-i18n={o.cleI18n}>{o.nom}</span>
            </button>
          ))}
        </div>

        <!-- Bouton Menu. Il ouvre la navigation plein ecran, et sur
             telephone c'est la SEULE facon d'atteindre les pages : il ne
             doit jamais disparaitre. Il a ete emporte une fois par un
             retrait du selecteur de theme voisin — d'ou le garde-fou qui
             le reclame desormais sur chaque page. -->
        <button class="menu-btn plq" id="menu-btn"
          aria-label="Menu — ouvrir la navigation" data-i18n-aria="a11y-menu"
          aria-expanded="false">
          <svg viewBox="0 0 24 24" aria-hidden="true"><line x1="3" y1="7" x2="21" y2="7"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="17" x2="21" y2="17"/></svg>
          <span class="hdr-btn-lbl" data-i18n="hdr-menu">Menu</span>
        </button>

<!-- Bouton Retour -->
        {back && (
          <InteractiveButton text="Retour" class="hdr-back" id="hdr-back"
                             aria-label="Retour — page précédente" data-i18n-aria="a11y-retour"
                             data-i18n="hdr-back" />
        )}

        {/* L'APPEL A L'ACTION PEUT ETRE RETIRE. Sur /devis il menait a
            /devis : la page etait deja celle vers laquelle il invitait,
            et le bouton n'y proposait que de rester sur place. */}
        {cta !== false && (
          <InteractiveButton text={cta} href={ctaHref} variant="gold" class="hdr-cta" data-i18n="hdr-cta" />
        )}
      </div>
    </nav>
  </div>
</header>

<!-- NAVIGATION PLEIN ÉCRAN — une liste, plus un cercle d'icônes.
     Le menu radial à pictogrammes se lisait plus lentement qu'une liste,
     et ses icônes n'aidaient pas (une étiquette pour « Tarifs », des
     calques pour « Services »). Les liens sont écrits en clair, dans
     l'ordre où un visiteur les cherche, alignés à gauche dans .wrap.
     #cnav-ring garde son nom et sa transition d'ouverture : seule la
     forme a changé, pas le mouvement. -->
<div class="cnav" id="cnav" role="dialog" aria-modal="true" aria-label="Navigation"
     data-i18n-aria="a11y-nav" inert>
  <div class="cnav-ring wrap" id="cnav-ring">
    <button class="cnav-close plq" id="cnav-close" aria-label="Fermer la navigation" data-i18n-aria="a11y-fermer">
      <svg viewBox="0 0 24 24" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
    <ul class="cnav-liste" role="list">
      <li><a href="/" class="cnav-link h-md" data-i18n="hdr-nav-home">Accueil</a></li>
      <li><a href="/services" class="cnav-link h-md" data-i18n="hdr-nav-services">Services</a></li>
      <li><a href="/tarifs" class="cnav-link h-md" data-i18n="hdr-nav-pricing">Tarifs</a></li>
      <li><a href="/comment-ca-marche" class="cnav-link h-md" data-i18n="hdr-nav-ccm">Comment ça marche</a></li>
      <li class="cnav-groupe"><span class="cnav-sous-t" data-i18n="hdr-nav-metier">Par métier</span>
        <ul class="cnav-sous" role="list">
          <li><a href="/site-internet-restaurant" class="cnav-link cnav-link-s" data-i18n="hdr-nav-resto">Restaurants</a></li>
          <li><a href="/site-internet-commerce" class="cnav-link cnav-link-s" data-i18n="hdr-nav-commerce">Commerces</a></li>
          <li><a href="/site-internet-artisan" class="cnav-link cnav-link-s" data-i18n="hdr-nav-artisan">Artisans</a></li>
        </ul>
      </li>
      <li><a href="/equipe" class="cnav-link h-md" data-i18n="hdr-nav-team">L'équipe</a></li>
      <li><a href="/avis" class="cnav-link h-md" data-i18n="hdr-nav-reviews">Avis</a></li>
      <li><a href="/#faq" class="cnav-link h-md" data-i18n="hdr-nav-faq">FAQ</a></li>
      <li><a href="/contact" class="cnav-link h-md" data-i18n="hdr-nav-contact">Contact</a></li>
      <li><a href="/rendez-vous" class="cnav-link h-md" data-i18n="hdr-nav-rdv">Rendez-vous</a></li>
      <li><a href="/devis" class="cnav-link h-md" data-i18n="hdr-nav-devis">Demander un devis</a></li>
    </ul>
  </div>

  <!-- Langue et thème, sur mobile uniquement.
       Dans la barre ils écrasaient le logo et repoussaient le bouton
       Retour dans le coin, sans son libellé. Ici ils ont la place.
       Le même JS pilote les deux exemplaires. -->
  <div class="cnav-tools">
    <div class="lang-sel plq plq-fixe" role="group" aria-label="Langue" data-i18n-aria="a11y-langue">
      <button class="lang-opt plq" data-lang="fr">FR</button>
      <button class="lang-opt plq" data-lang="en">EN</button>
    </div>
    <div class="theme-sel plq plq-fixe" role="radiogroup" aria-label="Thème d'affichage" data-i18n-aria="a11y-theme">
      {THEMES.map(o => (
        <button type="button" class="theme-opt plq" role="radio" data-theme-opt={o.cle}
                aria-checked="false" tabindex="-1"
                title={o.nom} data-i18n-title={o.cleI18n}>
          <Fragment set:html={o.svg} />
          <span class="sr-only" data-i18n={o.cleI18n}>{o.nom}</span>
        </button>
      ))}
    </div>
  </div>
</div>

<script is:inline>
(function(){
  'use strict';

  var root = document.documentElement;

  /* ═══════════════════════════════════════════════════════════════════
     LE THÈME — système, clair, sombre

     Le choix vit dans localStorage sous « nw-theme », et BaseLayout
     l'applique avant le premier pixel pour qu'aucune page ne clignote
     dans la mauvaise couleur. « système » n'est pas une valeur stockée :
     c'est l'ABSENCE de valeur. On efface la clé, et les media queries de
     tokens.css reprennent la main.

     UN SEUL ÉTAT PEINT SUR DEUX EXEMPLAIRES — celui de la barre et celui
     du menu plein écran. Sur téléphone la barre est pleine : le groupe y
     est masqué sous 640 px et c'est le menu qui le porte.

     On peint le CHOIX, pas le thème qui en résulte. La version
     précédente n'avait que deux boutons et peignait le thème effectif,
     faute de quoi aucun n'aurait été coché en mode système — et un
     radiogroup sans bouton coché n'a plus d'arrêt de tabulation, donc
     devient injoignable au clavier. Avec « système » comme vrai bouton,
     il y a toujours exactement un coché, sans détour. */
  var mqDark = window.matchMedia('(prefers-color-scheme: dark)');
  var sels = Array.prototype.slice.call(document.querySelectorAll('.theme-sel'));

  function choixGarde(){
    try{ var t = localStorage.getItem('nw-theme'); return (t==='light'||t==='dark') ? t : 'system'; }
    catch(e){ return 'system'; }
  }

  function peindre(choix){
    sels.forEach(function(sel){
      sel.querySelectorAll('.theme-opt').forEach(function(b){
        var on = b.getAttribute('data-theme-opt') === choix;
        b.setAttribute('aria-checked', on ? 'true' : 'false');
        /* Un seul arrêt de tabulation par groupe — motif radiogroup. */
        b.tabIndex = on ? 0 : -1;
        b.classList.toggle('on', on);
      });
    });
  }

  function appliquer(choix){
    /* On coupe les transitions le temps de la bascule : sinon les
       couleurs traversent des teintes intermédiaires et l'écran
       clignote. */
    document.body.classList.add('theme-switching');
    requestAnimationFrame(function(){
      requestAnimationFrame(function(){ document.body.classList.remove('theme-switching'); });
    });
    if(choix === 'system'){
      root.removeAttribute('data-theme');
      try{ localStorage.removeItem('nw-theme'); }catch(e){}
    }else{
      root.setAttribute('data-theme', choix);
      try{ localStorage.setItem('nw-theme', choix); }catch(e){}
    }
    peindre(choix);
    document.dispatchEvent(new CustomEvent('nw-theme', { detail: choix }));
  }

  if(sels.length){
    peindre(choixGarde());
    sels.forEach(function(sel){
      var opts = Array.prototype.slice.call(sel.querySelectorAll('.theme-opt'));
      opts.forEach(function(b){
        b.addEventListener('click', function(){ appliquer(b.getAttribute('data-theme-opt')); b.focus(); });
      });
      /* Flèches directionnelles : la navigation attendue dans un
         radiogroup. */
      sel.addEventListener('keydown', function(e){
        var i = opts.indexOf(document.activeElement);
        if(i < 0) return;
        var n = null;
        if(e.key === 'ArrowRight' || e.key === 'ArrowDown') n = (i + 1) % opts.length;
        if(e.key === 'ArrowLeft'  || e.key === 'ArrowUp')   n = (i - 1 + opts.length) % opts.length;
        if(n === null) return;
        e.preventDefault();
        appliquer(opts[n].getAttribute('data-theme-opt'));
        opts[n].focus();
      });
    });
    /* En mode système, l'OS peut basculer pendant la visite : le site
       suit sans rechargement, et les écouteurs du site sont prévenus. */
    mqDark.addEventListener('change', function(){
      if(choixGarde() === 'system'){
        document.dispatchEvent(new CustomEvent('nw-theme', { detail: 'system' }));
      }
    });
  }


  /* ── Retour ──────────────────────────────────────────────────────────
     Le nom accessible annonce « page précédente » : le bouton doit le
     faire. Il ne revient en arrière que si la page précédente appartient
     bien à ce site — sinon on renverrait le visiteur vers Google ou vers
     le lien qui l'a amené. Arrivée directe : retour à l'accueil. */
  var backBtn = document.getElementById('hdr-back');
  if(backBtn) backBtn.addEventListener('click', function(){
    var interne = (parseInt(root.dataset.vues || '0', 10) || 0) > 0;
    if(!interne){
      try{
        interne = !!document.referrer && new URL(document.referrer).origin === location.origin;
      }catch(e){}
    }
    if(interne && history.length > 1) history.back();
    else window.location.href = '/';
  });

  /* ── Langue FR/EN ── */
  var savedLang = 'fr';
  try{ savedLang = localStorage.getItem('nw-lang') || 'fr'; }catch(e){}
  document.querySelectorAll('.lang-opt').forEach(function(b){
    var isOn = b.getAttribute('data-lang') === savedLang;
    b.classList.toggle('active', isOn);
    b.setAttribute('aria-pressed', isOn ? 'true' : 'false');
    b.addEventListener('click', function(){
      var lang = b.getAttribute('data-lang');
      try{ localStorage.setItem('nw-lang', lang); }catch(e){}
      document.querySelectorAll('.lang-opt').forEach(function(x){
        var on = x.getAttribute('data-lang') === lang;
        x.classList.toggle('active', on);
        x.setAttribute('aria-pressed', on ? 'true' : 'false');
      });
      document.dispatchEvent(new CustomEvent('nw-lang', { detail: lang }));
    });
  });

  /* ═══════════════════════════════════════════════════════════════════
     NAVIGATION PLEIN ÉCRAN — fond opaque, scroll verrouillé, focus piégé
     ═══════════════════════════════════════════════════════════════════ */
  var overlay = document.getElementById('cnav');
  var ring    = document.getElementById('cnav-ring');
  var menuBtn = document.getElementById('menu-btn');
  var closeBtn= document.getElementById('cnav-close');
  if(!overlay || !ring || !menuBtn) return;

  var scrollY = 0;

  function focusables(){
    /* tabIndex < 0 : les radios non cochées du sélecteur de thème. Les
       inclure ferait boucler le piège sur un élément que la touche
       Tabulation n'atteint jamais. */
    return Array.prototype.slice.call(
      overlay.querySelectorAll('a[href],button:not([disabled])')
    ).filter(function(el){ return el.offsetParent !== null && el.tabIndex >= 0; });
  }

  function openNav(){
    scrollY = window.scrollY;
    overlay.removeAttribute('inert');
    overlay.classList.add('open');
    menuBtn.setAttribute('aria-expanded', 'true');
    // Verrouillage du scroll sans saut de page (iOS compris).
    document.body.classList.add('nav-open');
    document.body.style.top = (-scrollY) + 'px';
    closeBtn.focus();
  }

  function closeNav(){
    overlay.classList.remove('open');
    overlay.setAttribute('inert', '');
    menuBtn.setAttribute('aria-expanded', 'false');
    document.body.classList.remove('nav-open');
    document.body.style.top = '';
    window.scrollTo(0, scrollY);
    menuBtn.focus();
  }

  menuBtn.addEventListener('click', openNav);
  closeBtn.addEventListener('click', closeNav);
  overlay.addEventListener('click', function(e){ if(e.target === overlay) closeNav(); });

  document.addEventListener('keydown', function(e){
    if(!overlay.classList.contains('open')) return;
    if(e.key === 'Escape'){ closeNav(); return; }
    if(e.key !== 'Tab') return;
    // Piège de focus : la tabulation tourne en boucle dans l'overlay.
    var f = focusables();
    if(!f.length) return;
    var first = f[0], last = f[f.length - 1];
    if(e.shiftKey && document.activeElement === first){ e.preventDefault(); last.focus(); }
    else if(!e.shiftKey && document.activeElement === last){ e.preventDefault(); first.focus(); }
  });

  ring.querySelectorAll('.cnav-link').forEach(function(l){ l.addEventListener('click', closeNav); });

  /* ── UNE SEULE PLAQUE D'OR PAR ÉCRAN ──
     Tant qu'un bouton d'or de la page est à l'écran (le premier écran de
     l'accueil en porte un), celui de la barre passe en plaque neutre :
     deux ors côte à côte, on ne sait plus lequel presser. */
  /* Ce script s'exécute avant que <main> soit lu : on attend le DOM. */
  function unSeulOr(){
    var hdrCta = document.querySelector('.hdr .hdr-cta');
    var orPage = document.querySelector('main .ihb-gold');
    if(!hdrCta || !orPage || !('IntersectionObserver' in window)) return;
    new IntersectionObserver(function(es){
      var vu = es[0].isIntersecting;
      hdrCta.classList.toggle('ihb-gold', !vu);
      hdrCta.classList.toggle('ihb-dark', vu);
    }).observe(orPage);
  }
  if(document.readyState === 'loading') document.addEventListener('DOMContentLoaded', unSeulOr);
  else unSeulOr();

  /* ── Infobulles au toucher ── */
  document.querySelectorAll('.hdr-tip').forEach(function(el){
    el.addEventListener('touchstart', function(){ el.classList.add('tip-active'); }, { passive:true });
    el.addEventListener('touchend',   function(){ setTimeout(function(){ el.classList.remove('tip-active'); }, 700); });
    el.addEventListener('touchcancel',function(){ el.classList.remove('tip-active'); });
  });
})();
</script>
