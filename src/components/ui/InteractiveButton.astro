---
/**
 * LE BOUTON — un seul bouton pour tout le site.
 *
 * Une plaque à angles coupés, et un libellé. Rien d'autre.
 *
 * ── CE QUI A ÉTÉ RETIRÉ, ET POURQUOI ─────────────────────────────────
 * Le bouton précédent reprenait l'« Interactive Hover Button » de
 * magicui sur une plaque de chrome liquide : au survol, le libellé
 * fuyait vers la droite et revenait suivi d'une flèche, pendant qu'un
 * reflet glissait. C'est le bouton par défaut des bibliothèques de
 * composants, donc celui de tous les sites générés : il disait « modèle »
 * avant de dire « Nexa ». Plus de copie du libellé, plus de flèche, plus
 * de reflet. La forme et sa matière vivent dans global.css (« LA
 * PLAQUE ») ; le survol change la teinte, l'appui enfonce d'un pixel.
 *
 * ── LE PIÈGE DES TRADUCTIONS ─────────────────────────────────────────
 * public/i18n.js applique les traductions par « el.innerHTML = t[k] ».
 * Une clé data-i18n posée sur la RACINE remplacerait tout le contenu du
 * bouton. Elle est donc posée sur le libellé interne, qui ne contient
 * que du texte : la structure survit au changement de langue.
 *
 * ── LES VARIANTES ────────────────────────────────────────────────────
 *   variant="gold" : la plaque d'or, l'action principale (une par écran)
 *   variant="dark" : la plaque neutre, tout le reste (défaut)
 */
interface Props {
  text: string;
  href?: string;
  type?: string;
  variant?: 'dark' | 'gold';
  class?: string;
  [cle: string]: any;
}

const {
  text,
  href,
  type,
  variant = 'dark',
  class: classe = '',
  ...reste
} = Astro.props;

/* Un lien s'il mène quelque part, un bouton sinon. */
const Balise = href ? 'a' : 'button';

/* La clé de traduction descend sur le libellé (voir plus haut). */
const { 'data-i18n': cleI18n, ...autres } = reste;

/* Un <button> sans type vaut « submit » dans un formulaire : on ne veut
   pas qu'un bouton d'affichage envoie le formulaire par surprise. */
const typeFinal = href ? undefined : (type ?? 'button');
---

<Balise
  class={`ihb ihb-${variant}${classe ? ' ' + classe : ''}`}
  href={href}
  type={typeFinal}
  {...autres}
>
  <span class="ihb-t" data-i18n={cleI18n}>{text}</span>
</Balise>
