---
/**
 * LE LOGO LIQUIDE — le rendu fourni, posé proprement.
 *
 * L'image passe par la chaîne d'images du site : AVIF, WebP et repli
 * JPEG, trois largeurs, dimensions écrites dans le manifeste donc aucun
 * saut de mise en page. La source fait 660 px de côté : au-delà de
 * 330 px d'affichage sur un écran à double densité, elle s'adoucit.
 *
 * Le rendu est livré sur un noir plein : sur le thème clair, ce noir
 * ferait un cadre autour de la tuile. La découpe qui l'enlève est dans
 * global.css, taillée sur l'arête du verre mesurée dans le fichier, et
 * non sur une valeur estimée.
 *
 * Le mot reste du texte : net à toutes les tailles, traduit avec le
 * reste, et lisible par un lecteur d'écran. Figé dans l'image, il
 * perdrait les trois.
 *
 * L'or liquide est en option : sans « anime », rien de WebGL n'est
 * téléchargé ni exécuté. Avec, le rendu fixe reste ce qu'on voit
 * d'abord, et ce qu'on voit tout court si la machine ne suit pas —
 * voir public/liquide.js pour les conditions, et le poids du moteur.
 *
 * Les styles vivent dans global.css : <Picture> est un composant enfant,
 * son <picture> ne porte pas l'attribut de portée de celui-ci, donc un
 * style scopé ne l'atteindrait pas.
 */
import Picture from './Picture.astro';

export interface Props {
  taille?: number;        // côté de la tuile en pixels
  nom?: boolean;          // afficher « NEXA WEB » dessous
  aide?: boolean;         // afficher la ligne d'invitation
  interactif?: boolean;   // survol et clic
  anime?: boolean;        // l'or ondule sous le curseur (WebGL, à la demande)
  lueur?: boolean;        // halo chaud derrière la tuile
  prioritaire?: boolean;  // image au-dessus de la ligne de flottaison
  class?: string;
}
const {
  taille = 320,
  nom = true,
  aide = false,
  interactif = true,
  anime = false,
  lueur = true,
  prioritaire = false,
  class: klass = '',
} = Astro.props;
---

<div
  class:list={['llq', interactif && 'llq-i', !lueur && 'llq-sec', klass]}
  style={`--llq-taille:${taille}px`}
>
  <div class="llq-tuile" data-liquide={anime ? '' : undefined}>
    <Picture
      name="logo-liquide"
      alt="Nexa Web"
      sizes={`${taille}px`}
      priority={prioritaire}
      curtain={false}
    />
    {anime && <canvas class="llq-canvas" aria-hidden="true"></canvas>}
    <span class="llq-goutte" aria-hidden="true"></span>
  </div>

  {nom && (
    <p class="llq-nom"><span class="llq-nexa">NEXA</span><span class="llq-web">WEB</span></p>
  )}
  {aide && (
    <p class="llq-aide">Passez la souris sur le logo · cliquez pour une goutte</p>
  )}
</div>

{anime && (
  /* Un module : plusieurs instances dans la page ne le chargent et ne
     l'évaluent qu'une fois, le navigateur les associant à l'URL. */
  <script is:inline type="module" src="/liquide.js"></script>
)}

{interactif && (
  <script is:inline>
    /* La goutte tombe au clic : on pose une classe, l'animation CSS fait
       le reste, et la classe part d'elle-même à la fin. Sans ce retrait,
       un deuxième clic ne rejouerait rien. */
    (function () {
      'use strict';
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      document.addEventListener('click', function (e) {
        var l = e.target.closest ? e.target.closest('.llq-i') : null;
        if (!l || l.classList.contains('llq-tombe')) return;
        l.classList.add('llq-tombe');
        setTimeout(function () { l.classList.remove('llq-tombe'); }, 1000);
      }, { passive: true });
    })();
  </script>
)}
