---
import { SITE } from '../config/site';

interface Props {
  /** Libelle de la page courante. L'accueil est toujours le premier maillon. */
  label: string;
  path: string;
}
const { label, path } = Astro.props;
---

<nav class="fil" aria-label="Fil d'Ariane">
  <a href="/">Accueil</a>
  <span aria-hidden="true">/</span>
  <span aria-current="page">{label}</span>
</nav>

<script
  is:inline
  type="application/ld+json"
  set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Accueil', item: `https://${SITE.domain}/` },
      { '@type': 'ListItem', position: 2, name: label, item: `https://${SITE.domain}${path}` },
    ],
  })}
/>
