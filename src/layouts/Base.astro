---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Chemin de la page, sans slash final, pour le canonical. Ex : "/mentions-legales" */
  path?: string;
  /** Pages de service (confirmation, erreur, 404) : hors index, hors sitemap. */
  noindex?: boolean;
}

const { title, description, path = '', noindex = false } = Astro.props;
const canonical = new URL(path, Astro.site).href;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="any" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content="Nexa Web" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {/* JPEG et non WebP : LinkedIn et une partie des clients de messagerie
        ignorent encore le WebP et n'affichent alors aucune vignette. */}
    <meta property="og:image" content={new URL('/assets/og.jpg', Astro.site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Nexa Web — sites internet pour les commerces des Hauts-de-France" />
    <meta name="twitter:card" content="summary_large_image" />

    {/* Polices servies par le site lui-meme (voir src/styles/fonts.css).
        Seules les deux faces du titre sont prechargees : c'est le plus grand
        element de la page, donc celui qui decide du LCP. Archivo suit par la
        feuille de style, son texte est plus petit et moins penalisant. */}
    <link rel="preload" as="font" type="font/woff2" href="/fonts/cormorant-latin.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/cormorant-italic-latin.woff2" crossorigin />
  </head>
  <body>
    <slot />
  </body>
</html>
