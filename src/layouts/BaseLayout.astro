---
export interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}
/* LA CLE DU TITRE ET DE LA DESCRIPTION SE DEDUIT DE L'ADRESSE.
   Chaque page a son <title> et sa meta description, et aucun des deux
   n'etait traduit : en anglais, l'onglet et le resultat de recherche
   restaient en francais. Deduire la cle du chemin evite d'editer
   vingt-trois pages pour y poser deux attributs, et evite surtout
   qu'une page nouvelle soit oubliee — elle herite du mecanisme sans
   rien faire. i18n.js pose aussi lang="en" au passage : un
   <html lang="fr"> sur une page anglaise, c'est un lecteur d'ecran qui
   prononce l'anglais avec les regles du francais.

   « / » devient « accueil », « /mentions-legales » reste tel quel. */
const clePage = (Astro.url.pathname.replace(/^\/|\/$/g, '') || 'accueil')
  .replace(/[^a-z0-9-]/gi, '-');

const {
  title,
  description = "Nexa Web conçoit des sites internet sur-mesure pour commerçants et artisans. Refonte dès 490 €, livraison en 2 à 4 semaines. Carvin, Hauts-de-France.",
  noindex = false,
} = Astro.props;

const siteOrigin = 'https://nexaaweb.com';
const canonicalUrl = siteOrigin + Astro.url.pathname;
// Deux variantes existent ; la sombre est l'identité de la marque et
// reste la déclaration principale, les plateformes ne lisant en
// pratique que la première.
const ogImageUrl = siteOrigin + '/og-image.png';
const ogImageLightUrl = siteOrigin + '/og-image-light.png';
import River from '../components/River.astro';
import Cookies from '../components/Cookies.astro';
import Intro from '../components/Intro.astro';
---
<!doctype html>
<html lang="fr"
      data-i18n-doctitle={`meta-t-${clePage}`}
      data-i18n-docdescr={`meta-d-${clePage}`}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow"} />
  <!-- Fait suivre le thème aux barres de défilement, champs natifs et autofill -->
  <meta name="color-scheme" content="dark light" />
  <!-- L'icône de l'onglet, c'est le rendu 3D, pas le monogramme vectoriel.
       Le SVG n'est plus déclaré : quand un navigateur en trouve un, il le
       préfère à tous les PNG, et c'est le vecteur qui s'afficherait.
       Deux tailles, parce qu'elles ne portent pas le même dessin : à 16 px
       l'image entière n'est qu'une tache, le recadrage y est resserré de
       15 % pour que le N garde assez de pixels. Vérifié en agrandissant. -->
  {/* L'ICO d'abord, pour les vieux navigateurs et les agregateurs qui
      ne lisent que /favicon.ico ; les PNG ensuite, que tout le reste
      prefere. Le SVG n'est PAS declare comme icone : declare, il
      primerait sur les PNG, et son fond arrondi se rend mal dans
      certaines barres d'onglets. */}
  <link rel="icon" href="/favicon.ico" sizes="32x32" />
  <link rel="icon" href="/icons/icon-32.png" type="image/png" sizes="32x32" />
  <link rel="icon" href="/icons/icon-16.png" type="image/png" sizes="16x16" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
  <link rel="manifest" href="/site.webmanifest" />
  <link rel="canonical" href={canonicalUrl} />
  <title>{title}</title>
  <!-- Open Graph -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:image" content={ogImageUrl} />
  <meta property="og:image:alt" content="Nexa Web — des sites web qui donnent une nouvelle dimension à votre marque. Carvin, Hauts-de-France." />
  <meta property="og:image" content={ogImageLightUrl} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />

  {/* DONNÉES STRUCTURÉES. Il n'y en avait aucune : ce bloc est ce que
      Google lit pour composer une fiche d'entreprise, et « logo » est
      exactement l'image qu'il affiche à côté du nom. On n'y met que ce
      que le site dit déjà publiquement — mentions légales et pied de
      page —, rien d'inventé. */}
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'ProfessionalService',
    name: 'Nexa Web',
    url: siteOrigin,
    logo: siteOrigin + '/icons/icon-512.png',
    image: ogImageUrl,
    description: "Agence web à Carvin, Hauts-de-France : création de sites vitrine, e-commerce et refonte.",
    email: 'contact.nexaweb62@gmail.com',
    telephone: '+33641467898',
    founder: { '@type': 'Person', name: 'Ahmed Chteoui' },
    address: {
      '@type': 'PostalAddress',
      streetAddress: "3 rue d'Albi",
      postalCode: '62220',
      addressLocality: 'Carvin',
      addressRegion: 'Hauts-de-France',
      addressCountry: 'FR',
    },
    areaServed: 'Hauts-de-France',
    sameAs: [
      'https://www.linkedin.com/in/ahmed-chteoui-049211429/',
      'https://www.facebook.com/people/Nexaweb/61593685250868/',
    ],
  })} />
  <meta property="og:locale" content="fr_FR" />
  <meta property="og:site_name" content="Nexa Web" />
  <!-- Twitter / X -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageUrl} />

  <!-- ══════════════════════════════════════════════════════════════════
       Script bloquant, avant tout rendu.
       (a) applique le thème enregistré → aucun flash de la mauvaise couleur
       (b) pose .js-enabled → les états de départ des animations ne
           s'appliquent QUE si le JS tourne, sinon tout reste visible
       ══════════════════════════════════════════════════════════════════ -->
  <script is:inline>
    (function () {
      var r = document.documentElement;
      try {
        var t = localStorage.getItem('nw-theme');
        if (t === 'light' || t === 'dark') r.setAttribute('data-theme', t);
      } catch (e) { /* navigation privée, stockage bloqué */ }
      /* Combien de pages de ce site l'onglet a-t-il déjà servies ? Le
         bouton Retour a besoin de le savoir : document.referrer est vide
         dès qu'une politique de référent le coupe, et history.length
         compte aussi les pages des autres sites. Ce compteur, lui, ne
         compte que les nôtres, et meurt avec l'onglet. */
      try {
        var vues = parseInt(sessionStorage.getItem('nw-vues') || '0', 10) || 0;
        r.dataset.vues = String(vues);
        sessionStorage.setItem('nw-vues', String(Math.min(vues + 1, 99)));
      } catch (e) { /* stockage bloqué : on retombera sur l'accueil */ }
      r.classList.add('js-enabled');

      /* ── LE FILET DE SÉCURITÉ ──────────────────────────────────────
         C'est cette ligne, juste au-dessus, qui autorise le système
         d'animation à masquer le contenu au départ. Si le script qui
         doit ensuite le révéler échoue — une erreur, un fichier qui
         n'arrive pas, un observateur qui ne se déclenche jamais — le
         texte reste invisible, et la page a l'air vide.

         Le minuteur est armé ICI, dans le même script que .js-enabled,
         et pas dans le fichier d'animation : les deux doivent vivre ou
         mourir ensemble. Si ce script ne tourne pas, rien n'a été
         masqué et il n'y a rien à rattraper ; s'il tourne, le filet
         existe quoi qu'il arrive ensuite.

         Six secondes : une arrivée normale en dure moins de deux. Ce
         filet ne doit jamais se voir. */
      setTimeout(function () { r.classList.add('tout-visible'); }, 6000);

      /* ── RIEN NE TOURNE QUAND PERSONNE NE REGARDE ──────────────────
         Les fonds décoratifs — le grain, les traînées, le tissage de la
         page Tarifs — sont des animations infinies. Dans un onglet
         d'arrière-plan elles continuent de consommer, et au retour le
         navigateur doit rattraper tout ce qu'il a manqué. On les met en
         pause par une classe ; le CSS décide lesquelles. */
      document.addEventListener('visibilitychange', function () {
        document.body.classList.toggle('hors-champ', document.hidden);
      });
    })();
  </script>

  <!-- Global i18n EN/FR -->
  <script src="/i18n.js" defer></script>
  <!-- Système de mouvement (reveals, parallaxe, compteurs, barre de lecture) -->
  <script src="/motion.js" defer></script>
  <!-- Le mouvement au scroll : ruban, lumière de passage, lecture mot à mot -->
  <script src="/scroll-fx.js" defer></script>
  <!-- Titres mot a mot, boutons, curseur, rideau de transition -->
  <script src="/finition.js" defer></script>
  <!-- La matiere des boutons : un rendu WebGL unique, puis le contexte
       est relache. Voir l'en-tete de public/metal.js. -->
  <script src="/metal.js" defer></script>
</head>
<body data-page={Astro.url.pathname === "/" ? "home" : "page"}>
  <a class="skip-link" href="#main-content" data-i18n="a11y-skip">Aller au contenu</a>
  {/* L'intro : une fois par visite, sur la premiere page ouverte. */}
  <Intro />
  <River />
  <div class="grain" aria-hidden="true" role="presentation"></div>
  <div class="lamp" aria-hidden="true" role="presentation"></div>
  <!-- Le rideau de transition. Il n'existe que si le JS tourne : sans
       lui, la navigation reste une navigation, simplement sans rideau. -->
  <div class="curtain" aria-hidden="true" role="presentation" hidden>
    <span class="sheen"></span><span class="edgeline"></span>
    <span class="cw">NEXA<i>WEB</i></span>
  </div>
  <!-- Le fond vivant : ce que le verre des boutons réfracte. Décoratif,
       retiré de l'arbre d'accessibilité, sous tout le contenu. -->
  <div class="ambience" aria-hidden="true" role="presentation">
    <div class="amb-depth"></div>
    <div class="amb-weave"></div>
    <div class="amb-streak"></div>
    <div class="amb-streak-2"></div>
  </div>
  <div class="read-bar" aria-hidden="true"></div>

  <!-- Cookies et traceurs. AVANT le contenu, et c'est délibéré : son
       script publie window.nwConsent, que les pages interrogent pour
       savoir si elles ont le droit de charger un tiers. Posé après le
       <slot />, il s'exécutait après elles — mesuré, la page
       Rendez-vous retombait alors sur « pas encore de réponse » et
       n'affichait plus le calendrier même à un visiteur qui venait de
       l'autoriser. Le bandeau reste visuellement en bas, il est en
       position fixe ; seul l'ordre du document change, et un lecteur
       d'écran rencontre la question avant la page, comme un visiteur
       qui la voit en arrivant. -->
  <Cookies />

  <slot />

  <!-- La couleur de la barre du navigateur suit le thème. Lue dans les
       tokens CSS : aucune couleur n'est écrite en dur ici. -->
  <script is:inline>
    (function () {
      function sync() {
        var bg = getComputedStyle(document.documentElement).getPropertyValue('--bg').trim();
        if (!bg) return;
        var m = document.querySelector('meta[name="theme-color"]');
        if (!m) { m = document.createElement('meta'); m.name = 'theme-color'; document.head.appendChild(m); }
        m.setAttribute('content', bg);
      }
      sync();
      document.addEventListener('nw-theme', sync);
      window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', sync);
    })();
  </script>
</body>
</html>
