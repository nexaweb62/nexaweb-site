---
export interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}
const {
  title,
  description = "Nexa Web conçoit des sites internet sur-mesure pour commerçants et artisans. Livraison en 7 jours. Carvin, Hauts-de-France.",
  noindex = false,
} = Astro.props;

const siteOrigin = 'https://nexaaweb.com';
const canonicalUrl = siteOrigin + Astro.url.pathname;
// Deux variantes existent ; la sombre est l'identité de la marque et
// reste la déclaration principale, les plateformes ne lisant en
// pratique que la première.
const ogImageUrl = siteOrigin + '/og-image.png';
const ogImageLightUrl = siteOrigin + '/og-image-light.png';
---
<!doctype html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow"} />
  <!-- Fait suivre le thème aux barres de défilement, champs natifs et autofill -->
  <meta name="color-scheme" content="dark light" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/icons/icon-180.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <link rel="canonical" href={canonicalUrl} />
  <title>{title}</title>
  <!-- Open Graph -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:image" content={ogImageUrl} />
  <meta property="og:image:alt" content="Nexa Web — des sites web qui donnent une nouvelle dimension à votre marque. Carvin, Hauts-de-France." />
  <meta property="og:image" content={ogImageLightUrl} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:locale" content="fr_FR" />
  <meta property="og:site_name" content="Nexa Web" />
  <!-- Twitter / X -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageUrl} />

  <!-- ══════════════════════════════════════════════════════════════════
       Script bloquant, avant tout rendu.
       (a) applique le thème enregistré → aucun flash de la mauvaise couleur
       (b) pose .js-enabled → les états de départ des animations ne
           s'appliquent QUE si le JS tourne, sinon tout reste visible
       ══════════════════════════════════════════════════════════════════ -->
  <script is:inline>
    (function () {
      var r = document.documentElement;
      try {
        var t = localStorage.getItem('nw-theme');
        if (t === 'light' || t === 'dark') r.setAttribute('data-theme', t);
      } catch (e) { /* navigation privée, stockage bloqué */ }
      r.classList.add('js-enabled');
    })();
  </script>

  <!-- Global i18n EN/FR -->
  <script src="/i18n.js" defer></script>
  <!-- Système de mouvement (reveals, parallaxe, compteurs, barre de lecture) -->
  <script src="/motion.js" defer></script>
</head>
<body>
  <a class="skip-link" href="#main-content">Aller au contenu</a>
  <div class="read-bar" aria-hidden="true"></div>
  <slot />

  <!-- La couleur de la barre du navigateur suit le thème. Lue dans les
       tokens CSS : aucune couleur n'est écrite en dur ici. -->
  <script is:inline>
    (function () {
      function sync() {
        var bg = getComputedStyle(document.documentElement).getPropertyValue('--bg').trim();
        if (!bg) return;
        var m = document.querySelector('meta[name="theme-color"]');
        if (!m) { m = document.createElement('meta'); m.name = 'theme-color'; document.head.appendChild(m); }
        m.setAttribute('content', bg);
      }
      sync();
      document.addEventListener('nw-theme', sync);
      window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', sync);
    })();
  </script>
</body>
</html>
