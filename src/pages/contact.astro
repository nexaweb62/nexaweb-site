---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import '../styles/global.css';
---
<BaseLayout title="Localisation — Nexa Web" description="Nexa Web est basée à Carvin, Hauts-de-France. Retrouvez notre localisation et contactez-nous par email.">
<style>
/* Page override — full-screen globe */
html,body{overflow:hidden;height:100%}

/* Globe canvas */
#globe-canvas{position:fixed;inset:0;width:100%;height:100%;cursor:grab;z-index:0;display:block}
#globe-canvas:active{cursor:grabbing}

/* Loading */
#globe-loading{position:fixed;inset:0;z-index:200;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:18px;background:var(--bg);transition:opacity .6s}
#globe-loading.out{opacity:0;pointer-events:none}
.gl-spinner{width:28px;height:28px;border:2px solid var(--border-strong);border-top-color:var(--accent);border-radius:50%;animation:spin .75s linear infinite}
.gl-loading-text{font-size:var(--fs-caption);font-weight:600;letter-spacing:0;color:var(--text-muted)}
@keyframes spin{to{transform:rotate(360deg)}}

/* Page title */
.contact-head{position:fixed;top:calc(var(--hdr) + 40px);left:clamp(20px,5vw,80px);z-index:10;pointer-events:none}
.contact-eyebrow{font-size:var(--fs-caption);font-weight:600;letter-spacing:0;color:var(--accent-text);margin-bottom:10px}
.contact-title{font-size:clamp(1.7rem,3.8vw,3rem);font-weight:600;letter-spacing:-.04em;line-height:.96;color:var(--text)}
.contact-title em{font-style:italic;color:var(--text-muted)}

/* Carvin marker */
#carvin-pin{position:fixed;z-index:30;pointer-events:none;display:flex;flex-direction:column;align-items:center;gap:4px;transform:translate(-50%,-100%) translateY(-10px);opacity:0;transition:opacity .4s}
#carvin-pin.visible{opacity:1}
.carvin-badge{font-size:var(--fs-caption);font-weight:600;letter-spacing:0;color:var(--text);background:color-mix(in srgb,var(--bg) 78%,transparent);border:1px solid var(--accent);padding:3px 9px;border-radius:4px;backdrop-filter:blur(8px);white-space:nowrap}
.carvin-line{width:1px;height:12px;background:linear-gradient(to bottom,var(--accent),rgb(from var(--accent) r g b / 0))}
.carvin-dot{width:10px;height:10px;border-radius:50%;background:var(--accent);box-shadow:0 0 0 0 var(--accent-glow);animation:carvin-beat 2s ease-out infinite}
@keyframes carvin-beat{0%{box-shadow:0 0 0 0 var(--accent-glow)}70%{box-shadow:0 0 0 14px transparent}100%{box-shadow:0 0 0 0 transparent}}

/* Floating contact buttons */
.c-btn{position:fixed;z-index:50;display:inline-flex;align-items:center;gap:10px;padding:11px 20px;border-radius:var(--radius-pill);color:var(--text);font-family:var(--font);font-size:var(--fs-caption);font-weight:500;letter-spacing:0;text-decoration:none;white-space:nowrap;cursor:pointer;transition:background-color .25s,transform .25s;user-select:none}
.c-btn:hover{transform:translateY(-3px) !important}
.c-btn svg{width:14px;height:14px;flex-shrink:0;color:var(--accent-text)}
.c-btn-3{bottom:12%;left:50%;transform:translateX(-50%);animation:fl3 4.8s ease-in-out infinite}
@keyframes fl3{0%,100%{transform:translateX(-50%) translateY(0)}50%{transform:translateX(-50%) translateY(-9px)}}
.c-btn-3:hover{transform:translateX(-50%) translateY(-3px) !important}
@media(max-width:600px){.c-btn{font-size:var(--fs-caption);padding:9px 15px;gap:8px}.c-btn-3{bottom:10%}}
</style>

<Header />

<!-- Loading -->
<div id="globe-loading">
  <div class="gl-spinner"></div>
  <span class="gl-loading-text">Chargement du globe…</span>
</div>

<!-- Globe -->
<canvas id="globe-canvas" aria-hidden="true"></canvas>

<main id="main-content" tabindex="-1">

<!-- Page title -->
<div class="contact-head" aria-label="Contact Nexa Web">
  <div class="contact-eyebrow" data-i18n="ctt-eyebrow">Notre localisation</div>
  <h1 class="contact-title" data-i18n="ctt-title">On est à<br><em>Carvin.</em></h1>
</div>

<!-- Carvin marker -->
<div id="carvin-pin" role="presentation">
  <div class="carvin-badge">Carvin, France</div>
  <div class="carvin-line"></div>
  <div class="carvin-dot"></div>
</div>

<!-- Floating contact button — email uniquement -->
<a href="mailto:contact.nexaweb62@gmail.com" class="c-btn c-btn-3" aria-label="Envoyer un email à contact.nexaweb62@gmail.com">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
  contact.nexaweb62@gmail.com
</a>

</main>

<script is:inline src="https://cdn.jsdelivr.net/npm/d3@7/dist/d3.min.js"></script>
<script is:inline>
(function(){
  var CARVIN   = [2.9598, 50.4914];
  var GEOJSON  = 'https://raw.githubusercontent.com/martynafford/natural-earth-geojson/refs/heads/master/110m/physical/ne_110m_land.json';
  var DOT_STEP = 1.8;

  var canvas   = document.getElementById('globe-canvas');
  var ctx      = canvas.getContext('2d');

  /* Le globe lit ses couleurs dans les tokens : il suit la bascule de thème
     et aucune couleur n'est écrite en dur dans ce script. */
  var T = function(n){ return window.nwToken ? window.nwToken(n) : 'transparent'; };
  var A = function(a){ return window.nwTokenRgba ? window.nwTokenRgba('--accent', a) : 'transparent'; };
  var loadEl   = document.getElementById('globe-loading');
  var pinEl    = document.getElementById('carvin-pin');

  var W, H, radius, DPR;
  var rotation = [-2, -25];
  var autoRotate  = true;
  var rotSpeed    = 0.12;
  var landFeatures = null;
  var allDots      = [];
  var rafId;

  var projection = d3.geoOrthographic().clipAngle(90);
  var geoPath    = d3.geoPath().projection(projection).context(ctx);
  var graticule  = d3.geoGraticule()();

  function setProjection(){ projection.scale(radius).translate([W/2, H/2]).rotate(rotation); }

  function resize(){
    DPR    = Math.min(window.devicePixelRatio||1, 2);
    W      = window.innerWidth;
    H      = window.innerHeight;
    radius = Math.min(W, H) * 0.44;
    canvas.width  = Math.round(W * DPR);
    canvas.height = Math.round(H * DPR);
    canvas.style.width  = W + 'px';
    canvas.style.height = H + 'px';
    setProjection();
  }

  function ptInPoly(pt, ring){
    var x=pt[0], y=pt[1], inside=false;
    for(var i=0, j=ring.length-1; i<ring.length; j=i++){
      var xi=ring[i][0], yi=ring[i][1], xj=ring[j][0], yj=ring[j][1];
      if((yi>y)!==(yj>y) && x<((xj-xi)*(y-yi))/(yj-yi)+xi) inside=!inside;
    }
    return inside;
  }

  function ptInFeature(pt, f){
    var g=f.geometry;
    if(g.type==='Polygon'){
      if(!ptInPoly(pt,g.coordinates[0])) return false;
      for(var i=1;i<g.coordinates.length;i++) if(ptInPoly(pt,g.coordinates[i])) return false;
      return true;
    }
    if(g.type==='MultiPolygon'){
      for(var p=0;p<g.coordinates.length;p++){
        var poly=g.coordinates[p];
        if(ptInPoly(pt,poly[0])){
          var hole=false;
          for(var h=1;h<poly.length;h++) if(ptInPoly(pt,poly[h])){hole=true;break;}
          if(!hole) return true;
        }
      }
    }
    return false;
  }

  function buildDots(features){
    var dots=[];
    features.forEach(function(f){
      var b=d3.geoBounds(f);
      var minLng=b[0][0], minLat=b[0][1], maxLng=b[1][0], maxLat=b[1][1];
      for(var lng=minLng; lng<=maxLng; lng+=DOT_STEP){
        for(var lat=minLat; lat<=maxLat; lat+=DOT_STEP){
          var pt=[lng,lat];
          if(ptInFeature(pt,f)) dots.push(pt);
        }
      }
    });
    return dots;
  }

  function render(ts){
    ctx.setTransform(DPR,0,0,DPR,0,0);
    ctx.clearRect(0,0,W,H);
    ctx.beginPath();
    ctx.arc(W/2, H/2, radius, 0, Math.PI*2);
    ctx.fillStyle=T('--bg');
    ctx.fill();
    ctx.strokeStyle=A(.30);
    ctx.lineWidth=1.2;
    ctx.stroke();
    ctx.beginPath();
    geoPath(graticule);
    ctx.strokeStyle=A(.09);
    ctx.lineWidth=0.5;
    ctx.stroke();
    if(landFeatures){
      ctx.beginPath();
      landFeatures.features.forEach(function(f){ geoPath(f); });
      ctx.strokeStyle=A(.25);
      ctx.lineWidth=0.7;
      ctx.stroke();
    }
    ctx.fillStyle=A(.60);
    allDots.forEach(function(dot){
      var p=projection(dot);
      if(!p) return;
      ctx.beginPath();
      ctx.arc(p[0], p[1], 1.1, 0, Math.PI*2);
      ctx.fill();
    });
    var cp=projection(CARVIN);
    if(cp){
      var cx=cp[0], cy=cp[1];
      var t=(ts||0)/1000;
      [0, 1].forEach(function(offset){
        var phase=((t+offset)%2)/2;
        var r=5+phase*18;
        var a=(1-phase)*0.55;
        ctx.beginPath();
        ctx.arc(cx, cy, r, 0, Math.PI*2);
        ctx.strokeStyle=A(a);
        ctx.lineWidth=1.5;
        ctx.stroke();
      });
      ctx.beginPath();
      ctx.arc(cx, cy, 4.5, 0, Math.PI*2);
      ctx.fillStyle=T('--accent');
      ctx.shadowColor=A(.9);
      ctx.shadowBlur=10;
      ctx.fill();
      ctx.shadowBlur=0;
      ctx.beginPath();
      ctx.arc(cx, cy, 2, 0, Math.PI*2);
      ctx.fillStyle=T('--text');
      ctx.fill();
      pinEl.style.left = cx+'px';
      pinEl.style.top  = (cy-8)+'px';
      pinEl.classList.add('visible');
    } else {
      pinEl.classList.remove('visible');
    }
  }

  function tick(ts){
    if(autoRotate){ rotation[0]+=rotSpeed; setProjection(); }
    render(ts);
    rafId=requestAnimationFrame(tick);
  }

  function startDrag(startX, startY){
    autoRotate=false;
    var r0=[rotation[0], rotation[1]];
    return function move(dx, dy){
      rotation[0]=r0[0]+dx*0.38;
      rotation[1]=Math.max(-90,Math.min(90, r0[1]-dy*0.38));
      setProjection();
    };
  }

  canvas.addEventListener('mousedown',function(e){
    var move=startDrag(e.clientX, e.clientY);
    var sx=e.clientX, sy=e.clientY;
    function mm(e){ move(e.clientX-sx, e.clientY-sy); }
    function mu(){ document.removeEventListener('mousemove',mm); document.removeEventListener('mouseup',mu); setTimeout(function(){autoRotate=true;},1200); }
    document.addEventListener('mousemove',mm);
    document.addEventListener('mouseup',mu);
  });

  canvas.addEventListener('touchstart',function(e){
    var t0=e.touches[0];
    var move=startDrag(t0.clientX, t0.clientY);
    var sx=t0.clientX, sy=t0.clientY;
    function tm(e){ var t=e.touches[0]; move(t.clientX-sx, t.clientY-sy); }
    function te(){ canvas.removeEventListener('touchmove',tm); canvas.removeEventListener('touchend',te); setTimeout(function(){autoRotate=true;},1200); }
    canvas.addEventListener('touchmove',tm,{passive:true});
    canvas.addEventListener('touchend',te);
  },{passive:true});

  canvas.addEventListener('wheel',function(e){
    e.preventDefault();
    var f=e.deltaY>0?0.92:1.09;
    radius=Math.max(Math.min(W,H)*0.28, Math.min(Math.min(W,H)*0.72, radius*f));
    setProjection();
  },{passive:false});

  resize();
  window.addEventListener('resize', resize, {passive:true});

  fetch(GEOJSON)
    .then(function(r){ return r.json(); })
    .then(function(data){
      landFeatures=data;
      allDots=buildDots(data.features);
      loadEl.classList.add('out');
      setTimeout(function(){ loadEl.remove(); }, 700);
      rafId=requestAnimationFrame(tick);
    })
    .catch(function(){
      loadEl.classList.add('out');
      setTimeout(function(){ loadEl.remove(); }, 700);
      rafId=requestAnimationFrame(tick);
    });
})();
</script>
</BaseLayout>
