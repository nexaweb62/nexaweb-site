<script>
/* ── BUDGET : les pastilles ──────────────────────────────────────────
   Deux entrées, un seul état. La souris passe par le clic (avec le
   reclique qui décoche) ; le clavier passe par les flèches, qui
   déclenchent un change sur le radio. Sans l'écoute de change, la
   sélection au clavier cocherait le radio sans jamais allumer la
   pastille — le focus serait visible, la sélection non. */
(function(){
  var pills = Array.from(document.querySelectorAll('.budget-pill'));
  if(!pills.length) return;

  /* Le rang de chaque pastille : l'animation d'apparition s'en sert
     pour les faire arriver l'une après l'autre. */
  pills.forEach(function(p,i){ p.style.setProperty('--k', i); });

  function sync(){
    pills.forEach(function(p){
      p.classList.toggle('selected', p.querySelector('input').checked);
    });
  }
  pills.forEach(function(pill){
    var radio = pill.querySelector('input');
    pill.addEventListener('click', function(e){
      /* Les flèches du clavier COCHENT le radio puis emettent un clic.
         Sans cette garde, « avant » vaut deja true et la logique de
         reclique decoche aussitot ce que la fleche vient de choisir :
         le focus avance, la selection disparait. e.detail vaut 0 quand
         le clic ne vient pas d'un pointeur — on laisse alors faire le
         comportement natif. */
      if(e.detail === 0){ sync(); return; }
      e.preventDefault();                  // souris : on gère le reclique
      var avant = radio.checked;
      pills.forEach(function(p){ p.querySelector('input').checked = false; });
      if(!avant) radio.checked = true;
      sync();
      radio.dispatchEvent(new Event('change', {bubbles:true}));
    });
    radio.addEventListener('change', sync);   // flèches du clavier
  });

  /* ── Depuis une carte tarif : /devis?formule=refonte ──
     La pastille est cochée et le type de site pré-rempli. Les trois
     formules ont leur pastille ; « entreprise » retombe sur le type
     vitrine, faute de type qui lui corresponde.
     Une valeur inventée ne trouve simplement rien — c'est voulu. */
  var TYPE = { refonte:'refonte', vitrine:'vitrine', entreprise:'vitrine' };
  var f = new URLSearchParams(location.search).get('formule');
  if(f){
    var r = document.querySelector('.budget-pill input[value="' + (CSS.escape ? CSS.escape(f) : f) + '"]');
    if(r){ r.checked = true; sync(); }
    var t = document.getElementById('type');
    if(t && TYPE[f]) t.value = TYPE[f];
  }
})();

/* ── FORM SUBMIT ── */
(function(){
  const form=document.getElementById('devis-form');
  const overlay=document.getElementById('success-overlay');
  const btn=document.getElementById('submit-btn');
  document.getElementById('success-back-btn').addEventListener('click',()=>window.location.href='/');

  function canSubmit(){var last=sessionStorage.getItem('nw_devis_ts');return !last||(Date.now()-parseInt(last,10))>60000}
  function stampSubmit(){sessionStorage.setItem('nw_devis_ts',String(Date.now()))}

  /* Le message seul ne suffit pas : on marque le champ lui-meme, sinon
     l'oeil ne sait pas ou regarder dans un formulaire de dix champs.
     Le premier fautif recoit le focus, et l'erreur s'efface des que le
     visiteur corrige — pas a l'envoi suivant. */
  var CHAMP = { 'err-prenom':'prenom','err-nom':'nom','err-email':'email','err-type':'type',
                'err-desc':'description','err-rgpd':'rgpd-consent' };
  var premierFautif = null;
  function setErr(id,msg){
    var el=document.getElementById(id); if(el) el.textContent=msg;
    var ch=document.getElementById(CHAMP[id]);
    if(ch){
      var f = ch.closest('.field') || ch.closest('.rgpd-row');
      if(f) f.classList.toggle('has-err', !!msg);
      if(msg){
        ch.setAttribute('aria-invalid','true');
        if(el) ch.setAttribute('aria-describedby', id);
        if(!premierFautif) premierFautif = ch;
      } else {
        ch.removeAttribute('aria-invalid');
      }
    }
  }
  function clearErrors(){
    premierFautif = null;
    Object.keys(CHAMP).forEach(function(id){ setErr(id,''); });
    hideBanner();
  }
  /* Des que le champ change, son erreur disparait. */
  Object.keys(CHAMP).forEach(function(id){
    var ch=document.getElementById(CHAMP[id]); if(!ch) return;
    var effacer=function(){ if(document.getElementById(id).textContent) setErr(id,''); };
    ch.addEventListener('input', effacer);
    ch.addEventListener('change', effacer);
  });
  function showBanner(msg){var b=document.getElementById('form-error');document.getElementById('form-error-text').textContent=msg;b.classList.add('show');b.scrollIntoView({behavior:'smooth',block:'nearest'})}
  function hideBanner(){document.getElementById('form-error').classList.remove('show')}
  function setLoading(on){btn.classList.toggle('loading',on);btn.disabled=on}

  form.addEventListener('submit',async function(e){
    e.preventDefault();clearErrors();

    if(document.getElementById('website_url').value.length>0){form.classList.add('hide');overlay.classList.add('show');return}
    if(!canSubmit()){showBanner('Une demande a déjà été envoyée. Attendez une minute avant de réessayer.');return}

    const prenom=document.getElementById('prenom').value.trim();
    const nom=document.getElementById('nom').value.trim();
    const emailVal=document.getElementById('email').value.trim();
    const type=document.getElementById('type').value;
    const desc=document.getElementById('description').value.trim();
    const tel=document.getElementById('tel').value.trim();
    const entreprise=document.getElementById('entreprise').value.trim();
    const delai=document.getElementById('delai').value;
    const siteActuel=document.getElementById('site-actuel').value.trim();
    const rgpd=document.getElementById('rgpd-consent').checked;
    const budgetEl=document.querySelector('input[name="budget"]:checked');
    const budget=budgetEl?budgetEl.value:'';

    let ok=true;
    if(!prenom){setErr('err-prenom','Le prénom est requis.');ok=false}
    if(!nom){setErr('err-nom','Le nom est requis.');ok=false}
    if(!emailVal){setErr('err-email',"L'e-mail est requis.");ok=false}
    else if(!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(emailVal)){setErr('err-email','Adresse e-mail invalide.');ok=false}
    if(!type){setErr('err-type','Veuillez sélectionner un type de site.');ok=false}
    if(!desc){setErr('err-desc','La description est requise.');ok=false}
    else if(desc.length<20){setErr('err-desc','Décrivez votre projet en au moins 20 caractères.');ok=false}
    if(!rgpd){setErr('err-rgpd','Vous devez accepter le traitement de vos données pour continuer.');ok=false}
    if(!ok){
      if(premierFautif){
        premierFautif.focus({preventScroll:true});
        premierFautif.scrollIntoView({behavior:'smooth',block:'center'});
      }
      return;
    }

    if(!window.sb){showBanner('Erreur de connexion. Écrivez-nous à contact.nexaweb62@gmail.com');return}

    setLoading(true);
    try{
      var planParam=new URLSearchParams(location.search).get('plan')||null;
      const{error:insertErr}=await window.sb.from('demandes_devis').insert({
        prenom,nom,email:emailVal,telephone:tel||null,entreprise:entreprise||null,
        type_site:type||null,delai_souhaite:delai||null,budget_estime:budget||null,
        description:desc,site_existant:siteActuel||null,formule:planParam
      });
      if(insertErr){showBanner("Erreur lors de l'enregistrement. Contactez-nous directement à contact.nexaweb62@gmail.com");return}
      stampSubmit();
      /* Décrémente les places Vitrine Pro si applicable */
      if(planParam==='vitrine-pro'){
        try{await window.sb.rpc('decrement_vitrine_spots');}catch(e){console.warn('[spots]',e);}
      }
      try{await window.sb.functions.invoke('send-devis-email',{body:{prenom,nom,email:emailVal,telephone:tel,entreprise,formule:planParam,type_site:type,delai_souhaite:delai,budget_estime:budget,description:desc,site_existant:siteActuel}})}
      catch(e){console.warn('[devis] email failed (data saved):',e)}
      form.classList.add('hide');overlay.classList.add('show');window.scrollTo({top:0,behavior:'smooth'});
    }catch(err){
      console.error('[devis] unexpected:',err);
      showBanner("Une erreur inattendue est survenue. Écrivez-nous à contact.nexaweb62@gmail.com");
    }finally{setLoading(false)}
  });
})();
</script>

<script is:inline>
/* ── AETHER FLOW — port fidèle (répulsion souris, lignes blanches cursor) ── */
(function(){
  'use strict';
  var cv=document.getElementById('aether-cv');
  if(!cv)return;
  var ctx=cv.getContext('2d');
  var W,H,pts=[];
  var mouse={x:null,y:null,r:200};
  var RAF;

  function Particle(){
    this.x=Math.random()*W;
    this.y=Math.random()*H;
    this.vx=(Math.random()*.4)-.2;
    this.vy=(Math.random()*.4)-.2;
    this.size=Math.random()*1.8+.6;
  }
  Particle.prototype.update=function(){
    /* bounce */
    if(this.x>W||this.x<0)this.vx=-this.vx;
    if(this.y>H||this.y<0)this.vy=-this.vy;
    /* mouse repulsion */
    if(mouse.x!==null){
      var dx=mouse.x-this.x,dy=mouse.y-this.y;
      var dist=Math.sqrt(dx*dx+dy*dy);
      if(dist<mouse.r+this.size&&dist>0){
        var fx=dx/dist,fy=dy/dist;
        var f=(mouse.r-dist)/mouse.r;
        this.x-=fx*f*5;
        this.y-=fy*f*5;
      }
    }
    this.x+=this.vx;this.y+=this.vy;
    /* dot */
    ctx.beginPath();ctx.arc(this.x,this.y,this.size,0,Math.PI*2);
    ctx.fillStyle=window.nwTokenRgba?window.nwTokenRgba('--accent',.80):'transparent';ctx.fill();
  };

  function connect(){
    var thresh=(W/7)*(H/7);
    for(var a=0;a<pts.length;a++){
      for(var b=a;b<pts.length;b++){
        var ddx=pts[a].x-pts[b].x,ddy=pts[a].y-pts[b].y;
        var d2=ddx*ddx+ddy*ddy;
        if(d2<thresh){
          var op=1-(d2/20000);
          /* blanc si l'un des deux est proche du curseur */
          var nearMouse=false;
          if(mouse.x!==null){
            var max=pts[a].x-mouse.x,may=pts[a].y-mouse.y;
            nearMouse=Math.sqrt(max*max+may*may)<mouse.r;
          }
          ctx.strokeStyle=window.nwTokenRgba?window.nwTokenRgba(nearMouse?'--text':'--accent',op):'transparent';
          ctx.lineWidth=1;
          ctx.beginPath();ctx.moveTo(pts[a].x,pts[a].y);ctx.lineTo(pts[b].x,pts[b].y);ctx.stroke();
        }
      }
    }
  }

  /* Ce décor animait ses particules même sous prefers-reduced-motion.
     Il dessine désormais une seule image figée pour qui le demande. */
  var PRM=window.matchMedia('(prefers-reduced-motion:reduce)');
  function draw(){
    ctx.clearRect(0,0,W,H);
    for(var i=0;i<pts.length;i++)pts[i].update();
    connect();
  }
  /* La boucle s'arrete quand l'onglet passe en arriere-plan, et le
     drapeau « tourne » empeche qu'un redimensionnement ou un retour
     d'onglet en demarre une seconde par-dessus la premiere.
     L'observateur ci-dessous ne se declenchera jamais tel quel : le
     canevas est en position fixed et couvre l'ecran, il est donc
     toujours « visible ». Il est garde comme filet, pas comme gain. */
  var visible=true,tourne=false;
  function animate(){
    if(PRM.matches){ draw(); return; }
    if(document.hidden||!visible){ tourne=false; return; }
    RAF=requestAnimationFrame(animate);
    draw();
  }
  function reveiller(){
    if(tourne||PRM.matches||document.hidden||!visible)return;
    tourne=true;RAF=requestAnimationFrame(animate);
  }

  function init(){
    W=cv.width=window.innerWidth;H=cv.height=window.innerHeight;
    pts=[];
    var n=Math.min(Math.floor(W*H/9000),160);
    for(var i=0;i<n;i++)pts.push(new Particle());
  }

  window.addEventListener('resize',function(){cancelAnimationFrame(RAF);tourne=false;init();reveiller();},{passive:true});
  window.addEventListener('mousemove',function(e){mouse.x=e.clientX;mouse.y=e.clientY;},{passive:true});
  window.addEventListener('mouseleave',function(){mouse.x=null;mouse.y=null;});
  document.addEventListener('visibilitychange',function(){
    if(document.hidden){cancelAnimationFrame(RAF);tourne=false;}else reveiller();
  });
  if(window.IntersectionObserver){
    new IntersectionObserver(function(e){visible=e[0].isIntersecting;reveiller();},
      {rootMargin:'200px'}).observe(cv);
  }
  init();
  if(PRM.matches)draw();else{tourne=true;RAF=requestAnimationFrame(animate);}
})();
</script>

