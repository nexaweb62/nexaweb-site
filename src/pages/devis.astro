---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import '../styles/global.css';
import { REFONTE_PRIX } from '../data/formules';
---
<BaseLayout title="Devis gratuit — Nexa Web" description="Décrivez votre projet web et recevez un devis gratuit sous 24 h. Site vitrine, e-commerce, refonte — Nexa Web, Carvin, Hauts-de-France.">
<style>
/* ── PAGE ── */
/* L'en-tête est fixe : sans var(--hdr) ici, le héros passe dessous. */
.devis-page{min-height:calc(100vh - var(--hdr));
  padding:calc(var(--hdr) + clamp(28px,5vh,60px)) var(--pad-x) clamp(64px,10vh,120px);
  max-width:1180px;margin:0 auto}

/* ── LE HÉROS ── */
.dv-hero{text-align:center;margin-bottom:clamp(30px,5vw,54px)}
.dv-pill{display:inline-flex;align-items:center;gap:8px;border:1px solid var(--border-strong);
  border-radius:var(--radius-pill);padding:6px 16px;font-size:var(--fs-caption);font-weight:600;
  letter-spacing:0;color:var(--text-muted);margin-bottom:22px}
.dv-pill-dot{width:6px;height:6px;border-radius:50%;background:var(--accent);box-shadow:0 0 8px var(--accent)}
.dv-title{font-size:clamp(1.9rem,5vw,3.4rem);font-weight:600;letter-spacing:-.035em;line-height:1.04;
  text-wrap:balance;margin:0}
.dv-title em{font-style:normal}
.dv-lede{margin:18px auto 0;max-width:52ch;color:var(--text-muted);font-weight:300;line-height:1.7}

/* ── DEUX COLONNES ── */
.devis-grid{display:grid;grid-template-columns:1fr;gap:clamp(20px,3vw,32px);align-items:start}
@media(min-width:900px){
  .devis-grid{grid-template-columns:minmax(0,1fr) 340px}
  /* Le panneau reste sous les yeux pendant qu'on remplit le formulaire.
     124px = la hauteur de l'en-tête plus une respiration. */
  .devis-side{position:sticky;top:124px}
}
.devis-main{min-width:0}
.dv-aside-h{font-size:1.05rem;font-weight:600;letter-spacing:-.02em;margin:0 0 18px}
.dv-next{list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:18px}
.dv-next li{display:flex;gap:13px;align-items:flex-start}
.dv-next-n{flex:none;width:23px;height:23px;border-radius:50%;display:flex;align-items:center;
  justify-content:center;font-size:11px;font-weight:600;color:var(--on-accent);background:var(--accent);
  font-variant-numeric:tabular-nums}
.dv-next b{display:block;font-size:var(--fs-caption);font-weight:600;margin-bottom:4px}
.dv-next p{margin:0;font-size:12.5px;font-weight:300;line-height:1.6;color:var(--text-muted)}
.dv-aside-fine{margin:20px 0 0;padding-top:16px;border-top:1px solid var(--border);
  font-size:11.5px;font-weight:300;line-height:1.6;color:var(--text-subtle)}

/* ── CARD ── */
.devis-card{width:100%;background:var(--surface);border:1px solid var(--border-strong);border-radius:16px;padding:clamp(32px,5vw,56px) clamp(24px,5vw,52px);box-shadow:var(--shadow-2)}
:root[data-theme="light"] .devis-card{background:var(--surface);border-color:var(--border)}
@media(prefers-color-scheme:light){:root:not([data-theme="dark"]) .devis-card{background:var(--surface);border-color:var(--border)}}

/* ── LAUNCH NOTICE ── */
.launch-notice{display:flex;align-items:center;gap:12px;background:var(--success-glow);border:1px solid var(--success);border-radius:10px;padding:14px 18px;margin-bottom:32px}
.launch-notice svg{width:18px;height:18px;stroke:var(--success);stroke-width:2;fill:none;flex-shrink:0}
/* Mesuré : sur un panneau teinté (or ou vert à ~13 %), le gris secondaire
   tombe juste sous AA en sombre — 4.48:1 et 4.1:1. Sur ces fonds-là, le
   texte secondaire prend l'encre pleine. */
.launch-notice p{font-size:12.5px;color:var(--text);line-height:1.55}
.launch-notice strong{color:var(--success)}

/* ── CARD HEAD ── */
.card-eyebrow{font-size:var(--fs-caption);font-weight:600;letter-spacing:0;color:var(--accent-text);margin-bottom:10px}
.card-title{font-size:clamp(1.6rem,3vw,2.4rem);font-weight:600;letter-spacing:-.04em;line-height:.95;margin-bottom:10px}
.card-title em{font-style:italic;color:var(--text-muted)}
.card-sub{font-size:13px;color:var(--text-muted);line-height:1.6;margin-bottom:36px}

/* ── SECTION LABEL ── */
.form-section{margin-bottom:28px}
/* Un numéro dans un cercle doré, et un filet dessous. */
.fstep{display:flex;align-items:center;gap:11px;margin-bottom:18px;padding-bottom:10px;
  border-bottom:1px solid var(--border)}
.fstep-n{flex:none;width:24px;height:24px;border-radius:50%;display:flex;align-items:center;
  justify-content:center;font-size:12px;font-weight:600;color:var(--on-accent);background:var(--accent);
  font-variant-numeric:tabular-nums}
.fstep-t{font-size:var(--fs-caption);font-weight:600;letter-spacing:0;color:var(--text)}
:root[data-theme="light"] .section-label{border-bottom-color:var(--border)}
@media(prefers-color-scheme:light){:root:not([data-theme="dark"]) .section-label{border-bottom-color:var(--border)}}

/* ── FIELDS ── */
.field-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}
@media(max-width:560px){.field-grid{grid-template-columns:1fr}}
@media(max-width:600px){
  .devis-page{padding-top:32px;padding-bottom:40px}
  .devis-card{padding:22px 18px}
  .card-title{font-size:1.35rem}
  .card-sub{font-size:12px;margin-bottom:24px}
  .field label{font-size:var(--fs-caption)}
  .field input:not([type=checkbox]):not([type=radio]),.field textarea,.field select{font-size:12px;padding:10px 13px}
  .section-label{font-size:var(--fs-caption)}
  .submit-btn{font-size:var(--fs-caption);padding:12px 22px}
  .budget-pill{font-size:var(--fs-caption);padding:7px 13px}
}
.field{display:flex;flex-direction:column;gap:6px}
.field-full{grid-column:1/-1}
/* Petites capitales espacées. Exception assumée à la règle de typographie
   du site (zéro capitale espacée) : demandée nommément pour ce formulaire. */
.field label{font-size:10px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;
  color:var(--text-subtle)}
.field .req{color:var(--accent-text);font-style:normal;margin-left:.15em}
.field input:not([type=checkbox]):not([type=radio]),.field textarea,.field select{
  width:100%;padding:12px 15px;background:var(--surface);border:1px solid var(--border);border-radius:5px;
  font:inherit;font-size:13px;color:var(--text);outline:none;
  transition:border-color .2s,box-shadow .2s;-webkit-appearance:none;appearance:none;
}
/* Le gris du mode sombre est illisible sur blanc : le placeholder a son
   propre jeton, plus sombre en mode clair. */
.field input::placeholder,.field textarea::placeholder{color:var(--placeholder)}
.field input:focus,.field textarea:focus,.field select:focus{border-color:var(--accent);box-shadow:0 0 0 3px var(--accent-glow)}
.field select{padding-right:36px;cursor:pointer}
/* Chevron dessiné en CSS plutôt qu'en SVG inline : il prend la couleur du
   token et suit donc le thème, là où l'ancienne data-URI figeait la sienne. */
.field:has(select){position:relative}
.field:has(select)::after{
  content:'';position:absolute;right:16px;top:calc(50% + 10px);
  width:7px;height:7px;margin-top:-6px;
  border-right:1.5px solid var(--accent);
  border-bottom:1.5px solid var(--accent);
  transform:rotate(45deg);pointer-events:none;
}
.field select option{background:var(--surface);color:var(--text)}
/* « Sélectionner… » en gris tant que rien n'est choisi — pour les deux
   menus, obligatoire ou non. :invalid ne couvre que le premier. */
.field select:invalid,
.field select:has(option[value=""]:checked){color:var(--text-subtle)}
.field textarea{resize:vertical;min-height:110px;line-height:1.6}

/* ═══════════════════════════════════════════════════════════════════
   L'APPARITION AU DÉFILEMENT
   Les champs, les titres d'étape et l'encadré d'offre montent en même
   temps que la page défile. Les pastilles arrivent l'une après l'autre :
   chacune porte son rang --k, posé en JavaScript.
   Le repli est explicite : sans animations au défilement, ou en
   mouvement réduit, tout est visible. Un formulaire ne doit jamais
   pouvoir rester invisible.
   ═══════════════════════════════════════════════════════════════════ */
@keyframes rvIn{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:none}}
@supports (animation-timeline: view()){
  @media (prefers-reduced-motion:no-preference){
    .devis-card .field,.devis-card .fstep,.devis-card .launch-notice,.dv-next li{
      animation:rvIn linear both;animation-timeline:view();
      animation-range:entry 4% cover 26%}
    .budget-pill{animation:rvIn linear both;animation-timeline:view();
      animation-range:entry calc(4% + var(--k,0)*3%) cover calc(26% + var(--k,0)*3%)}
  }
}

/* ── BUDGET PILLS ── */
.budget-pills{display:flex;flex-wrap:wrap;gap:8px}
/* Les pastilles sont des <label> DANS un .field : sans ces trois
   remises à zéro, elles héritent des petites capitales espacées de
   .field label et partent en MAJUSCULES. */
/* .field label pese 0,1,1 et bat .budget-pill a 0,1,0 : la remise a zero
   doit etre AU MOINS aussi specifique, sinon les pastilles heritent des
   MAJUSCULES des etiquettes. Mesure : elles sortaient bien en uppercase
   avec le selecteur simple. */
.field label.budget-pill,.field label.budget-pill span{
  text-transform:none;letter-spacing:normal;
  /* PAS font:inherit ici : plus specifique que .budget-pill, il ecraserait
     sa taille et ferait passer la pastille de 35 a 46 px de haut. */
  font-size:var(--fs-caption);font-weight:600}
.budget-pill{position:relative;cursor:pointer;text-transform:none;letter-spacing:normal;font:inherit;
  font-size:var(--fs-caption);font-weight:600;padding:8px 16px;border:1px solid var(--border);
  border-radius:var(--radius-pill);color:var(--text-muted);user-select:none;
  transition:border-color .2s,background-color .2s,color .2s,box-shadow .2s}
/* Masqué mais jamais display:none : sinon il ne reçoit plus le focus
   clavier et les flèches ne parcourent plus le groupe. 1px, pas 0. */
.budget-pill input{position:absolute;opacity:0;width:1px;height:1px;margin:0;pointer-events:none}
.budget-pill:hover{border-color:var(--border-strong);color:var(--text)}
/* Le focus ne se voit pas sur un radio invisible : il se voit ici. */
.budget-pill:has(input:focus-visible){outline:3px solid var(--accent-hover);outline-offset:3px}
.budget-pill.selected{border-color:var(--accent);background:var(--accent-glow);color:var(--accent-text);
  box-shadow:0 0 0 3px rgb(from var(--accent) r g b / .14)}
@media (prefers-reduced-motion:no-preference){
  .budget-pill.selected{animation:pillPick 420ms cubic-bezier(.22,.9,.24,1)}
  @keyframes pillPick{0%{transform:scale(1)}38%{transform:scale(1.06)}100%{transform:scale(1)}}
}

/* ── SUBMIT ── */
.submit-row{display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap;margin-top:32px;padding-top:24px;border-top:1px solid var(--border)}
:root[data-theme="light"] .submit-row{border-top-color:var(--border)}
@media(prefers-color-scheme:light){:root:not([data-theme="dark"]) .submit-row{border-top-color:var(--border)}}
.submit-note{font-size:var(--fs-caption);color:var(--text-muted);line-height:1.55}
.submit-note svg{display:inline;width:12px;height:12px;stroke:var(--success);fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;margin-right:4px;vertical-align:-1px}
.submit-btn{display:inline-flex;align-items:center;gap:10px;padding:15px 32px;border-radius:var(--radius-pill);font-size:var(--fs-caption);font-weight:600;letter-spacing:0;cursor:pointer;transition:background-color .2s,transform .2s;white-space:nowrap}
.submit-btn:hover{transform:translateY(-2px)}
.submit-btn:disabled{opacity:.6;cursor:not-allowed;transform:none!important}
.submit-btn svg{width:16px;height:16px;stroke:currentColor;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
.submit-btn-spinner{display:none;width:14px;height:14px;border:2px solid var(--glass-edge-r);border-top-color:currentColor;border-radius:50%;animation:spin .7s linear infinite}
.submit-btn.loading .submit-btn-icon{display:none}
.submit-btn.loading .submit-btn-spinner{display:block}
@keyframes spin{to{transform:rotate(360deg)}}

/* ── RGPD ── */
.rgpd-row{padding:14px 16px;margin-top:6px;background:var(--accent-glow);border:1px solid var(--accent);border-radius:8px}
.rgpd-label{display:flex;align-items:flex-start;gap:10px;cursor:pointer}
.rgpd-label input[type=checkbox]{width:15px;height:15px;flex-shrink:0;margin-top:2px;accent-color:var(--accent);cursor:pointer}
.rgpd-label span{font-size:var(--fs-caption);line-height:1.65;color:var(--text)}
.rgpd-label a{color:var(--accent-text);text-decoration:underline}
.req{color:var(--accent-text)}
.field-err{font-size:var(--fs-caption);color:var(--danger);min-height:14px;display:block;margin-top:3px;line-height:1.4}
/* Le champ fautif se voit, discretement : une bordure rouge-orange et
   son halo. --danger est verifie AA dans les deux themes. */
.field.has-err input:not([type=checkbox]),
.field.has-err textarea,
.field.has-err select,
.rgpd-row.has-err .rgpd-label{border-color:var(--danger)}
.field.has-err input:not([type=checkbox]):focus,
.field.has-err textarea:focus,
.field.has-err select:focus{border-color:var(--danger);
  box-shadow:0 0 0 3px rgb(from var(--danger) r g b / .18)}
.rgpd-row.has-err .field-err{margin-top:8px}

/* ── FORM BANNER ── */
.form-banner{display:none;align-items:flex-start;gap:10px;padding:12px 16px;border-radius:9px;font-size:12.5px;line-height:1.55;margin-bottom:20px}
.form-banner.show{display:flex}
.form-banner.error{background:var(--danger-glow);border:1px solid var(--danger);color:var(--danger)}
.form-banner svg{flex-shrink:0;margin-top:1px}

/* ── SUCCESS ── */
.success-overlay{display:none;flex-direction:column;align-items:center;justify-content:center;gap:18px;text-align:center;padding:40px;min-height:360px}
.success-overlay.show{display:flex}
.devis-form.hide{display:none}
.success-icon{width:64px;height:64px;border-radius:50%;background:var(--success-glow);border:1px solid var(--success);display:flex;align-items:center;justify-content:center}
.success-icon svg{width:30px;height:30px;stroke:var(--success);fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
.success-title{font-size:1.5rem;font-weight:600;letter-spacing:-.03em}
.success-text{font-size:13px;color:var(--text-muted);line-height:1.65;max-width:380px}
.success-back{display:inline-flex;align-items:center;gap:8px;font-size:var(--fs-caption);font-weight:600;letter-spacing:0;color:var(--text);border-radius:var(--radius-pill);padding:11px 22px;transition:color .2s,background-color .2s,transform .2s;cursor:pointer}
.success-back:hover{color:var(--text)}
:focus-visible{outline:2px solid var(--accent);outline-offset:3px;border-radius:3px}

/* ── AETHER CANVAS ── */
#aether-cv{opacity:var(--decor-opacity);position:fixed;inset:0;width:100%;height:100%;pointer-events:none;z-index:0}
.devis-page{position:relative;z-index:1}
</style>

<canvas id="aether-cv" aria-hidden="true"></canvas>
<Header backBtn={true} />

<main id="main-content" tabindex="-1">
  <div class="devis-page">

    <!-- LE HÉROS -->
    <header class="dv-hero">
      <span class="dv-pill"><span class="dv-pill-dot" aria-hidden="true"></span><span data-i18n="dv-pill">Devis gratuit</span></span>
      <h1 class="dv-title">Un prix ferme en <em class="liquid">48 heures</em>.</h1>
      <p class="dv-lede" data-i18n="dv-lede">Décrivez votre projet. Nous revenons vers vous avec un devis
        détaillé, sans engagement — et sans mauvaise surprise.</p>
    </header>

    <div class="devis-grid">
      <div class="devis-main">
    <div class="devis-card">

      <!-- SUCCESS STATE -->
      <div class="success-overlay" id="success-overlay" role="alert" aria-live="polite">
        <div class="success-icon">
          <svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
        </div>
        <h2 class="success-title">Devis envoyé !</h2>
        <p class="success-text">Merci pour votre demande. Nous vous recontacterons sous <strong>24 heures ouvrées</strong> avec une proposition personnalisée.</p>
        <button class="success-back" id="success-back-btn">
          <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true" style="stroke:currentColor;fill:none;stroke-width:2;stroke-linecap:round"><polyline points="15 18 9 12 15 6"/></svg>
          Retour à l'accueil
        </button>
      </div>

      <!-- FORM -->
      <form class="devis-form" id="devis-form" novalidate>

        <!-- Honeypot -->
        <div style="position:absolute;left:-9999px;opacity:0;pointer-events:none" aria-hidden="true">
          <input type="text" name="website_url" id="website_url" tabindex="-1" autocomplete="new-password">
        </div>

        <!-- Error banner -->
        <div class="form-banner error" id="form-error" role="alert">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          <span id="form-error-text"></span>
        </div>

        <!-- OFFRE LANCEMENT -->
        <div class="launch-notice">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
          <p><strong>Offre de lancement :</strong> les 3 premiers clients bénéficient d'un site complet à <strong>1 000 €</strong> tout inclus. Mentionnez-le dans votre description.</p>
        </div>

        <!-- HEAD -->
        <div class="card-eyebrow" data-i18n="eyebrow">Demande de devis gratuit</div>
        <h1 class="card-title" data-i18n="title">Parlons de<br><em>votre projet.</em></h1>
        <p class="card-sub" data-i18n="sub">Réponse sous 24 h · Devis gratuit &amp; sans engagement</p>

        <!-- CONTACT -->
        <div class="form-section">
          <div class="fstep"><span class="fstep-n" aria-hidden="true">1</span><span class="fstep-t" data-i18n="sec1">Vos coordonnées</span></div>
          <div class="field-grid">
            <div class="field">
              <label for="prenom"><span data-i18n="prenom">Prénom</span> <span class="req">*</span></label>
              <input type="text" id="prenom" name="prenom" placeholder="Jean" autocomplete="given-name" required>
              <span class="field-err" id="err-prenom"></span>
            </div>
            <div class="field">
              <label for="nom"><span data-i18n="nom">Nom</span> <span class="req">*</span></label>
              <input type="text" id="nom" name="nom" placeholder="Dupont" autocomplete="family-name" required>
              <span class="field-err" id="err-nom"></span>
            </div>
            <div class="field">
              <label for="email"><span data-i18n="email">E-mail</span> <span class="req">*</span></label>
              <input type="email" id="email" name="email" placeholder="jean@entreprise.fr" autocomplete="email" required>
              <span class="field-err" id="err-email"></span>
            </div>
            <div class="field">
              <label for="tel"><span data-i18n="tel">Téléphone</span></label>
              <input type="tel" id="tel" name="tel" placeholder="+33 6 00 00 00 00" autocomplete="tel">
            </div>
            <div class="field field-full">
              <label for="entreprise"><span data-i18n="entreprise">Entreprise / Activité</span></label>
              <input type="text" id="entreprise" name="entreprise" placeholder="Ma Boulangerie, Auto-entrepreneur…" autocomplete="organization">
            </div>
          </div>
        </div>

        <!-- PROJECT -->
        <div class="form-section">
          <div class="fstep"><span class="fstep-n" aria-hidden="true">2</span><span class="fstep-t" data-i18n="sec2">Votre projet</span></div>
          <div class="field-grid">
            <div class="field">
              <label for="type"><span data-i18n="type">Type de site</span> <span class="req">*</span></label>
              <select id="type" name="type" required>
                <option value="" disabled selected>Sélectionner…</option>
                <option value="vitrine">Site vitrine</option>
                <option value="ecommerce">Boutique e-commerce</option>
                <option value="blog">Blog / Magazine</option>
                <option value="app">Application web</option>
                <option value="refonte">Refonte de site existant</option>
                <option value="autre">Autre</option>
              </select>
              <span class="field-err" id="err-type"></span>
            </div>
            <div class="field">
              <label for="delai"><span data-i18n="delai">Délai souhaité</span></label>
              <select id="delai" name="delai">
                <option value="" disabled selected>Sélectionner…</option>
                <option value="urgent">Dès que possible</option>
                <option value="1mois">Dans 1 mois</option>
                <option value="3mois">Dans 2 à 3 mois</option>
                <option value="flexible">Flexible</option>
              </select>
            </div>
            <div class="field field-full">
              <label><span data-i18n="budget">Budget estimé</span></label>
              <div class="budget-pills" role="radiogroup" aria-label="Budget estimé">
                <label class="budget-pill"><input type="radio" name="budget" value="refonte"><span>Refonte — dès {REFONTE_PRIX}</span></label>
                <label class="budget-pill"><input type="radio" name="budget" value="vitrine"><span>Vitrine Pro — 1&#8239;000&nbsp;€</span></label>
                <label class="budget-pill"><input type="radio" name="budget" value="entreprise"><span>Entreprise — 1&#8239;200 à 3&#8239;100&nbsp;€</span></label>
              </div>
            </div>
            <div class="field field-full">
              <label for="description"><span data-i18n="desc">Décrivez votre projet</span> <span class="req">*</span></label>
