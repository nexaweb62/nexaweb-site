---
import InteractiveButton from '../components/ui/InteractiveButton.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
---
<BaseLayout title="Refonte de Site — Nexa Web" description="Refonte complète de site web — design moderne, performance et SEO améliorés. Nexa Web, Carvin.">
<style>
main{padding-top:var(--hdr)}

.svc-hero{padding-top:80px;padding-bottom:60px;position:relative}
.svc-title{margin-bottom:28px;position:relative;z-index:1}
.svc-desc{font-size:var(--fs-body);color:var(--text-muted);line-height:1.75;max-width:640px;margin-bottom:40px;position:relative;z-index:1}

.svc-features{padding-top:60px;padding-bottom:60px}
/* Ce libellé introduit les <h3> de la grille : c'est un niveau 2,
   pas un <span> décoratif. axe refusait le saut h1 → h3. */
.svc-section-label{color:var(--text);margin:0 0 32px;display:block}
/* Une liste à filets, une colonne de 68 caractères au plus : ce qui est
   compris n'est pas une suite d'étapes, il n'y a donc plus de numéros. */
.feat-grid{display:block;background:none;max-width:68ch}
.feat-item{padding:var(--sp-5) 0;border-top:1px solid var(--border)}
.feat-item:last-child{border-bottom:1px solid var(--border)}
.feat-title{font-size:1.125rem;font-weight:600;letter-spacing:0;margin-bottom:8px}
.feat-desc{font-size:.875rem;color:var(--text-muted);line-height:1.65}

.svc-divider{height:1px;background:var(--border);margin:0 var(--pad-x)}

.svc-band{padding-top:60px;padding-bottom:60px;display:flex;align-items:center;justify-content:space-between;gap:40px;flex-wrap:wrap}
.svc-band-text h2{margin:0 0 8px}
.svc-band-text p{font-size:var(--fs-body);color:var(--text-muted);line-height:1.6}

@media(max-width:700px){.svc-band{flex-direction:column;align-items:flex-start}}
</style>

<Header backBtn={true} />

<main id="main-content" tabindex="-1">
  <div class="svc-hero wrap">
    <h1 class="svc-title h-xl" data-i18n="rf-h1">Refonte <span>de site</span></h1>
    <p class="svc-desc" data-i18n="rf-3">Si votre site est lent, daté ou difficile à modifier, on le refait en gardant vos textes, vos photos et l'adresse de vos pages, pour ne pas perdre votre place sur Google. L'ancien site reste en ligne jusqu'à la bascule.</p>
    <InteractiveButton text="Demander un devis" data-i18n="rf-b1" href="/devis" class="svc-cta" />
  </div>

  <div class="svc-divider"></div>

  <div class="svc-features wrap">
    <h2 class="svc-section-label h-lg" data-i18n="rf-4">Ce qui est inclus</h2>
    <div class="feat-grid">
      <div class="feat-item">
        <h3 class="feat-title" data-i18n="rf-5">Audit complet</h3>
        <p class="feat-desc" data-i18n="rf-6">Analyse de votre site actuel : vitesse, SEO, UX, accessibilité, concurrents. On identifie tous les points à améliorer avant de commencer.</p>
      </div>
      <div class="feat-item">
        <h3 class="feat-title" data-i18n="rf-7">Nouveau design sur mesure</h3>
        <p class="feat-desc" data-i18n="rf-8">Un nouveau design, dessiné pour votre activité et validé sur maquette.</p>
      </div>
      <div class="feat-item">
        <h3 class="feat-title" data-i18n="rf-9">Migration des contenus</h3>
        <p class="feat-desc" data-i18n="rf-10">Tous vos textes, images et pages sont transférés sans perte. Aucune coupure de service pendant la transition.</p>
      </div>
      <div class="feat-item">
        <h3 class="feat-title" data-i18n="rf-11">SEO préservé</h3>
        <p class="feat-desc" data-i18n="rf-12">Redirections 301 pour chaque ancienne URL, balises méta migrées, sitemap mis à jour. Votre référencement Google est protégé.</p>
      </div>
      <div class="feat-item">
        <h3 class="feat-title" data-i18n="rf-13">Plus léger</h3>
        <p class="feat-desc" data-i18n="rf-14">Code optimisé, images compressées, pages légères : on mesure le poids de chaque page avant et après la refonte.</p>
      </div>
      <div class="feat-item">
        <h3 class="feat-title" data-i18n="rf-15">Livraison en 2 semaines</h3>
        <p class="feat-desc" data-i18n="rf-16">Bascule DNS propre, redirections SEO activées et formation à la prise en main, en deux semaines.</p>
      </div>
    </div>
  </div>

  <div class="svc-divider"></div>

  <div class="svc-band wrap">
    <div class="svc-band-text">
      <h2 class="h-lg" data-i18n="rf-17">Demander un devis</h2>
      <p data-i18n="rf-18">Réponse sous 24 h. Gratuit et sans engagement.</p>
    </div>
    <InteractiveButton text="Demander un devis" data-i18n="rf-b2" href="/devis" />
  </div>
</main>

<Footer />
</BaseLayout>
