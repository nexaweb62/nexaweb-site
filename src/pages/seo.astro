---
import InteractiveButton from '../components/ui/InteractiveButton.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
---
<BaseLayout title="SEO & Performance — Nexa Web" description="Audit SEO, optimisation technique et performance web. Nexa Web booste votre visibilité Google à Carvin.">
<style>
main{padding-top:var(--hdr)}

.svc-hero{padding:80px var(--pad-x) 60px;max-width:1100px;margin:0 auto;position:relative}
.svc-hero::before{content:'';position:fixed;top:0;left:0;right:0;bottom:0;background:radial-gradient(ellipse 70% 50% at 60% 20%,var(--accent-glow) 0%,rgb(from var(--accent-glow) r g b / 0) 70%);pointer-events:none;z-index:0}
.svc-eyebrow{font-size:var(--fs-caption);font-weight:600;letter-spacing:0;color:var(--accent-text);margin-bottom:20px;display:flex;align-items:center;gap:8px;position:relative;z-index:1}
.svc-eyebrow::before{content:'';width:5px;height:5px;border-radius:50%;background:var(--accent);flex-shrink:0}
.svc-title{font-size:clamp(2.8rem,7vw,5.5rem);font-weight:600;letter-spacing:-.03em;line-height:1;margin-bottom:28px;position:relative;z-index:1}
.svc-title span{color:var(--accent-text)}
.svc-desc{font-size:clamp(1rem,1.8vw,1.15rem);color:var(--text-muted);line-height:1.75;max-width:640px;margin-bottom:40px;position:relative;z-index:1}

.svc-features{padding:60px var(--pad-x);max-width:1100px;margin:0 auto}
/* Ce libellé introduit les <h3> de la grille : c'est un niveau 2,
   pas un <span> décoratif. axe refusait le saut h1 → h3. */
.svc-section-label{font-size:var(--fs-caption);font-weight:600;letter-spacing:0;color:var(--accent-text);margin:0 0 40px;display:block}
.feat-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--border)}
.feat-item{background:var(--bg);padding:32px 28px}
.feat-num{font-size:var(--fs-caption);font-weight:600;color:var(--accent-text);letter-spacing:0;margin-bottom:14px}
.feat-title{font-size:1rem;font-weight:600;letter-spacing:-.01em;margin-bottom:10px}
.feat-desc{font-size:.875rem;color:var(--text-muted);line-height:1.65}

.svc-divider{height:1px;background:var(--border);margin:0 var(--pad-x)}

.svc-band{padding:60px var(--pad-x);max-width:1100px;margin:0 auto;display:flex;align-items:center;justify-content:space-between;gap:40px;flex-wrap:wrap}
.svc-band-text h2{font-size:clamp(1.5rem,3vw,2.2rem);font-weight:600;letter-spacing:-.02em;margin-bottom:8px}
.svc-band-text p{font-size:.9rem;color:var(--text-muted);line-height:1.6}

@media(max-width:700px){.feat-grid{grid-template-columns:1fr}.svc-band{flex-direction:column;align-items:flex-start}}
</style>

<Header backBtn={true} />

<main id="main-content" tabindex="-1">
  <div class="svc-hero">
    <p class="svc-eyebrow" data-i18n="seo-1">Service · Visibilité</p>
    <h1 class="svc-title" data-i18n="seo-h1">SEO & <span>Performance</span></h1>
    <p class="svc-desc" data-i18n="seo-3">Être en ligne ne suffit pas — il faut être visible. On optimise votre site pour qu'il remonte sur Google, charge en moins de 2 secondes et convertisse davantage. Résultats mesurables, stratégie sur mesure.</p>
    <InteractiveButton text="Obtenir un audit gratuit" data-i18n="seo-b1" href="/devis" class="svc-cta" />
  </div>

  <div class="svc-divider"></div>

  <div class="svc-features">
    <h2 class="svc-section-label" data-i18n="seo-4">Ce qui est inclus</h2>
    <div class="feat-grid">
      <div class="feat-item">
        <div class="feat-num">01</div>
        <h3 class="feat-title" data-i18n="seo-5">Audit SEO complet</h3>
        <p class="feat-desc" data-i18n="seo-6">Analyse technique de votre site : indexation, balises, maillage interne, backlinks, Core Web Vitals. Un rapport clair avec les priorités à corriger.</p>
      </div>
      <div class="feat-item">
        <div class="feat-num">02</div>
        <h3 class="feat-title" data-i18n="seo-7">Optimisation technique</h3>
        <p class="feat-desc" data-i18n="seo-8">Correction des erreurs de crawl, optimisation des balises title/méta, schema.org, sitemap XML, robots.txt et redirections 301.</p>
      </div>
      <div class="feat-item">
        <div class="feat-num">03</div>
        <h3 class="feat-title" data-i18n="seo-9">Performance & vitesse</h3>
        <p class="feat-desc" data-i18n="seo-10">Objectif Lighthouse 90+ sur nos standards techniques. Compression des images, lazy loading, minification du code, cache navigateur et CDN configurés.</p>
      </div>
      <div class="feat-item">
        <div class="feat-num">04</div>
        <h3 class="feat-title" data-i18n="seo-11">Mots-clés stratégiques</h3>
        <p class="feat-desc" data-i18n="seo-12">Recherche et analyse des mots-clés de votre secteur. On cible les requêtes qui vous apportent de vrais clients, pas juste du trafic.</p>
      </div>
      <div class="feat-item">
        <div class="feat-num">05</div>
        <h3 class="feat-title" data-i18n="seo-13">Google Analytics 4</h3>
        <p class="feat-desc" data-i18n="seo-14">Configuration complète de GA4 et Google Search Console. Tableau de bord personnalisé pour suivre vos performances chaque mois.</p>
      </div>
      <div class="feat-item">
        <div class="feat-num">06</div>
        <h3 class="feat-title" data-i18n="seo-15">Rapport mensuel</h3>
        <p class="feat-desc" data-i18n="seo-16">Suivi des positions, du trafic organique et des conversions chaque mois. Vous savez exactement ce qui évolue et pourquoi.</p>
      </div>
    </div>
  </div>

  <div class="svc-divider"></div>

  <div class="svc-band">
    <div class="svc-band-text">
      <h2 data-i18n="seo-17">Prêt à dominer Google ?</h2>
      <p data-i18n="seo-18">Audit gratuit offert. Premiers résultats mesurables dès 30 jours selon votre marché.</p>
    </div>
    <InteractiveButton text="Démarrer mon SEO" data-i18n="seo-b2" href="/devis" />
  </div>
</main>

<Footer />
</BaseLayout>
