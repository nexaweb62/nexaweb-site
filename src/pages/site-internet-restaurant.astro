---
import InteractiveButton from '../components/ui/InteractiveButton.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Secteurs from '../components/graphes/Secteurs.astro';
import Echeancier from '../components/graphes/Echeancier.astro';
import '../styles/global.css';
---
<BaseLayout title="Site Internet pour Restaurant — Nexa Web" description="Un site restaurant avec menu en ligne, formulaire de réservation et SEO local. Livraison rapide — Nexa Web, Carvin, Hauts-de-France.">
<style>
main { padding-top: var(--hdr) }

/* Hero */
.hero { padding: clamp(80px,14vh,160px) 0 clamp(60px,10vh,120px); text-align: center; position: relative; overflow: hidden; }
.hero-title { font-size:clamp(2.2rem,5vw,4.5rem); font-weight:600; letter-spacing:-.014em; line-height:1; text-wrap:balance; margin-bottom:24px; }
.hero-sub { font-size:clamp(.95rem,1.6vw,1.1rem); color:var(--text-muted); line-height:1.7; max-width:560px; margin:0 auto 40px; }

/* Sections */
.s { padding: var(--sec) 0; }
.s-title { font-size:clamp(1.6rem,3.5vw,2.8rem); font-weight:600; letter-spacing:-.010em; line-height:1.1; text-wrap:balance; margin-bottom:16px; }
.s-sub { font-size:clamp(.9rem,1.4vw,1rem); color:var(--text-muted); line-height:1.7; max-width:580px; margin-bottom:clamp(40px,6vw,72px); }

/* L'argument à gauche, sa preuve chiffrée à droite. Sous 960 px, la
   preuve passe sous l'argument, à une largeur de lecture.
   Au bureau, la preuve reste à l'écran tant que l'argument défile : les
   cartes du constat s'empilent en position collante (global.css) et
   rendent la colonne de gauche bien plus haute que le graphique. Sans
   cela, la colonne de droite redevenait vide pendant l'empilement.
   Seulement si l'écran est assez haut pour montrer le graphique entier. */
.duo { display:grid; row-gap:var(--sp-8); }
.duo-fig { min-width:0; max-width:560px; }
@media (min-width:960px) {
  .duo { grid-template-columns:minmax(0,1fr) minmax(340px,460px); column-gap:clamp(48px,6vw,96px); align-items:start; }
  .duo-fig { max-width:none; }
}
@media (min-width:960px) and (min-height:820px) {
  .duo-fig { position:sticky; top:calc(var(--hdr) + var(--sp-5)); }
}

/* Constat */
.constat-list { display:flex; flex-direction:column; gap:16px; max-width:760px; }
.constat-item { display:flex; gap:20px; align-items:flex-start; padding:24px; background:var(--surface); border:1px solid var(--border); border-radius:4px; }
.constat-num { font-size:var(--fs-caption); font-weight:600; color:var(--accent-text); letter-spacing:0; flex-shrink:0; padding-top:2px; }
.constat-text strong { display:block; font-size:1rem; font-weight:600; margin-bottom:6px; }
.constat-text p { font-size:.9rem; color:var(--text-muted); line-height:1.65; }

/* Cards livrables — la grille suit le nombre de cartes, aucune case
   ne reste vide : une colonne au téléphone ; deux de 600 à 899 px, la
   dernière carte seule prenant toute la ligne ; trois au-delà, sur une
   trame de six, la dernière rangée incomplète s'élargissant (5 = 3 + 2). */
.cards { display:grid; grid-template-columns:minmax(0,1fr); gap:0 clamp(24px,3vw,40px); margin-top:clamp(32px,5vw,60px); border-bottom:1px solid var(--border); }
@media (min-width:600px) and (max-width:899.98px) {
  .cards { grid-template-columns:repeat(2,minmax(0,1fr)); }
  .card:nth-child(odd):last-child { grid-column:1 / -1; }
}
@media (min-width:900px) {
  .cards { grid-template-columns:repeat(6,minmax(0,1fr)); }
  .card { grid-column:span 2; }
  .card:nth-child(3n+1):nth-last-child(2),
  .card:nth-child(3n+1):nth-last-child(2) ~ .card { grid-column:span 3; }
  .card:nth-child(3n+1):last-child { grid-column:1 / -1; }
}
.card { padding:28px 0 32px; border-top:1px solid var(--border); }
.card-title { font-size:1rem; font-weight:600; margin-bottom:8px; }
.card-desc { font-size:.875rem; color:var(--text-muted); line-height:1.65; }

/* Tarif */
.prix-block { max-width:540px; }
.prix-depuis { font-size:clamp(2.2rem,5vw,3.2rem); font-weight:600; letter-spacing:-.014em; margin-bottom:8px; }
.prix-depuis strong { color:var(--accent-text); }
.prix-desc { font-size:.95rem; color:var(--text-muted); margin-bottom:28px; line-height:1.6; }
.prix-links { display:flex; gap:16px; flex-wrap:wrap; align-items:center; }
/* CTA finale */
.cta-btns { display:flex; gap:16px; flex-wrap:wrap; align-items:center; margin-bottom:40px; }

/* FAQ */
.faq-list { display:flex; flex-direction:column; gap:0; max-width:760px; }
/* La FAQ sur deux colonnes au bureau : le titre à gauche, les réponses à
   droite, comme sur l'accueil. Sur une colonne, la moitié droite de
   l'écran restait vide. */
@media (min-width:1024px){
  .faq-sec { display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1.7fr); column-gap:clamp(48px,6vw,96px); align-items:start; }
  .faq-intro { position:sticky; top:calc(var(--hdr) + var(--sp-5)); }
  .faq-sec .faq-list { max-width:none; }
}
.faq-item { border-top:1px solid var(--border); padding:24px 0; }
.faq-item:last-child { border-bottom:1px solid var(--border); }
.faq-q { font-size:1rem; font-weight:600; margin-bottom:10px; }
.faq-a { font-size:.9rem; color:var(--text-muted); line-height:1.7; }

/* Navigation métier */
.other-pages { margin-top:8px; }
.other-pages p { font-size:.82rem; color:var(--text-muted); margin-bottom:10px; font-weight:500; letter-spacing:0; }
.other-pages a { display:inline-block; margin-right:12px; margin-bottom:8px; font-size:.82rem; color:var(--text-muted); border:1px solid var(--border-strong); padding:5px 12px; border-radius:3px; transition:color .2s,border-color .2s; }
.other-pages a:hover { color:var(--text); border-color:var(--text-muted); }

@media(max-width:768px) {
  .contact-grid { grid-template-columns:1fr; }
}
/* Une colonne : les filets séparent les cartes, le texte s'aligne sur le titre. */
@media(max-width:599.98px) {
  .card { padding:28px 0; }
}
/* Au téléphone, le retour forcé du titre laissait un mot seul en fin de ligne. */
@media (max-width:600px){ .hero-title br { display:none; } }
</style>

<Header backBtn={true} />

<main id="main-content" tabindex="-1">
  <!-- 2. Hero -->
  <section class="hero">
    <div class="wrap">
      <h1 class="hero-title r d1" data-i18n="resto-h1">Vos concurrents prennent<br>vos réservations en ligne.</h1>
      <p class="hero-sub r d2" data-i18n="resto-2">Avant de sortir, beaucoup de clients cherchent un restaurant sur Google. Sans site, c'est la table d'à côté qui remplit la salle — pas la vôtre.</p>
      <InteractiveButton text="Avoir mon site restaurant" data-i18n="resto-b1" href="/devis?plan=vitrine-pro" class="r d3" r />
    </div>
  </section>

  <!-- 3. Le constat -->
  <section class="s sec-seam">
    <div class="wrap duo">
      <div class="duo-txt">
        <h2 class="s-title r" data-i18n="resto-3">Ce qui se passe vraiment quand vous n'êtes pas en ligne</h2>
        <p class="s-sub r d1" data-i18n="resto-4">Pas de site, pas de réservation directe.</p>
        <ul class="constat-list">
          <li class="constat-item r d1">
            <span class="constat-num" data-i18n="resto-n1">55 %</span>
            <div class="constat-text">
              <strong data-i18n="resto-5">Des très petites entreprises de l'hébergement-restauration ayant accès à Internet n'ont pas de site web (Insee, 2022)</strong>
              <p data-i18n="resto-6">Sur Google, TripAdvisor ou les Pages Jaunes, le client choisit parmi les restaurants qui apparaissent. Si le vôtre n'y est pas, il ne revient pas chercher.</p>
            </div>
          </li>
          <li class="constat-item r d2">
            <div class="constat-text">
              <strong data-i18n="resto-7">Un menu PDF partagé sur WhatsApp ne rassure pas</strong>
              <p data-i18n="resto-8">Un client qui reçoit un PDF non consultable sur téléphone, sans horaires clairs ni adresse cliquable, passe vite à autre chose.</p>
            </div>
          </li>
          <li class="constat-item r d3">
            <div class="constat-text">
              <strong data-i18n="resto-9">L'absence en ligne, c'est votre concurrent qui prend la réservation</strong>
              <p data-i18n="resto-10">Le restaurant d'en face avec un site soigné capte les clients du quartier, les touristes, les groupes. Vous, vous attendez le bouche-à-oreille.</p>
            </div>
          </li>
        </ul>
      </div>
      <div class="duo-fig r d2"><Secteurs secteur="restauration" /></div>
    </div>
  </section>

  <!-- 4. Ce que vous recevez -->
  <section class="s sec-seam">
    <div class="wrap">
      <h2 class="s-title r" data-i18n="resto-11">Ce que vous recevez</h2>
      <p class="s-sub r d1" data-i18n="resto-12">Cinq livrables concrets, pensés pour un restaurant — pas un site générique.</p>
      <div class="cards">
        <div class="card r d1">
          <h3 class="card-title" data-i18n="resto-13">Menu en ligne toujours à jour</h3>
          <p class="card-desc" data-i18n="resto-14">Vos plats, vins et formules affichés clairement. Modifiables sans agence dès que la carte change.</p>
        </div>
        <div class="card r d2">
          <h3 class="card-title" data-i18n="resto-15">Formulaire de réservation directe</h3>
          <p class="card-desc" data-i18n="resto-16">Les clients réservent depuis le site, sans passer par une plateforme tierce qui prend une commission.</p>
        </div>
        <div class="card r d3">
          <h3 class="card-title" data-i18n="resto-17">Galerie plats et ambiance</h3>
          <p class="card-desc" data-i18n="resto-18">Photos de vos plats et de votre salle mises en valeur. Le client voit avant de venir — et il vient.</p>
        </div>
        <div class="card r d1">
          <h3 class="card-title" data-i18n="resto-19">SEO local "restaurant [votre ville]"</h3>
          <p class="card-desc" data-i18n="resto-20">Optimisé pour que Google vous propose quand quelqu'un cherche où manger près de chez lui.</p>
        </div>
        <div class="card r d2">
          <h3 class="card-title" data-i18n="resto-21">Fiche Google optimisée</h3>
          <p class="card-desc" data-i18n="resto-22">Horaires, photos, avis, lien de réservation — votre fiche Google Maps complète et à jour.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. Tarif -->
  <section class="s sec-seam">
    <div class="wrap duo">
      <div class="duo-txt">
        <h2 class="s-title r" data-i18n="resto-23">Un tarif lisible, sans surprise</h2>
        <p class="s-sub r d1" data-i18n="resto-24">Formule Vitrine Pro adaptée aux restaurants et commerces locaux.</p>
        <div class="prix-block r d2">
          <p class="prix-desc" data-i18n="resto-25">Tarif actuel et détail des places disponibles sur notre page tarifs.</p>
          <div class="prix-links">
            <InteractiveButton text="Voir le détail des tarifs" data-i18n="resto-b2" href="/tarifs" />
            <InteractiveButton text="Demander un devis" data-i18n="resto-b3" href="/devis?plan=vitrine-pro" />
          </div>
        </div>
      </div>
      <div class="duo-fig r d2"><Echeancier formule="vitrine" /></div>
    </div>
  </section>

  <!-- 6. FAQ -->
  <section class="s sec-seam">
    <div class="wrap faq-sec">
      <div class="faq-intro">
        <h2 class="s-title r" data-i18n="resto-26">Questions fréquentes</h2>
        <p class="s-sub r d1" data-i18n="resto-27">Les vraies questions que posent les restaurateurs avant de se lancer.</p>
      </div>
      <div class="faq-list">
        <div class="faq-item r d1">
          <p class="faq-q" data-i18n="resto-28">Est-ce que je peux mettre à jour le menu moi-même ?</p>
          <p class="faq-a" data-i18n="resto-29">Oui. On vous forme en 20 minutes. Vous changez les plats, les prix et les formules directement depuis votre téléphone, sans toucher au code. Si vous préférez qu'on s'en charge, mentionnez-le dans votre devis.</p>
        </div>
        <div class="faq-item r d2">
          <p class="faq-q" data-i18n="resto-30">Combien de temps avant d'être en ligne ?</p>
          <p class="faq-a" data-i18n="resto-31">Deux à quatre semaines après validation du brief et réception de vos contenus (photos, textes). Le calendrier est fixé dès le premier appel.</p>
        </div>
        <div class="faq-item r d3">
          <p class="faq-q" data-i18n="resto-32">Je n'ai pas de photos professionnelles de mes plats.</p>
          <p class="faq-a" data-i18n="resto-33">Pas de problème. Des photos prises avec un smartphone récent fonctionnent très bien. On vous explique comment les cadrer correctement. Sinon, on peut vous recommander un photographe local pour un shooting rapide.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 7. Démarrer -->
  <section class="s sec-seam" id="contact">
    <div class="wrap">
      <h2 class="s-title r" data-i18n="resto-34">Prêt à vous lancer ?</h2>
      <p class="s-sub r d1" data-i18n="resto-35">Décrivez votre projet en 2 minutes. On vous revient sous 24 h, sans engagement.</p>
      <div class="cta-btns r d2">
        <InteractiveButton text="Demander un devis gratuit" data-i18n="resto-b4" href="/devis?plan=vitrine-pro" />
        <InteractiveButton text="Réserver un créneau" data-i18n="resto-b5" href="/rendez-vous" />
      </div>
      <div class="other-pages r d3">
        <p data-i18n="resto-36">Autres pages métier</p>
        <a href="/site-internet-commerce" data-i18n="resto-37">Commerce de proximité</a>
        <a href="/site-internet-artisan" data-i18n="resto-38">Artisan &amp; TPE</a>
      </div>
    </div>
  </section>
</main>

<Footer />

<script is:inline>
(function(){
  var els=document.querySelectorAll('.r');
  if(!els.length)return;
  var io=new IntersectionObserver(function(entries){entries.forEach(function(e){if(e.isIntersecting){e.target.classList.add('v');io.unobserve(e.target);}});},{threshold:0.12});
  els.forEach(function(el){io.observe(el);});
})();
</script>
</BaseLayout>
