---
import InteractiveButton from '../components/ui/InteractiveButton.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import GarantieBadge from '../components/GarantieBadge.astro';
import Simulateur from '../components/graphes/Simulateur.astro';
import Mesure from '../components/graphes/Mesure.astro';
import { VITRINE_PRIX, REFONTE_PRIX, ENTREPRISE, REFONTE, prix } from '../data/formules';
import { MESURE_ACCUEIL } from '../data/mesures';
import manifest from '../../public/img/manifest.json';
import '../styles/global.css';

/* LES DÉLAIS DU DOSSIER « MISE EN LIGNE ».
   Refonte : formules.ts (REFONTE.delaiSemaines), jamais recopié.
   Vitrine Pro : « 2 à 4 semaines », tel qu'écrit sur /site-vitrine
   (« Livraison en 2 à 4 semaines ») et dans la FAQ de cette page.
   L'échelle des barres va jusqu'au plus long des deux délais. */
const VP_MIN = 2, VP_MAX = 4;
const ECHELLE_SEM = Math.max(VP_MAX, REFONTE.delaiSemaines);
const pctSem = (s: number) => ((s / ECHELLE_SEM) * 100).toFixed(2);

/* LES FONDATEURS — les photos de /equipe (public/img/gen/vignette-*),
   servies en AVIF/WebP/JPEG d'après public/img/manifest.json, comme le
   fait Picture.astro. Picture n'est pas utilisé ici : il ne sait pas
   porter la clé de traduction du texte alternatif (data-i18n-alt).
   Prénom, rôle et spécialité : les mêmes clés que /equipe. */
const jeu = (nom: string, ext: string) =>
  Object.values((manifest as Record<string, { widths: Record<string, { w: number }> }>)[nom].widths)
    .map((v) => `/img/gen/${nom}-${v.w}.${ext} ${v.w}w`).join(', ');
const FONDATEURS = [
  { photo: 'vignette-membre1', prenom: 'Imad', prenomCle: 'idx-fond1-nom',
    alt: 'Imad Torchi, co-fondateur de Nexa Web, développement web et architecture', altCle: 'idx-fond1-alt',
    spe: 'Développement web & Architecture', speCle: 'eq-title1' },
  { photo: 'vignette-membre2', prenom: 'Ahmed', prenomCle: 'idx-fond2-nom',
    alt: 'Ahmed Chteoui, co-fondateur de Nexa Web, design UI/UX et stratégie digitale', altCle: 'idx-fond2-alt',
    spe: 'Design UI/UX & Stratégie digitale', speCle: 'eq-title2' },
].map((f) => {
  const tailles = Object.values((manifest as any)[f.photo].widths) as { w: number }[];
  return { ...f, avif: jeu(f.photo, 'avif'), webp: jeu(f.photo, 'webp'), jpg: jeu(f.photo, 'jpg'),
           src: `/img/gen/${f.photo}-${tailles[0].w}.jpg` };
});
---
<BaseLayout title="Nexa Web — Agence web à Carvin" description="Nexa Web conçoit des sites internet sur-mesure pour commerçants et artisans. Refonte dès 490 €, livraison en 2 à 4 semaines. Carvin, Hauts-de-France.">
<style>

/* ── HERO ──
   À la hauteur de son contenu, plus à celle de l'écran : sans décor
   derrière, un premier écran de 100 svh n'était qu'un titre perdu dans
   le noir. La liste des prestations commence juste en dessous. */
.s-hero{padding:calc(var(--hdr) + clamp(48px,11vh,128px)) 0 clamp(24px,4vh,48px)}
.hero-hl{margin-bottom:clamp(20px,3.4vh,40px);width:100%;text-wrap:wrap;overflow-wrap:anywhere}
.hero-hl .ln{display:block}
/* LE TITRE SUR TÉLÉPHONE. Sous 520 px la taille suit la largeur utile,
   calée pour que « des Hauts-de-France. » tienne d'un seul tenant
   (9,6 cadratins mesurés), et chaque ligne s'équilibre. */
@media (max-width:520px){
  .hero-hl{font-size:min(40px,calc((100vw - 2 * var(--pad-x)) / 9.6))}
  .hero-hl .li{text-wrap:balance}
}
.hero-hl .li{display:block}
.hero-sub{margin-bottom:clamp(24px,4vh,40px)}
.hero-ctas{display:flex;flex-wrap:wrap;gap:12px}
.hero-main{min-width:0}

/* ── SERVICES ── */
.s-svc{}
.svc-hdr{display:flex;justify-content:space-between;align-items:flex-end;flex-wrap:wrap;gap:24px;margin-bottom:clamp(36px,6vh,72px)}
/* ═══════════════════════════════════════════════════════════════════
   DES LIGNES, PAS DES CARTES — recopie de la reference.
   Aucun rayon, aucun fond : des filets fins, et c'est tout. Le
   traitement carte (.gloss/.pass/.lip) a ete retire de .svc-row dans
   scroll-fx.js : ce n'est pas une carte.
   ═══════════════════════════════════════════════════════════════════ */
.svc-list{display:flex;flex-direction:column}
.svc-row{
  display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:baseline;gap:8px 24px;
  padding:clamp(18px,2.6vw,26px) clamp(10px,2vw,20px);
  color:inherit;background:transparent;border-top:1px solid var(--border);
  transition:background-color var(--dur-short) var(--ease-out);
}
.svc-list .svc-row:last-child{border-bottom:1px solid var(--border)}
.svc-name{font-size:clamp(1.05rem,2.4vw,1.6rem);font-weight:600;letter-spacing:-.009em}
/* Le prix de départ et le délai, lus dans formules.ts : ce qu'un
   visiteur cherche sur une liste de prestations. */
.svc-meta{display:flex;align-items:baseline;gap:18px;color:var(--text-muted);font-size:15px;
  white-space:nowrap}
.svc-prix{color:var(--text);font-weight:600}
@media (hover:hover){
  .svc-row:hover{background:var(--surface)}
  .svc-row:hover .svc-name{text-decoration:underline;text-decoration-thickness:1px;text-underline-offset:.18em}
}
.svc-row:focus-visible{background:var(--surface)}
@media(max-width:600px){
  .svc-row{grid-template-columns:1fr}
  .svc-meta{white-space:normal;flex-wrap:wrap;gap:4px 14px}
}
/* L'en-tête de section : à droite au bureau, sous le titre au téléphone. */
.svc-hdr-d{max-width:320px;text-align:right}
@media(max-width:700px){.svc-hdr-d{text-align:left;max-width:none}}

/* ═══════════════════════════════════════════════════════════════════
   NOTRE METHODE — une sequence epinglee, pas une grille de cartes.

   La section se bloque pendant qu'on defile et les quatre etapes
   passent l'une apres l'autre AU MEME ENDROIT. .proc-step ne recoit
   aucun calque de carte et aucun cardFlight : il a stepIn, point.
   ═══════════════════════════════════════════════════════════════════ */
.s-proc{padding-top:clamp(60px,10vw,120px)}
.proc-hdr{margin-bottom:clamp(36px,6vh,72px)}

/* ── LA BASE : UNE LISTE ──────────────────────────────────────────────
   Chaque étape, puis son dossier. C'est ce que voient le navigateur
   sans animations au défilement (Firefox, Safari anciens), le visiteur
   en mouvement réduit, l'écran de moins de 768 px et l'écran trop bas
   pour tenir la séquence épinglée. Dès 768 px, l'étape et son dossier
   se rangent sur la même ligne : le dossier n'est jamais un panneau
   isolé, ni quatre panneaux empilés à la même place.
   L'ordre du DOM est l'ordre de lecture dans tous les cas : étape 1,
   dossier 1, étape 2, dossier 2… Les étapes sont des <div>, les
   dossiers des <article> : :nth-of-type les compte chacun de leur côté
   (.procticks, le seul autre <div>, vient après les quatre étapes). */
.procwrap{position:relative;z-index:2}
.procpin .wrap{position:relative;z-index:1}
.procstack{display:grid;grid-template-columns:minmax(0,1fr);row-gap:var(--sp-5)}
.proc-step{display:flex;flex-direction:column;gap:14px;background:none;border-radius:0;padding:0}
.proc-step .k{font-size:clamp(46px,8.5vw,104px);line-height:.88;font-weight:600;
  letter-spacing:-.016em;font-variant-numeric:tabular-nums}
.proc-step .proc-title{font-size:clamp(21px,3vw,32px);font-weight:600;letter-spacing:-.007em;margin:0}
.proc-step .proc-desc{margin:0;color:var(--text-muted);max-width:44ch;
  font-size:16px;font-weight:300;line-height:1.68}
.procticks{display:none;gap:7px;margin-top:clamp(20px,3vw,30px)}
.procticks i{display:block;height:2px;width:clamp(34px,5vw,56px);background:var(--border);
  border-radius:2px;overflow:hidden;position:relative}
.procticks i::after{content:'';position:absolute;inset:0;background:var(--accent);
  transform-origin:left;transform:scaleX(0)}
@media (max-width:767.98px){
  .dossier:not(:last-of-type){margin-bottom:var(--sp-7)}
}
@media (min-width:768px){
  .procstack{grid-template-columns:minmax(0,5fr) minmax(0,6fr);
    column-gap:clamp(40px,6vw,104px);row-gap:var(--sp-8);align-items:start}
}

/* ── LE DOSSIER DE L'ÉTAPE ──
   Un palier de fond, droit à 2 px. Titre en haut, provenance en bas :
   le pied descend au bas du panneau, quelle que soit la hauteur. */
.dossier{display:flex;flex-direction:column;min-width:0;
  background:var(--surface);border-radius:var(--radius-block);
  padding:clamp(24px,2.8vw,40px);color:var(--text)}
.dos-t{margin:0 0 var(--sp-5);font-family:var(--font-display);font-weight:var(--w-display);
  font-synthesis:none;font-size:var(--fs-300);line-height:1.2;letter-spacing:var(--ls-sub);
  text-wrap:balance}
.dos-st{margin:0 0 var(--sp-2);font-size:14px;font-weight:var(--w-semi);line-height:1.35;color:var(--text)}
.dos-ligne{margin:0 0 var(--sp-4);font-size:15px;line-height:1.5;color:var(--text-muted)}
.dos-liste{margin:0;padding:0;list-style:none;font-size:15px;line-height:1.4;color:var(--text-muted)}
.dos-liste li{padding:7px 0;border-top:1px solid var(--border)}
.dos-liste li:last-child{border-bottom:1px solid var(--border)}
.dos-pied{margin:auto 0 0;padding-top:var(--sp-5);font-size:13px;line-height:1.45;color:var(--text-muted)}
.dos-lien{color:var(--text);font-size:15px;font-weight:var(--w-semi);
  text-decoration:underline;text-decoration-thickness:1px;text-underline-offset:4px;
  text-decoration-color:var(--border-strong);
  transition:text-decoration-color 160ms var(--ease-out),color 160ms var(--ease-out)}
@media (hover:hover) and (pointer:fine){.dos-lien:hover{color:var(--accent-text);text-decoration-color:currentColor}}
.dos-lien:focus-visible{outline:2px solid var(--focus);outline-offset:3px;border-radius:var(--radius-tag)}



/* 04 — les délais, en semaines. Même dessin que le graphique de la
   mesure (étape 03) : libellé, barre, valeur au bout. La part « jusqu'à
   4 semaines » de la Vitrine Pro est la même barre, en or bas. */
.dos-delais{margin:0 0 var(--sp-6);display:grid;gap:var(--sp-3)}
.dos-d{display:grid;gap:var(--sp-1)}
.dos-d dt{font-size:14px;line-height:1.3;color:var(--text);font-weight:var(--w-semi)}
.dos-d dd{margin:0;display:flex;align-items:center;gap:var(--sp-2);min-height:22px}
.dos-piste{flex:none;display:flex;gap:2px;width:calc((100% - 8.5rem) * var(--l) / 100)}
.dos-barre{height:14px;flex:var(--f) 1 0;min-width:2px;background:var(--accent);border-radius:0 4px 4px 0}
.dos-barre-min{border-radius:0}
.dos-barre-max{background:repeating-linear-gradient(135deg,var(--accent) 0 2px,transparent 2px 5px);box-shadow:inset 0 0 0 1px var(--accent)}
.dos-val{font-size:14px;line-height:1;color:var(--text);white-space:nowrap}

/* ── LA SÉQUENCE ÉPINGLÉE ─────────────────────────────────────────────
   Seulement si le navigateur sait animer au défilement, si le mouvement
   est permis, et si l'écran a la place (768 px de large, 640 de haut).
   La section se bloque ; à gauche les quatre étapes passent l'une après
   l'autre au même endroit, à droite leurs dossiers dans un seul panneau.
   Étapes et dossiers suivent LA MÊME chronologie (--proc) avec les
   mêmes plages : aucun JavaScript de défilement.
   La première étape et son dossier sont déjà là quand la section
   arrive, et la dernière reste en place quand elle repart : la séquence
   ne commence ni ne finit sur un écran vide. */
@supports (animation-timeline: view()){
@media (prefers-reduced-motion:no-preference) and (min-width:768px) and (min-height:640px){
  .procwrap{height:340vh;view-timeline-name:--proc;view-timeline-axis:block}
  .procpin{position:sticky;top:0;height:100svh;display:flex;align-items:center;
    padding-top:var(--hdr);perspective:1200px;overflow:clip}
  .procstack{grid-template-rows:auto 1fr;row-gap:0;transform-style:preserve-3d}
  /* Le panneau ne bouge pas : seul son contenu change. */
  .procstack::before{content:'';grid-area:1 / 2 / 3 / 3;align-self:stretch;
    background:var(--surface);border-radius:var(--radius-block)}
  .proc-step{grid-area:1 / 1;animation:stepIn linear both;animation-timeline:--proc}
  .dossier{grid-area:1 / 2 / 3 / 3;align-self:stretch;background:none;
    animation:dosIn linear both;animation-timeline:--proc}
  /* Les repères de progression se posent sur la ligne du bas du
     panneau : la colonne de gauche tient la même hauteur que lui. */
  .procticks{display:flex;grid-area:2 / 1;align-self:end;margin-top:var(--sp-6)}

  .proc-step:nth-of-type(1),.dossier:nth-of-type(1){animation-range:contain 0% contain 25%}
  .proc-step:nth-of-type(2),.dossier:nth-of-type(2){animation-range:contain 25% contain 50%}
  .proc-step:nth-of-type(3),.dossier:nth-of-type(3){animation-range:contain 50% contain 75%}
  .proc-step:nth-of-type(4),.dossier:nth-of-type(4){animation-range:contain 75% contain 100%}
  .proc-step:nth-of-type(1){animation-name:stepFirst}
  .proc-step:nth-of-type(4){animation-name:stepLast}
  .dossier:nth-of-type(1){animation-name:dosFirst}
  .dossier:nth-of-type(4){animation-name:dosLast}

  /* Bout à bout, sans fondu croisé : une étape finit de s'effacer
     exactement où la suivante commence à paraître. Avant, les plages se
     recouvraient d'un point et les deux textes se superposaient. */
  @keyframes stepIn{
    0%{opacity:0;transform:translateY(24px)}
    15%{opacity:1;transform:none}
    85%{opacity:1;transform:none}
    100%{opacity:0;transform:translateY(-18px)}}
  @keyframes stepFirst{
    0%,85%{opacity:1;transform:none}
    100%{opacity:0;transform:translateY(-18px)}}
  @keyframes stepLast{
    0%{opacity:0;transform:translateY(24px)}
    15%,100%{opacity:1;transform:none}}
  /* visibility suit l'opacité : un dossier éteint ne prend ni le focus,
     ni le pointeur, et les lecteurs d'écran ne lisent que celui qu'on voit. */
  @keyframes dosIn{
    0%{opacity:0;visibility:hidden;transform:translateY(16px)}
    15%{opacity:1;visibility:visible;transform:none}
    85%{opacity:1;visibility:visible;transform:none}
    100%{opacity:0;visibility:hidden;transform:translateY(-12px)}}
  @keyframes dosFirst{
    0%,85%{opacity:1;visibility:visible;transform:none}
    100%{opacity:0;visibility:hidden;transform:translateY(-12px)}}
  @keyframes dosLast{
    0%{opacity:0;visibility:hidden;transform:translateY(16px)}
    15%,100%{opacity:1;visibility:visible;transform:none}}

  .procticks i::after{animation:lineDraw linear both;animation-timeline:--proc}
  .procticks i:nth-child(1)::after{animation-range:contain 0% contain 25%}
  .procticks i:nth-child(2)::after{animation-range:contain 25% contain 50%}
  .procticks i:nth-child(3)::after{animation-range:contain 50% contain 75%}
  .procticks i:nth-child(4)::after{animation-range:contain 75% contain 100%}
  @keyframes lineDraw{to{transform:scaleX(1)}}
}
}

/* ── WHY ── */
.s-why{
  /* Un aplat --surface à bords francs produisait deux arêtes nettes sur
     toute la largeur. Le décrochement se fait en dégradé vertical. */
  background:linear-gradient(to bottom,
    rgb(from var(--surface) r g b / 0) 0%,
    color-mix(in srgb,var(--surface) 70%,transparent) 22%,
    color-mix(in srgb,var(--surface) 70%,transparent) 78%,
    rgb(from var(--surface) r g b / 0) 100%);
}
.why-in{display:grid;grid-template-columns:1fr 1fr;gap:clamp(40px,8vw,120px);align-items:start}
/* Le titre vit dans une colonne de ~560 px : à la taille pleine de .h-lg
   il se cassait en quatre lignes bancales autour de son <br>. */
.why-in .h-lg{font-size:clamp(var(--fs-500),3.6vw,var(--fs-700))}
.why-bio{display:flex;flex-direction:column;gap:18px;padding:4px 0}
.why-bio-lead{font-size:clamp(1.35rem,2.4vw,1.9rem);font-weight:600;line-height:1.18;letter-spacing:-.010em;color:var(--text)}
.why-bio-body{font-size:15px;font-weight:var(--w-reg);line-height:1.7;color:var(--text-muted)}
/* Sans « align-self:flex-start », ce bouton s'etire sur toute la largeur
   de sa colonne : mesure, 510 px pour un parent de 510 px. La regle
   vivait dans l'ancien .why-bio-cta, emporte avec le CSS des boutons. */
.why-bio-cta{align-self:flex-start;margin-top:8px}
/* .why-bio est une colonne en flex avec 18 px de gouttière : le badge
   s'y range comme les paragraphes, et s'aligne à gauche au lieu de
   s'étirer sur toute la largeur de la colonne. */
.why-gar{align-self:flex-start;margin-top:4px}
@media(max-width:720px){.why-in{grid-template-columns:1fr}}

/* LES FONDATEURS — sous le paragraphe de la colonne de gauche. Les
   photos de /equipe, en petit, droites à 2 px : ni cercle, ni ombre,
   ni cadre. Les fichiers d'origine portent un liseré clair sur leurs
   bords ; le léger agrandissement le sort du cadre. */
.fond{margin-top:clamp(32px,4vw,48px);max-width:480px}
.fond-liste{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:var(--sp-5);
  margin:0;padding:0;list-style:none}
.fond-photo{display:block;width:96px;aspect-ratio:4 / 5;overflow:hidden;
  border-radius:var(--radius-block);background:var(--surface-2);margin-bottom:var(--sp-3)}
.fond-photo img{display:block;width:100%;height:100%;object-fit:cover;scale:1.06}
.fond-p1 img{object-position:50% 24%}
.fond-p2 img{object-position:50% 12%}
.fond-nom{margin:0;font-size:15px;font-weight:var(--w-semi);line-height:1.35;color:var(--text)}
.fond-role{margin:0;font-size:13px;line-height:1.4;color:var(--text-muted)}
.fond-lien{display:inline-block;margin-top:var(--sp-5)}

/* ── LE SIMULATEUR ── */
.sim-h{margin:0 0 clamp(28px,4vw,48px);max-width:24ch}

/* ── FAQ ── */
.s-faq{}
.faq-in{display:grid;grid-template-columns:1fr 1.8fr;gap:clamp(40px,8vw,120px)}
.faq-side p{margin-top:20px;font-size:13px}
/* ═══════════════════════════════════════════════════════════════════
   FAQ — une liste a filets, pas des cartes. Recopie de la reference.

   Le + est DESSINE (deux barres), pas ecrit : un caractere « + » se
   pose sur la ligne de base et ne se centre jamais dans son cercle.
   Le depliage passe par grid-template-rows 0fr -> 1fr : aucune hauteur
   a mesurer en JavaScript, donc aucun saut.
   ═══════════════════════════════════════════════════════════════════ */
.faq-list{display:flex;flex-direction:column}
.qa{position:relative;border-top:1px solid var(--border)}
.qa:last-child{border-bottom:1px solid var(--border)}
.qa .bar{position:absolute;left:0;top:0;bottom:0;width:2px;transform-origin:top;transform:scaleY(0);
  background:linear-gradient(180deg,var(--accent),rgb(from var(--accent) r g b / 0));
  transition:transform 480ms cubic-bezier(.22,.9,.24,1)}
.qa.open .bar{transform:scaleY(1)}
.qa .q{width:100%;background:none;border:0;color:inherit;font:inherit;cursor:pointer;text-align:left;
  display:flex;align-items:center;gap:16px;padding:clamp(16px,2.2vw,22px) 4px;
  font-size:clamp(15px,1.8vw,18px);font-weight:600;letter-spacing:-.007em}
.qa .q:focus-visible{outline:2px solid var(--text);outline-offset:-2px;border-radius:2px}
.qa .q .qt{transition:transform 420ms cubic-bezier(.22,.9,.24,1),color 260ms var(--ease-out)}
.qa.open .q .qt{transform:translateX(12px);color:var(--text)}
.qa .q:hover .qt{transform:translateX(6px)}
.qa .plus{margin-left:auto;flex:none;position:relative;width:28px;height:28px;border-radius:var(--radius-tag);
  box-shadow:inset 0 0 0 1px var(--border-strong);
  transition:transform 480ms cubic-bezier(.22,.9,.24,1),box-shadow var(--dur-short) var(--ease-out)}
.qa .plus::before,.qa .plus::after{content:'';position:absolute;top:50%;left:50%;
  background:var(--accent);border-radius:1px}
.qa .plus::before{width:11px;height:1.5px;transform:translate(-50%,-50%)}
.qa .plus::after{width:1.5px;height:11px;transform:translate(-50%,-50%) scaleY(1);
  transition:transform 420ms cubic-bezier(.22,.9,.24,1)}
.qa.open .plus{transform:rotate(180deg);box-shadow:inset 0 0 0 1px rgb(from var(--accent) r g b / .5)}
.qa.open .plus::after{transform:translate(-50%,-50%) scaleY(0)}
.qa .panel{display:grid;grid-template-rows:0fr;
  transition:grid-template-rows 480ms cubic-bezier(.22,.9,.24,1)}
.qa.open .panel{grid-template-rows:1fr}
.qa .panel>div{overflow:hidden}
.qa .ans{padding:0 4px clamp(18px,2.4vw,24px) 18px;color:var(--text-muted);font-size:15px;
  font-weight:300;line-height:1.75;max-width:60ch;margin:0;opacity:0;transform:translateY(-6px);
  transition:opacity 340ms var(--ease-out) 90ms,transform 420ms cubic-bezier(.22,.9,.24,1) 90ms}
.qa.open .ans{opacity:1;transform:none}
@media (prefers-reduced-motion:reduce){
  .qa .bar,.qa .q .qt,.qa .plus,.qa .plus::after,.qa .panel,.qa .ans{transition:none}
}
@media(max-width:700px){.faq-in{grid-template-columns:1fr}}

/* ── CTA ── */
.s-cta{text-align:center}
.cta-in{max-width:900px;margin:0 auto;padding:clamp(80px,15vw,180px) 0}
.cta-super{font-size:clamp(.6rem,1vw,.75rem);font-weight:600;letter-spacing:0;color:var(--text-muted);margin-bottom:32px}
.cta-hl{font-size:clamp(3rem,8vw,9.5rem);font-weight:600;line-height:.92;letter-spacing:-.014em;margin-bottom:48px;text-wrap:balance}
.cta-hl em{font-style:italic;font-weight:600}

/* ── POUR QUI ── */
.s-who{}
.who-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:clamp(36px,6vh,72px)}
.who-card{background:var(--surface);border-radius:var(--radius-block);padding:clamp(28px,4vw,48px);display:flex;flex-direction:column;gap:16px}
.who-target{font-size:clamp(1.1rem,2.2vw,1.7rem);font-weight:600;letter-spacing:-.009em;line-height:1.12}
.who-desc{font-size:13px;font-weight:300;line-height:1.72;color:var(--text-muted);flex:1}
.who-price{font-size:clamp(1.7rem,3.2vw,2.6rem);font-weight:600;letter-spacing:-.014em;line-height:1;font-variant-numeric:tabular-nums}
.who-price-sub{font-size:var(--fs-caption);font-weight:500;letter-spacing:0;color:var(--text-muted);margin-top:6px}
@media(max-width:600px){.who-grid{grid-template-columns:1fr;gap:0}.who-card:not(:last-child){border-bottom:1px solid var(--border)}}

