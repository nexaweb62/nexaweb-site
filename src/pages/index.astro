---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactForm from '../components/ContactForm.astro';
import ActionBar from '../components/ActionBar.astro';
import {
  SITE, AREA, HERO, STATS, PROBLEMS, OFFER, LAUNCH, PRICING, PLEDGES, PRICING_NOTES, FAQ,
} from '../config/site';
import { METIERS } from '../config/metiers';

const title = 'Nexa Web — Sites internet pour restaurants et commerces · Carvin';
const description =
  "Nexa Web met votre restaurant ou votre commerce en ligne : site, nom de domaine, réservations, suivi des visites et formation. Frais de lancement puis abonnement, sans engagement. Carvin, Hauts-de-France.";
---

<Base title={title} description={description} path="/">
  {/* Balisage de l'etablissement. ProfessionalService derive de LocalBusiness :
      c'est le type le plus precis pour une agence locale. Les montants sont
      repris de PRICING, donc un changement de prix met le balisage a jour tout
      seul — un prix contredit par les donnees structurees est un signal negatif. */}
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'ProfessionalService',
      '@id': `https://${SITE.domain}/#nexaweb`,
      name: SITE.name,
      description:
        "Création de sites internet pour les restaurants et les commerces de proximité : site, nom de domaine, réservations, suivi des visites et formation.",
      url: `https://${SITE.domain}`,
      email: SITE.email,
      telephone: '+33698840194',
      image: `https://${SITE.domain}/assets/og.jpg`,
      logo: `https://${SITE.domain}/assets/logo.svg`,
      priceRange: '€€',
      currenciesAccepted: 'EUR',
      areaServed: [
        { '@type': 'AdministrativeArea', name: SITE.region },
        ...AREA.map((ville) => ({ '@type': 'City', name: ville })),
      ],
      address: {
        '@type': 'PostalAddress',
        addressLocality: SITE.city,
        addressRegion: SITE.region,
        addressCountry: 'FR',
      },
      knowsLanguage: 'fr-FR',
      makesOffer: [
        {
          '@type': 'Offer',
          name: 'Lancement digital — mise en ligne',
          description:
            "Site vitrine ou boutique en ligne, nom de domaine, formulaire ou prise de rendez-vous, configuration des outils de suivi et formation. Facturé une seule fois.",
          price: PRICING.setup,
          priceCurrency: 'EUR',
          availability: 'https://schema.org/InStock',
        },
        {
          '@type': 'Offer',
          name: 'Lancement digital — abonnement',
          description:
            "Hébergement, nom de domaine, sauvegardes, mises à jour, modifications courantes et accompagnement. Sans engagement de durée.",
          priceSpecification: {
            '@type': 'UnitPriceSpecification',
            price: PRICING.monthly,
            priceCurrency: 'EUR',
            unitCode: 'MON',
            billingIncrement: 1,
          },
          availability: 'https://schema.org/InStock',
        },
      ],
    })}
  />

  {/* Les questions de la page, sous forme lisible par les moteurs. Google a
      restreint l'affichage des resultats enrichis FAQ en 2023 : le gain n'est
      plus dans la SERP mais dans la comprehension de la page — reponses
      reprises par les assistants et les apercus generes. Cout : zero. */}
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: FAQ.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    })}
  />

  <div class="page">
    <div class="bg">
      <video
        class="bg-video"
        data-src="/assets/hero.mp4"
        poster="/assets/hero-poster.webp"
        muted
        loop
        playsinline
        preload="metadata"
        aria-hidden="true"></video>
    </div>

    <Header active="/" />

    <div class="hero">
      <div class="trust anim" style="--d:0.05s">
        <span class="trust-badge">
          <span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" /><circle cx="12" cy="10" r="3" />
            </svg>
          </span>
        </span>
        <span class="trust-badge">
          <span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" />
            </svg>
          </span>
        </span>
        <span class="trust-badge">
          <span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 3l7 3v6c0 4.5-3 7.6-7 9-4-1.4-7-4.5-7-9V6l7-3Z" /><path d="m9 12 2 2 4-4" />
            </svg>
          </span>
        </span>
        <span class="trust-pill">{HERO.trustPill}</span>
      </div>

      <h1 class="headline">
        <span class="l1">{HERO.headline[0]}</span>
        <span class="l2">{HERO.headline[1]}</span>
      </h1>

      <p class="subhead anim" style="--d:0.28s">{HERO.subhead}</p>

      <a class="cta anim anim-pulse" style="--d:0.4s" href={HERO.ctaHref}>
        {HERO.ctaLabel}
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 5v14" /><path d="m19 12-7 7-7-7" />
        </svg>
      </a>
    </div>

    <div class="stats" id="stats">
      {
        STATS.map((s, i) => (
          <div class="stat anim" style={`--d:${0.5 + i * 0.08}s`}>
            <div
              class="stat-value"
              data-count={s.value}
              data-decimals={s.decimals}
              data-suffix={s.suffix}
            >
              0{s.suffix}
            </div>
            <div class="stat-label">{s.label}</div>
          </div>
        ))
      }
    </div>
  </div>

  <main>
    <!-- Le constat -->
    <section class="section" id="constat">
      <div class="container">
        <p class="eyebrow">Le constat</p>
        <h2 class="section-title">Vos clients vous cherchent en ligne. Ils trouvent quoi ?</h2>
        <div class="split">
          <div>
            <p class="split-note">
              Avant de pousser la porte d'un restaurant ou d'une boutique, on regarde
              son téléphone. Ce qui s'affiche à ce moment-là décide de la visite —
              et la plupart du temps, ce n'est pas vous qui l'avez choisi.
            </p>
          </div>
          <ul class="points">
            {
              PROBLEMS.map((p) => (
                <li>
                  <strong>{p.title}</strong>
                  {p.text}
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    <!-- L'offre -->
    <section class="section" id="offre">
      <div class="container">
        <p class="eyebrow">L'offre</p>
        <h2 class="section-title">Lancement digital</h2>
        <p class="lede">
          Une seule offre, pensée pour les restaurants et les commerces de proximité.
          Tout ce qu'il faut pour exister en ligne — et rien de plus.
        </p>
        <div class="offer-list">
          {
            OFFER.map((o) => (
              <article class="offer-item">
                <span aria-hidden="true">{o.num}</span>
                <div>
                  <h3>{o.title}</h3>
                  <p>
                    {o.text}
                    {'lien' in o && (
                      <>
                        {' '}
                        <a class="inline-link" href={o.lien.href}>{o.lien.label}</a>.
                      </>
                    )}
                  </p>
                </div>
              </article>
            ))
          }
        </div>

        <nav class="metier-liens" aria-label="Pages par métier">
          <span>Ce que ça donne dans votre métier :</span>
          {METIERS.map((m) => <a class="inline-link" href={`/${m.slug}`}>{m.nav}</a>)}
        </nav>
      </div>
    </section>

    <!-- Premiers projets : pourquoi aucune référence n'est encore affichée -->
    <section class="section" id="lancement">
      <div class="container">
        <p class="eyebrow">{LAUNCH.eyebrow}</p>
        <h2 class="section-title">Nous ouvrons avec un <em>nombre limité</em> de commerces</h2>
        <div class="split">
          <div>
            {LAUNCH.notes.map((n) => <p class="split-note">{n}</p>)}
            <p class="split-note">
              <a class="inline-link" href="/equipe">Voir qui est derrière Nexa Web</a>
            </p>
          </div>
          <ul class="points">
            {
              LAUNCH.terms.map((t) => (
                <li>
                  <strong>{t.title}</strong>
                  {t.text}
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    <!-- Tarifs -->
    <section class="section" id="tarifs">
      <div class="container">
        <p class="eyebrow">Tarifs</p>
        <h2 class="section-title">Des frais de lancement, puis un abonnement</h2>
        <p class="lede">
          Le lancement est facturé une fois. L'abonnement couvre l'hébergement, les mises à jour,
          les modifications et l'accompagnement.
        </p>

        <ul class="pledges">
          {
            PLEDGES.map((p) => (
              <li>
                <strong>{p.title}</strong>
                {p.text}
              </li>
            ))
          }
        </ul>

        <div class="price-grid">
          <div class="price-card">
            <p class="price-kicker">Frais de lancement</p>
            <p class:list={['price-figure', { 'price-todo': PRICING.setup === null }]}>
              {PRICING.setup === null ? '— — —' : `${PRICING.setup.toLocaleString('fr-FR')} €`}
              <small>une fois</small>
            </p>
            {PRICING.setup === null && <span class="price-todo-note">Montant à définir</span>}
            <p>
              Conception, contenus, mise en ligne, configuration des outils et formation.
              Facturé au démarrage du projet.
            </p>
          </div>

          <div class="price-card">
            <p class="price-kicker">Abonnement</p>
            <p class:list={['price-figure', { 'price-todo': PRICING.monthly === null }]}>
              {PRICING.monthly === null ? '— — —' : `${PRICING.monthly.toLocaleString('fr-FR')} €`}
              <small>par mois</small>
            </p>
            {PRICING.monthly === null && <span class="price-todo-note">Montant à définir</span>}
            <p>
              Hébergement, nom de domaine, sauvegardes, mises à jour, modifications courantes
              et accompagnement.
            </p>
          </div>
        </div>

        <ul class="price-notes">
          {PRICING_NOTES.map((n) => <li><span>{n}</span></li>)}
        </ul>

        {/* Seuil de rentabilite. L'analyse economique est formelle : vendu comme
            un cout technique, l'abonnement est trop cher ; ramene a ce qu'il
            doit rapporter, il est bon marche. Le calcul est une division, pas
            une promesse — et la note dit explicitement qu'il s'agit de chiffre
            d'affaires et non de marge. Sans JavaScript, l'exemple par defaut
            reste lisible et exact. */}
        <div class="seuil" id="seuil" data-mensuel={PRICING.monthly}>
          <p class="seuil-titre">Ce que l'abonnement doit rapporter pour être remboursé</p>
          <p class="seuil-ligne">
            <label for="panier">Si un client vous laisse en moyenne</label>
            <span class="seuil-champ">
              <input id="panier" type="number" min="1" max="10000" step="1" value="25" inputmode="numeric" />
              <span aria-hidden="true">€</span>
            </span>
          </p>
          <p class="seuil-resultat" id="seuil-resultat" aria-live="polite">
            il faut <strong>4 clients de plus par mois</strong> pour couvrir les {PRICING.monthly} €,
            soit environ <strong>1 par semaine</strong>.
          </p>
          <p class="form-note" style="text-align:left">
            Calcul en chiffre d'affaires, pas en marge : selon votre activité, comptez deux à
            trois fois plus pour le bénéfice net. Et les frais de lancement s'amortissent à
            part, sur la première année.
          </p>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section" id="faq">
      <div class="container">
        <p class="eyebrow">Questions</p>
        <h2 class="section-title">Ce qu'on nous demande le plus</h2>
        <div class="faq">
          {
            FAQ.map((f) => (
              <details>
                <summary>{f.q}</summary>
                <p>{f.a}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Contact -->
    <section class="section" id="contact">
      <div class="container">
        <div class="contact-panel">
          <p class="eyebrow" style="justify-content:center">Prendre contact</p>
          <h2 class="section-title" style="max-width:none;margin-inline:auto">
            Un appel de 30 minutes, sans engagement
          </h2>
          <p class="lede" style="margin-inline:auto">
            On regarde ensemble ce que donnent votre site et votre fiche Google aujourd'hui,
            et ce qu'il faudrait pour faire mieux. Vous repartez avec un avis clair,
            même si on ne travaille pas ensemble.
          </p>
          <ContactForm source="accueil" quickbook />
        </div>
      </div>
    </section>
  </main>

  <ActionBar />

  <Footer />
</Base>

<script>
  /* --- Fond video ------------------------------------------------------------
     Trois conditions peuvent l'ecarter, et une quatrieme peut faire echouer la
     lecture : ecran sous 720 px, animations reduites, mode economie de donnees,
     et refus d'autoplay par le navigateur. Aucune ne se voyait : le fond restait
     fixe sans que rien ne l'explique, ni a l'ecran ni dans la console.

     Trois corrections :
     - le refus d'autoplay n'est plus avale silencieusement : la lecture est
       retentee au premier geste du visiteur (clic, touche, defilement) ;
     - chaque mise a l'ecart est ecrite dans la console, avec sa raison ;
     - `?video=1` dans l'URL force le chargement, quelles que soient les
       conditions, pour verifier en deux secondes que le fichier est bon.
     --- */
  const video = document.querySelector<HTMLVideoElement>('.bg-video');
  const calm = window.matchMedia('(prefers-reduced-motion: reduce)');

  if (video) {
    const src = video.dataset.src;
    const force = new URLSearchParams(location.search).has('video');
    /* Marque la racine : la feuille de style s'en sert pour lever le
       `display: none` applique en prefers-reduced-motion. */
    if (force) document.documentElement.dataset.video = 'force';
    let charge = false;

    const raison = (): string | null => {
      if (force) return null;
      if (window.innerWidth <= 720) return "ecran de moins de 720 px : l'affiche suffit et economise 1,2 Mo";
      if (calm.matches) return 'le systeme demande des animations reduites (prefers-reduced-motion)';
      const reseau = (navigator as any).connection;
      if (reseau?.saveData) return 'le navigateur est en mode economie de donnees';
      if (/2g/.test(reseau?.effectiveType ?? '')) return 'connexion estimee en 2G';
      return null;
    };

    /* Autoplay refuse : on retente au premier geste, ce qui leve la restriction
       dans tous les navigateurs. Sans ca, l'echec etait definitif et muet. */
    const relanceAuGeste = () => {
      const relance = () => {
        video.play().catch(() => {});
      };
      ['pointerdown', 'keydown', 'touchstart', 'scroll'].forEach((evt) =>
        window.addEventListener(evt, relance, { once: true, passive: true }),
      );
    };

    const charger = () => {
      if (charge || !src) return;
      const bloquant = raison();
      if (bloquant) return;

      charge = true;
      video.preload = 'auto';
      video.src = src;
      video.load();

      video.addEventListener('error', () => {
        console.warn(`[nexa] fond video : ${src} n'a pas pu etre charge (fichier absent ou codec refuse).`);
      });

      video.play().catch((e) => {
        console.info(`[nexa] fond video : lecture automatique refusee (${e?.name ?? 'erreur'}), relance au premier geste.`);
        relanceAuGeste();
      });
    };

    charger();

    if (!charge) {
      const bloquant = raison();
      if (bloquant) console.info(`[nexa] fond video ecarte — ${bloquant}. Forcer avec ?video=1`);
    }

    /* Un agrandissement de fenetre repasse au-dessus de 720 px. */
    window.addEventListener('resize', charger, { passive: true });
  }

  /* --- Raccourci Calendly : le jour choisi devient un parametre d'URL.
         Si Calendly ignore ces parametres, le lien ouvre la page normale :
         aucune regression possible. --- */
  const jour = document.getElementById('jour') as HTMLInputElement | null;
  const lien = document.getElementById('book-link') as HTMLAnchorElement | null;

  if (jour && lien) {
    const base = lien.href;
    const now = new Date();
    const local = new Date(now.getTime() - now.getTimezoneOffset() * 60000);
    jour.min = local.toISOString().slice(0, 10);

    jour.addEventListener('change', () => {
      if (!jour.value) {
        lien.href = base;
        return;
      }
      const url = new URL(base);
      url.searchParams.set('month', jour.value.slice(0, 7));
      url.searchParams.set('date', jour.value);
      lien.href = url.toString();
    });
  }


  /* --- Seuil de rentabilite : une division, mise a jour a la frappe.
         Le montant vient du HTML (data-mensuel), lui-meme rempli depuis
         PRICING : changer le prix dans la configuration change le calcul. --- */
  const bloc = document.getElementById('seuil');
  const panier = document.getElementById('panier') as HTMLInputElement | null;
  const resultat = document.getElementById('seuil-resultat');
  const mensuel = Number(bloc?.dataset.mensuel ?? 0);

  if (bloc && panier && resultat && mensuel > 0) {
    const calcule = () => {
      const valeur = Number(panier.value);
      if (!Number.isFinite(valeur) || valeur <= 0) {
        resultat.textContent = 'Indiquez un montant pour voir le calcul.';
        return;
      }
      const parMois = Math.ceil(mensuel / valeur);
      const parSemaine = Math.max(1, Math.round(parMois / 4.33));
      resultat.innerHTML =
        `il faut <strong>${parMois} client${parMois > 1 ? 's' : ''} de plus par mois</strong> ` +
        `pour couvrir les ${mensuel} €, soit environ <strong>${parSemaine} par semaine</strong>.`;
    };

    panier.addEventListener('input', calcule);
    calcule();
  }

  /* --- Compteurs du bandeau de chiffres --- */
  const easeOutCubic = (t: number) => 1 - Math.pow(1 - t, 3);

  const values = Array.from(document.querySelectorAll<HTMLElement>('.stat-value'));
  const stats = document.getElementById('stats');

  const runCount = (el: HTMLElement, index: number) => {
    const target = Number(el.dataset.count ?? 0);
    const decimals = Number(el.dataset.decimals ?? 0);
    const suffix = el.dataset.suffix ?? '';
    const duration = 1500 + index * 80;
    const startAt = performance.now() + 480 + index * 90;

    const frame = (now: number) => {
      if (now < startAt) return requestAnimationFrame(frame);
      const t = Math.min((now - startAt) / duration, 1);
      el.textContent = (target * easeOutCubic(t)).toFixed(decimals) + suffix;
      if (t < 1) requestAnimationFrame(frame);
    };
    requestAnimationFrame(frame);
  };

  if (stats && values.length) {
    if (calm.matches) {
      values.forEach((el) => {
        const decimals = Number(el.dataset.decimals ?? 0);
        el.textContent = Number(el.dataset.count ?? 0).toFixed(decimals) + (el.dataset.suffix ?? '');
      });
    } else {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            observer.disconnect();
            values.forEach(runCount);
          });
        },
        { threshold: 0.25 },
      );
      observer.observe(stats);
    }
  }
</script>
