---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import '../styles/global.css';
---
<BaseLayout title="Nexa Web — Agence Web Premium · Carvin" description="Nexa Web conçoit des sites internet sur-mesure pour commerçants et artisans. Livraison en 7 jours. Carvin, Hauts-de-France.">
<style>
/* ── NEON FLOW v2 ── */
:root{--neon-opacity:0.60}
@media(prefers-color-scheme:light){:root:not([data-theme="dark"]){--neon-opacity:0.14}}
:root[data-theme="light"]{--neon-opacity:0.14}
.neon-flow{position:fixed;inset:0;z-index:-1;pointer-events:none;overflow:hidden;opacity:var(--neon-opacity)}
.nf-r{position:absolute;border-radius:50%}
.nf-r4{width:1400px;height:700px;background:radial-gradient(ellipse at 52% 42%,rgba(99,102,241,.20) 0%,rgba(139,92,246,.08) 46%,transparent 68%);top:-250px;right:-320px;animation:r4 45s ease-in-out infinite 18s}
.nf-r1b{width:1300px;height:650px;background:radial-gradient(ellipse at 58% 42%,rgba(139,92,246,.32) 0%,rgba(99,102,241,.11) 48%,transparent 70%);top:-150px;right:-280px;animation:r1b 40s ease-in-out infinite 5s}
.nf-r5{width:800px;height:480px;background:radial-gradient(ellipse,rgba(224,231,255,.12) 0%,rgba(59,130,246,.07) 46%,transparent 66%);bottom:-80px;right:12%;animation:r5 42s ease-in-out infinite 26s}
.nf-r1{width:1100px;height:155px;background:radial-gradient(ellipse at 50% 50%,rgba(139,92,246,.90) 0%,rgba(99,102,241,.55) 32%,rgba(99,102,241,.18) 62%,transparent 80%);top:4vh;right:-220px;animation:r1 30s ease-in-out infinite}
.nf-r2{width:900px;height:100px;background:radial-gradient(ellipse at 50% 50%,rgba(59,130,246,.82) 0%,rgba(37,99,235,.48) 35%,rgba(99,102,241,.16) 65%,transparent 82%);top:30vh;right:-120px;animation:r2 38s ease-in-out infinite 9s}
.nf-r3{width:460px;height:68px;background:radial-gradient(ellipse at 50% 50%,rgba(217,70,239,.62) 0%,rgba(139,92,246,.28) 48%,transparent 72%);top:8vh;right:6vw;animation:r3 22s ease-in-out infinite 2s}
@keyframes r1{0%,100%{transform:translate3d(0,0,0) rotate(-32deg) scaleX(1)}25%{transform:translate3d(-52px,44px,0) rotate(-29deg) scaleX(1.06)}50%{transform:translate3d(-82px,-18px,0) rotate(-35deg) scaleX(.96)}75%{transform:translate3d(28px,58px,0) rotate(-30deg) scaleX(1.04)}}
@keyframes r1b{0%,100%{transform:translate3d(0,0,0) scale(1)}50%{transform:translate3d(-65px,42px,0) scale(1.07)}}
@keyframes r2{0%,100%{transform:translate3d(0,0,0) rotate(-18deg) scaleX(1)}33%{transform:translate3d(62px,-72px,0) rotate(-15deg) scaleX(1.12)}66%{transform:translate3d(-42px,52px,0) rotate(-21deg) scaleX(.91)}}
@keyframes r3{0%,100%{transform:translate3d(0,0,0) rotate(-44deg) scaleX(1)}40%{transform:translate3d(-38px,-62px,0) rotate(-40deg) scaleX(1.22)}80%{transform:translate3d(22px,28px,0) rotate(-47deg) scaleX(.86)}}
@keyframes r4{0%,100%{transform:translate3d(0,0,0) scale(1)}45%{transform:translate3d(-52px,-32px,0) scale(1.05)}80%{transform:translate3d(42px,52px,0) scale(.96)}}
@keyframes r5{0%,100%{transform:translate3d(0,0,0) scale(1)}50%{transform:translate3d(52px,-42px,0) scale(1.10)}}
@media(max-width:768px){.nf-r1{width:600px;height:100px}.nf-r1b{width:700px;height:380px}.nf-r2{width:500px;height:72px}.nf-r3,.nf-r5{display:none}.nf-r4{width:800px;height:420px}}
@media(prefers-reduced-motion:reduce){.nf-r1,.nf-r1b,.nf-r2,.nf-r3,.nf-r4,.nf-r5{animation:none!important}}

/* ── LOADING SCREEN ── */
#loader{position:fixed;inset:0;background:#050509;z-index:9999;display:flex;align-items:center;justify-content:center}
#loader.ld-exit{opacity:0;transform:scale(1.06);transition:opacity .85s cubic-bezier(.4,0,.6,1),transform .85s cubic-bezier(.4,0,.6,1);pointer-events:none}
.ld-inner{display:flex;flex-direction:column;align-items:center;text-align:center;user-select:none;gap:0}
.ld-brand{font-size:11px;font-weight:700;letter-spacing:.30em;text-transform:uppercase;color:rgba(232,232,242,.82);margin-bottom:52px;opacity:0;transform:translateY(10px);animation:ldfade .55s cubic-bezier(.16,1,.3,1) .08s forwards}
.ld-brand b{color:rgba(232,232,242,.30);font-weight:700}
.ld-nucleus-wrap{position:fixed;inset:0;z-index:0}
#nucleus-cv{display:block;width:100%;height:100%}
.ld-inner{position:relative;z-index:1}
.ld-status{font-size:8.5px;font-weight:500;letter-spacing:.24em;text-transform:uppercase;color:rgba(232,232,242,.40);margin-bottom:14px;opacity:0;animation:ldfade .55s cubic-bezier(.16,1,.3,1) .30s forwards}
.ld-pct{font-size:clamp(2.2rem,8vw,3.4rem);font-weight:900;letter-spacing:-.04em;font-variant-numeric:tabular-nums;color:rgba(232,232,242,.92);margin-bottom:18px;line-height:1;opacity:0;animation:ldfade .55s cubic-bezier(.16,1,.3,1) .36s forwards}
.ld-bar-track{width:180px;height:1px;background:rgba(255,255,255,.07);margin-bottom:30px;overflow:hidden;opacity:0;animation:ldfade .55s cubic-bezier(.16,1,.3,1) .42s forwards}
.ld-bar-fill{height:100%;width:0%;background:linear-gradient(90deg,#8B5CF6 0%,#6366F1 52%,#3B82F6 100%)}
.ld-caption{font-size:8.5px;font-weight:500;letter-spacing:.26em;text-transform:uppercase;color:rgba(232,232,242,.20);opacity:0;animation:ldfade .5s cubic-bezier(.16,1,.3,1) .48s forwards}
@keyframes ldfade{to{opacity:1;transform:none}}
@media(prefers-reduced-motion:reduce){#loader{display:none}}

/* ── HERO ── */
.s-hero{min-height:100svh;display:flex;flex-direction:column;padding-top:var(--hdr)}
.hero-main{flex:1;display:flex;flex-direction:column;justify-content:center;padding:clamp(40px,8vh,100px) 0}
.hero-eye{display:flex;align-items:center;gap:12px;margin-bottom:clamp(24px,4vh,48px);opacity:0;transform:translateY(14px);animation:fu .6s cubic-bezier(.16,1,.3,1) .2s forwards}
.hero-dot{width:6px;height:6px;border-radius:50%;background:var(--text-muted)}
.h-xl em{font-style:italic;font-weight:800;color:var(--text-muted)}
.hero-hl{margin-bottom:clamp(24px,4vh,52px);overflow:hidden;width:100%;text-wrap:wrap;overflow-wrap:anywhere}
.hero-hl .ln{display:block;overflow:hidden}
.hero-hl .li{display:block;transform:translateY(110%);animation:su .85s cubic-bezier(.16,1,.3,1) forwards}
.hero-hl .ln:nth-child(1) .li{animation-delay:.4s}
.hero-hl .ln:nth-child(2) .li{animation-delay:.56s}
.hero-hl .ln:nth-child(3) .li{animation-delay:.72s}
.hero-sub{margin-bottom:clamp(28px,5vh,52px);opacity:0;animation:fu .6s cubic-bezier(.16,1,.3,1) .95s forwards}
.hero-ctas{display:flex;flex-wrap:wrap;gap:12px;opacity:0;animation:fu .6s cubic-bezier(.16,1,.3,1) 1.1s forwards}
.hero-foot{display:flex;align-items:center;gap:12px;padding:22px 0;border-top:1px solid var(--border);opacity:0;animation:fu .5s cubic-bezier(.16,1,.3,1) 1.3s forwards}
.hero-line{width:40px;height:1px;background:var(--text-dim)}
.hero-cols .hero-main{flex:0 0 auto;width:clamp(340px,52%,640px);min-width:0}
@media(max-width:900px){.hero-cols .hero-main{width:100%}}
@keyframes su{to{transform:translateY(0)}}
@keyframes fu{to{opacity:1;transform:translateY(0)}}
@media(prefers-reduced-motion:reduce){.hero-eye,.hero-hl .li,.hero-sub,.hero-ctas,.hero-foot{animation:none!important;opacity:1!important;transform:none!important}}

/* ── PHILOSOPHY ── */
.s-phil{border-top:1px solid var(--border)}
.phil-in{display:grid;grid-template-columns:1fr 2fr;gap:clamp(32px,6vw,120px);align-items:start}
.phil-txt{font-size:clamp(1.5rem,3.5vw,3.4rem);font-weight:700;line-height:1.15;letter-spacing:-.025em}
.phil-txt span{color:var(--text-muted)}
@media(max-width:700px){.phil-in{grid-template-columns:1fr;gap:22px}}

/* ── SERVICES ── */
.s-svc{border-top:1px solid var(--border)}
.svc-hdr{display:flex;justify-content:space-between;align-items:flex-end;flex-wrap:wrap;gap:24px;margin-bottom:clamp(36px,6vh,72px)}
.svc-list{border-top:1px solid var(--border)}
.svc-row{display:grid;grid-template-columns:52px 1fr auto;align-items:center;gap:20px;padding:clamp(16px,2.5vh,26px) 0;border-bottom:1px solid var(--border);position:relative;overflow:hidden;cursor:pointer;text-decoration:none;color:inherit}
.svc-row::before{content:'';position:absolute;inset:0;background:var(--bg-alt);transform:translateX(-100%);transition:transform .45s cubic-bezier(.16,1,.3,1);z-index:0}
.svc-row:hover::before{transform:translateX(0)}
.svc-row>*{position:relative;z-index:1}
.svc-n{font-size:9.5px;font-weight:500;letter-spacing:.12em;color:var(--text-dim);font-variant-numeric:tabular-nums}
.svc-name{font-size:clamp(1rem,2.5vw,2rem);font-weight:700;letter-spacing:-.02em}
.svc-meta{display:flex;align-items:center;gap:16px;color:var(--text-muted)}
.svc-tag{font-size:9px;font-weight:500;letter-spacing:.14em;text-transform:uppercase;color:var(--text-dim)}
.svc-arr{font-size:1.1rem;transition:transform .3s cubic-bezier(.16,1,.3,1);color:var(--text-muted)}
.svc-row:hover .svc-arr{transform:translateX(7px)}
@media(max-width:600px){.svc-tag{display:none}}

/* ── PROCESS ── */
.s-proc{border-top:1px solid var(--border)}
.proc-hdr{margin-bottom:clamp(36px,6vh,72px)}
.proc-grid{display:grid;grid-template-columns:repeat(4,1fr);border:1px solid var(--border)}
.proc-step{padding:clamp(22px,4vw,48px);border-right:1px solid var(--border)}
.proc-step:last-child{border-right:none}
.proc-n{font-size:9.5px;font-weight:500;letter-spacing:.14em;color:var(--text-dim);margin-bottom:36px;font-variant-numeric:tabular-nums}
.proc-title{font-size:clamp(.95rem,1.8vw,1.4rem);font-weight:700;letter-spacing:-.02em;margin-bottom:10px}
.proc-desc{font-size:13px;font-weight:300;line-height:1.68;color:var(--text-muted)}
@media(max-width:860px){.proc-grid{grid-template-columns:repeat(2,1fr)}.proc-step:nth-child(2){border-right:none}.proc-step:nth-child(n+3){border-top:1px solid var(--border)}.proc-step:nth-child(4){border-right:none}}
@media(max-width:480px){.proc-grid{grid-template-columns:1fr}.proc-step{border-right:none;border-top:1px solid var(--border)}.proc-step:first-child{border-top:none}}

/* ── WHY ── */
.s-why{border-top:1px solid var(--border);background:var(--bg-alt)}
.why-in{display:grid;grid-template-columns:1fr 1fr;gap:clamp(40px,8vw,120px);align-items:start}
.why-bio{display:flex;flex-direction:column;gap:18px;padding:4px 0}
.why-bio-lead{font-size:clamp(1.35rem,2.4vw,1.9rem);font-weight:800;line-height:1.18;letter-spacing:-.03em;color:var(--text)}
.why-bio-body{font-size:13px;font-weight:300;line-height:1.72;color:var(--text-muted)}
.why-bio-cta{display:inline-flex;align-items:center;gap:8px;margin-top:8px;font-size:11px;font-weight:700;letter-spacing:.13em;text-transform:uppercase;color:var(--text);border-bottom:1px solid var(--border-hi);padding-bottom:4px;transition:color .2s,border-color .2s;align-self:flex-start}
.why-bio-cta:hover{color:var(--text);border-color:var(--text)}
@media(max-width:720px){.why-in{grid-template-columns:1fr}}

/* ── STATS ── */
.s-stats{border-top:1px solid var(--border)}
.stats-grid{display:grid;grid-template-columns:repeat(3,1fr);border:1px solid var(--border)}
.stat{padding:clamp(28px,6vw,64px);border-right:1px solid var(--border);text-align:center}
.stat:last-child{border-right:none}
.stat-val{font-size:clamp(2.8rem,6vw,6rem);font-weight:900;letter-spacing:-.04em;line-height:1;margin-bottom:10px;font-variant-numeric:tabular-nums}
.stat-lbl{font-size:10.5px;font-weight:500;letter-spacing:.16em;text-transform:uppercase;color:var(--text-muted)}
@media(max-width:500px){.stats-grid{grid-template-columns:1fr}.stat{border-right:none;border-bottom:1px solid var(--border)}.stat:last-child{border-bottom:none}}

/* ── FAQ ── */
.s-faq{border-top:1px solid var(--border)}
.faq-in{display:grid;grid-template-columns:1fr 1.8fr;gap:clamp(40px,8vw,120px)}
.faq-side p{margin-top:20px;font-size:13px}
.faq-list{border-top:1px solid var(--border)}
.faq-item{border-bottom:1px solid var(--border)}
.faq-q{display:flex;justify-content:space-between;align-items:center;width:100%;text-align:left;padding:21px 0;font-size:clamp(.88rem,1.4vw,1.02rem);font-weight:600;letter-spacing:-.01em;gap:16px;cursor:pointer;color:var(--text)}
.faq-q:focus-visible{outline:2px solid var(--text);border-radius:2px}
.faq-ind{flex-shrink:0;width:23px;height:23px;border:1px solid var(--border-hi);border-radius:50%;font-size:14px;display:flex;align-items:center;justify-content:center;color:var(--text-muted);transition:transform .3s,border-color .3s}
.faq-item.open .faq-ind{transform:rotate(45deg);border-color:var(--text-muted)}
.faq-a{max-height:0;overflow:hidden;transition:max-height .4s cubic-bezier(.16,1,.3,1)}
.faq-a-in{padding-bottom:22px;font-size:13.5px;font-weight:300;line-height:1.75;color:var(--text-muted)}
@media(max-width:700px){.faq-in{grid-template-columns:1fr}}

/* ── CTA ── */
.s-cta{border-top:1px solid var(--border);text-align:center}
.cta-in{max-width:900px;margin:0 auto;padding:clamp(80px,15vw,180px) 0}
.cta-super{font-size:clamp(.6rem,1vw,.75rem);font-weight:600;letter-spacing:.22em;text-transform:uppercase;color:var(--text-dim);margin-bottom:32px}
.cta-hl{font-size:clamp(3rem,8vw,9.5rem);font-weight:900;line-height:.92;letter-spacing:-.04em;margin-bottom:48px;text-wrap:balance}
.cta-hl em{font-style:italic;font-weight:800}
.cta-btn{display:inline-flex;align-items:center;gap:12px;background:var(--btn-bg);color:var(--btn-text);font-size:12px;font-weight:700;letter-spacing:.15em;text-transform:uppercase;padding:18px 40px;border-radius:2px;transition:opacity .2s,transform .3s cubic-bezier(.16,1,.3,1)}
.cta-btn:hover{opacity:.84;transform:translateY(-2px)}
.cta-btn:focus-visible{outline:2px solid var(--text);outline-offset:4px}
.cta-arr{display:inline-block;transition:transform .25s}
.cta-btn:hover .cta-arr{transform:translateX(5px)}

/* ── SECTIONS skip render ── */
.s-phil,.s-svc,.s-proc,.s-why,.s-stats,.s-faq,.s-cta,.s-foot{content-visibility:auto;contain-intrinsic-size:0 500px}
</style>

<!-- Neon Flow -->
<div class="neon-flow" aria-hidden="true" role="presentation">
  <div class="nf-r nf-r4"></div>
  <div class="nf-r nf-r1b"></div>
  <div class="nf-r nf-r5"></div>
  <div class="nf-r nf-r1"></div>
  <div class="nf-r nf-r2"></div>
  <div class="nf-r nf-r3"></div>
</div>

<!-- Loading Screen -->
<div id="loader" role="status" aria-live="polite" aria-label="Chargement Nexa Web">
  <div class="ld-nucleus-wrap" aria-hidden="true">
    <canvas id="nucleus-cv"></canvas>
  </div>
  <div class="ld-inner">
    <div class="ld-brand">NEXA<b>WEB</b></div>
    <p class="ld-status">INITIALISATION...</p>
    <div class="ld-pct" id="ld-pct" aria-hidden="true">00%</div>
    <div class="ld-bar-track" aria-hidden="true">
      <div class="ld-bar-fill" id="ld-bar"></div>
    </div>
    <div class="ld-caption" aria-hidden="true">CRAFTING DIGITAL EXPERIENCES</div>
  </div>
</div>

<Header />

<main id="main-content">

<!-- HERO -->
<section class="s-hero" id="accueil" aria-label="Accueil">
  <div class="wrap hero-cols">
    <div class="hero-main">
      <div class="hero-eye" aria-hidden="true">
        <div class="hero-dot"></div>
        <span class="label">Agence web premium · Carvin</span>
      </div>
      <h1 class="h-xl hero-hl">
        <span class="ln"><span class="li">Des sites web qui</span></span>
        <span class="ln"><span class="li">donnent une <em>nouvelle</em></span></span>
        <span class="ln"><span class="li">dimension à votre marque.</span></span>
      </h1>
      <p class="body hero-sub" style="max-width:480px">
        Nexa Web conçoit des expériences digitales modernes, rapides et sur mesure pour les entreprises qui veulent se démarquer.
      </p>
      <div class="hero-ctas">
        <a href="/devis" class="btn">Démarrer un projet <span aria-hidden="true">→</span></a>
        <a href="/avis" class="btn-g">Nos avis clients</a>
      </div>
    </div>
  </div>
  <div class="wrap">
    <div class="hero-foot" aria-hidden="true">
      <div class="hero-line"></div>
      <span class="label">Défiler pour découvrir</span>
    </div>
  </div>
</section>

<!-- PHILOSOPHY -->
<section class="s-phil" style="padding:var(--sec) 0" id="apropos" aria-labelledby="phil-h">
  <div class="wrap">
    <div class="phil-in">
      <div class="r"><span class="label" id="phil-h">Notre vision</span></div>
      <p class="phil-txt r d1">
        Votre site n'est pas simplement une vitrine. C'est le <span>premier contact</span> entre votre marque et votre futur client. Chaque détail compte. Chaque pixel est une décision.
      </p>
    </div>
  </div>
</section>

<!-- SERVICES -->
<section class="s-svc" style="padding:var(--sec) 0" id="services" aria-labelledby="svc-h">
  <div class="wrap">
    <div class="svc-hdr r">
      <div>
        <span class="label" id="svc-h">Ce que nous créons</span>
        <h2 class="h-lg" style="margin-top:14px">Nos services</h2>
      </div>
      <p class="body" style="max-width:300px;text-align:right">Chaque prestation est pensée pour maximiser l'impact de votre présence en ligne.</p>
    </div>
    <div class="svc-list">
      <a href="/site-vitrine" class="svc-row r">
        <span class="svc-n" aria-hidden="true">01</span>
        <span class="svc-name">Site vitrine</span>
        <div class="svc-meta"><span class="svc-tag">Essentiel</span><span class="svc-arr" aria-hidden="true">→</span></div>
      </a>
      <a href="/ecommerce" class="svc-row r d1">
        <span class="svc-n" aria-hidden="true">02</span>
        <span class="svc-name">Site e-commerce</span>
        <div class="svc-meta"><span class="svc-tag">Conversion</span><span class="svc-arr" aria-hidden="true">→</span></div>
      </a>
      <a href="/refonte" class="svc-row r d2">
        <span class="svc-n" aria-hidden="true">03</span>
        <span class="svc-name">Refonte de site</span>
        <div class="svc-meta"><span class="svc-tag">Modernisation</span><span class="svc-arr" aria-hidden="true">→</span></div>
      </a>
      <a href="/design-uiux" class="svc-row r d3">
        <span class="svc-n" aria-hidden="true">04</span>
        <span class="svc-name">Design UI/UX</span>
        <div class="svc-meta"><span class="svc-tag">Expérience</span><span class="svc-arr" aria-hidden="true">→</span></div>
      </a>
      <a href="/seo" class="svc-row r d4">
        <span class="svc-n" aria-hidden="true">05</span>
        <span class="svc-name">Optimisation SEO &amp; Performance</span>
        <div class="svc-meta"><span class="svc-tag">Visibilité</span><span class="svc-arr" aria-hidden="true">→</span></div>
      </a>
    </div>
  </div>
</section>

<!-- PROCESS -->
<section class="s-proc" style="padding:var(--sec) 0" aria-labelledby="proc-h">
  <div class="wrap">
    <div class="proc-hdr r">
      <span class="label" id="proc-h">De l'idée au site en ligne</span>
      <h2 class="h-lg" style="margin-top:14px">Notre méthode</h2>
    </div>
    <div class="proc-grid">
      <div class="proc-step r"><div class="proc-n">01</div><div class="proc-title">Découverte</div><p class="proc-desc">Nous apprenons à connaître votre activité, vos objectifs et votre audience pour concevoir une stratégie digitale sur mesure.</p></div>
      <div class="proc-step r d1"><div class="proc-n">02</div><div class="proc-title">Direction artistique</div><p class="proc-desc">Création d'une identité visuelle cohérente, des maquettes aux prototypes interactifs, validés à chaque étape.</p></div>
      <div class="proc-step r d2"><div class="proc-n">03</div><div class="proc-title">Développement</div><p class="proc-desc">Code propre, performant et maintenable. Optimisé pour la vitesse, le référencement et tous les appareils.</p></div>
      <div class="proc-step r d3"><div class="proc-n">04</div><div class="proc-title">Mise en ligne</div><p class="proc-desc">Déploiement soigné, tests complets et formation à la gestion de votre site. Nous restons disponibles après le lancement.</p></div>
    </div>
  </div>
</section>

<!-- WHY -->
<section class="s-why" style="padding:var(--sec) 0" id="apropos2" aria-labelledby="why-h">
  <div class="wrap">
    <div class="why-in">
      <div>
        <span class="label r" id="why-h">Pourquoi Nexa Web</span>
