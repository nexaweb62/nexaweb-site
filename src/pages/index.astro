<!-- PROCESS — sequence epinglee.
     .procwrap est HORS de la <section>, juste apres : c'est lui qui
     porte la view-timeline, et un ancetre en overflow hidden/auto
     casserait le position:sticky de .procpin. -->
<section class="s-proc sec-seam" style="padding:var(--sec) 0 0" aria-labelledby="proc-h">
  <div class="wrap">
    <div class="proc-hdr r">
      <h2 class="h-lg" id="proc-h" data-i18n="idx-proc-h">Notre méthode.</h2>
    </div>
  </div>
</section>
<div class="procwrap">
  <div class="procpin">
    <div class="wrap" style="width:100%">
      <div class="procstack">
        <div class="proc-step"><span class="k">01</span>
          <h3 class="proc-title" data-i18n="idx-proc-t1">Découverte</h3>
          <p class="proc-desc" data-i18n="idx-proc-d1">Un appel pour comprendre votre activité, vos clients, et ce qu'ils doivent trouver sur votre site.</p></div>
        {/* Dossier 01 — les intitulés du formulaire de devis
            (src/pages/devis.astro), avec les clés qu'il utilise. */}
        <article class="dossier" aria-labelledby="dos1-t">
          <h4 class="dos-t" id="dos1-t" data-i18n="idx-dos1-t">Ce que le devis vous demande</h4>
          <p class="dos-st" data-i18n="sec1">Vos coordonnées</p>
          <p class="dos-ligne" data-i18n="idx-dos1-coord">Prénom, nom, e-mail, téléphone, entreprise / activité</p>
          <p class="dos-st" data-i18n="sec2">Votre projet</p>
          <ul class="dos-liste">
            <li data-i18n="type">Type de site</li>
            <li data-i18n="delai">Délai souhaité</li>
            <li data-i18n="dvs-paiement">Paiement</li>
            <li data-i18n="budget">Budget estimé</li>
            <li data-i18n="desc">Décrivez votre projet</li>
            <li data-i18n="siteActuel">Avez-vous un site existant ?</li>
          </ul>
          <p class="dos-pied"><a class="dos-lien" href="/devis" data-i18n="idx-dos1-lien">Ouvrir le formulaire de devis</a></p>
        </article>

        <div class="proc-step"><span class="k">02</span>
          <h3 class="proc-title" data-i18n="idx-proc-t2">Direction artistique</h3>
          <p class="proc-desc" data-i18n="idx-proc-d2">Création d'une identité visuelle cohérente, des maquettes aux prototypes interactifs, validés à chaque étape.</p></div>
        {/* Dossier 02 — ce que le client reçoit à cette étape : la maquette et
            la garantie, telles qu'écrites dans les CGV (cgv-p2, cgv-p3) et
            sur /tarifs (gar-p1, gar-p2). */}
        <article class="dossier" aria-labelledby="dos2-t">
          <h4 class="dos-t" id="dos2-t" data-i18n="idx-dos2-t">Ce que vous recevez</h4>
          <ul class="dos-liste">
            <li data-i18n="idx-dos2-l1">La maquette de votre site, à valider avant le développement</li>
            <li data-i18n="idx-dos2-l2">14 jours pour la valider, à partir de sa présentation</li>
            <li data-i18n="idx-dos2-l3">2 séries de retouches comprises dans le prix</li>
            <li data-i18n="idx-dos2-l4">Si elle ne vous convient toujours pas, l'acompte vous est remboursé</li>
          </ul>
          <p class="dos-pied"><a href="/cgv" data-i18n="idx-dos2-pied">Les conditions de la garantie</a></p>
        </article>

        <div class="proc-step"><span class="k">03</span>
          <h3 class="proc-title" data-i18n="idx-proc-t3">Développement</h3>
          <p class="proc-desc" data-i18n="idx-proc-d3">Code propre, performant et maintenable. Optimisé pour la vitesse, le référencement et tous les appareils.</p></div>
        {/* Dossier 03 — la mesure de cette page (src/data/mesures.ts). */}
        <article class="dossier" aria-labelledby="gr-mes-t">
          <Mesure {...MESURE_ACCUEIL} compact />
        </article>

        <div class="proc-step"><span class="k">04</span>
          <h3 class="proc-title" data-i18n="idx-proc-t4">Mise en ligne</h3>
          <p class="proc-desc" data-i18n="idx-proc-d4">Déploiement soigné, tests complets et formation à la gestion de votre site. Nous restons disponibles après le lancement.</p></div>
        {/* Dossier 04 — délais : formules.ts et /site-vitrine ; ce qui
            est livré : /comment-ca-marche (étape 5), cette page (étape 04
            et FAQ), /tarifs (Vitrine Pro). */}
        <article class="dossier" aria-labelledby="dos4-t">
          <h4 class="dos-t" id="dos4-t" data-i18n="idx-dos4-t">Délais de mise en ligne</h4>
          <dl class="dos-delais">
            <div class="dos-d">
              <dt data-i18n="trf-p4-name">Refonte de site</dt>
              <dd>
                <span class="dos-piste" style={`--l:${pctSem(REFONTE.delaiSemaines)}`} aria-hidden="true"><span class="dos-barre" style="--f:1"></span></span>
                <span class="dos-val"><span>{REFONTE.delaiSemaines}</span> <span data-i18n="idx-dos4-sem">semaines</span></span>
              </dd>
            </div>
            <div class="dos-d">
              <dt data-i18n="trf-p2-name">Vitrine Pro</dt>
              <dd>
                <span class="dos-piste" style={`--l:${pctSem(VP_MAX)}`} aria-hidden="true"><span class="dos-barre dos-barre-min" style={`--f:${VP_MIN}`}></span><span class="dos-barre dos-barre-max" style={`--f:${VP_MAX - VP_MIN}`}></span></span>
                <span class="dos-val" data-i18n="idx-dos4-vp">2 à 4 semaines</span>
              </dd>
            </div>
          </dl>
          <p class="dos-st" data-i18n="idx-dos4-livre">À la mise en ligne</p>
          <ul class="dos-liste">
            <li data-i18n="idx-dos4-l1">Tests sur tous les appareils</li>
            <li data-i18n="idx-dos4-l2">Déploiement sur votre nom de domaine</li>
            <li data-i18n="idx-dos4-l3">Formation à la gestion de votre site</li>
            <li data-i18n="idx-dos4-l4">1 mois de support inclus avec la Vitrine Pro</li>
          </ul>
          <p class="dos-pied" data-i18n="idx-dos4-depart">Délais comptés à partir de la validation du brief. La partie hachurée dépend du nombre de retours sur la maquette.</p>
        </article>

        <div class="procticks" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
      </div>
    </div>
  </div>
</div>

<!-- WHY -->
<section class="s-why sec-seam" style="padding:var(--sec) 0" id="apropos" aria-labelledby="why-h">
  <div class="wrap">
    <div class="why-in">
      <div>
        <h2 class="h-lg" id="why-h" data-i18n="idx-why-h">Les deux personnes<br>qui feront votre site.</h2>
        <p class="body r d2" style="margin-top:22px;max-width:380px" data-i18n="idx-why-sub">Nous ne faisons pas dans la quantité. Chaque projet reçoit une attention totale, de la stratégie à la mise en ligne.</p>
        <div class="fond r d3">
          <ul class="fond-liste">
            {FONDATEURS.map((f, i) => (
              <li>
                <picture class={`fond-photo fond-p${i + 1}`}>
                  <source type="image/avif" srcset={f.avif} sizes="96px" />
                  <source type="image/webp" srcset={f.webp} sizes="96px" />
                  <img src={f.src} srcset={f.jpg} sizes="96px" width="96" height="120"
                       alt={f.alt} data-i18n-alt={f.altCle} loading="lazy" decoding="async" />
                </picture>
                <p class="fond-nom" data-i18n={f.prenomCle}>{f.prenom}</p>
                <p class="fond-role" data-i18n="eq-role">Co-fondateur</p>
                <p class="fond-role" data-i18n={f.speCle}>{f.spe}</p>
              </li>
            ))}
          </ul>
          <a class="dos-lien fond-lien" href="/equipe" data-i18n="idx-fond-lien">Voir l'équipe</a>
        </div>
      </div>
      <div class="why-bio r d1">
        <p class="why-bio-lead" data-i18n="idx-why-lead">Une agence jeune, des ambitions sérieuses.</p>
        <p class="why-bio-body" data-i18n="idx-why-b1">Nexa Web, ce sont ses deux fondateurs, Imad et Ahmed, partis d'une idée simple : une petite entreprise mérite un site aussi soigné que celui d'une grande marque, à un prix qu'elle peut payer.</p>
        <p class="why-bio-body" data-i18n="idx-why-b2">Nous démarrons notre aventure sans catalogue de réalisations. Pas parce que nous manquons de compétences, mais parce que nous avons choisi de ne pas gonfler un portfolio avec des projets fictifs. Ce que nous offrons à la place, c'est une implication totale : chaque ligne de code, chaque détail de design, pensés uniquement pour vous.</p>
        <p class="why-bio-body" data-i18n="idx-why-b3">Nos premiers clients bénéficient d'une attention rare — celle qu'une agence qui n'a pas encore cent projets en parallèle peut vraiment offrir.</p>
        <!-- La promesse qui rassure le plus se tient à côté de l'appel
             à l'action, pas en bas du formulaire de devis. -->
        <GarantieBadge class="why-gar" />
        <InteractiveButton text="Être parmi les premiers" href="/devis" class="why-bio-cta" data-i18n="idx-why-cta" />
      </div>
    </div>
  </div>
</section>

<!-- LE SIMULATEUR — à la place de la rangée « 100 % / 24/7 / ∞ ».
     Aucune statistique : un calcul fait avec les chiffres du visiteur. -->
<section class="s-sim sec-seam" style="padding:var(--sec) 0" id="calcul" aria-labelledby="sim-h">
  <div class="wrap">
    <h2 class="h-lg sim-h" id="sim-h" data-i18n="idx-sim-h">Votre site, remboursé en combien de mois&nbsp;?</h2>
