<script is:inline>
(function(){
  'use strict';

  /* Le hero ne s'efface plus au défilement : il reste lisible tant qu'il
     est à l'écran. Les révélations sont gérées par /motion.js. */

  /* ── FAQ : ouverture en douceur, une seule a la fois ──
     Plus aucune hauteur mesuree : c'est .panel{grid-template-rows}
     qui fait le depliage, donc aucun saut quand le texte change de
     longueur ou quand la langue bascule. */
  (function(){
    var items = [].slice.call(document.querySelectorAll('.qa'));
    items.forEach(function(it){
      var b = it.querySelector('.q');
      if(!b) return;
      b.addEventListener('click', function(){
        var open = it.classList.contains('open');
        items.forEach(function(o){
          o.classList.remove('open');
          o.querySelector('.q').setAttribute('aria-expanded','false');
        });
        if(!open){ it.classList.add('open'); b.setAttribute('aria-expanded','true'); }
      });
    });
  })();

  /* ── Smooth anchor scroll ── */
  document.addEventListener('click',function(e){
    var a=e.target.closest('a[href^="#"]');
    if(!a)return;
    var tgt=document.querySelector(a.getAttribute('href'));
    if(!tgt)return;
    e.preventDefault();
    window.scrollTo({top:tgt.getBoundingClientRect().top+window.scrollY-80,behavior:'smooth'});
  });
})();
</script>

<script is:inline>
/* ── OAuth callback (Supabase redirect) ── */
(function(){
  var hasCode=window.location.search.indexOf('code=')!==-1;
  var hasToken=window.location.hash.indexOf('access_token=')!==-1;
  if(!hasCode&&!hasToken)return;
  function loadScript(src,cb){var s=document.createElement('script');s.src=src;s.onload=cb;document.head.appendChild(s);}
  loadScript('https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2',function(){
    loadScript('/supabase-client.js',function(){
      if(!window.sb)return;
      window.sb.auth.onAuthStateChange(function(event,session){
        if((event==='SIGNED_IN'||event==='INITIAL_SESSION')&&session){
          window.location.replace('/espace-client');
        }
      });
    });
  });
})();
</script>

