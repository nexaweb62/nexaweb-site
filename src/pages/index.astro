<script is:inline>
/* ── LOADING SCREEN ── */
(function initLoader(){
  'use strict';
  var ld=document.getElementById('loader');
  if(!ld)return;
  if(sessionStorage.getItem('nxa-ld')){ld.remove();return;}
  if(window.matchMedia('(prefers-reduced-motion:reduce)').matches||
     window.matchMedia('(max-width:768px)').matches){
    sessionStorage.setItem('nxa-ld','1');ld.remove();return;
  }
  var pctEl=document.getElementById('ld-pct');
  var barEl=document.getElementById('ld-bar');
  var rafP,tStart;
  var DURATION=1400;
  function ease(t){return t<.5?2*t*t:-1+(4-2*t)*t;}
  function stepProgress(ts){
    if(!tStart)tStart=ts;
    var raw=Math.min((ts-tStart)/DURATION,1);
    var pct=Math.round(ease(raw)*100);
    pctEl.textContent=(pct<10?'0':'')+pct+'%';
    barEl.style.width=pct+'%';
    if(raw<1){rafP=requestAnimationFrame(stepProgress);}
    else{setTimeout(exitLoader,180);}
  }
  setTimeout(function(){rafP=requestAnimationFrame(stepProgress);},100);
  function exitLoader(){
    cancelAnimationFrame(rafP);
    sessionStorage.setItem('nxa-ld','1');
    ld.classList.add('ld-exit');
    setTimeout(function(){ld.remove();},900);
  }
})();
</script>

<script is:inline>
/* ── NUCLEUS WebGL2 SHADER ── */
(function(){
  'use strict';
  var cv=document.getElementById('nucleus-cv');
  if(!cv)return;
  setTimeout(function(){
    var gl=cv.getContext('webgl2');
    if(!gl)return;
    var VS='#version 300 es\nprecision highp float;\nlayout(location=0) in vec2 a_pos;\nout vec2 v_uv;\nvoid main(){v_uv=a_pos*.5+.5;gl_Position=vec4(a_pos,0.,1.);}';
    var FS='#version 300 es\nprecision lowp float;\nout vec4 fragColor;\nin vec2 v_uv;\nuniform vec3 iResolution;\nuniform float iTime;\nuniform int iFrame;\nuniform vec4 iMouse;\nvoid mainImage(out vec4 fc,in vec2 coord){\nvec2 r=iResolution.xy;\nfloat t=iTime;\nvec3 FC=vec3(coord,t);\nvec4 o=vec4(0.);\nvec3 p,a;\nfloat z=0.,d=0.;\nfor(float i=0.;i<20.;i++){\np=z*normalize(FC.rgb*2.-r.xyy);\na=normalize(cos(vec3(4.,2.,0.)+t-d*10.));\np.z+=8.;\na=a*dot(a,p)-cross(a,p);\nfor(float k=1.;k<4.;k+=1.)a+=sin(a*k+t).yzx/k;\nd=abs(length(a)-5.)/6.;\nz+=d;\no+=vec4(5.,2.,9.,0.)/max(d,1e-4)/9e4;\n}\nfc=vec4(o.rgb,1.);\n}\nvoid main(){mainImage(fragColor,gl_FragCoord.xy);}';
    function mkShader(type,src){var s=gl.createShader(type);gl.shaderSource(s,src);gl.compileShader(s);return s;}
    var prog=gl.createProgram();
    gl.attachShader(prog,mkShader(gl.VERTEX_SHADER,VS));
    gl.attachShader(prog,mkShader(gl.FRAGMENT_SHADER,FS));
    gl.linkProgram(prog);gl.useProgram(prog);
    var vao=gl.createVertexArray();gl.bindVertexArray(vao);
    var buf=gl.createBuffer();gl.bindBuffer(gl.ARRAY_BUFFER,buf);
    gl.bufferData(gl.ARRAY_BUFFER,new Float32Array([-1,-1,3,-1,-1,3]),gl.STATIC_DRAW);
    gl.enableVertexAttribArray(0);gl.vertexAttribPointer(0,2,gl.FLOAT,false,0,0);
    var uRes=gl.getUniformLocation(prog,'iResolution');
    var uTime=gl.getUniformLocation(prog,'iTime');
    var uFrame=gl.getUniformLocation(prog,'iFrame');
    var uMouse=gl.getUniformLocation(prog,'iMouse');
    var SCALE=0.4,t0=performance.now(),frame=0,rafN;
    function resize(){var w=Math.round((cv.clientWidth||window.innerWidth)*SCALE);var h=Math.round((cv.clientHeight||window.innerHeight)*SCALE);cv.width=w;cv.height=h;gl.viewport(0,0,w,h);}
    resize();window.addEventListener('resize',resize,{passive:true});
    var skipCount=0;
    function tick(ts){
      rafN=requestAnimationFrame(tick);
      skipCount=(skipCount+1)%3;if(skipCount!==0)return;
      gl.uniform3f(uRes,cv.width,cv.height,1);
      gl.uniform1f(uTime,(ts-t0)/1000);
      gl.uniform1i(uFrame,frame++);
      gl.uniform4f(uMouse,0,0,0,0);
      gl.drawArrays(gl.TRIANGLES,0,3);
    }
    rafN=requestAnimationFrame(tick);
    var obs=new MutationObserver(function(muts){
      muts.forEach(function(m){m.removedNodes.forEach(function(n){
        if(n.id==='loader'){cancelAnimationFrame(rafN);obs.disconnect();gl.deleteBuffer(buf);gl.deleteProgram(prog);gl.deleteVertexArray(vao);}
      });});
    });
    obs.observe(document.body,{childList:true});
  },0);
})();
</script>

<script is:inline>
(function(){
  'use strict';
  var PRM=window.matchMedia('(prefers-reduced-motion:reduce)').matches;
  var IS_MOBILE=window.matchMedia('(max-width:768px)').matches;

  /* ── Bidirectional scroll reveal ── */
  var revEls=document.querySelectorAll('.r');
  if(PRM){
    revEls.forEach(function(el){el.classList.add('v')});
  } else if('IntersectionObserver' in window){
    var io=new IntersectionObserver(function(entries){
      entries.forEach(function(e){e.target.classList.toggle('v',e.isIntersecting)});
    },{threshold:0.1,rootMargin:'0px 0px -60px 0px'});
    revEls.forEach(function(el){io.observe(el)});
  } else {
    revEls.forEach(function(el){el.classList.add('v')});
  }

  /* ── Scroll-linked: hero fade/drift + neon parallax ── */
  if(!PRM && !IS_MOBILE){
    var heroMain=document.querySelector('.hero-main');
    var heroFoot=document.querySelector('.hero-foot');
    var heroSec=document.getElementById('accueil');
    var neonFlow=document.querySelector('.neon-flow');
    var heroSecH=heroSec?heroSec.offsetHeight:800;
    window.addEventListener('resize',function(){if(heroSec)heroSecH=heroSec.offsetHeight;},{passive:true});
    function applyFX(){
      var sy=window.scrollY;
      if(heroMain&&heroSec){
        var prog=Math.min(Math.max(sy/(heroSecH*.62),0),1);
        heroMain.style.opacity=Math.max(0,1-prog*1.2).toFixed(3);
        heroMain.style.transform='translateY('+(-50*prog).toFixed(1)+'px)';
        if(heroFoot)heroFoot.style.opacity=Math.max(0,1-prog*2.5).toFixed(3);
      }
      if(neonFlow)neonFlow.style.transform='translateY('+(sy*.055).toFixed(1)+'px)';
    }
    var _rAF=null;
    window.addEventListener('scroll',function(){
      if(!_rAF)_rAF=requestAnimationFrame(function(){_rAF=null;applyFX();});
    },{passive:true});
    applyFX();
  }

  /* ── FAQ accordion ── */
  document.querySelectorAll('.faq-q').forEach(function(btn){
    btn.addEventListener('click',function(){
      var item=btn.closest('.faq-item');
      var ans=item.querySelector('.faq-a');
      var open=item.classList.contains('open');
      document.querySelectorAll('.faq-item.open').forEach(function(o){
        if(o!==item){o.classList.remove('open');o.querySelector('.faq-q').setAttribute('aria-expanded','false');o.querySelector('.faq-a').style.maxHeight='0'}
      });
      if(open){item.classList.remove('open');btn.setAttribute('aria-expanded','false');ans.style.maxHeight='0'}
      else{item.classList.add('open');btn.setAttribute('aria-expanded','true');ans.style.maxHeight=ans.scrollHeight+'px'}
    });
  });

  /* ── Smooth anchor scroll ── */
  document.addEventListener('click',function(e){
    var a=e.target.closest('a[href^="#"]');
    if(!a)return;
    var tgt=document.querySelector(a.getAttribute('href'));
    if(!tgt)return;
    e.preventDefault();
    window.scrollTo({top:tgt.getBoundingClientRect().top+window.scrollY-80,behavior:'smooth'});
  });
})();
</script>

<script is:inline>
/* ── OAuth callback (Supabase redirect) ── */
(function(){
  var hasCode=window.location.search.indexOf('code=')!==-1;
  var hasToken=window.location.hash.indexOf('access_token=')!==-1;
  if(!hasCode&&!hasToken)return;
  function loadScript(src,cb){var s=document.createElement('script');s.src=src;s.onload=cb;document.head.appendChild(s);}
  loadScript('https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2',function(){
    loadScript('/supabase-client.js',function(){
      if(!window.sb)return;
      window.sb.auth.onAuthStateChange(function(event,session){
        if((event==='SIGNED_IN'||event==='INITIAL_SESSION')&&session){
          window.location.replace('/espace-client');
        }
      });
    });
  });
})();
</script>

