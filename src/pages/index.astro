---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import '../styles/global.css';
---
<BaseLayout title="Nexa Web — Agence Web Premium · Carvin" description="Nexa Web conçoit des sites internet sur-mesure pour commerçants et artisans. Refonte dès 490 €, livraison en 2 à 4 semaines. Carvin, Hauts-de-France.">
<style>

/* ── HERO ── */
.s-hero{min-height:100svh;display:flex;flex-direction:column;padding-top:var(--hdr)}
.s-hero>.wrap{width:100%}
.hero-main{flex:1;display:flex;flex-direction:column;justify-content:center;padding:clamp(40px,8vh,100px) 0}
.hero-eye{display:flex;align-items:center;gap:12px;margin-bottom:clamp(24px,4vh,48px);opacity:0;transform:translateY(14px);animation:fu .6s cubic-bezier(.16,1,.3,1) .2s forwards}
.hero-dot{width:6px;height:6px;border-radius:50%;background:var(--text-muted)}
.h-xl em{font-style:italic;font-weight:600;color:var(--text-muted)}
.hero-hl{margin-bottom:clamp(24px,4vh,52px);overflow:hidden;width:100%;text-wrap:wrap;overflow-wrap:anywhere}
.hero-hl .ln{display:block;overflow:hidden}
.hero-hl .li{display:block;transform:translateY(110%);animation:su .85s cubic-bezier(.16,1,.3,1) forwards}
.hero-hl .ln:nth-child(1) .li{animation-delay:.4s}
.hero-hl .ln:nth-child(2) .li{animation-delay:.56s}
.hero-hl .ln:nth-child(3) .li{animation-delay:.72s}
.hero-sub{margin-bottom:clamp(28px,5vh,52px);opacity:0;animation:fu .6s cubic-bezier(.16,1,.3,1) .95s forwards}
.hero-ctas{display:flex;flex-wrap:wrap;gap:12px;opacity:0;animation:fu .6s cubic-bezier(.16,1,.3,1) 1.1s forwards}
.hero-foot{display:flex;align-items:center;gap:12px;padding:22px 0;border-top:1px solid var(--border);opacity:0;animation:fu .5s cubic-bezier(.16,1,.3,1) 1.3s forwards}
.hero-line{width:40px;height:1px;background:var(--border-strong)}
.hero-cols{display:flex;align-items:center;gap:clamp(24px,5vw,80px)}
.hero-cols .hero-main{flex:0 0 auto;min-width:0}
@media(max-width:900px){.hero-cols{flex-direction:column}}
@keyframes su{to{transform:translateY(0)}}
@keyframes fu{to{opacity:1;transform:translateY(0)}}
@media(prefers-reduced-motion:reduce){.hero-eye,.hero-hl .li,.hero-sub,.hero-ctas,.hero-foot{animation:none!important;opacity:1!important;transform:none!important}}

/* ── PHILOSOPHY ── */
.s-phil{}
.phil-in{display:grid;grid-template-columns:1fr 2fr;gap:clamp(32px,6vw,120px);align-items:start}
.s-phil{min-height:62vh}
.phil-txt{font-size:clamp(1.5rem,3.5vw,3.4rem);font-weight:600;line-height:1.15;letter-spacing:-.025em}
.phil-txt span{color:var(--text-muted)}
@media(max-width:700px){.phil-in{grid-template-columns:1fr;gap:22px}.pin-label{position:static}.s-phil{min-height:0}}

/* ── SERVICES ── */
.s-svc{}
.svc-hdr{display:flex;justify-content:space-between;align-items:flex-end;flex-wrap:wrap;gap:24px;margin-bottom:clamp(36px,6vh,72px)}
/* ═══════════════════════════════════════════════════════════════════
   DES LIGNES, PAS DES CARTES — recopie de la reference.
   Aucun rayon, aucun fond : des filets fins, et c'est tout. Le
   traitement carte (.gloss/.pass/.lip) a ete retire de .svc-row dans
   scroll-fx.js : ce n'est pas une carte.
   ═══════════════════════════════════════════════════════════════════ */
.svc-list{display:flex;flex-direction:column}
.svc-row{
  display:grid;grid-template-columns:52px 1fr auto;align-items:center;gap:20px;
  padding:clamp(18px,2.6vw,28px) clamp(10px,2vw,20px);
  position:relative;cursor:pointer;color:inherit;border-radius:0;background:transparent;
  border-top:1px solid var(--border);
  transition:background-color var(--dur-short) var(--ease-out);
}
.svc-list .svc-row:last-child{border-bottom:1px solid var(--border)}
.svc-row>*{position:relative;z-index:1}
.svc-n{font-size:var(--fs-caption);font-weight:600;letter-spacing:0;color:var(--text-subtle);
  font-variant-numeric:tabular-nums;transition:color var(--dur-short) var(--ease-out)}
.svc-name{font-size:clamp(1.05rem,2.4vw,1.6rem);font-weight:600;letter-spacing:-.025em;
  transition:transform var(--dur-short) var(--ease-out)}
.svc-meta{display:flex;align-items:center;gap:16px;color:var(--text-muted)}
/* Petites capitales espacees : une etiquette, pas un titre. */
.svc-tag{font-size:10px;font-weight:600;letter-spacing:.16em;text-transform:uppercase;
  color:var(--text-subtle);white-space:nowrap}
.svc-arr{font-size:1.1rem;color:var(--text-subtle);
  transition:transform var(--dur-short) var(--ease-out),color var(--dur-short) var(--ease-out)}

@media (hover:hover){
  .svc-row:hover{background:var(--surface)}
  .svc-row:hover .svc-n,.svc-row:hover .svc-arr{color:var(--accent-text)}
  .svc-row:hover .svc-name{transform:translateX(8px)}
  .svc-row:hover .svc-arr{transform:translateX(6px)}
}
.svc-row:focus-visible{background:var(--surface)}
.svc-row:focus-visible .svc-n,.svc-row:focus-visible .svc-arr{color:var(--accent-text)}

/* Le courant qui traverse la ligne au survol. */
.svc-row::before{
  content:'';position:absolute;inset:0;border-radius:0;pointer-events:none;opacity:0;z-index:0;
  background:linear-gradient(90deg,
    rgb(from var(--accent) r g b / 0),
    rgb(from var(--accent) r g b / .17) 48%,
    rgb(from var(--accent) r g b / 0));
  background-size:42% 100%;background-repeat:no-repeat;background-position:-46% 0;
  transition:opacity 220ms var(--ease-out);
}
@media (prefers-reduced-motion:no-preference) and (hover:hover){
  .svc-row:hover::before{opacity:1;animation:flowRun 1.25s linear infinite}
  @keyframes flowRun{to{background-position:146% 0}}
}

/* La tete de lecture : le trait d'or qui marque la ligne au centre de
   l'ecran. A top:-1px — donc JAMAIS d'overflow:hidden sur .svc-row,
   il la couperait. */
.svc-row::after{
  content:'';position:absolute;left:0;top:-1px;height:1px;width:100%;z-index:2;pointer-events:none;
  background:linear-gradient(90deg,var(--accent),rgb(from var(--accent) r g b / 0));
  transform-origin:left;transform:scaleX(0);
}
@supports (animation-timeline: view()){
  .svc-row::after{animation:playhead linear both;animation-timeline:view();
    animation-range:cover 34% cover 66%}
  @keyframes playhead{0%{transform:scaleX(0)}50%{transform:scaleX(1)}100%{transform:scaleX(0)}}
}
@media (prefers-reduced-motion:reduce){
  .svc-row::after{animation:none!important;transform:scaleX(0)}
}
@media(max-width:600px){.svc-tag{display:none}}

/* ═══════════════════════════════════════════════════════════════════
   NOTRE METHODE — une sequence epinglee, pas une grille de cartes.

   La section se bloque pendant qu'on defile et les quatre etapes
   passent l'une apres l'autre AU MEME ENDROIT. .proc-step ne recoit
   aucun calque de carte et aucun cardFlight : il a stepIn, point.
   ═══════════════════════════════════════════════════════════════════ */
.s-proc{padding-top:clamp(60px,10vw,120px)}
.proc-hdr{margin-bottom:clamp(36px,6vh,72px)}
.procwrap{position:relative;height:340vh;z-index:2}
.procpin{position:sticky;top:0;height:100svh;display:flex;align-items:center;
  perspective:1200px;overflow:clip}
.procpin .wrap{position:relative;z-index:1}
.procstack{position:relative;width:100%;min-height:clamp(240px,34vh,340px);
  transform-style:preserve-3d}
.proc-step{position:absolute;inset:0;display:flex;flex-direction:column;justify-content:center;
  gap:14px;opacity:0;background:none;border-radius:0;padding:0}
.proc-step .k{font-size:clamp(46px,8.5vw,104px);line-height:.88;font-weight:600;
  letter-spacing:-.045em;font-variant-numeric:tabular-nums}
.proc-step .proc-title{font-size:clamp(21px,3vw,32px);font-weight:600;letter-spacing:-.02em;margin:0}
.proc-step .proc-desc{margin:0;color:var(--text-muted);max-width:44ch;
  font-size:16px;font-weight:300;line-height:1.68}
.procticks{display:flex;gap:7px;margin-top:clamp(20px,3vw,30px)}
.procticks i{display:block;height:2px;width:clamp(34px,5vw,56px);background:var(--border);
  border-radius:2px;overflow:hidden;position:relative}
.procticks i::after{content:'';position:absolute;inset:0;background:var(--accent);
  transform-origin:left;transform:scaleX(0)}
.proc-glow{position:absolute;inset:-20% -10%;z-index:0;pointer-events:none;opacity:0;
  background:
    radial-gradient(34% 30% at 80% 34%, rgb(from var(--accent) r g b / .15) 0, rgb(from var(--accent) r g b / 0) 70%),
    radial-gradient(30% 26% at 14% 78%, rgb(from var(--gold-deep) r g b / .13) 0, rgb(from var(--gold-deep) r g b / 0) 72%)}

@supports (animation-timeline: view()){
  .procwrap{view-timeline-name:--proc;view-timeline-axis:block}
  .proc-step{animation:stepIn linear both;animation-timeline:--proc}
  .proc-step:nth-child(1){animation-range:contain 0% contain 26%}
  .proc-step:nth-child(2){animation-range:contain 25% contain 51%}
  .proc-step:nth-child(3){animation-range:contain 50% contain 76%}
  .proc-step:nth-child(4){animation-range:contain 75% contain 100%}
  @keyframes stepIn{
    0%{opacity:0;transform:translate3d(0,30px,-80px) rotateX(8deg)}
    18%{opacity:1;transform:none}
    80%{opacity:1;transform:none}
    100%{opacity:0;transform:translate3d(0,-24px,-60px) rotateX(-6deg)}}
  .procticks i::after{animation:lineDraw linear both;animation-timeline:--proc}
  .procticks i:nth-child(1)::after{animation-range:contain 0% contain 26%}
  .procticks i:nth-child(2)::after{animation-range:contain 25% contain 51%}
  .procticks i:nth-child(3)::after{animation-range:contain 50% contain 76%}
  .procticks i:nth-child(4)::after{animation-range:contain 75% contain 100%}
  @keyframes lineDraw{to{transform:scaleX(1)}}
  .proc-glow{animation:procGlow linear both;animation-timeline:--proc;
    animation-range:contain 0% contain 100%}
  @keyframes procGlow{
    0%{opacity:0}12%{opacity:.85}24%{opacity:.34}
    36%{opacity:.85}50%{opacity:.34}
    62%{opacity:.85}74%{opacity:.34}
    88%{opacity:.85}100%{opacity:0}}
}

/* Sans animations au defilement, ou en mouvement reduit : les quatre
   etapes l'une sous l'autre. Rien ne reste invisible. */
@supports not (animation-timeline: view()){
  .procticks i::after{transform:scaleX(1)}
  .proc-step{opacity:1;position:relative;inset:auto;margin-bottom:30px}
  .procstack{min-height:0}.procwrap{height:auto}
  .procpin{position:static;height:auto;display:block}
}
@media (prefers-reduced-motion:reduce){
  .proc-step{opacity:1!important;position:relative;inset:auto;margin-bottom:30px;
    animation:none!important;transform:none!important}
  .procstack{min-height:0}.procwrap{height:auto}
  .procpin{position:static;height:auto;display:block}
  .procticks i::after{transform:scaleX(1);animation:none!important}
  .proc-glow{opacity:0;animation:none!important}
}

/* ── WHY ── */
.s-why{
  /* Un aplat --surface à bords francs produisait deux arêtes nettes sur
     toute la largeur. Le décrochement se fait en dégradé vertical. */
  background:linear-gradient(to bottom,
    rgb(from var(--surface) r g b / 0) 0%,
    color-mix(in srgb,var(--surface) 70%,transparent) 22%,
    color-mix(in srgb,var(--surface) 70%,transparent) 78%,
    rgb(from var(--surface) r g b / 0) 100%);
}
.why-in{display:grid;grid-template-columns:1fr 1fr;gap:clamp(40px,8vw,120px);align-items:start}
/* Le titre vit dans une colonne de ~560 px : à la taille pleine de .h-lg
   il se cassait en quatre lignes bancales autour de son <br>. */
.why-in .h-lg{font-size:clamp(var(--fs-500),3.6vw,var(--fs-700))}
.why-bio{display:flex;flex-direction:column;gap:18px;padding:4px 0}
.why-bio-lead{font-size:clamp(1.35rem,2.4vw,1.9rem);font-weight:600;line-height:1.18;letter-spacing:-.03em;color:var(--text)}
.why-bio-body{font-size:13px;font-weight:300;line-height:1.72;color:var(--text-muted)}
.why-bio-cta{display:inline-flex;align-items:center;gap:8px;margin-top:8px;font-size:var(--fs-caption);font-weight:600;letter-spacing:0;color:var(--text);border-bottom:1px solid var(--border-strong);padding-bottom:4px;transition:color .2s,border-color .2s;align-self:flex-start}
.why-bio-cta:hover{color:var(--text);border-color:var(--text)}
@media(max-width:720px){.why-in{grid-template-columns:1fr}}

/* ── STATS ── */
/* ── TUILES DE CHIFFRES ──
   Règles du système de dataviz appliquées : la valeur domine, le libellé
   reste discret, les lignes de base sont alignées, et AUCUNE couleur
   décorative ne touche les chiffres — ils portent le token de texte, pas
   l'accent. Le cuivre ne sert qu'au filet sous la valeur. */
.s-stats{}
.stats-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}
.stat{
  padding:clamp(28px,6vw,64px);background:var(--surface);border-radius:var(--radius-block);
  display:flex;flex-direction:column;align-items:center;
}

.stat-val{
  font-size:clamp(2.8rem,6vw,6rem);font-weight:600;letter-spacing:-.04em;
  line-height:1;color:var(--text);
  /* Ligne de base commune aux trois tuiles, quel que soit le glyphe */
  display:flex;align-items:baseline;justify-content:center;
  min-height:1em;
}
/* Filet cuivre : le seul accent de la tuile */
.stat-rule{width:32px;height:2px;background:var(--accent);margin:18px 0 12px;transform-origin:left}
.stat-lbl{
  font-size:13px;font-weight:400;letter-spacing:0;color:var(--text-muted);
  text-align:center;
}
/* Masqué seulement si le JS peut le révéler : sans JS, « 24/7 » reste entier. */
.js-enabled .stat-static{opacity:0}
@media(prefers-reduced-motion:reduce){.js-enabled .stat-static{opacity:1}}
@media(max-width:500px){.stats-grid{grid-template-columns:1fr}.stat{border-right:none;border-bottom:1px solid var(--border)}.stat:last-child{border-bottom:none}}

/* ── FAQ ── */
.s-faq{}
.faq-in{display:grid;grid-template-columns:1fr 1.8fr;gap:clamp(40px,8vw,120px)}
.faq-side p{margin-top:20px;font-size:13px}
/* ═══════════════════════════════════════════════════════════════════
   FAQ — une liste a filets, pas des cartes. Recopie de la reference.

   Le + est DESSINE (deux barres), pas ecrit : un caractere « + » se
   pose sur la ligne de base et ne se centre jamais dans son cercle.
   Le depliage passe par grid-template-rows 0fr -> 1fr : aucune hauteur
   a mesurer en JavaScript, donc aucun saut.
   ═══════════════════════════════════════════════════════════════════ */
.faq-list{display:flex;flex-direction:column}
.qa{position:relative;border-top:1px solid var(--border)}
.qa:last-child{border-bottom:1px solid var(--border)}
.qa .bar{position:absolute;left:0;top:0;bottom:0;width:2px;transform-origin:top;transform:scaleY(0);
  background:linear-gradient(180deg,var(--accent),rgb(from var(--accent) r g b / 0));
  transition:transform 480ms cubic-bezier(.22,.9,.24,1)}
.qa.open .bar{transform:scaleY(1)}
.qa .q{width:100%;background:none;border:0;color:inherit;font:inherit;cursor:pointer;text-align:left;
  display:flex;align-items:center;gap:16px;padding:clamp(16px,2.2vw,22px) 4px;
  font-size:clamp(15px,1.8vw,18px);font-weight:600;letter-spacing:-.02em}
.qa .q:focus-visible{outline:2px solid var(--text);outline-offset:-2px;border-radius:2px}
.qa .q .qt{transition:transform 420ms cubic-bezier(.22,.9,.24,1),color 260ms var(--ease-out)}
.qa.open .q .qt{transform:translateX(12px);color:var(--text)}
.qa .q:hover .qt{transform:translateX(6px)}
.qa .plus{margin-left:auto;flex:none;position:relative;width:28px;height:28px;border-radius:50%;
  box-shadow:inset 0 0 0 1px var(--border-strong);
  transition:transform 480ms cubic-bezier(.22,.9,.24,1),box-shadow var(--dur-short) var(--ease-out)}
.qa .plus::before,.qa .plus::after{content:'';position:absolute;top:50%;left:50%;
  background:var(--accent);border-radius:1px}
.qa .plus::before{width:11px;height:1.5px;transform:translate(-50%,-50%)}
.qa .plus::after{width:1.5px;height:11px;transform:translate(-50%,-50%) scaleY(1);
  transition:transform 420ms cubic-bezier(.22,.9,.24,1)}
.qa.open .plus{transform:rotate(180deg);box-shadow:inset 0 0 0 1px rgb(from var(--accent) r g b / .5)}
.qa.open .plus::after{transform:translate(-50%,-50%) scaleY(0)}
.qa .panel{display:grid;grid-template-rows:0fr;
  transition:grid-template-rows 480ms cubic-bezier(.22,.9,.24,1)}
.qa.open .panel{grid-template-rows:1fr}
.qa .panel>div{overflow:hidden}
.qa .ans{padding:0 4px clamp(18px,2.4vw,24px) 18px;color:var(--text-muted);font-size:15px;
  font-weight:300;line-height:1.75;max-width:60ch;margin:0;opacity:0;transform:translateY(-6px);
  transition:opacity 340ms var(--ease-out) 90ms,transform 420ms cubic-bezier(.22,.9,.24,1) 90ms}
.qa.open .ans{opacity:1;transform:none}
@media (prefers-reduced-motion:reduce){
  .qa .bar,.qa .q .qt,.qa .plus,.qa .plus::after,.qa .panel,.qa .ans{transition:none}
}
@media(max-width:700px){.faq-in{grid-template-columns:1fr}}

/* ── CTA ── */
.s-cta{text-align:center}
.cta-in{max-width:900px;margin:0 auto;padding:clamp(80px,15vw,180px) 0}
.cta-super{font-size:clamp(.6rem,1vw,.75rem);font-weight:600;letter-spacing:0;color:var(--text-muted);margin-bottom:32px}
.cta-hl{font-size:clamp(3rem,8vw,9.5rem);font-weight:600;line-height:.92;letter-spacing:-.04em;margin-bottom:48px;text-wrap:balance}
.cta-hl em{font-style:italic;font-weight:600}
.cta-btn{display:inline-flex;align-items:center;gap:12px;font-size:var(--fs-caption);font-weight:600;letter-spacing:0;padding:18px 40px;border-radius:var(--radius-pill);transition:background-color .2s,transform .3s cubic-bezier(.16,1,.3,1)}
.cta-btn:hover{transform:translateY(-2px)}
.cta-btn:focus-visible{outline:2px solid var(--text);outline-offset:4px}
.cta-arr{display:inline-block;transition:transform .25s}
.cta-btn:hover .cta-arr{transform:translateX(5px)}

/* ── POUR QUI ── */
.s-who{}
.who-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:clamp(36px,6vh,72px)}
.who-card{background:var(--surface);border-radius:var(--radius-block);padding:clamp(28px,4vw,48px);display:flex;flex-direction:column;gap:16px}
.who-marker{font-size:var(--fs-caption);font-weight:500;letter-spacing:0;color:var(--text-subtle);margin-bottom:6px;font-variant-numeric:tabular-nums}
.who-target{font-size:clamp(1.1rem,2.2vw,1.7rem);font-weight:600;letter-spacing:-.025em;line-height:1.12}
.who-desc{font-size:13px;font-weight:300;line-height:1.72;color:var(--text-muted);flex:1}
.who-price{font-size:clamp(1.7rem,3.2vw,2.6rem);font-weight:600;letter-spacing:-.04em;line-height:1;font-variant-numeric:tabular-nums}
.who-price-sub{font-size:var(--fs-caption);font-weight:500;letter-spacing:0;color:var(--text-muted);margin-top:6px}
@media(max-width:600px){.who-grid{grid-template-columns:1fr;gap:0}.who-card:not(:last-child){border-bottom:1px solid var(--border)}}

/* content-visibility:auto a été retiré ici : avec contain-intrinsic-size
   à 500px pour des sections qui en font 700 à 1200, la hauteur du document
   changeait pendant le défilement. Conséquences directes : la barre de
   progression de lecture sautait, les ancres visaient à côté, et les
   reveals des sections repliées ne se déclenchaient pas. La page est
   largement assez légère pour s'en passer. */
</style>

<Header back={false} />

<main id="main-content" tabindex="-1">

<!-- HERO -->
<section class="s-hero has-glow" id="accueil" aria-label="Accueil">
  <div class="wrap hero-cols">
    <div class="hero-main">
      <div class="hero-eye" aria-hidden="true">
        <div class="hero-dot"></div>
        <span class="label" data-i18n="idx-eye">Agence web · Carvin</span>
      </div>
      <h1 class="h-xl hero-hl">
        <span class="ln"><span class="li" data-i18n="idx-hl1">Des sites pour les</span></span>
        <span class="ln"><span class="li" data-i18n="idx-hl2"><em>commerçants</em> et artisans</span></span>
        <span class="ln"><span class="li" data-i18n="idx-hl3">des <span class="nb">Hauts-de-France.</span></span></span>
      </h1>
      <p class="body hero-sub" style="max-width:480px" data-i18n="idx-sub">
        Site vitrine, boutique en ligne ou refonte : on conçoit, on développe, on met en ligne. Tarifs affichés, calendrier fixé dès le premier appel.
      </p>
      <div class="hero-ctas">
        <a href="/devis" class="btn" data-i18n="idx-cta1">Démarrer un projet <span aria-hidden="true">→</span></a>
        <a href="/avis" class="btn-g" data-i18n="idx-cta2">Nos avis clients</a>
      </div>
    </div>
  </div>
  <div class="wrap">
