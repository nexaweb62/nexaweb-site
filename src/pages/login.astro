---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/global.css';
---
<BaseLayout title="Connexion — Nexa Web" noindex={true}>
<style>
html,body{height:100%;overflow:hidden}
@media(max-width:768px){html,body{overflow:auto}}

.login-wrap{display:grid;grid-template-columns:1fr 1fr;height:100vh;overflow:hidden}
@media(max-width:768px){.login-wrap{grid-template-columns:1fr}.login-right{display:none}}

/* LEFT PANEL */
.login-left{display:flex;flex-direction:column;background:var(--bg-alt);height:100vh;overflow-y:auto;position:relative;z-index:2}
.login-left::after{content:'';position:fixed;left:50%;top:50%;transform:translate(-50%,-50%);width:600px;height:600px;background:radial-gradient(ellipse,rgba(139,92,246,.06) 0%,transparent 70%);pointer-events:none;z-index:0}

.lf-top{display:flex;align-items:center;justify-content:space-between;padding:28px 40px;position:relative;z-index:1}
.lf-logo{font-size:14px;font-weight:900;letter-spacing:.1em;color:var(--text)}
.lf-logo span{color:var(--text-muted)}
.lf-back{font-size:10px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:var(--text-muted);display:flex;align-items:center;gap:6px;transition:color .2s}
.lf-back:hover{color:var(--text)}
.lf-back svg{width:14px;height:14px;stroke:currentColor;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
.lf-lang{display:flex;align-items:center;gap:4px}
.lf-lang-btn{font-size:9.5px;font-weight:700;letter-spacing:.1em;color:var(--text-dim);background:none;border:1px solid transparent;border-radius:3px;padding:4px 7px;cursor:pointer;transition:color .18s,border-color .18s}
.lf-lang-btn:hover{color:var(--text-muted)}
.lf-lang-btn.active{color:var(--text);border-color:var(--border-hi)}

.lf-body{flex:1;display:flex;align-items:center;justify-content:center;padding:40px;position:relative;z-index:1}
.lf-form-wrap{width:100%;max-width:400px}

.lf-headline{font-size:clamp(1.75rem,3vw,2.4rem);font-weight:900;line-height:.96;letter-spacing:-.04em;margin-bottom:44px;text-wrap:balance}
.lf-headline em{font-style:italic;font-weight:800;color:var(--text-muted)}

.lf-social-btn{display:flex;align-items:center;justify-content:center;gap:10px;width:100%;padding:13px 20px;border:1px solid var(--ghost-border);border-radius:3px;font-size:11px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--text-muted);transition:border-color .2s,color .2s,background .2s;background:transparent;cursor:pointer}
.lf-social-btn:hover{border-color:var(--border-hi);color:var(--text);background:rgba(232,232,242,.03)}
.lf-social-btn svg{width:18px;height:18px;flex-shrink:0}

.lf-divider{display:flex;align-items:center;gap:14px;margin:24px 0}
.lf-divider::before,.lf-divider::after{content:'';flex:1;height:1px;background:var(--border)}
.lf-divider span{font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:var(--text-dim);flex-shrink:0}

.lf-field{margin-bottom:12px}
.lf-input{display:block;width:100%;padding:13px 16px;background:var(--bg-card);border:1px solid var(--border);border-radius:3px;font:inherit;font-size:13px;color:var(--text);outline:none;transition:border-color .2s,box-shadow .2s}
.lf-input::placeholder{color:var(--text-dim)}
.lf-input:focus{border-color:rgba(139,92,246,.5);box-shadow:0 0 0 3px rgba(139,92,246,.12)}

.lf-btn{display:flex;align-items:center;justify-content:center;width:100%;margin-top:8px;padding:14px 20px;background:var(--btn-bg);color:var(--btn-text);border-radius:3px;font-size:11px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;transition:opacity .2s,transform .2s;border:none;cursor:pointer}
.lf-btn:hover{opacity:.88;transform:translateY(-1px)}
.lf-btn.loading{opacity:.6;pointer-events:none}
.lf-btn-spinner{width:14px;height:14px;border:2px solid rgba(8,8,17,.3);border-top-color:var(--btn-text);border-radius:50%;animation:spin .7s linear infinite;display:none}
.lf-btn.loading .lf-btn-spinner{display:block}
.lf-btn.loading .lf-btn-label{display:none}
@keyframes spin{to{transform:rotate(360deg)}}

.lf-foot{display:flex;flex-direction:column;gap:16px;margin-top:36px;text-align:center}
.lf-magic{font-size:11.5px;color:var(--text-muted)}
.lf-magic a,.lf-register a{color:var(--text);text-decoration:underline;text-underline-offset:3px;transition:opacity .2s}
.lf-magic a:hover,.lf-register a:hover{opacity:.7}
.lf-register{font-size:11.5px;color:var(--text-muted)}

.lf-bottom{padding:24px 40px;text-align:center;position:relative;z-index:1}
.lf-bottom p{font-size:10.5px;color:var(--text-dim);line-height:1.6;max-width:340px;margin:0 auto}
.lf-bottom a{text-decoration:underline;text-underline-offset:3px;transition:color .2s}
.lf-bottom a:hover{color:var(--text-muted)}

/* RIGHT PANEL */
.login-right{position:relative;height:100vh;overflow:hidden;background:var(--bg)}
.login-right::before{content:'';position:absolute;inset:0;background:linear-gradient(to right,var(--bg-alt) 0%,transparent 18%),linear-gradient(to bottom,var(--bg) 0%,transparent 10%,transparent 90%,var(--bg) 100%);z-index:2;pointer-events:none}
.lr-trust{position:absolute;bottom:36px;left:0;right:0;display:flex;flex-direction:column;align-items:center;gap:14px;z-index:3;pointer-events:none}
.lr-trust-label{font-size:9.5px;font-weight:600;letter-spacing:.18em;text-transform:uppercase;color:var(--text-dim)}
.lr-logos{display:flex;align-items:center;gap:20px}
.lr-logo-pill{padding:6px 14px;border:1px solid var(--border);border-radius:3px;font-size:9px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--text-dim);background:rgba(8,8,17,.6)}
#globe-canvas{position:absolute;inset:0;width:100%;height:100%;display:block;cursor:grab}
#globe-canvas:active{cursor:grabbing}

/* PASSWORD TOGGLE */
.lf-pwd-wrap{position:relative}
.lf-pwd-wrap .lf-input{padding-right:44px}
.lf-eye{position:absolute;right:14px;top:50%;transform:translateY(-50%);width:18px;height:18px;color:var(--text-dim);cursor:pointer;background:none;border:none;padding:0;display:flex;align-items:center;justify-content:center;transition:color .2s}
.lf-eye:hover{color:var(--text-muted)}
.lf-eye svg{width:16px;height:16px;stroke:currentColor;fill:none;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}

/* AUTH STATES */
.lf-error{display:none;align-items:center;gap:9px;background:rgba(239,68,68,.10);border:1px solid rgba(239,68,68,.30);border-radius:4px;padding:11px 14px;margin-bottom:14px;font-size:12px;font-weight:500;color:#f87171;line-height:1.45}
.lf-error.show{display:flex}
.lf-error svg{width:14px;height:14px;stroke:#f87171;fill:none;stroke-width:2;stroke-linecap:round;flex-shrink:0}
.lf-success{display:none;align-items:center;gap:9px;background:rgba(34,197,94,.10);border:1px solid rgba(34,197,94,.30);border-radius:4px;padding:11px 14px;margin-bottom:14px;font-size:12px;font-weight:500;color:#4ade80}
.lf-success.show{display:flex}

/* RESET */
.lf-reset-wrap{display:none;flex-direction:column;gap:10px;padding:14px 0 4px}
.lf-reset-wrap.show{display:flex}
.lf-reset-note{font-size:11px;color:var(--text-muted);line-height:1.5}
.lf-reset-row{display:flex;gap:8px}
.lf-reset-input{flex:1;padding:10px 13px;background:var(--bg-card);border:1px solid var(--border);border-radius:3px;font:inherit;font-size:12px;color:var(--text);outline:none;transition:border-color .2s}
.lf-reset-input:focus{border-color:rgba(139,92,246,.5)}
.lf-reset-input::placeholder{color:var(--text-dim)}
.lf-reset-btn{padding:10px 16px;background:transparent;border:1px solid var(--ghost-border);border-radius:3px;font-size:10px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--text-muted);cursor:pointer;white-space:nowrap;transition:color .2s,border-color .2s}
.lf-reset-btn:hover{color:var(--text);border-color:var(--border-hi)}
:focus-visible{outline:2px solid rgba(139,92,246,.7);outline-offset:3px;border-radius:2px}
</style>

<div class="login-wrap">

  <!-- GAUCHE -->
  <div class="login-left">
    <div class="lf-top">
      <a href="/" class="lf-logo">NEXA<span>WEB</span></a>
      <div style="display:flex;align-items:center;gap:12px">
        <div class="lf-lang" role="group" aria-label="Langue">
          <button class="lf-lang-btn" data-lang="fr">FR</button>
          <button class="lf-lang-btn" data-lang="en">EN</button>
        </div>
        <button id="theme-btn" aria-label="Basculer le thème" style="width:28px;height:28px;border:1px solid var(--border-hi);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:12px;color:var(--text-muted);background:none;cursor:pointer;transition:border-color .2s,color .2s">○</button>
        <a href="/" class="lf-back">
          <svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
          Retour
        </a>
      </div>
    </div>

    <div class="lf-body">
      <div class="lf-form-wrap">

        <h1 class="lf-headline" data-i18n="login-headline">Bienvenue,<br>connectez-vous<br>à votre <em>espace.</em></h1>

        <button type="button" class="lf-social-btn" id="google-btn">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true">
            <path style="fill:#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
            <path style="fill:#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
            <path style="fill:#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z"/>
            <path style="fill:#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
          </svg>
          <span data-i18n="login-google">Continuer avec Google</span>
        </button>

        <div class="lf-divider"><span data-i18n="login-or">ou</span></div>

        <form id="login-form" novalidate>

          <div class="lf-error" id="lf-error" role="alert" aria-live="polite">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            <span id="lf-error-text"></span>
          </div>

          <div class="lf-success" id="lf-success" role="status" aria-live="polite">
            <span id="lf-success-text"></span>
          </div>

          <div class="lf-field">
            <input class="lf-input" type="email" id="email" name="email" placeholder="Adresse e-mail" data-i18n-ph="login-email-ph" autocomplete="email" required>
          </div>

          <div class="lf-field lf-pwd-wrap">
            <input class="lf-input" type="password" id="password" name="password" placeholder="Mot de passe" data-i18n-ph="login-pwd-ph" autocomplete="current-password" required>
            <button type="button" class="lf-eye" id="pwd-toggle" aria-label="Afficher le mot de passe">
              <svg id="eye-open" viewBox="0 0 24 24"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
              <svg id="eye-close" viewBox="0 0 24 24" style="display:none"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
            </button>
          </div>

          <div class="h-captcha" data-sitekey="5a7ee49c-3bac-4284-a130-5d76459a0fd2" style="margin-bottom:16px"></div>

          <button type="submit" class="lf-btn" id="submit-btn">
            <span class="lf-btn-label" data-i18n="login-submit">Se connecter</span>
            <span class="lf-btn-spinner" aria-hidden="true"></span>
          </button>

          <div class="lf-foot" style="margin-top:18px">
            <p class="lf-magic"><a href="#" id="forgot-link" data-i18n="login-forgot">Mot de passe oublié ?</a></p>
            <p class="lf-register" data-i18n="login-register">Pas encore de compte ? <a href="/inscription">Créer un compte</a></p>
          </div>

          <div class="lf-reset-wrap" id="reset-wrap" aria-live="polite">
            <p class="lf-reset-note" data-i18n="login-reset-note">Entrez votre e-mail pour recevoir un lien de réinitialisation.</p>
            <div class="lf-reset-row">
              <input type="email" id="reset-email" class="lf-reset-input" placeholder="votre@email.fr" autocomplete="email">
              <button type="button" id="reset-btn" class="lf-reset-btn" data-i18n="login-reset-btn">Envoyer</button>
            </div>
          </div>

        </form>
      </div>
    </div>

    <div class="lf-bottom">
      <p data-i18n="login-rgpd">Vos données sont traitées conformément au RGPD. <a href="/politique-confidentialite">Politique de confidentialité</a> · <a href="/mentions-legales">Mentions légales</a></p>
    </div>
  </div>

  <!-- DROITE : Globe -->
  <div class="login-right" aria-hidden="true">
    <canvas id="globe-canvas"></canvas>
    <div class="lr-trust">
      <span class="lr-trust-label" data-i18n="login-trust">Votre espace sécurisé</span>
      <div class="lr-logos">
        <span class="lr-logo-pill">SSL</span>
        <span class="lr-logo-pill">RGPD</span>
        <span class="lr-logo-pill">2FA</span>
        <span class="lr-logo-pill">Chiffré</span>
      </div>
    </div>
  </div>

</div>

<script is:inline>
(function(){
  if(window.matchMedia('(max-width:768px)').matches)return;
  var s=document.createElement('script');
  s.src='https://cdn.jsdelivr.net/npm/d3@7/dist/d3.min.js';
  s.onload=initGlobe;
  document.head.appendChild(s);

  function initGlobe(){
    var canvas=document.getElementById('globe-canvas');
    if(!canvas)return;
    var ctx=canvas.getContext('2d');
    var parent=canvas.parentElement;
    var dpr=Math.min(window.devicePixelRatio||1,2);
    var W=parent.offsetWidth,H=parent.offsetHeight;
    canvas.width=W*dpr;canvas.height=H*dpr;
    canvas.style.width=W+'px';canvas.style.height=H+'px';
    ctx.scale(dpr,dpr);

    var radius=Math.min(W,H)*0.40;
    var cx=W/2,cy=H/2;

    var proj=d3.geoOrthographic().scale(radius).translate([cx,cy]).clipAngle(90);
    var path=d3.geoPath().projection(proj).context(ctx);
    var grat=d3.geoGraticule();

    var rot=[0,-20],autoRot=true,land=null,dots=[];

    function pip(pt,ring){
      var x=pt[0],y=pt[1],inside=false;
      for(var i=0,j=ring.length-1;i<ring.length;j=i++){
        var xi=ring[i][0],yi=ring[i][1],xj=ring[j][0],yj=ring[j][1];
        if((yi>y)!==(yj>y)&&x<((xj-xi)*(y-yi))/(yj-yi)+xi)inside=!inside;
      }
      return inside;
    }

    function inFeature(pt,f){
      var g=f.geometry;
      if(g.type==='Polygon'){
        if(!pip(pt,g.coordinates[0]))return false;
        for(var i=1;i<g.coordinates.length;i++)if(pip(pt,g.coordinates[i]))return false;
        return true;
      }
      if(g.type==='MultiPolygon'){
        for(var p=0;p<g.coordinates.length;p++){
          var poly=g.coordinates[p];
          if(pip(pt,poly[0])){
            var hole=false;
            for(var h=1;h<poly.length;h++)if(pip(pt,poly[h])){hole=true;break;}
            if(!hole)return true;
          }
        }
        return false;
      }
      return false;
    }

    function makeDots(f){
      var b=d3.geoBounds(f),step=1.4;
      var out=[];
      for(var ln=b[0][0];ln<=b[1][0];ln+=step)
        for(var lt=b[0][1];lt<=b[1][1];lt+=step)
          if(inFeature([ln,lt],f))out.push([ln,lt]);
      return out;
    }

    function render(){
      ctx.clearRect(0,0,W,H);
      var sc=proj.scale();
      /* sphere */
      ctx.beginPath();ctx.arc(cx,cy,sc,0,2*Math.PI);
      ctx.fillStyle='#000';ctx.fill();
      ctx.strokeStyle='rgba(255,255,255,0.18)';ctx.lineWidth=1;ctx.stroke();
      if(!land)return;
      /* graticule */
      ctx.beginPath();path(grat());
      ctx.strokeStyle='rgba(255,255,255,0.10)';ctx.lineWidth=0.5;ctx.stroke();
      /* land outline */
      ctx.beginPath();
      land.features.forEach(function(f){path(f);});
      ctx.strokeStyle='rgba(255,255,255,0.55)';ctx.lineWidth=0.9;ctx.stroke();
      /* dots */
      ctx.fillStyle='rgba(255,255,255,0.65)';
      dots.forEach(function(d){
        var p=proj(d);if(!p)return;
        ctx.beginPath();ctx.arc(p[0],p[1],1.4,0,2*Math.PI);ctx.fill();
      });
    }

    fetch('https://raw.githubusercontent.com/martynafford/natural-earth-geojson/refs/heads/master/110m/physical/ne_110m_land.json')
      .then(function(r){return r.json();})
      .then(function(data){
        land=data;
        data.features.forEach(function(f){makeDots(f).forEach(function(d){dots.push(d);});});
        render();
      }).catch(function(){});

    var timer=d3.timer(function(){
      if(autoRot){rot[0]+=0.25;proj.rotate(rot);render();}
    });

    canvas.addEventListener('mousedown',function(e){
      autoRot=false;
      var sx=e.clientX,sy=e.clientY,sr=rot.slice();
      function mv(e){
        rot[0]=sr[0]+(e.clientX-sx)*0.4;
        rot[1]=Math.max(-90,Math.min(90,sr[1]-(e.clientY-sy)*0.4));
        proj.rotate(rot);render();
      }
      function up(){
        document.removeEventListener('mousemove',mv);
        document.removeEventListener('mouseup',up);
        setTimeout(function(){autoRot=true;},60);
      }
      document.addEventListener('mousemove',mv);
      document.addEventListener('mouseup',up);
    });

    document.addEventListener('visibilitychange',function(){
      if(document.hidden){timer.stop();}
      else{timer=d3.timer(function(){if(autoRot){rot[0]+=0.25;proj.rotate(rot);render();}});}
    });
  }
})();
</script>
<script is:inline src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<script is:inline src="https://js.hcaptcha.com/1/api.js" async defer></script>
<script is:inline src="/supabase-client.js"></script>

<script>
/* Redirect if already logged in */
(async function(){
  if(!window.sb)return;
  var s=await window.sb.auth.getSession();
  if(s.data.session)window.location.replace('/espace-client');
})();

/* Lang FR/EN */
(function(){
  var savedLang=localStorage.getItem('nw-lang')||'fr';
  document.querySelectorAll('.lf-lang-btn').forEach(function(b){
    b.classList.toggle('active',b.getAttribute('data-lang')===savedLang);
    b.addEventListener('click',function(){
      var lang=b.getAttribute('data-lang');
      localStorage.setItem('nw-lang',lang);
      document.querySelectorAll('.lf-lang-btn').forEach(function(x){
        x.classList.toggle('active',x.getAttribute('data-lang')===lang);
      });
      document.dispatchEvent(new CustomEvent('nw-lang',{detail:lang}));
    });
  });
})();

/* Theme toggle */
(function(){
  var root=document.documentElement,btn=document.getElementById('theme-btn');
  function sync(){btn.textContent=root.getAttribute('data-theme')==='light'?'●':'○'}
  sync();
  btn.addEventListener('click',function(){
    var next=root.getAttribute('data-theme')==='dark'?'light':'dark';
    root.setAttribute('data-theme',next);localStorage.setItem('nw-theme',next);sync();
  });
})();

/* Password toggle */
(function(){
  var btn=document.getElementById('pwd-toggle'),inp=document.getElementById('password');
  var eo=document.getElementById('eye-open'),ec=document.getElementById('eye-close');
  btn.addEventListener('click',function(){
    var show=inp.type==='password';inp.type=show?'text':'password';
    eo.style.display=show?'none':'block';ec.style.display=show?'block':'none';
    btn.setAttribute('aria-label',show?'Masquer le mot de passe':'Afficher le mot de passe');
  });
})();

/* UI helpers */
function showError(msg){var el=document.getElementById('lf-error');document.getElementById('lf-error-text').textContent=msg;el.classList.add('show');document.getElementById('lf-success').classList.remove('show')}
function showSuccess(msg){var el=document.getElementById('lf-success');document.getElementById('lf-success-text').textContent=msg;el.classList.add('show');document.getElementById('lf-error').classList.remove('show')}
function clearMessages(){document.getElementById('lf-error').classList.remove('show');document.getElementById('lf-success').classList.remove('show')}
function setLoading(on){var btn=document.getElementById('submit-btn');btn.classList.toggle('loading',on);btn.disabled=on}
function translateError(err){
  if(!err)return'Une erreur est survenue.';
  var msg=(err.message||'').toLowerCase();
  if(msg.includes('invalid login')||msg.includes('invalid credentials')||msg.includes('email not confirmed'))return'Email ou mot de passe incorrect.';
  if(msg.includes('rate limit')||msg.includes('too many'))return'Trop de tentatives. Réessayez dans quelques minutes.';
  if(msg.includes('network')||msg.includes('fetch'))return'Erreur réseau. Vérifiez votre connexion.';
  return'Une erreur est survenue. Contactez le support.';
}

/* Login form */
document.getElementById('login-form').addEventListener('submit',async function(e){
  e.preventDefault();clearMessages();
  var email=document.getElementById('email').value.trim();
  var password=document.getElementById('password').value;
  if(!email||!password){showError('Veuillez remplir tous les champs.');return}
  var captchaToken=window.hcaptcha?window.hcaptcha.getResponse():'';
  if(!captchaToken){showError('Merci de valider le captcha avant de continuer.');return}
  setLoading(true);
  try{
    var result=await window.sb.auth.signInWithPassword({email,password,options:{captchaToken}});
    if(result.error){if(window.hcaptcha)window.hcaptcha.reset();showError(translateError(result.error))}
    else window.location.replace('/espace-client');
  }catch(err){if(window.hcaptcha)window.hcaptcha.reset();showError(translateError(err))}
  finally{setLoading(false)}
});

/* Google OAuth */
document.getElementById('google-btn').addEventListener('click',async function(){
  this.disabled=true;this.style.opacity='.6';
  try{
    var result=await window.sb.auth.signInWithOAuth({provider:'google',options:{redirectTo:'https://nexaaweb.com/'}});
    if(result.error)showError('Erreur Google : '+result.error.message);
  }catch(err){showError('Erreur Google. Réessayez dans quelques instants.');this.disabled=false;this.style.opacity=''}
});

/* Forgot password */
document.getElementById('forgot-link').addEventListener('click',function(e){
  e.preventDefault();clearMessages();
  var wrap=document.getElementById('reset-wrap');
  wrap.classList.toggle('show');
  if(wrap.classList.contains('show')){
    var em=document.getElementById('email').value.trim();
    if(em)document.getElementById('reset-email').value=em;
    document.getElementById('reset-email').focus();
  }
});

document.getElementById('reset-btn').addEventListener('click',async function(){
  var email=document.getElementById('reset-email').value.trim();
  if(!email){showError('Entrez votre adresse e-mail.');return}
  this.disabled=true;this.textContent='Envoi…';
  try{
    var result=await window.sb.auth.resetPasswordForEmail(email,{redirectTo:window.location.origin+'/espace-client'});
    if(result.error){showError(translateError(result.error))}
    else{document.getElementById('reset-wrap').classList.remove('show');showSuccess('Si cet e-mail existe, un lien de réinitialisation a été envoyé.')}
  }catch(err){showError(translateError(err))}
  finally{this.disabled=false;this.textContent='Envoyer'}
});
</script>
</BaseLayout>
