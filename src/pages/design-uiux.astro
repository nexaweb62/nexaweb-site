---
import InteractiveButton from '../components/ui/InteractiveButton.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
---
<BaseLayout title="Design UI/UX — Nexa Web" description="Design UI/UX soigné pour interfaces web et apps mobiles. Maquettes Figma, prototypes interactifs — Nexa Web.">
<style>
main{padding-top:var(--hdr)}

.svc-hero{padding-top:80px;padding-bottom:60px;position:relative}
.svc-title{margin-bottom:28px;position:relative;z-index:1}
.svc-desc{font-size:var(--fs-body);color:var(--text-muted);line-height:1.75;max-width:640px;margin-bottom:40px;position:relative;z-index:1}

.svc-features{padding-top:60px;padding-bottom:60px}
/* Ce libellé introduit les <h3> de la grille : c'est un niveau 2,
   pas un <span> décoratif. axe refusait le saut h1 → h3. */
.svc-section-label{color:var(--text);margin:0 0 32px;display:block}
/* Une liste à filets, une colonne de 68 caractères au plus : ce qui est
   compris n'est pas une suite d'étapes, il n'y a donc plus de numéros. */
.feat-grid{display:block;background:none;max-width:68ch}
.feat-item{padding:var(--sp-5) 0;border-top:1px solid var(--border)}
.feat-item:last-child{border-bottom:1px solid var(--border)}
.feat-title{font-size:1.125rem;font-weight:600;letter-spacing:0;margin-bottom:8px}
.feat-desc{font-size:.875rem;color:var(--text-muted);line-height:1.65}

.svc-divider{height:1px;background:var(--border);margin:0 var(--pad-x)}

.svc-band{padding-top:60px;padding-bottom:60px;display:flex;align-items:center;justify-content:space-between;gap:40px;flex-wrap:wrap}
.svc-band-text h2{margin:0 0 8px}
.svc-band-text p{font-size:var(--fs-body);color:var(--text-muted);line-height:1.6}

@media(max-width:700px){.svc-band{flex-direction:column;align-items:flex-start}}
</style>

<Header backBtn={true} />

<main id="main-content" tabindex="-1">
  <div class="svc-hero wrap">
    <h1 class="svc-title h-xl" data-i18n="ux-h1">Design <span>UI/UX</span></h1>
    <p class="svc-desc" data-i18n="ux-3">On dessine l'organisation de chaque page, puis la maquette, puis un prototype que vous pouvez cliquer avant qu'on écrive le code.</p>
    <InteractiveButton text="Demander un devis" data-i18n="ux-b1" href="/devis" class="svc-cta" />
  </div>

  <div class="svc-divider"></div>

  <div class="svc-features wrap">
    <h2 class="svc-section-label h-lg" data-i18n="ux-4">Ce qui est inclus</h2>
    <div class="feat-grid">
      <div class="feat-item">
        <h3 class="feat-title" data-i18n="ux-5">Plan de chaque page</h3>
        <p class="feat-desc" data-i18n="ux-6">Ce qui va sur chaque page, dans quel ordre, et où se trouvent les boutons de contact.</p>
      </div>
      <div class="feat-item">
        <h3 class="feat-title" data-i18n="ux-7">Maquettes haute fidélité</h3>
        <p class="feat-desc" data-i18n="ux-8">La maquette de chaque page, avec vos couleurs, vos polices et vos photos.</p>
      </div>
      <div class="feat-item">
        <h3 class="feat-title" data-i18n="ux-9">Prototype interactif</h3>
        <p class="feat-desc" data-i18n="ux-10">Simulation cliquable de votre futur site. Vous testez le parcours utilisateur en conditions réelles avant la moindre ligne de code.</p>
      </div>
      <div class="feat-item">
        <h3 class="feat-title" data-i18n="ux-11">Bibliothèque d'éléments</h3>
        <p class="feat-desc" data-i18n="ux-12">Bibliothèque de composants réutilisables : boutons, formulaires, cartes, navigation. Votre identité visuelle reste cohérente sur toutes les pages.</p>
      </div>
      <div class="feat-item">
        <h3 class="feat-title" data-i18n="ux-13">Le téléphone d'abord</h3>
        <p class="feat-desc" data-i18n="ux-14">On dessine la version téléphone en premier, puis la version ordinateur.</p>
      </div>
      <div class="feat-item">
        <h3 class="feat-title" data-i18n="ux-15">Deux séries de retouches</h3>
        <p class="feat-desc" data-i18n="ux-16">Deux séries de retouches sont comprises, comme pour tous nos sites. Les fichiers Figma vous sont remis à la fin.</p>
      </div>
    </div>
  </div>

  <div class="svc-divider"></div>

  <div class="svc-band wrap">
    <div class="svc-band-text">
      <h2 class="h-lg" data-i18n="ux-17">Demander un devis</h2>
      <p data-i18n="ux-18">Réponse sous 24 h. Gratuit et sans engagement.</p>
    </div>
    <InteractiveButton text="Demander un devis" data-i18n="ux-b2" href="/devis" />
  </div>
</main>

<Footer />
</BaseLayout>
