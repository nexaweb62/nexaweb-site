---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
---
<BaseLayout title="Site Internet pour Commerce de Proximité — Nexa Web" description="Un site vitrine pour votre commerce local : catalogue, horaires, formulaire de commande et SEO local. 490 € lancement, 39 €/mois.">
<style>
main { padding-top: var(--hdr) }

/* Hero */
.hero { padding: clamp(80px,14vh,160px) 0 clamp(60px,10vh,120px); text-align: center; position: relative; overflow: hidden; }
.hero::before { content:''; position:absolute; inset:0; background: radial-gradient(ellipse 80% 60% at 50% 0%, rgba(139,92,246,.18) 0%, transparent 70%); pointer-events:none; }
.hero-tag { font-size:10px; font-weight:600; letter-spacing:.2em; text-transform:uppercase; color:var(--accent); margin-bottom:20px; display:inline-block; }
.hero-title { font-size:clamp(2.2rem,5vw,4.5rem); font-weight:900; letter-spacing:-.04em; line-height:1; text-wrap:balance; margin-bottom:24px; }
.hero-sub { font-size:clamp(.95rem,1.6vw,1.1rem); color:var(--text-muted); line-height:1.7; max-width:560px; margin:0 auto 40px; }

/* Sections */
.s { padding: var(--sec) 0; border-top: 1px solid var(--border); }
.s-title { font-size:clamp(1.6rem,3.5vw,2.8rem); font-weight:900; letter-spacing:-.03em; line-height:1.1; text-wrap:balance; margin-bottom:16px; }
.s-sub { font-size:clamp(.9rem,1.4vw,1rem); color:var(--text-muted); line-height:1.7; max-width:580px; margin-bottom:clamp(40px,6vw,72px); }

/* Constat */
.constat-list { display:flex; flex-direction:column; gap:16px; max-width:760px; }
.constat-item { display:flex; gap:20px; align-items:flex-start; padding:24px; background:var(--bg-card); border:1px solid var(--border); border-radius:4px; }
.constat-num { font-size:11px; font-weight:700; color:var(--accent); letter-spacing:.1em; flex-shrink:0; padding-top:2px; }
.constat-text strong { display:block; font-size:1rem; font-weight:700; margin-bottom:6px; }
.constat-text p { font-size:.9rem; color:var(--text-muted); line-height:1.65; }

/* Cards livrables */
.cards { display:grid; grid-template-columns:repeat(auto-fill,minmax(260px,1fr)); gap:1px; background:var(--border); margin-top:clamp(32px,5vw,60px); }
.card { background:var(--bg); padding:32px 28px; }
.card-icon { width:36px; height:36px; background:var(--accent-dim); border-radius:8px; display:flex; align-items:center; justify-content:center; margin-bottom:20px; }
.card-icon svg { width:18px; height:18px; stroke:var(--accent); stroke-width:1.8; fill:none; stroke-linecap:round; stroke-linejoin:round; }
.card-title { font-size:1rem; font-weight:700; margin-bottom:8px; }
.card-desc { font-size:.875rem; color:var(--text-muted); line-height:1.65; }

/* Tarif */
.tarif-box { max-width:540px; border:1px solid var(--border-hi); border-radius:8px; padding:clamp(32px,5vw,56px); background:var(--bg-card); }
.tarif-price { font-size:clamp(2.8rem,6vw,4rem); font-weight:900; letter-spacing:-.04em; margin-bottom:4px; }
.tarif-price span { font-size:1.1rem; font-weight:400; color:var(--text-muted); }
.tarif-mensuel { font-size:.95rem; color:var(--text-muted); margin-bottom:28px; }
.tarif-list { display:flex; flex-direction:column; gap:10px; margin-bottom:32px; }
.tarif-list li { font-size:.9rem; display:flex; gap:10px; align-items:flex-start; }
.tarif-list li::before { content:'✓'; color:var(--accent); font-weight:700; flex-shrink:0; }

/* FAQ */
.faq-list { display:flex; flex-direction:column; gap:0; max-width:760px; }
.faq-item { border-top:1px solid var(--border); padding:24px 0; }
.faq-item:last-child { border-bottom:1px solid var(--border); }
.faq-q { font-size:1rem; font-weight:700; margin-bottom:10px; }
.faq-a { font-size:.9rem; color:var(--text-muted); line-height:1.7; }

/* Contact */
.contact-grid { display:grid; grid-template-columns:1fr 1fr; gap:clamp(40px,7vw,100px); align-items:start; }
.contact-form { display:flex; flex-direction:column; gap:14px; }
.contact-form input, .contact-form select, .contact-form textarea { width:100%; background:var(--bg-card); border:1px solid var(--border-hi); color:var(--text); font:inherit; font-size:.9rem; padding:12px 16px; border-radius:4px; outline:none; transition:border-color .2s; }
.contact-form input:focus, .contact-form select:focus, .contact-form textarea:focus { border-color:var(--accent); }
.contact-form select option { background:var(--bg); }
.contact-aside { display:flex; flex-direction:column; gap:20px; }
.contact-link { display:flex; align-items:center; gap:12px; font-size:.9rem; font-weight:600; color:var(--text-muted); transition:color .2s; }
.contact-link:hover { color:var(--text); }
.contact-link svg { width:18px; height:18px; stroke:currentColor; stroke-width:1.8; fill:none; stroke-linecap:round; stroke-linejoin:round; flex-shrink:0; }
.other-pages { margin-top:8px; }
.other-pages p { font-size:.82rem; color:var(--text-dim); margin-bottom:10px; font-weight:500; letter-spacing:.06em; text-transform:uppercase; }
.other-pages a { display:inline-block; margin-right:12px; margin-bottom:8px; font-size:.82rem; color:var(--text-muted); border:1px solid var(--border-hi); padding:5px 12px; border-radius:3px; transition:color .2s,border-color .2s; }
.other-pages a:hover { color:var(--text); border-color:var(--text-muted); }

/* Breadcrumb */
.breadcrumb { font-size:.78rem; color:var(--text-dim); padding:clamp(16px,3vw,24px) 0 0; }
.breadcrumb a { color:var(--text-dim); transition:color .2s; }
.breadcrumb a:hover { color:var(--text-muted); }
.breadcrumb span { margin:0 6px; }

@media(max-width:768px) {
  .contact-grid { grid-template-columns:1fr; }
  .cards { grid-template-columns:1fr; background:none; gap:1px; }
  .card { border:1px solid var(--border); }
}
</style>

<Header backBtn={true} />

<main>
  <!-- 1. Fil d'Ariane -->
  <div class="wrap">
    <nav class="breadcrumb">
      <a href="/">Accueil</a><span>›</span>
      <a href="/#services">Services</a><span>›</span>
      Site internet commerce
    </nav>
  </div>

  <!-- 2. Hero -->
  <section class="hero">
    <div class="wrap">
      <span class="hero-tag r">Commerces de proximité</span>
      <h1 class="hero-title r r.d1">Vos clients commandent sur Amazon<br>parce qu'ils ignorent que vous existez en ligne.</h1>
      <p class="hero-sub r r.d2">60 % des acheteurs vérifient en ligne avant d'entrer en boutique. Sans présence web, vous perdez des ventes sans même le savoir.</p>
      <a href="#contact" class="btn r r.d3">Créer mon site commerce →</a>
    </div>
  </section>

  <!-- 3. Le constat -->
  <section class="s">
    <div class="wrap">
      <h2 class="s-title r">Ce que vous perdez chaque semaine sans site</h2>
      <p class="s-sub r r.d1">Des clients passent devant votre vitrine — en ligne — et repartent chez la concurrence.</p>
      <ul class="constat-list">
        <li class="constat-item r r.d1">
          <span class="constat-num">60 %</span>
          <div class="constat-text">
            <strong>Des acheteurs vérifient en ligne avant d'aller en boutique</strong>
            <p>Ils cherchent les horaires, l'adresse, ce que vous vendez. Sans site, ils supposent que vous êtes fermé ou que vous n'avez pas ce qu'il faut — et ils vont ailleurs.</p>
          </div>
        </li>
        <li class="constat-item r r.d2">
          <span class="constat-num">−</span>
          <div class="constat-text">
            <strong>Pas de site = pas d'horaires clairs = clients qui se déplacent pour rien</strong>
            <p>Un client qui se déplace et trouve porte close ne reviendra pas. Il trouve votre concurrent en deux clics — et commande depuis son canapé.</p>
          </div>
        </li>
        <li class="constat-item r r.d3">
          <span class="constat-num">vs</span>
          <div class="constat-text">
            <strong>Les grandes enseignes vous volent des clients locaux grâce au web</strong>
            <p>Amazon, Cdiscount, les chaînes nationales — ils ont des équipes entières pour exister en ligne. Un bon site local bien référencé peut renverser la tendance sur votre ville.</p>
          </div>
        </li>
      </ul>
    </div>
  </section>

  <!-- 4. Ce que vous recevez -->
  <section class="s">
    <div class="wrap">
      <h2 class="s-title r">Ce que vous recevez</h2>
      <p class="s-sub r r.d1">Cinq livrables pensés pour un commerce de quartier — pas un template générique.</p>
      <div class="cards">
        <div class="card r r.d1">
          <div class="card-icon">
            <svg viewBox="0 0 24 24"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><path d="M3 6h18M16 10a4 4 0 0 1-8 0"/></svg>
          </div>
          <h3 class="card-title">Catalogue produits ou services visible</h3>
          <p class="card-desc">Vos produits phares ou vos prestations mis en valeur, avec descriptions et photos. Le client sait ce que vous vendez avant de passer.</p>
        </div>
        <div class="card r r.d2">
          <div class="card-icon">
            <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          </div>
          <h3 class="card-title">Horaires et plan d'accès toujours à jour</h3>
          <p class="card-desc">Plus de déplacements inutiles. Vos horaires, votre adresse et un plan Google Maps directement sur le site.</p>
        </div>
        <div class="card r r.d3">
          <div class="card-icon">
            <svg viewBox="0 0 24 24"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
          </div>
          <h3 class="card-title">Formulaire de contact et de commande</h3>
          <p class="card-desc">Les clients vous contactent ou passent commande directement depuis le site, sans intermédiaire.</p>
        </div>
        <div class="card r r.d1">
          <div class="card-icon">
            <svg viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          </div>
          <h3 class="card-title">Page "Nouveautés" pour fidéliser</h3>
          <p class="card-desc">Partagez vos arrivages, vos promos et vos actualités. Vos clients reviennent voir ce qui change.</p>
        </div>
        <div class="card r r.d2">
          <div class="card-icon">
            <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
          </div>
          <h3 class="card-title">SEO local "boutique [votre ville]"</h3>
          <p class="card-desc">Optimisé pour apparaître quand un habitant cherche ce que vous vendez près de chez lui — sans payer de publicité.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. Tarif -->
  <section class="s">
    <div class="wrap">
      <h2 class="s-title r">Un prix fixe, sans mauvaise surprise</h2>
      <p class="s-sub r r.d1">Vous savez exactement ce que vous payez dès le départ.</p>
      <div class="tarif-box r r.d2">
        <div class="tarif-price">490 <span>€ HT</span></div>
        <p class="tarif-mensuel">+ 39 €/mois — hébergement, maintenance et mises à jour inclus</p>
        <ul class="tarif-list">
          <li>Site livré en 7 jours ouvrés</li>
          <li>Catalogue produits ou services</li>
          <li>Horaires, adresse et plan d'accès</li>
          <li>Formulaire de contact et commande</li>
          <li>Page actualités et nouveautés</li>
          <li>SEO local optimisé</li>
        </ul>
        <a href="#contact" class="btn">Lancer mon site →</a>
      </div>
    </div>
  </section>

  <!-- 6. FAQ -->
  <section class="s">
    <div class="wrap">
      <h2 class="s-title r">Questions fréquentes</h2>
      <p class="s-sub r r.d1">Ce que demandent les commerçants avant de se décider.</p>
      <div class="faq-list">
        <div class="faq-item r r.d1">
          <p class="faq-q">Puis-je ajouter des produits moi-même ?</p>
          <p class="faq-a">Oui. On vous forme en une demi-heure. Vous gérez votre catalogue, vos photos et vos descriptions depuis votre téléphone ou ordinateur, sans toucher au code. Si vous préférez déléguer, c'est compris dans le mensuel.</p>
        </div>
        <div class="faq-item r r.d2">
          <p class="faq-q">Dois-je gérer un stock en ligne ou faire de la vente à distance ?</p>
          <p class="faq-a">Non. Ce site n'est pas une boutique e-commerce avec paiement en ligne. Il présente ce que vous vendez et donne envie aux clients de venir ou de vous appeler. Simple, efficace, sans logistique supplémentaire.</p>
        </div>
        <div class="faq-item r r.d3">
          <p class="faq-q">Ça fonctionne pour quel type de commerce ?</p>
          <p class="faq-a">Boulangerie, fleuriste, librairie, épicerie fine, cave à vins, prêt-à-porter, pharmacie indépendante, animalerie, quincaillerie — tout commerce de proximité qui veut être visible en ligne sans vendre en ligne.</p>
        </div>
        <div class="faq-item r r.d1">
          <p class="faq-q">Mon budget est limité. Est-ce vraiment pour moi ?</p>
          <p class="faq-a">490 € une fois, 39 € par mois : c'est moins d'un encart publicitaire local par an. Et contrairement à la pub, le site travaille pour vous 24h/24 sans frais supplémentaires.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 7. Contact -->
  <section class="s" id="contact">
    <div class="wrap">
      <h2 class="s-title r">On en parle sans engagement</h2>
      <p class="s-sub r r.d1">Laissez vos coordonnées. On vous rappelle dans la journée pour voir si c'est adapté à votre situation.</p>
      <div class="contact-grid">
        <form class="contact-form r r.d1" action="" method="POST">
          <input type="text" name="nom" placeholder="Votre nom" required />
          <input type="text" name="activite" placeholder="Nom de votre commerce" required />
          <input type="tel" name="telephone" placeholder="Téléphone" required />
          <select name="creneau">
            <option value="" disabled selected>Créneau de rappel préféré</option>
            <option value="matin">Matin (9h–12h)</option>
            <option value="midi">Midi (12h–14h)</option>
            <option value="apres-midi">Après-midi (14h–18h)</option>
            <option value="soir">Soir (18h–20h)</option>
          </select>
          <button type="submit" class="btn">Envoyer ma demande →</button>
        </form>
        <div class="contact-aside r r.d2">
          <a href="https://calendly.com/contact-nexaweb62/30min" target="_blank" rel="noopener" class="contact-link">
            <svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
            Réserver un créneau Calendly
          </a>
          <a href="tel:+33641467898" class="contact-link">
            <svg viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.63 3.48 2 2 0 0 1 3.6 1.28h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.9a16 16 0 0 0 6 6l.92-.92a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7a2 2 0 0 1 1.72 2.02z"/></svg>
            +33 6 41 46 78 98
          </a>
          <div class="other-pages">
            <p>Autres pages métier</p>
            <a href="/site-internet-restaurant">Restaurant &amp; Brasserie</a>
            <a href="/site-internet-artisan">Artisan &amp; TPE</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</main>

<Footer />

<script is:inline>
(function(){
  var els=document.querySelectorAll('.r');
  if(!els.length)return;
  var io=new IntersectionObserver(function(entries){entries.forEach(function(e){if(e.isIntersecting){e.target.classList.add('v');io.unobserve(e.target);}});},{threshold:0.12});
  els.forEach(function(el){io.observe(el);});
})();
</script>
</BaseLayout>
