---
/**
 * LA PAGE DE CONNEXION.
 *
 * Elle ne contient aucun secret et ne revele rien : ni le nom des
 * comptes autorises, ni la raison exacte d'un refus. « Ce compte n'est
 * pas autorise » et « la signature est invalide » renseigneraient tous
 * deux celui qui cherche a entrer ; on dit seulement que la connexion
 * n'a pas abouti.
 *
 * Elle est non prerendue uniquement pour pouvoir rediriger une session
 * deja valide vers le tableau de bord.
 */
import AdminLayout from '../../layouts/AdminLayout.astro';
import { COOKIE_SESSION, lireSession, estAutorise } from '../../lib/admin/session';
import { lireEnv } from '../../lib/admin/env';

export const prerender = false;

const env = await lireEnv();

/* Deja connecte ? On ne reaffiche pas le bouton. */
const jeton = Astro.cookies.get(COOKIE_SESSION)?.value;
if (jeton && env.ADMIN_SESSION_SECRET) {
  const email = await lireSession(jeton, env.ADMIN_SESSION_SECRET);
  if (email && estAutorise(email, env.ADMIN_EMAILS)) return Astro.redirect('/admin');
}

const MESSAGES: Record<string, string> = {
  etat: 'La connexion a expiré ou n\'a pas pu être vérifiée. Réessayez.',
  google: 'Google n\'a pas confirmé cette connexion. Réessayez.',
  annule: 'Connexion annulée.',
  config: 'Le tableau de bord n\'est pas encore configuré.',
};
const code = Astro.url.searchParams.get('erreur');
const erreur = code ? (MESSAGES[code] ?? 'La connexion n\'a pas abouti.') : null;
const deconnecte = Astro.url.searchParams.get('deconnecte') === '1';

Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow, noarchive');
Astro.response.headers.set('Cache-Control', 'private, no-store');
---

<AdminLayout titre="Connexion">
  <div class="ad-login">
    <div class="ad-login-c">
      <span class="ad-pastille" aria-hidden="true">N</span>
      <h1 class="ad-login-h">Tableau de bord interne</h1>
      <p class="ad-login-p">Réservé aux associés de Nexa Web.</p>

      {erreur && <div class="ad-alerte">{erreur}</div>}
      {deconnecte && !erreur && (
        <p class="ad-login-p" style="color:var(--accent)">Vous êtes déconnecté.</p>
      )}

      <a class="ad-btn ad-google" href="/admin/oauth/start" rel="nofollow">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path style="fill:var(--brand-google-blue)" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
          <path style="fill:var(--brand-google-green)" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
          <path style="fill:var(--brand-google-yellow)" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z"/>
          <path style="fill:var(--brand-google-red)" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
        </svg>
        <span>Continuer avec Google</span>
      </a>
    </div>
  </div>
</AdminLayout>
