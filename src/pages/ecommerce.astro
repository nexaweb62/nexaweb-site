---
import InteractiveButton from '../components/ui/InteractiveButton.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
---
<BaseLayout title="Site E-commerce — Nexa Web" description="Boutiques e-commerce performantes et sécurisées. Nexa Web conçoit votre shop en ligne à Carvin.">
<style>
main{padding-top:var(--hdr)}

.svc-hero{padding-top:80px;padding-bottom:60px;position:relative}
.svc-title{margin-bottom:28px;position:relative;z-index:1}
.svc-desc{font-size:var(--fs-body);color:var(--text-muted);line-height:1.75;max-width:640px;margin-bottom:40px;position:relative;z-index:1}

.svc-features{padding-top:60px;padding-bottom:60px}
/* Ce libellé introduit les <h3> de la grille : c'est un niveau 2,
   pas un <span> décoratif. axe refusait le saut h1 → h3. */
.svc-section-label{color:var(--text);margin:0 0 32px;display:block}
/* Une liste à filets, une colonne de 68 caractères au plus : ce qui est
   compris n'est pas une suite d'étapes, il n'y a donc plus de numéros. */
.feat-grid{display:block;background:none;max-width:68ch}
.feat-item{padding:var(--sp-5) 0;border-top:1px solid var(--border)}
.feat-item:last-child{border-bottom:1px solid var(--border)}
.feat-title{font-size:1.125rem;font-weight:600;letter-spacing:0;margin-bottom:8px}
.feat-desc{font-size:.875rem;color:var(--text-muted);line-height:1.65}

.svc-divider{height:1px;background:var(--border);margin:0 var(--pad-x)}

.svc-band{padding-top:60px;padding-bottom:60px;display:flex;align-items:center;justify-content:space-between;gap:40px;flex-wrap:wrap}
.svc-band-text h2{margin:0 0 8px}
.svc-band-text p{font-size:var(--fs-body);color:var(--text-muted);line-height:1.6}

@media(max-width:700px){.svc-band{flex-direction:column;align-items:flex-start}}
</style>

<Header backBtn={true} />

<main id="main-content" tabindex="-1">
  <div class="svc-hero wrap">
    <h1 class="svc-title h-xl" data-i18n="ec-h1">Site <span>E-commerce</span></h1>
    <p class="svc-desc" data-i18n="ec-3">Une boutique en ligne avec paiement par carte, gestion du stock et fiches produits. Vous recevez les commandes par e-mail et dans un tableau de bord.</p>
    <InteractiveButton text="Demander un devis" data-i18n="ec-b1" href="/devis" class="svc-cta" />
  </div>

  <div class="svc-divider"></div>

  <div class="svc-features wrap">
    <h2 class="svc-section-label h-lg" data-i18n="ec-4">Ce qui est inclus</h2>
    <div class="feat-grid">
      <div class="feat-item">
        <h3 class="feat-title" data-i18n="ec-5">Catalogue produits complet</h3>
        <p class="feat-desc" data-i18n="ec-6">Fiches produits détaillées avec galeries photos, variantes (taille, couleur), descriptions SEO et gestion des stocks en temps réel.</p>
      </div>
      <div class="feat-item">
        <h3 class="feat-title" data-i18n="ec-7">Paiement sécurisé</h3>
        <p class="feat-desc" data-i18n="ec-8">Intégration Stripe, PayPal ou autre solution. Paiement par carte, virement, et possibilité de paiement en plusieurs fois.</p>
      </div>
      <div class="feat-item">
        <h3 class="feat-title" data-i18n="ec-9">Gestion des commandes</h3>
        <p class="feat-desc" data-i18n="ec-10">Tableau de bord pour suivre chaque commande, gérer les expéditions, envoyer des confirmations automatiques par email.</p>
      </div>
      <div class="feat-item">
        <h3 class="feat-title" data-i18n="ec-11">SEO e-commerce avancé</h3>
        <p class="feat-desc" data-i18n="ec-12">URLs optimisées, balisage schema.org pour les produits, sitemap automatique. Vos produits remontent sur Google.</p>
      </div>
      <div class="feat-item">
        <h3 class="feat-title" data-i18n="ec-13">Design sur mesure</h3>
        <p class="feat-desc" data-i18n="ec-14">La maquette de la boutique est dessinée pour vos produits, et vous la validez avant le développement.</p>
      </div>
      <div class="feat-item">
        <h3 class="feat-title" data-i18n="ec-15">Livraison en 2 à 4 semaines</h3>
        <p class="feat-desc" data-i18n="ec-16">Votre boutique en ligne, complète et fonctionnelle. Formation à la prise en main incluse.</p>
      </div>
    </div>
  </div>

  <div class="svc-divider"></div>

  <div class="svc-band wrap">
    <div class="svc-band-text">
      <h2 class="h-lg" data-i18n="ec-17">Demander un devis</h2>
      <p data-i18n="ec-18">Réponse sous 24 h. Gratuit et sans engagement.</p>
    </div>
    <InteractiveButton text="Demander un devis" data-i18n="ec-b2" href="/devis" />
  </div>
</main>

<Footer />
</BaseLayout>
