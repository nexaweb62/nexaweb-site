---
/**
 * MENTIONS LÉGALES — LCEN, art. 1-1 (loi n° 2004-575 du 21 juin 2004,
 * modifiée par la loi n° 2024-449 du 21 mai 2024).
 *
 * Aucune donnée d'identité n'est écrite ici : tout vient de
 * src/data/entreprise.ts, par IdentiteEditeur, Mediateur et Valeur.
 * Ce qui y vaut null s'affiche « à compléter ».
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import IdentiteEditeur from '../components/IdentiteEditeur.astro';
import Mediateur from '../components/Mediateur.astro';
import Valeur from '../components/Valeur.astro';
import AdressePostale from '../components/AdressePostale.astro';
import DateMaj from '../components/DateMaj.astro';
import { HEBERGEUR, BASE_DONNEES, EDITEUR } from '../data/entreprise';
import '../styles/global.css';
import '../styles/legal.css';
const H = HEBERGEUR, S = BASE_DONNEES;
---
<BaseLayout title="Mentions légales — Nexa Web" description="Éditeur, hébergeur, médiateur de la consommation et propriété intellectuelle du site nexaaweb.com.">
<Header backBtn={true} />

<main id="main-content" tabindex="-1">
  <div class="wrap" style="max-width:800px">
    <div class="legal-hero">
      <h1 class="legal-title" data-i18n="ml-h">Mentions<br>légales</h1>
      <p class="legal-intro" data-i18n="ml-intro">Les informations que la loi pour la confiance dans l'économie numérique (art. 1-1) impose de publier sur l'éditeur et l'hébergeur de ce site.</p>
      <DateMaj />
    </div>
    <div class="legal-body">
      <section id="editeur">
        <h2 data-i18n="ml-h1">1. Éditeur du site</h2>
        <IdentiteEditeur complet />
      </section>

      <section id="hebergement">
        <h2 data-i18n="ml-h2">2. Hébergement</h2>
        <h3 data-i18n="ml-heb-site">Le site</h3>
        <dl class="lg-dl">
          <div><dt data-i18n="lg-hebergeur">Hébergeur</dt><dd><Valeur v={H.nom} /></dd></div>
          <div><dt data-i18n="lg-adresse">Adresse</dt><dd><AdressePostale a={H.adresse} /></dd></div>
          <div><dt data-i18n="lg-tel">Téléphone</dt><dd><Valeur v={H.telephone} href={'tel:' + H.telephone.replace(/[^\d+]/g, '')} /></dd></div>
          <div><dt data-i18n="lg-site">Site</dt><dd><Valeur v="www.cloudflare.com" href={H.site} /></dd></div>
        </dl>
        <h3 data-i18n="ml-heb-donnees">Les comptes clients, les avis et les demandes de devis confirmées</h3>
        <dl class="lg-dl">
          <div><dt data-i18n="lg-hebergeur">Hébergeur</dt><dd><Valeur v={S.nom} /></dd></div>
          <div><dt data-i18n="lg-adresse">Adresse</dt><dd><AdressePostale a={S.adresse} /></dd></div>
          <div><dt data-i18n="lg-tel">Téléphone</dt><dd>{S.telephone ? <Valeur v={S.telephone} /> : <span data-i18n="ml-supa-tel">non publié par Supabase ; contact écrit :</span>} {!S.telephone && <Valeur v={S.contact} href={'mailto:' + S.contact} />}</dd></div>
          <div><dt data-i18n="lg-region">Région de stockage</dt><dd><Valeur v={S.region} /></dd></div>
        </dl>
      </section>

      <section id="mediation">
        <h2 data-i18n="ml-h3b">3. Médiation de la consommation</h2>
        <p data-i18n="ml-med">Un client particulier peut recourir gratuitement à un médiateur de la consommation après une réclamation écrite restée sans solution (Code de la consommation, art. L612-1). Les conditions figurent dans nos <a href="/cgv#reclamations">conditions de vente</a>.</p>
        <Mediateur />
      </section>

      <section id="propriete">
        <h2 data-i18n="ml-h3">4. Propriété intellectuelle</h2>
        <p data-i18n="ml-pi1">Les textes, le logo, les illustrations et le code de ce site sont protégés par le droit d'auteur. Sauf mention contraire, ils appartiennent à Nexa Web. Les polices de caractères et les bibliothèques logicielles utilisées restent la propriété de leurs auteurs et sont employées selon leur licence.</p>
        <p data-i18n="ml-pi2">Les reproduire sans autorisation écrite est interdit (Code de la propriété intellectuelle, art. L122-4), sauf dans les cas que la loi permet, comme la courte citation avec mention de la source (art. L122-5).</p>
      </section>

      <section id="donnees">
        <h2 data-i18n="ml-h4">5. Données personnelles et cookies</h2>
        <p data-i18n="ml-rgpd">Ce que le site collecte, pourquoi, combien de temps et chez quels prestataires est décrit dans la <a href="/politique-confidentialite">politique de confidentialité</a>.</p>
      </section>

      <section id="signaler">
        <h2 data-i18n="ml-h5">6. Signaler une erreur ou un contenu</h2>
        <p data-i18n="ml-resp">Une information inexacte, un contenu illicite ou une faille de sécurité se signale par e-mail ; nous corrigeons ce qui doit l'être. Les liens vers d'autres sites sont donnés à titre d'information : leur contenu relève de leurs éditeurs.</p>
        <p><Valeur v={EDITEUR.email} href={'mailto:' + EDITEUR.email} /></p>
      </section>

      <section id="droit">
        <h2 data-i18n="ml-h6">7. Droit applicable</h2>
        <p data-i18n="ml-droit">Ce site et ces mentions sont soumis au droit français. Les règles propres aux contrats, dont la juridiction qu'un client particulier peut saisir, figurent dans les <a href="/cgv#droit">conditions de vente</a>.</p>
      </section>

      <section id="autres">
        <h2 data-i18n="ml-h7">8. Autres engagements</h2>
        <p data-i18n="ml-autres">La garantie satisfait ou remboursé sur la maquette, le droit de rétractation et les garanties légales sont décrits dans les <a href="/cgv">conditions de vente</a>. Nos engagements de qualité, de sécurité et de sobriété figurent dans la <a href="/politique-entreprise">politique de l'entreprise</a>.</p>
      </section>
    </div>
  </div>
</main>

<Footer />
</BaseLayout>
