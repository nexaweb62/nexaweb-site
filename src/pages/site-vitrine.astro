---
import InteractiveButton from '../components/ui/InteractiveButton.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
---
<BaseLayout title="Site Vitrine — Nexa Web" description="Création de sites vitrines sur mesure, rapides et élégants. Nexa Web, agence web à Carvin.">
<style>
main{padding-top:var(--hdr)}

.svc-hero{padding:80px var(--pad-x) 60px;max-width:1100px;margin:0 auto;position:relative}
.svc-hero::before{content:'';position:fixed;top:0;left:0;right:0;bottom:0;background:radial-gradient(ellipse 70% 50% at 60% 20%,var(--accent-glow) 0%,rgb(from var(--accent-glow) r g b / 0) 70%);pointer-events:none;z-index:0}
.svc-eyebrow{font-size:var(--fs-caption);font-weight:600;letter-spacing:0;color:var(--accent-text);margin-bottom:20px;display:flex;align-items:center;gap:8px;position:relative;z-index:1}
.svc-eyebrow::before{content:'';width:5px;height:5px;border-radius:50%;background:var(--accent);flex-shrink:0}
.svc-title{font-size:clamp(2.8rem,7vw,5.5rem);font-weight:600;letter-spacing:-.03em;line-height:1;margin-bottom:28px;position:relative;z-index:1}
.svc-title span{color:var(--accent-text)}
.svc-desc{font-size:clamp(1rem,1.8vw,1.15rem);color:var(--text-muted);line-height:1.75;max-width:640px;margin-bottom:40px;position:relative;z-index:1}

.svc-features{padding:60px var(--pad-x);max-width:1100px;margin:0 auto}
/* Ce libellé introduit les <h3> de la grille : c'est un niveau 2,
   pas un <span> décoratif. axe refusait le saut h1 → h3. */
.svc-section-label{font-size:var(--fs-caption);font-weight:600;letter-spacing:0;color:var(--accent-text);margin:0 0 40px;display:block}
.feat-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--border)}
.feat-item{background:var(--bg);padding:32px 28px}
.feat-num{font-size:var(--fs-caption);font-weight:600;color:var(--accent-text);letter-spacing:0;margin-bottom:14px}
.feat-title{font-size:1rem;font-weight:600;letter-spacing:-.01em;margin-bottom:10px}
.feat-desc{font-size:.875rem;color:var(--text-muted);line-height:1.65}

.svc-divider{height:1px;background:var(--border);margin:0 var(--pad-x)}

.svc-band{padding:60px var(--pad-x);max-width:1100px;margin:0 auto;display:flex;align-items:center;justify-content:space-between;gap:40px;flex-wrap:wrap}
.svc-band-text h2{font-size:clamp(1.5rem,3vw,2.2rem);font-weight:600;letter-spacing:-.02em;margin-bottom:8px}
.svc-band-text p{font-size:.9rem;color:var(--text-muted);line-height:1.6}

@media(max-width:700px){.feat-grid{grid-template-columns:1fr}.svc-band{flex-direction:column;align-items:flex-start}}
</style>

<Header backBtn={true} />

<main id="main-content" tabindex="-1">
  <div class="svc-hero">
    <p class="svc-eyebrow" data-i18n="sv-1">Service · Essentiel</p>
    <h1 class="svc-title" data-i18n="sv-h1">Site <span>Vitrine</span></h1>
    <p class="svc-desc" data-i18n="sv-3">Votre vitrine digitale, pensée pour impressionner dès les premières secondes. Un site élégant, rapide et optimisé SEO — livré en 2 à 4 semaines, entièrement sur mesure, sans abonnement caché.</p>
    <InteractiveButton text="Obtenir un devis gratuit" data-i18n="sv-b1" href="/devis" class="svc-cta" />
  </div>

  <div class="svc-divider"></div>

  <div class="svc-features">
    <h2 class="svc-section-label" data-i18n="sv-4">Ce qui est inclus</h2>
    <div class="feat-grid">
      <div class="feat-item">
        <div class="feat-num">01</div>
        <h3 class="feat-title" data-i18n="sv-5">Design 100 % sur mesure</h3>
        <p class="feat-desc" data-i18n="sv-6">Chaque pixel est pensé pour votre marque. Pas de template, pas de thème générique — un design unique qui vous ressemble.</p>
      </div>
      <div class="feat-item">
        <div class="feat-num">02</div>
        <h3 class="feat-title" data-i18n="sv-7">Responsive & mobile-first</h3>
        <p class="feat-desc" data-i18n="sv-8">Votre site s'adapte parfaitement à tous les écrans. Tablette, smartphone, desktop — une expérience irréprochable partout.</p>
      </div>
      <div class="feat-item">
        <div class="feat-num">03</div>
        <h3 class="feat-title" data-i18n="sv-9">SEO technique inclus</h3>
        <p class="feat-desc" data-i18n="sv-10">Balises méta, sitemap, schema.org, vitesse optimisée. Votre site est prêt pour Google dès le premier jour.</p>
      </div>
      <div class="feat-item">
        <div class="feat-num">04</div>
        <h3 class="feat-title" data-i18n="sv-11">Formulaire de contact</h3>
        <p class="feat-desc" data-i18n="sv-12">Un formulaire fonctionnel et sécurisé pour que vos prospects puissent vous joindre directement depuis le site.</p>
      </div>
      <div class="feat-item">
        <div class="feat-num">05</div>
        <h3 class="feat-title" data-i18n="sv-13">Livraison en 2 à 4 semaines</h3>
        <p class="feat-desc" data-i18n="sv-14">Le calendrier est fixé avant de commencer, à partir de la validation du brief. Il dépend de la rapidité de vos retours et de la fourniture de vos contenus.</p>
      </div>
      <div class="feat-item">
        <div class="feat-num">06</div>
        <h3 class="feat-title" data-i18n="sv-15">1 mois de support</h3>
        <p class="feat-desc" data-i18n="sv-16">Après la livraison, on reste disponibles. Corrections, ajustements, questions — on est là pendant 30 jours.</p>
      </div>
    </div>
  </div>

  <div class="svc-divider"></div>

  <div class="svc-band">
    <div class="svc-band-text">
      <h2 data-i18n="sv-17">Prêt à lancer votre site ?</h2>
      <p data-i18n="sv-18">Devis gratuit en 24h. On commence dès cette semaine.</p>
    </div>
    <InteractiveButton text="Démarrer mon projet" data-i18n="sv-b2" href="/devis" />
  </div>
</main>

<Footer />

</BaseLayout>
