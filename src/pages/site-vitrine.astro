---
import InteractiveButton from '../components/ui/InteractiveButton.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
---
<BaseLayout title="Site Vitrine — Nexa Web" description="Création de sites vitrines sur mesure, rapides et élégants. Nexa Web, agence web à Carvin.">
<style>
main{padding-top:var(--hdr)}

.svc-hero{padding-top:80px;padding-bottom:60px;position:relative}
.svc-title{margin-bottom:28px;position:relative;z-index:1}
.svc-desc{font-size:var(--fs-body);color:var(--text-muted);line-height:1.75;max-width:640px;margin-bottom:40px;position:relative;z-index:1}

.svc-features{padding-top:60px;padding-bottom:60px}
/* Ce libellé introduit les <h3> de la grille : c'est un niveau 2,
   pas un <span> décoratif. axe refusait le saut h1 → h3. */
.svc-section-label{color:var(--text);margin:0 0 32px;display:block}
/* Une liste à filets, une colonne de 68 caractères au plus : ce qui est
   compris n'est pas une suite d'étapes, il n'y a donc plus de numéros. */
.feat-grid{display:block;background:none;max-width:68ch}
.feat-item{padding:var(--sp-5) 0;border-top:1px solid var(--border)}
.feat-item:last-child{border-bottom:1px solid var(--border)}
.feat-title{font-size:1.125rem;font-weight:600;letter-spacing:0;margin-bottom:8px}
.feat-desc{font-size:.875rem;color:var(--text-muted);line-height:1.65}

.svc-divider{height:1px;background:var(--border);margin:0 var(--pad-x)}

.svc-band{padding-top:60px;padding-bottom:60px;display:flex;align-items:center;justify-content:space-between;gap:40px;flex-wrap:wrap}
.svc-band-text h2{margin:0 0 8px}
.svc-band-text p{font-size:var(--fs-body);color:var(--text-muted);line-height:1.6}

@media(max-width:700px){.svc-band{flex-direction:column;align-items:flex-start}}
</style>

<Header backBtn={true} />

<main id="main-content" tabindex="-1">
  <div class="svc-hero wrap">
    <h1 class="svc-title h-xl" data-i18n="sv-h1">Site <span>Vitrine</span></h1>
    <p class="svc-desc" data-i18n="sv-3">Un site vitrine qui présente votre activité, vos prix et vos coordonnées, rapide sur mobile et préparé pour Google. Livré en 2 à 4 semaines, sans abonnement caché.</p>
    <InteractiveButton text="Demander un devis" data-i18n="sv-b1" href="/devis" class="svc-cta" />
  </div>

  <div class="svc-divider"></div>

  <div class="svc-features wrap">
    <h2 class="svc-section-label h-lg" data-i18n="sv-4">Ce qui est inclus</h2>
    <div class="feat-grid">
      <div class="feat-item">
        <h3 class="feat-title" data-i18n="sv-5">Maquette dessinée pour vous</h3>
        <p class="feat-desc" data-i18n="sv-6">Pas de modèle acheté ni de thème générique : la maquette est dessinée pour votre activité, et vous la validez avant le développement.</p>
      </div>
      <div class="feat-item">
        <h3 class="feat-title" data-i18n="sv-7">Adapté au téléphone</h3>
        <p class="feat-desc" data-i18n="sv-8">Le site s'affiche correctement sur téléphone, tablette et ordinateur. On le teste sur les trois avant la mise en ligne.</p>
      </div>
      <div class="feat-item">
        <h3 class="feat-title" data-i18n="sv-9">SEO technique inclus</h3>
        <p class="feat-desc" data-i18n="sv-10">Balises méta, sitemap, schema.org, vitesse optimisée. Votre site est prêt pour Google dès le premier jour.</p>
      </div>
      <div class="feat-item">
        <h3 class="feat-title" data-i18n="sv-11">Formulaire de contact</h3>
        <p class="feat-desc" data-i18n="sv-12">Un formulaire pour que vos clients vous écrivent depuis le site. Vous recevez les messages par e-mail.</p>
      </div>
      <div class="feat-item">
        <h3 class="feat-title" data-i18n="sv-13">Livraison en 2 à 4 semaines</h3>
        <p class="feat-desc" data-i18n="sv-14">Le calendrier est fixé avant de commencer, à partir de la validation du brief. Il dépend de la rapidité de vos retours et de la fourniture de vos contenus.</p>
      </div>
      <div class="feat-item">
        <h3 class="feat-title" data-i18n="sv-15">1 mois de support</h3>
        <p class="feat-desc" data-i18n="sv-16">Pendant 30 jours après la mise en ligne, on corrige ce qui ne va pas et on répond à vos questions.</p>
      </div>
    </div>
  </div>

  <div class="svc-divider"></div>

  <div class="svc-band wrap">
    <div class="svc-band-text">
      <h2 class="h-lg" data-i18n="sv-17">Demander un devis</h2>
      <p data-i18n="sv-18">Réponse sous 24 h. Gratuit et sans engagement.</p>
    </div>
    <InteractiveButton text="Demander un devis" data-i18n="sv-b2" href="/devis" />
  </div>
</main>

<Footer />

</BaseLayout>
