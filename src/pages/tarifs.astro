---
import InteractiveButton from '../components/ui/InteractiveButton.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FondTarifs from '../components/FondTarifs.astro';
import GarantieBadge from '../components/GarantieBadge.astro';
import '../styles/global.css';
import {
  REFONTE_PRIX, REFONTE_DELAI, REFONTE_M3, REFONTE_M4,
  VITRINE_PRIX, VITRINE_M3, VITRINE_M4,
  ENTREPRISE_PRIX, ENTREPRISE_M3, ENTREPRISE_M4,
} from '../data/formules';
---
<BaseLayout title="Tarifs — Nexa Web" description="Refonte de site dès 490 €, Vitrine Pro à 999 € (offre de lancement, places limitées) et Entreprise à partir de 1 200 €. Paiement en 3 ou 4 fois possible. Devis gratuit — Nexa Web, Carvin.">
<style>
/* ── NOTE D'HISTOIRE ──────────────────────────────────────────────────
   Le fond de cette page fut longtemps une SOIE ANIMEE : un shader WebGL
   dont la clarte changeait sous le texte. Les commentaires ci-dessous
   citent des contrastes mesures CONTRE CETTE SOIE — ils disent pourquoi
   chaque compensation existe, et restent justes au passe.

   La soie a ete remplacee par trois aurores doree qui derivent, en CSS
   pur (voir FondTarifs.astro) : le fond bouge toujours, mais sans shader
   ni canvas. Les compensations sont donc gardees, et pour la meme raison
   qu'avant : la clarte change encore sous le texte. Elles ont ete
   revalidees contre ce nouveau fond, au pixel, par `npm run check:fond`
   — 174 mesures, aucune sous le seuil AA, en clair comme en sombre, en
   1280 comme en 390. */

/* ── HERO ── */
/* Le texte secondaire de cette page se pose sur une soie animée, pas
   sur un aplat. Mesuré : le gris habituel du site y descend jusqu'à
   1,67:1. Il passe donc d'un cran plus clair en sombre, d'un cran plus
   foncé en clair — sur CETTE page seulement, et seulement la couleur :
   aucun mot, aucun prix, aucune animation ne bouge. */
main{--text-muted:var(--raw-warm-200)}
/* En clair, le gris du site est déjà sombre (#55514A) et la soie y est
   pâle : on le laisse tel quel, et la mesure le confirme. Écrire ici un
   --raw-stone-700 inexistant aurait rendu la déclaration invalide et
   fait retomber --text-muted sur l'héritage — vérifié avant de pousser. */
:root[data-theme="light"] main,
:root:not([data-theme="dark"]) main{--text-muted:var(--raw-stone-600)}

.prix-hero{padding:clamp(56px,9vh,100px) 0 clamp(32px,5vh,56px);text-align:center;position:relative;z-index:1}
/* Le chapeau et le sous-titre n'ont aucune carte pour les porter :
   mesuré, le sous-titre tombe à 2,64:1 sur les passages clairs. Un
   renfort sombre local, qui s'éteint avant le bandeau de lancement. */
.prix-hero::before{
  content:"";position:absolute;inset-inline:calc(50% - 50vw);inset-block:-8% 0;
  z-index:-1;pointer-events:none;
  background:radial-gradient(120% 70% at 50% 40%,
    rgb(from var(--bg) r g b / .82), rgb(from var(--bg) r g b / 0) 70%);
}
.prix-pill{display:inline-flex;align-items:center;gap:8px;border:1px solid var(--border-strong);border-radius:100px;padding:6px 16px;font-size:var(--fs-caption);font-weight:600;letter-spacing:0;color:var(--text-muted);margin-bottom:24px}
.prix-pill-dot{width:6px;height:6px;border-radius:50%;background:var(--accent);box-shadow:0 0 8px var(--accent)}
.prix-h1{font-size:clamp(32px,5.5vw,72px);font-weight:600;line-height:1.06;letter-spacing:-.03em;margin-bottom:16px}
.prix-sub{font-size:clamp(15px,1.4vw,17px);color:var(--text-muted);line-height:1.65;max-width:440px;margin:0 auto}

/* ── OFFRE LANCEMENT ── */
.launch-band{
  margin:clamp(32px,5vh,56px) auto 0;
  max-width:780px;
  /* Même verre que les cartes : ce bandeau porte du texte secondaire
     directement sur la soie, et y tombait à 1,67:1. Sa teinte et sa
     bordure ne changent pas, seul un fond opaque s'ajoute dessous. */
  background:var(--bg);
  background-image:linear-gradient(var(--success-glow),var(--success-glow));
  border:1px solid var(--success);
  border-radius:14px;
  padding:clamp(24px,3vw,36px) clamp(24px,4vw,48px);
  display:flex;align-items:center;gap:24px;
  flex-wrap:wrap;
}
.launch-ico{
  width:56px;height:56px;border-radius:50%;background:var(--success-glow);border:1px solid var(--success);
  display:flex;align-items:center;justify-content:center;flex-shrink:0;
}
.launch-ico svg{width:28px;height:28px;stroke:var(--success);stroke-width:2;fill:none}
.launch-text{flex:1;min-width:200px}
.launch-tag{font-size:var(--fs-caption);font-weight:600;letter-spacing:0;color:var(--success);margin-bottom:6px}
.launch-title{font-size:clamp(18px,2.5vw,26px);font-weight:600;letter-spacing:-.02em;line-height:1.1;margin-bottom:6px}
.launch-title strong{color:var(--success)}
.launch-desc{font-size:13px;color:var(--text-muted);line-height:1.6}
.launch-spots{
  display:flex;flex-direction:column;align-items:center;gap:4px;text-align:center;flex-shrink:0;
}
.launch-num{font-size:clamp(32px,5vw,48px);font-weight:600;color:var(--success);line-height:1;letter-spacing:-.03em}
.launch-num-label{font-size:var(--fs-caption);font-weight:600;color:var(--text-muted);letter-spacing:0}
@media(max-width:600px){.launch-band{flex-direction:column;text-align:center}.launch-spots{flex-direction:row;gap:12px;justify-content:center}}

/* ── FORMULES ── */
.plans-section{padding:clamp(32px,5vh,56px) 0 clamp(48px,7vh,72px);position:relative;z-index:1}
/* Le chapeau et le titre de section n'ont, eux non plus, aucune carte
   pour les porter : ils tombent directement sur la soie, qui bouge. Le
   meme renfort sombre que le hero, limite a la hauteur de l'en-tete. */
.plans-section::before{
  content:"";position:absolute;inset-block-start:0;inset-inline:calc(50% - 50vw);
  height:clamp(230px,30vh,300px);z-index:-1;pointer-events:none;
  /* Le renfort MONTE avant de redescendre. La première version partait
     à 0,82 dès son premier pixel : la soie changeait de clarté d'un
     coup sur toute la largeur, à la limite exacte de la section.
     Mesuré par check:seams, ΔL* 18,83 en sombre et 6,57 en clair — une
     barre horizontale franche, visible à l'œil nu.
     Le palier haut commence là où commence le chapeau, et finit après
     le titre ; aux deux bouts, la pente est assez longue pour qu'aucune
     arête ne se forme. */
  background:linear-gradient(180deg,
    rgb(from var(--bg) r g b / 0)   0,
    rgb(from var(--bg) r g b / .82) 20%,
    rgb(from var(--bg) r g b / .82) 62%,
    rgb(from var(--bg) r g b / 0)   100%);
}
/* Ces deux classes existaient dans le balisage depuis l'origine sans
   qu'aucune règle ne les cible : le titre de section tombait sur le
   style h2 par défaut du navigateur — trop petit, interligne trop
   lâche. Elles prennent l'échelle. */
.section-tag{font-size:var(--fs-caption);font-weight:600;letter-spacing:0;color:var(--accent-text);margin:0 0 14px}
.section-title{
  font-size:var(--fs-section);font-weight:var(--w-semi);
  letter-spacing:var(--ls-section);line-height:var(--lh-section);
  margin:0 0 clamp(28px,4vh,44px);text-wrap:balance;
}
/* Trois formules : trois colonnes. Deux laisseraient une carte
   orpheline sur sa ligne. La bascule est a 900 px et non a 760 :
   mesure, a 760 px trois colonnes debordent de 31 px. */
.plans-grid{display:grid;grid-template-columns:1fr;gap:16px;margin-top:clamp(32px,5vw,52px);
  max-width:480px;margin-left:auto;margin-right:auto}
@media(min-width:900px){.plans-grid{grid-template-columns:repeat(3,1fr);gap:20px;max-width:none}}
/* « dès », « à partir de » : un prefixe, pas un prix. Il ne doit pas
   peser autant. Cette règle ne s'appliquait à rien jusqu'ici : le
   compteur de chiffres écrasait le textContent de la carte et
   détruisait le <small> avant même le premier défilement. Corrigé dans
   public/scroll-fx.js, qui n'écrit plus que dans les nœuds de texte. */
.plan-pre{font-size:.46em;font-weight:500;letter-spacing:.02em;color:var(--text-muted);
  margin-right:.12em;vertical-align:.32em}

/* ── PAIEMENT : COMPTANT OU MENSUEL ────────────────────────────────
   Les deux montants sont écrits dans la page ; la bascule ne fait
   qu'en cacher un. Conséquences voulues : rien n'est fabriqué en
   JavaScript, donc rien ne dépend d'un style de portée ; et les
   mensualités ne portent aucune des classes que le compteur de
   chiffres observe, donc il ne les met jamais à zéro — un montant
   caché n'entre jamais dans l'écran, son animation ne partirait
   jamais, et il resterait figé sur « 0 € ». */
.paie{border:0;margin:clamp(20px,3vw,28px) 0 0;padding:0;display:flex;justify-content:center}
.paie-seg{display:inline-flex;gap:4px;align-items:center;padding:3px 5px;
  border:1px solid var(--border-strong);border-radius:var(--radius-pill);
  background:var(--surface)}
/* IL N'Y A PLUS DE FLOU D'ARRIERE-PLAN SUR CETTE PAGE, ET C'EST VOULU.
   Les cartes, le bandeau, le segment de paiement et l'encart final en
   portaient un — cinq a sept elements selon le defilement. Chacun
   obligeait le navigateur a relire et reflouter, A CHAQUE IMAGE, la
   portion de decor situee derriere lui. Or le decor de cette page est
   un tissage qui derive : il ne cesse jamais de changer. C'est
   l'addition qui a fait rendre les armes au compositeur, et la page
   est devenue noire, texte compris.

   Ce qu'on perd est mince : ces fonds etaient deja opaques a 94 %, le
   flou ne jouait que sur les 6 % restants. Ils sont desormais pleins.
   Ce qu'on gagne, c'est une page qui se peint. */
.paie-radio{position:absolute;width:1px;height:1px;opacity:0;pointer-events:none}
.paie-lbl{
  font-size:var(--fs-caption);font-weight:500;letter-spacing:0;color:var(--text);
  display:flex;align-items:center;justify-content:center;cursor:pointer;
  min-height:30px;padding:2px 14px;border-radius:var(--radius-pill);
  transition:color var(--dur-micro) var(--ease-out),background-color var(--dur-micro) var(--ease-out);
}
.paie-radio:checked + .paie-lbl{background:var(--accent);color:var(--on-accent);font-weight:600}
/* Le radio est hors écran : sans cette règle, rien ne montrerait au
   clavier où l'on se trouve. */
.paie-radio:focus-visible + .paie-lbl{outline:2px solid var(--focus);outline-offset:2px}

/* .plan-mois et .plan-mois-note portent la TYPOGRAPHIE ; .plan-m3 et
   .plan-m4 portent la VISIBILITÉ. Séparer les deux permet d'ajouter un
   échéancier sans toucher aux styles. */
.plan-m3,.plan-m4{display:none}
.plan-mois{font-size:clamp(20px,2.4vw,28px);font-weight:600;letter-spacing:-.03em;line-height:1;
  white-space:nowrap;font-variant-numeric:tabular-nums}
.plan-mois-gros{font-size:clamp(23px,3vw,33px);letter-spacing:-.04em}
.plan-mois-u{font-size:.42em;font-weight:500;color:var(--text-muted);margin-left:.1em}
.plans-section:has(#paie-3:checked) .plan-comptant,
.plans-section:has(#paie-4:checked) .plan-comptant{display:none}
/* « block » et non « inline-flex » : un conteneur flex ne rend pas les
   nœuds de texte faits d'espaces seuls, et l'espace du gabarit entre
   « à partir de » et le montant disparaissait. Mesuré : 1,5 px d'écart
   au premier chiffre contre 8,4 px côté comptant, soit « à partir
   de400 € ». Le span est de toute façon rendu en bloc : c'est un
   enfant de .plan-range, qui est en flex. */
.plans-section:has(#paie-3:checked) .plan-m3{display:block}
.plans-section:has(#paie-4:checked) .plan-m4{display:block}
@media(max-width:600px){
  .plan-card{padding:14px 14px}
  .plan-name{font-size:var(--fs-caption);margin-bottom:8px}
  .plan-from,.plan-to{font-size:20px}
  .plan-amount{font-size:21px}
  .plan-sep{font-size:13px}
  .plan-desc{font-size:var(--fs-caption)}
  .plan-feature{font-size:var(--fs-caption);gap:6px}
  .plan-feature-icon{width:14px;height:14px}
  .plan-feature-icon svg{width:7px;height:7px}
  .plan-spots{font-size:var(--fs-caption);padding:4px 8px}
  .plan-spots-num{font-size:12px}
  .plan-divider{margin:12px 0}
  .plan-features{gap:7px;margin-bottom:16px}
}
/* Les cartes laissent voir la soie : même couleur de fond qu'avant,
   simplement rendue translucide, et un flou d'arrière-plan pour que les
   prix restent nets. Bordures et couleurs inchangées. */
.plan-card{
  position:relative;display:flex;flex-direction:column;
  background:var(--surface);
  border:1px solid var(--border-strong);border-radius:16px;
  padding:clamp(18px,2.2vw,26px);transition:border-color .25s,transform .2s ease-out;
  transform-style:preserve-3d;
}
.plan-card:hover{border-color:var(--accent)}
/* INJECTÉ EN JAVASCRIPT dans chaque .plan-card — d'où :global().
   Scopées, ces deux règles ne s'appliquaient à rien : Astro les compile
   en .plan-spotlight[data-astro-cid-…] et le script ne pose pas cet
   attribut. La nappe lumineuse au survol ne fonctionnait donc pas du
   tout, et un div vide restait dans le flux de la carte.
   L'ancrage sur .plan-card garde la règle chez elle. */
.plan-card :global(.plan-spotlight){position:absolute;inset:0;pointer-events:none;z-index:10;opacity:0;transition:opacity .3s;overflow:hidden}
.plan-card :global(.plan-spotlight::after){content:'';position:absolute;width:200%;height:200%;border-radius:50%;background:radial-gradient(circle,var(--accent-glow) 0%,rgb(from var(--accent-glow) r g b / 0) 40%);transform:translate(-50%,-50%);top:var(--sy,50%);left:var(--sx,50%)}
/* LE CTA RESTE COLLE AU BAS DE SA CARTE. « margin-top:auto » vivait
   dans l'ancienne regle .plan-cta, emportee avec le CSS des boutons :
   sans lui, les trois boutons remontent avec leur contenu et ne
   s'alignent plus d'une carte a l'autre. On ne garde que la mise en
   page — l'apparence vient du bouton interactif. */
.plan-cta{margin-top:auto;align-self:stretch}
.plan-card.plan-featured{
  border-color:var(--accent);
  box-shadow:0 0 0 1px var(--accent),var(--shadow-2);
}
.plan-badge{position:absolute;inset-x:0;top:-13px;display:flex;justify-content:center}
.plan-badge span{
  background:var(--accent);
  color:var(--on-accent);font-size:var(--fs-caption);font-weight:600;letter-spacing:0;
  padding:4px 12px;border-radius:100px;box-shadow:var(--shadow-1);
}
.plan-name{font-size:var(--fs-caption);font-weight:600;color:var(--text-muted);margin-bottom:12px}
.plan-range{display:flex;align-items:center;gap:6px;flex-wrap:nowrap}
.plan-from{font-size:clamp(20px,2.4vw,28px);font-weight:600;letter-spacing:-.03em;line-height:1;white-space:nowrap;font-variant-numeric:tabular-nums}
.plan-sep{font-size:clamp(14px,1.5vw,18px);color:var(--text-subtle);flex-shrink:0;line-height:1}
.plan-to{font-size:clamp(20px,2.4vw,28px);font-weight:600;letter-spacing:-.03em;line-height:1;color:var(--text-muted);white-space:nowrap;font-variant-numeric:tabular-nums}
/* Chasse fixe pendant que les chiffres montent, sinon ils tremblent.
   Les chiffres tabulaires sont plus larges : la taille descend d'un
   cran pour que « 1 200 € — 3 100 € » tienne encore sur une ligne. */
.plan-amount{font-size:clamp(23px,3vw,33px);font-weight:600;letter-spacing:-.04em;line-height:1;white-space:nowrap;font-variant-numeric:tabular-nums}
.plan-desc{font-size:var(--fs-caption);color:var(--text-muted);margin-top:5px;line-height:1.5}
/* La pastille des places restantes n'avait qu'une lueur doree pour
   fond : posee sur une carte deja translucide a 94 %, la soie remontait
   jusqu'a 83,74,52 sous son texte et le faisait tomber a 3,72:1. Teinte
   et bordure inchangees, un fond opaque s'ajoute dessous. */
.plan-spots{display:inline-flex;align-items:center;gap:5px;font-size:var(--fs-caption);font-weight:600;color:var(--accent-text);padding:4px 9px;
  background:var(--surface);
  background-image:linear-gradient(var(--accent-glow),var(--accent-glow));
  border:1px solid var(--accent);border-radius:6px;margin-bottom:14px}
.plan-spots-num{font-size:12px;font-weight:600;line-height:1}
.plan-divider{border:none;border-top:1px dashed var(--border-strong);margin:16px 0}
.plan-features{list-style:none;padding:0;margin:0 0 20px;display:flex;flex-direction:column;gap:8px;flex:1}
.plan-feature{display:flex;align-items:flex-start;gap:8px;font-size:var(--fs-caption);color:var(--text-muted);line-height:1.4}
.plan-feature-icon{width:16px;height:16px;border-radius:50%;background:var(--success-glow);border:1px solid var(--success);display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:1px}
.plan-feature-icon svg{width:8px;height:8px;stroke:var(--success);stroke-width:2.5;fill:none}

/* Le badge de garantie, centré sous la grille. Sa fenêtre et son
   habillage vivent dans le composant ; ici, seule sa place. */
/* LA GARANTIE, CENTREE SOUS LES CARTES.

   Cette regle etait MORTE. « plans-gar » est passee en prop a
   GarantieBadge, et c'est le composant qui pose la classe sur son
   <span> : ce <span> porte donc le marqueur de portee du COMPOSANT,
   pas celui de cette page. Astro compilait « .plans-gar[...-ndm5nux2] »
   quand l'element portait « ...-o32cia7a » — le selecteur ne pouvait
   pas mordre. Releve au pixel : margin-top calcule a 0px, et la
   pastille collee au bas des cartes, jusqu'a les chevaucher de 2 px a
   960 px de large.

   On sort donc la regle de la portee, ancree sur le <main> de la page
   pour qu'elle ne fuie pas ailleurs. Le centrage horizontal, lui, vient
   de .gar-plein (flex + justify-content:center) qui vit dans le
   composant et s'applique bien : il ne manquait que l'air au-dessus. */
#main-content :global(.plans-gar){
  margin-top:clamp(40px,6vh,72px);
  margin-bottom:clamp(8px,1.5vh,16px)}

/* ── CTA ── */
.cta-section{padding:clamp(32px,5vh,64px) 0 clamp(64px,10vh,120px);text-align:center;position:relative;z-index:1}
/* Même verre que les cartes : ce panneau n'avait qu'une lueur dorée
   translucide pour fond, la soie passait entière derrière son titre.
   Sa teinte et sa bordure ne changent pas, un fond opaque s'ajoute
   dessous. */
.cta-inner{
  max-width:580px;margin:0 auto;
  background:var(--bg);
  background-image:linear-gradient(var(--accent-glow),var(--accent-glow));
  border:1px solid var(--accent);border-radius:16px;
  padding:clamp(32px,4vw,52px);
}
.cta-title{font-size:clamp(20px,3vw,30px);font-weight:600;letter-spacing:-.02em;margin-bottom:12px}
/* Mesuré : sur un panneau teinté (or ou vert à ~13 %), le gris secondaire
   tombe juste sous AA en sombre — 4.48:1 et 4.1:1. Sur ces fonds-là, le
   texte secondaire prend l'encre pleine. */
.cta-sub{font-size:14px;color:var(--text);line-height:1.65;margin-bottom:28px}
.cta-btns{display:flex;gap:12px;justify-content:center;flex-wrap:wrap}

/* ── AMBIANCE ──
   Le shader WebGL plein écran a été retiré : violet/rose/jaune à 72 %
   d'opacité, il écrasait la page et rendait le mode clair illisible, pour
   un coût d'un requestAnimationFrame permanent. Même profondeur d'encre
   que l'accueil, en CSS, sans frais de GPU. */
.ambience{position:fixed;inset:0;z-index:0;pointer-events:none;overflow:hidden}
.amb-depth{position:absolute;inset:0;background:radial-gradient(ellipse 120% 80% at 70% -10%,var(--surface) 0%,rgb(from var(--surface) r g b / 0) 62%)}
.amb-streak{
  position:absolute;top:-6vh;right:-18vw;width:min(1100px,90vw);height:150px;
  background:radial-gradient(ellipse at 50% 50%,var(--accent-glow) 0%,rgb(from var(--accent-glow) r g b / 0) 72%);
  filter:blur(28px);transform:rotate(-28deg);
}
</style>

<FondTarifs />

<div class="ambience" aria-hidden="true" role="presentation">
  <div class="amb-depth"></div>
  <div class="amb-streak"></div>
</div>
<Header cta="Devis gratuit" ctaHref="/devis" />

<main id="main-content" tabindex="-1" style="position:relative;z-index:1">
  <div class="wrap" style="max-width:1040px">

    <!-- HERO -->
    <div class="prix-hero">
      <div class="prix-pill"><span class="prix-pill-dot"></span><span data-i18n="trf-pill">Tarifs 2026</span></div>
      <h1 class="prix-h1" data-i18n="trf-h1">Transparent.<br>Sans surprise.</h1>
      <p class="prix-sub" data-i18n="trf-sub">Un prix juste pour chaque projet. Vous savez exactement ce que vous payez avant de signer.</p>

      <!-- OFFRE LANCEMENT -->
      <div class="launch-band">
        <div class="launch-ico">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
        </div>
        <div class="launch-text">
          <p class="launch-tag" data-i18n="trf-launch-tag">Offre de lancement</p>
          <h2 class="launch-title" data-i18n="trf-launch-h">3 premiers clients à <strong>999&nbsp;€</strong> tout inclus</h2>
          <p class="launch-desc" data-i18n="trf-launch-d">Site vitrine complet, design sur mesure, responsive, SEO de base et 1 mois de support — à prix de lancement. Places très limitées.</p>
        </div>
        <div class="launch-spots">
          <span class="launch-num" id="launch-num">3</span>
