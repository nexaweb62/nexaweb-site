---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
---
<BaseLayout title="Tarifs — Nexa Web">
<style>
/* ── HERO ── */
.prix-hero{padding:clamp(56px,9vh,100px) 0 clamp(32px,5vh,56px);text-align:center;position:relative;z-index:1}
.prix-pill{display:inline-flex;align-items:center;gap:8px;border:1px solid var(--border-hi);border-radius:100px;padding:6px 16px;font-size:11px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--text-muted);margin-bottom:24px}
.prix-pill-dot{width:6px;height:6px;border-radius:50%;background:var(--accent);box-shadow:0 0 8px var(--accent)}
.prix-h1{font-size:clamp(32px,5.5vw,72px);font-weight:700;line-height:1.06;letter-spacing:-.03em;margin-bottom:16px}
.prix-sub{font-size:clamp(15px,1.4vw,17px);color:var(--text-muted);line-height:1.65;max-width:440px;margin:0 auto}

/* ── OFFRE LANCEMENT ── */
.launch-band{
  margin:clamp(32px,5vh,56px) auto 0;
  max-width:780px;
  background:linear-gradient(135deg,rgba(34,197,94,.12),rgba(34,197,94,.06));
  border:1px solid var(--green-ring);
  border-radius:14px;
  padding:clamp(24px,3vw,36px) clamp(24px,4vw,48px);
  display:flex;align-items:center;gap:24px;
  flex-wrap:wrap;
}
.launch-ico{
  width:56px;height:56px;border-radius:50%;background:var(--green-dim);border:1px solid var(--green-ring);
  display:flex;align-items:center;justify-content:center;flex-shrink:0;
}
.launch-ico svg{width:28px;height:28px;stroke:var(--green);stroke-width:2;fill:none}
.launch-text{flex:1;min-width:200px}
.launch-tag{font-size:10px;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:var(--green);margin-bottom:6px}
.launch-title{font-size:clamp(18px,2.5vw,26px);font-weight:700;letter-spacing:-.02em;line-height:1.1;margin-bottom:6px}
.launch-title strong{color:var(--green)}
.launch-desc{font-size:13px;color:var(--text-muted);line-height:1.6}
.launch-spots{
  display:flex;flex-direction:column;align-items:center;gap:4px;text-align:center;flex-shrink:0;
}
.launch-num{font-size:clamp(32px,5vw,48px);font-weight:700;color:var(--green);line-height:1;letter-spacing:-.03em}
.launch-num-label{font-size:11px;font-weight:600;color:var(--text-muted);letter-spacing:.06em}
@media(max-width:600px){.launch-band{flex-direction:column;text-align:center}.launch-spots{flex-direction:row;gap:12px;justify-content:center}}

/* ── RANGE SECTION ── */
.range-section{padding:clamp(48px,8vh,96px) 0;position:relative;z-index:1}
.section-tag{font-size:10px;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:var(--text-dim);margin-bottom:12px}
.section-title{font-size:clamp(22px,3.5vw,38px);font-weight:700;letter-spacing:-.02em;line-height:1.1;margin-bottom:8px}
.section-sub{font-size:14px;color:var(--text-muted);line-height:1.65;max-width:480px}

.range-card{
  border:1px solid var(--border-hi);border-radius:16px;
  background:var(--bg-card);overflow:hidden;margin-top:40px;
}
.range-top{
  padding:clamp(32px,4vw,48px);
  border-bottom:1px solid var(--border);
  display:flex;align-items:center;justify-content:space-between;gap:32px;flex-wrap:wrap;
}
.range-label{font-size:11px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--text-muted);margin-bottom:12px}
.range-prices{display:flex;align-items:baseline;gap:12px}
.range-from{font-size:clamp(40px,6vw,72px);font-weight:700;letter-spacing:-.04em;line-height:1}
.range-sep{font-size:24px;color:var(--text-dim)}
.range-to{font-size:clamp(40px,6vw,72px);font-weight:700;letter-spacing:-.04em;line-height:1;color:var(--text-muted)}
.range-plus{font-size:24px;color:var(--text-dim)}
.range-per{font-size:13px;color:var(--text-muted);margin-top:8px}

.range-bar-wrap{flex:1;min-width:220px}
.range-bar-labels{display:flex;justify-content:space-between;font-size:11px;color:var(--text-dim);margin-bottom:8px}
.range-bar-track{height:6px;background:var(--border-hi);border-radius:100px;position:relative;overflow:visible}
.range-bar-fill{
  position:absolute;left:0;top:0;bottom:0;width:100%;
  background:linear-gradient(90deg,var(--green),var(--accent));
  border-radius:100px;
}
.range-dots{position:absolute;top:50%;transform:translateY(-50%);width:100%;display:flex;justify-content:space-between;padding:0 2px}
.range-dot{
  width:14px;height:14px;border-radius:50%;background:var(--bg-card);
  border:2px solid var(--accent);transform:translateY(-50%);
  position:relative;cursor:default;
}
.range-dot::after{
  content:attr(data-label);
  position:absolute;top:18px;left:50%;transform:translateX(-50%);
  font-size:9px;font-weight:700;letter-spacing:.08em;white-space:nowrap;
  color:var(--text-muted);text-transform:uppercase;
}
.range-dot:first-child{border-color:var(--green)}
.range-dot:last-child{border-color:var(--text-muted)}

/* ── INCLUDED / FACTORS ── */
.range-bottom{display:grid;grid-template-columns:1fr 1fr;gap:0}
@media(max-width:680px){.range-bottom{grid-template-columns:1fr}}
.rb-col{padding:clamp(24px,3vw,36px) clamp(24px,4vw,40px)}
.rb-col:first-child{border-right:1px solid var(--border)}
@media(max-width:680px){.rb-col:first-child{border-right:none;border-bottom:1px solid var(--border)}}
.rb-title{font-size:11px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--text-muted);margin-bottom:18px}
.rb-list{display:flex;flex-direction:column;gap:10px}
.rb-item{display:flex;align-items:flex-start;gap:10px;font-size:13px;line-height:1.45;color:var(--text-muted)}
.rb-icon{width:18px;height:18px;border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:1px}
.rb-icon-ok{background:var(--green-dim);border:1px solid var(--green-ring)}
.rb-icon-ok svg{width:10px;height:10px;stroke:var(--green);stroke-width:2.5;fill:none}
.rb-icon-up{background:var(--accent-dim);border:1px solid var(--accent-ring)}
.rb-icon-up svg{width:10px;height:10px;stroke:var(--accent);stroke-width:2.5;fill:none}

/* ── CTA ── */
.cta-section{padding:clamp(32px,5vh,64px) 0 clamp(64px,10vh,120px);text-align:center;position:relative;z-index:1}
.cta-inner{
  max-width:580px;margin:0 auto;
  background:var(--accent-dim);border:1px solid var(--accent-ring);border-radius:16px;
  padding:clamp(32px,4vw,52px);
}
.cta-title{font-size:clamp(20px,3vw,30px);font-weight:700;letter-spacing:-.02em;margin-bottom:12px}
.cta-sub{font-size:14px;color:var(--text-muted);line-height:1.65;margin-bottom:28px}
.cta-btns{display:flex;gap:12px;justify-content:center;flex-wrap:wrap}

/* ── CANVAS ── */
#neon-bg{position:fixed;inset:0;z-index:0;pointer-events:none;opacity:.2}
</style>

<canvas id="neon-bg" aria-hidden="true"></canvas>
<Header cta="Devis gratuit" ctaHref="/devis" />

<main style="position:relative;z-index:1">
  <div class="wrap" style="max-width:1040px">

    <!-- HERO -->
    <div class="prix-hero">
      <div class="prix-pill"><span class="prix-pill-dot"></span>Tarifs 2026</div>
      <h1 class="prix-h1">Transparent.<br>Sans surprise.</h1>
      <p class="prix-sub">Un prix juste pour chaque projet. Vous savez exactement ce que vous payez avant de signer.</p>

      <!-- OFFRE LANCEMENT -->
      <div class="launch-band">
        <div class="launch-ico">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
        </div>
        <div class="launch-text">
          <p class="launch-tag">Offre de lancement</p>
          <h2 class="launch-title">3 premiers clients à <strong>1 000 €</strong> tout inclus</h2>
          <p class="launch-desc">Site vitrine complet, design sur mesure, responsive, SEO de base et 1 mois de support — à prix de lancement. Places très limitées.</p>
        </div>
        <div class="launch-spots">
          <span class="launch-num">3</span>
          <span class="launch-num-label">places restantes</span>
        </div>
      </div>
    </div>

    <!-- RANGE SECTION -->
    <div class="range-section">
      <p class="section-tag">Prix d'un site web</p>
      <h2 class="section-title">Combien coûte<br>votre site ?</h2>
      <p class="section-sub">Le prix dépend de vos besoins. Voici la fourchette habituelle pour un site professionnel réalisé par Nexa Web.</p>

      <div class="range-card">

        <!-- PRICE RANGE DISPLAY -->
        <div class="range-top">
          <div>
            <div class="range-label">Fourchette de prix</div>
            <div class="range-prices">
              <span class="range-from">800 €</span>
              <span class="range-sep">—</span>
              <span class="range-to">3 500 €</span>
              <span class="range-plus">+</span>
            </div>
            <p class="range-per">paiement unique · devis gratuit et sans engagement</p>
          </div>
          <div class="range-bar-wrap">
            <div class="range-bar-labels">
              <span>Vitrine</span>
              <span>Business</span>
              <span>E-commerce</span>
            </div>
            <div class="range-bar-track">
              <div class="range-bar-fill"></div>
              <div class="range-dots">
                <div class="range-dot" data-label="~900€"></div>
                <div class="range-dot" data-label="~1 600€"></div>
                <div class="range-dot" data-label="~3 000€"></div>
              </div>
            </div>
          </div>
        </div>

        <!-- INCLUDED / FACTORS -->
        <div class="range-bottom">
          <div class="rb-col">
            <p class="rb-title">Toujours inclus</p>
            <ul class="rb-list">
              <li class="rb-item">
                <span class="rb-icon rb-icon-ok"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></span>
                Design sur mesure adapté à votre activité
              </li>
              <li class="rb-item">
                <span class="rb-icon rb-icon-ok"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></span>
                Responsive mobile &amp; tablette
              </li>
              <li class="rb-item">
                <span class="rb-icon rb-icon-ok"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></span>
                Formulaire de contact fonctionnel
              </li>
              <li class="rb-item">
                <span class="rb-icon rb-icon-ok"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></span>
                SEO de base (balises, performance)
              </li>
              <li class="rb-item">
                <span class="rb-icon rb-icon-ok"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></span>
                Hébergement &amp; nom de domaine guidés
              </li>
              <li class="rb-item">
                <span class="rb-icon rb-icon-ok"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></span>
                Garantie satisfaction 30 jours
              </li>
            </ul>
          </div>
          <div class="rb-col">
            <p class="rb-title">Ce qui fait varier le prix</p>
            <ul class="rb-list">
              <li class="rb-item">
                <span class="rb-icon rb-icon-up"><svg viewBox="0 0 24 24"><polyline points="18 15 12 9 6 15"/></svg></span>
                Nombre de pages et de sections
              </li>
              <li class="rb-item">
                <span class="rb-icon rb-icon-up"><svg viewBox="0 0 24 24"><polyline points="18 15 12 9 6 15"/></svg></span>
                Boutique e-commerce avec paiement en ligne
              </li>
              <li class="rb-item">
                <span class="rb-icon rb-icon-up"><svg viewBox="0 0 24 24"><polyline points="18 15 12 9 6 15"/></svg></span>
                Espace client / tableau de bord admin
              </li>
              <li class="rb-item">
                <span class="rb-icon rb-icon-up"><svg viewBox="0 0 24 24"><polyline points="18 15 12 9 6 15"/></svg></span>
                Blog avec système de gestion de contenu
              </li>
              <li class="rb-item">
                <span class="rb-icon rb-icon-up"><svg viewBox="0 0 24 24"><polyline points="18 15 12 9 6 15"/></svg></span>
                SEO avancé et stratégie de contenu
              </li>
              <li class="rb-item">
                <span class="rb-icon rb-icon-up"><svg viewBox="0 0 24 24"><polyline points="18 15 12 9 6 15"/></svg></span>
                Durée du support après livraison
              </li>
            </ul>
          </div>
        </div>

      </div>
    </div>

    <!-- CTA -->
    <div class="cta-section">
      <div class="cta-inner">
        <h2 class="cta-title">Obtenez votre devis en 2 minutes</h2>
        <p class="cta-sub">Décrivez votre projet, on vous répond sous 24 h avec une estimation précise — gratuit et sans engagement.</p>
        <div class="cta-btns">
          <a href="/devis" class="btn">Demander un devis gratuit →</a>
          <a href="/contact" class="btn-g">Nous contacter</a>
        </div>
      </div>
    </div>

  </div>
</main>

<Footer />

<script>
(function(){
  const c=document.getElementById('neon-bg');
  if(!c)return;
  const g=c.getContext('2d');
  let W=0,H=0;
  const tubes=[];
  function resize(){W=c.width=innerWidth;H=c.height=innerHeight}
  function rand(a,b){return a+Math.random()*(b-a)}
  function mkTube(){
    const pts=[];const n=Math.floor(rand(4,8));
    for(let i=0;i<n;i++)pts.push({x:rand(0,W),y:rand(0,H)});
    return{pts,color:`hsl(${rand(250,290)},80%,60%)`,w:rand(.5,1.5),t:0,sp:rand(.002,.005),alpha:rand(.3,.7)};
  }
  function init(){resize();tubes.length=0;for(let i=0;i<10;i++)tubes.push(mkTube())}
  function catmull(pts,t){
    const n=pts.length;const seg=Math.min(Math.floor(t*(n-1)),n-2);
    const lt=(t*(n-1))-seg;
    const p0=pts[Math.max(seg-1,0)],p1=pts[seg],p2=pts[Math.min(seg+1,n-1)],p3=pts[Math.min(seg+2,n-1)];
    const t2=lt*lt,t3=t2*lt;
    return{x:.5*((2*p1.x)+(-p0.x+p2.x)*lt+(2*p0.x-5*p1.x+4*p2.x-p3.x)*t2+(-p0.x+3*p1.x-3*p2.x+p3.x)*t3),
           y:.5*((2*p1.y)+(-p0.y+p2.y)*lt+(2*p0.y-5*p1.y+4*p2.y-p3.y)*t2+(-p0.y+3*p1.y-3*p2.y+p3.y)*t3)};
  }
  function draw(){
    g.clearRect(0,0,W,H);
    for(const tb of tubes){
      tb.t=(tb.t+tb.sp)%1;
      g.beginPath();
      for(let i=0;i<=60;i++){const p=catmull(tb.pts,i/60);i===0?g.moveTo(p.x,p.y):g.lineTo(p.x,p.y)}
      g.strokeStyle=tb.color;g.lineWidth=tb.w;g.globalAlpha=tb.alpha*.25;g.stroke();
      const head=catmull(tb.pts,tb.t);
      const gl=g.createRadialGradient(head.x,head.y,0,head.x,head.y,20);
      gl.addColorStop(0,tb.color);gl.addColorStop(1,'transparent');
      g.beginPath();g.arc(head.x,head.y,20,0,Math.PI*2);g.fillStyle=gl;g.globalAlpha=tb.alpha*.55;g.fill();
      g.globalAlpha=1;
    }
    requestAnimationFrame(draw);
  }
  window.addEventListener('resize',()=>{resize();init()},{passive:true});
  init();draw();
})();
</script>
</BaseLayout>
