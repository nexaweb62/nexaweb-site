---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
---
<BaseLayout title="Tarifs — Nexa Web">
<style>
/* ── HERO ── */
.prix-hero{padding:clamp(56px,9vh,100px) 0 clamp(32px,5vh,64px);text-align:center;position:relative;z-index:1}
.prix-pill{display:inline-flex;align-items:center;gap:8px;border:1px solid var(--border-hi);border-radius:100px;padding:6px 16px;font-size:11px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--text-muted);margin-bottom:24px}
.prix-pill-dot{width:6px;height:6px;border-radius:50%;background:var(--green);box-shadow:0 0 8px var(--green)}
.prix-h1{font-size:clamp(32px,5.5vw,72px);font-weight:700;line-height:1.06;letter-spacing:-.03em;margin-bottom:20px}
.prix-sub{font-size:clamp(15px,1.4vw,17px);color:var(--text-muted);line-height:1.65;max-width:460px;margin:0 auto 32px}
.guarantee-band{display:inline-flex;align-items:center;gap:10px;border:1px solid var(--green-ring);border-radius:100px;padding:8px 20px;font-size:12px;font-weight:600;color:var(--green)}
.guarantee-band svg{width:16px;height:16px;stroke:var(--green);stroke-width:2;fill:none;flex-shrink:0}

/* ── GRID ── */
.prix-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;padding-bottom:clamp(64px,10vh,120px)}
@media(max-width:900px){.prix-grid{grid-template-columns:1fr;max-width:480px;margin:0 auto}}

/* ── CARD ── */
.prix-card{border:1px solid var(--border);border-radius:12px;overflow:hidden;background:var(--bg-card);display:flex;flex-direction:column;transition:border-color .25s,transform .25s}
.prix-card:hover{border-color:var(--border-hi);transform:translateY(-3px)}
.prix-card.featured{border-color:var(--accent-ring);transform:scale(1.04)}
.prix-card.featured:hover{transform:scale(1.04) translateY(-3px)}

.card-img-wrap{position:relative;height:180px;overflow:hidden;background:var(--bg-alt)}
.card-img-inner{width:100%;height:100%;display:flex;align-items:center;justify-content:center}
.card-icon{width:72px;height:72px;border-radius:16px;display:flex;align-items:center;justify-content:center;background:var(--accent-dim);border:1px solid var(--accent-ring)}
.card-icon svg{width:36px;height:36px;stroke:var(--accent);stroke-width:1.5;fill:none}
.featured .card-icon{background:rgba(139,92,246,.25)}
.card-img-overlay{position:absolute;inset:0;background:linear-gradient(180deg,transparent 40%,var(--bg-card))}

.card-body{padding:24px;flex:1;display:flex;flex-direction:column}
.card-badge{display:inline-block;font-size:9px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;padding:3px 10px;border-radius:100px;margin-bottom:14px;align-self:flex-start}
.badge-std{background:var(--border-hi);color:var(--text-muted)}
.badge-pop{background:var(--accent-dim);color:var(--accent);border:1px solid var(--accent-ring)}
.badge-prem{background:rgba(234,179,8,.1);color:#ca8a04;border:1px solid rgba(234,179,8,.3)}
:root[data-theme="light"] .badge-prem{color:#a16207}

.card-name{font-size:19px;font-weight:700;letter-spacing:-.01em;margin-bottom:6px}
.card-tagline{font-size:13px;color:var(--text-muted);line-height:1.5;margin-bottom:20px}
.card-price{margin-bottom:20px}
.card-price-num{font-size:clamp(36px,4vw,48px);font-weight:700;letter-spacing:-.03em;line-height:1}
.featured .card-price-num{background:linear-gradient(135deg,var(--accent),#60a5fa);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.card-price-label{font-size:12px;color:var(--text-muted);margin-top:4px}

.card-features{list-style:none;margin-bottom:auto;padding-bottom:24px;display:flex;flex-direction:column;gap:10px}
.card-feature{display:flex;align-items:flex-start;gap:10px;font-size:13px;line-height:1.45;color:var(--text-muted)}
.feat-icon{width:18px;height:18px;border-radius:50%;background:var(--accent-dim);border:1px solid var(--accent-ring);display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:1px}
.feat-icon svg{width:10px;height:10px;stroke:var(--accent);stroke-width:2.5;fill:none}
.card-cta{display:block;text-align:center;font-size:12px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;padding:12px 20px;border-radius:6px;transition:opacity .2s,transform .2s;margin-top:4px}
.card-cta:hover{opacity:.82;transform:translateY(-1px)}
.card-cta.ghost{border:1px solid var(--ghost-border);color:var(--text)}
.card-cta.primary{background:var(--accent);color:#fff}

/* ── GUARANTEE ── */
.guarantee-section{background:var(--bg-alt);border:1px solid var(--green-ring);border-radius:12px;padding:clamp(32px,4vw,48px);text-align:center;margin-bottom:clamp(64px,10vh,120px)}
.guarantee-ico{width:52px;height:52px;border-radius:50%;background:var(--green-dim);border:1px solid var(--green-ring);display:flex;align-items:center;justify-content:center;margin:0 auto 16px}
.guarantee-ico svg{width:26px;height:26px;stroke:var(--green);stroke-width:2;fill:none}
.guarantee-title{font-size:clamp(18px,2.5vw,24px);font-weight:700;letter-spacing:-.01em;margin-bottom:10px}
.guarantee-desc{font-size:14px;color:var(--text-muted);line-height:1.65;max-width:480px;margin:0 auto}

/* ── CANVAS ── */
#neon-bg{position:fixed;inset:0;z-index:0;pointer-events:none;opacity:.25}
</style>

<canvas id="neon-bg"></canvas>
<Header cta="Démarrer" ctaHref="/devis" />

<main style="position:relative;z-index:1">
  <div class="wrap" style="max-width:1160px">

    <!-- HERO -->
    <div class="prix-hero">
      <div class="prix-pill"><span class="prix-pill-dot"></span>Tarifs 2026</div>
      <h1 class="prix-h1">Des prix honnêtes,<br>zéro mauvaise surprise.</h1>
      <p class="prix-sub">Tout est inclus dans le prix affiché. Pas de frais cachés, pas d'abonnement imposé.</p>
      <div class="guarantee-band">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        Satisfait ou on retravaille — garantie 30 jours
      </div>
    </div>

    <!-- CARDS -->
    <div class="prix-grid">

      <!-- Vitrine -->
      <article class="prix-card">
        <div class="card-img-wrap">
          <div class="card-img-inner">
            <div class="card-icon">
              <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg>
            </div>
          </div>
          <div class="card-img-overlay"></div>
        </div>
        <div class="card-body">
          <span class="card-badge badge-std">Essentiel</span>
          <h2 class="card-name">Vitrine</h2>
          <p class="card-tagline">Parfait pour lancer votre présence en ligne rapidement.</p>
          <div class="card-price">
            <div class="card-price-num">790 €</div>
            <div class="card-price-label">paiement unique · livraison 7–10 j</div>
          </div>
          <ul class="card-features">
            <li class="card-feature"><span class="feat-icon"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></span>Jusqu'à 5 pages</li>
            <li class="card-feature"><span class="feat-icon"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></span>Design sur mesure</li>
            <li class="card-feature"><span class="feat-icon"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></span>Responsive mobile</li>
            <li class="card-feature"><span class="feat-icon"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></span>Formulaire de contact</li>
            <li class="card-feature"><span class="feat-icon"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></span>SEO de base</li>
            <li class="card-feature"><span class="feat-icon"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></span>1 mois de support</li>
          </ul>
          <a href="/devis" class="card-cta ghost">Démarrer →</a>
        </div>
      </article>

      <!-- Business (featured) -->
      <article class="prix-card featured">
        <div class="card-img-wrap">
          <div class="card-img-inner">
            <div class="card-icon">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
            </div>
          </div>
          <div class="card-img-overlay"></div>
        </div>
        <div class="card-body">
          <span class="card-badge badge-pop">Le plus populaire</span>
          <h2 class="card-name">Business</h2>
          <p class="card-tagline">La solution complète pour les entreprises qui veulent performer.</p>
          <div class="card-price">
            <div class="card-price-num">1 490 €</div>
            <div class="card-price-label">paiement unique · livraison 14–21 j</div>
          </div>
          <ul class="card-features">
            <li class="card-feature"><span class="feat-icon"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></span>Jusqu'à 12 pages</li>
            <li class="card-feature"><span class="feat-icon"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></span>Design premium</li>
            <li class="card-feature"><span class="feat-icon"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></span>Espace client sécurisé</li>
            <li class="card-feature"><span class="feat-icon"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></span>SEO avancé + blog</li>
            <li class="card-feature"><span class="feat-icon"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></span>Google Analytics</li>
            <li class="card-feature"><span class="feat-icon"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></span>3 mois de support</li>
          </ul>
          <a href="/devis" class="card-cta primary">Démarrer →</a>
        </div>
      </article>

      <!-- Premium -->
      <article class="prix-card">
        <div class="card-img-wrap">
          <div class="card-img-inner">
            <div class="card-icon">
              <svg viewBox="0 0 24 24" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            </div>
          </div>
          <div class="card-img-overlay"></div>
        </div>
        <div class="card-body">
          <span class="card-badge badge-prem">Premium</span>
          <h2 class="card-name">Premium</h2>
          <p class="card-tagline">Pour les projets ambitieux avec e-commerce et fonctionnalités avancées.</p>
          <div class="card-price">
            <div class="card-price-num">2 490 €</div>
            <div class="card-price-label">paiement unique · livraison 21–35 j</div>
          </div>
          <ul class="card-features">
            <li class="card-feature"><span class="feat-icon"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></span>Pages illimitées</li>
            <li class="card-feature"><span class="feat-icon"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></span>E-commerce complet</li>
            <li class="card-feature"><span class="feat-icon"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></span>Paiement en ligne</li>
            <li class="card-feature"><span class="feat-icon"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></span>SEO expert + stratégie</li>
            <li class="card-feature"><span class="feat-icon"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></span>Tableau de bord admin</li>
            <li class="card-feature"><span class="feat-icon"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></span>6 mois de support</li>
          </ul>
          <a href="/devis" class="card-cta ghost">Démarrer →</a>
        </div>
      </article>

    </div>

    <!-- GUARANTEE -->
    <div class="guarantee-section">
      <div class="guarantee-ico">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
      </div>
      <h2 class="guarantee-title">Garantie satisfaction 30 jours</h2>
      <p class="guarantee-desc">Si le résultat ne vous convient pas dans les 30 jours suivant la livraison, nous retravaillons le projet jusqu'à ce qu'il corresponde parfaitement à vos attentes. Votre investissement est protégé.</p>
    </div>

  </div>
</main>

<Footer />

<script>
(function(){
  const c=document.getElementById('neon-bg');
  if(!c)return;
  const g=c.getContext('2d');
  let W=0,H=0,rAF=0;
  const tubes=[];
  function resize(){W=c.width=innerWidth;H=c.height=innerHeight}
  function rand(a,b){return a+Math.random()*(b-a)}
  function mkTube(){
    const pts=[];const n=Math.floor(rand(4,8));
    for(let i=0;i<n;i++)pts.push({x:rand(0,W),y:rand(0,H)});
    return{pts,color:`hsl(${rand(250,290)},80%,60%)`,w:rand(.5,2),t:0,sp:rand(.002,.006),alpha:rand(.3,.8)};
  }
  function init(){resize();tubes.length=0;for(let i=0;i<12;i++)tubes.push(mkTube())}
  function catmull(pts,t){
    const n=pts.length;const seg=Math.min(Math.floor(t*(n-1)),n-2);
    const lt=(t*(n-1))-seg;
    const p0=pts[Math.max(seg-1,0)],p1=pts[seg],p2=pts[Math.min(seg+1,n-1)],p3=pts[Math.min(seg+2,n-1)];
    const t2=lt*lt,t3=t2*lt;
    return{x:.5*((2*p1.x)+(-p0.x+p2.x)*lt+(2*p0.x-5*p1.x+4*p2.x-p3.x)*t2+(-p0.x+3*p1.x-3*p2.x+p3.x)*t3),
           y:.5*((2*p1.y)+(-p0.y+p2.y)*lt+(2*p0.y-5*p1.y+4*p2.y-p3.y)*t2+(-p0.y+3*p1.y-3*p2.y+p3.y)*t3)};
  }
  function draw(){
    g.clearRect(0,0,W,H);
    for(const tb of tubes){
      tb.t=(tb.t+tb.sp)%1;
      g.beginPath();
      for(let i=0;i<=60;i++){const p=catmull(tb.pts,i/60);i===0?g.moveTo(p.x,p.y):g.lineTo(p.x,p.y)}
      g.strokeStyle=tb.color;g.lineWidth=tb.w;g.globalAlpha=tb.alpha*.3;g.stroke();
      const head=catmull(tb.pts,tb.t);
      const gl=g.createRadialGradient(head.x,head.y,0,head.x,head.y,24);
      gl.addColorStop(0,tb.color);gl.addColorStop(1,'transparent');
      g.beginPath();g.arc(head.x,head.y,24,0,Math.PI*2);g.fillStyle=gl;g.globalAlpha=tb.alpha*.6;g.fill();
      g.globalAlpha=1;
    }
    rAF=requestAnimationFrame(draw);
  }
  window.addEventListener('resize',()=>{resize();init()});
  init();draw();
})();
</script>
</BaseLayout>
