---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import { REFONTE_PRIX, REFONTE_DELAI } from '../data/formules';
---
<BaseLayout title="Tarifs — Nexa Web" description="Refonte de site dès 490 €, Vitrine Pro à 1 000 € (offre de lancement, places limitées) et Entreprise de 1 200 à 3 100 €. Devis gratuit — Nexa Web, Carvin.">
<style>
/* ── HERO ── */
.prix-hero{padding:clamp(56px,9vh,100px) 0 clamp(32px,5vh,56px);text-align:center;position:relative;z-index:1}
.prix-pill{display:inline-flex;align-items:center;gap:8px;border:1px solid var(--border-strong);border-radius:100px;padding:6px 16px;font-size:var(--fs-caption);font-weight:600;letter-spacing:0;color:var(--text-muted);margin-bottom:24px}
.prix-pill-dot{width:6px;height:6px;border-radius:50%;background:var(--accent);box-shadow:0 0 8px var(--accent)}
.prix-h1{font-size:clamp(32px,5.5vw,72px);font-weight:600;line-height:1.06;letter-spacing:-.03em;margin-bottom:16px}
.prix-sub{font-size:clamp(15px,1.4vw,17px);color:var(--text-muted);line-height:1.65;max-width:440px;margin:0 auto}

/* ── OFFRE LANCEMENT ── */
.launch-band{
  margin:clamp(32px,5vh,56px) auto 0;
  max-width:780px;
  background:var(--success-glow);
  border:1px solid var(--success);
  border-radius:14px;
  padding:clamp(24px,3vw,36px) clamp(24px,4vw,48px);
  display:flex;align-items:center;gap:24px;
  flex-wrap:wrap;
}
.launch-ico{
  width:56px;height:56px;border-radius:50%;background:var(--success-glow);border:1px solid var(--success);
  display:flex;align-items:center;justify-content:center;flex-shrink:0;
}
.launch-ico svg{width:28px;height:28px;stroke:var(--success);stroke-width:2;fill:none}
.launch-text{flex:1;min-width:200px}
.launch-tag{font-size:var(--fs-caption);font-weight:600;letter-spacing:0;color:var(--success);margin-bottom:6px}
.launch-title{font-size:clamp(18px,2.5vw,26px);font-weight:600;letter-spacing:-.02em;line-height:1.1;margin-bottom:6px}
.launch-title strong{color:var(--success)}
.launch-desc{font-size:13px;color:var(--text-muted);line-height:1.6}
.launch-spots{
  display:flex;flex-direction:column;align-items:center;gap:4px;text-align:center;flex-shrink:0;
}
.launch-num{font-size:clamp(32px,5vw,48px);font-weight:600;color:var(--success);line-height:1;letter-spacing:-.03em}
.launch-num-label{font-size:var(--fs-caption);font-weight:600;color:var(--text-muted);letter-spacing:0}
@media(max-width:600px){.launch-band{flex-direction:column;text-align:center}.launch-spots{flex-direction:row;gap:12px;justify-content:center}}

/* ── FORMULES ── */
.plans-section{padding:clamp(32px,5vh,56px) 0 clamp(48px,7vh,72px);position:relative;z-index:1}
/* Ces deux classes existaient dans le balisage depuis l'origine sans
   qu'aucune règle ne les cible : le titre de section tombait sur le
   style h2 par défaut du navigateur — trop petit, interligne trop
   lâche. Elles prennent l'échelle. */
.section-tag{font-size:var(--fs-caption);font-weight:600;letter-spacing:0;color:var(--accent-text);margin:0 0 14px}
.section-title{
  font-size:var(--fs-section);font-weight:var(--w-semi);
  letter-spacing:var(--ls-section);line-height:var(--lh-section);
  margin:0 0 clamp(28px,4vh,44px);text-wrap:balance;
}
/* Trois formules : trois colonnes. Deux laisseraient une carte
   orpheline sur sa ligne. La bascule est a 900 px et non a 760 :
   mesure, a 760 px trois colonnes debordent de 31 px. */
.plans-grid{display:grid;grid-template-columns:1fr;gap:16px;margin-top:clamp(32px,5vw,52px);
  max-width:480px;margin-left:auto;margin-right:auto}
@media(min-width:900px){.plans-grid{grid-template-columns:repeat(3,1fr);gap:20px;max-width:none}}
/* « dès » : un prefixe, pas un prix. Il ne doit pas peser autant. */
.plan-pre{font-size:.46em;font-weight:500;letter-spacing:.02em;color:var(--text-muted);
  margin-right:.12em;vertical-align:.32em}
@media(max-width:600px){
  .plan-card{padding:14px 14px}
  .plan-name{font-size:var(--fs-caption);margin-bottom:8px}
  .plan-from,.plan-to{font-size:20px}
  .plan-amount{font-size:21px}
  .plan-sep{font-size:13px}
  .plan-desc{font-size:var(--fs-caption)}
  .plan-feature{font-size:var(--fs-caption);gap:6px}
  .plan-feature-icon{width:14px;height:14px}
  .plan-feature-icon svg{width:7px;height:7px}
  .plan-spots{font-size:var(--fs-caption);padding:4px 8px}
  .plan-spots-num{font-size:12px}
  .plan-divider{margin:12px 0}
  .plan-features{gap:7px;margin-bottom:16px}
  .btn,.btn-g{font-size:var(--fs-caption);padding:10px 16px}
}
.plan-card{
  position:relative;display:flex;flex-direction:column;
  background:var(--surface);border:1px solid var(--border-strong);border-radius:16px;
  padding:clamp(18px,2.2vw,26px);transition:border-color .25s,transform .2s ease-out;
  will-change:transform;transform-style:preserve-3d;
}
.plan-card:hover{border-color:var(--accent)}
/* INJECTÉ EN JAVASCRIPT dans chaque .plan-card — d'où :global().
   Scopées, ces deux règles ne s'appliquaient à rien : Astro les compile
   en .plan-spotlight[data-astro-cid-…] et le script ne pose pas cet
   attribut. La nappe lumineuse au survol ne fonctionnait donc pas du
   tout, et un div vide restait dans le flux de la carte.
   L'ancrage sur .plan-card garde la règle chez elle. */
.plan-card :global(.plan-spotlight){position:absolute;inset:0;pointer-events:none;z-index:10;opacity:0;transition:opacity .3s;overflow:hidden}
.plan-card :global(.plan-spotlight::after){content:'';position:absolute;width:200%;height:200%;border-radius:50%;background:radial-gradient(circle,var(--accent-glow) 0%,rgb(from var(--accent-glow) r g b / 0) 40%);transform:translate(-50%,-50%);top:var(--sy,50%);left:var(--sx,50%)}
.plan-card.plan-featured{
  border-color:var(--accent);
  box-shadow:0 0 0 1px var(--accent),var(--shadow-2);
}
.plan-badge{position:absolute;inset-x:0;top:-13px;display:flex;justify-content:center}
.plan-badge span{
  background:var(--accent);
  color:var(--on-accent);font-size:var(--fs-caption);font-weight:600;letter-spacing:0;
  padding:4px 12px;border-radius:100px;box-shadow:var(--shadow-1);
}
.plan-name{font-size:var(--fs-caption);font-weight:600;color:var(--text-muted);margin-bottom:12px}
.plan-range{display:flex;align-items:center;gap:6px;flex-wrap:nowrap}
.plan-from{font-size:clamp(20px,2.4vw,28px);font-weight:600;letter-spacing:-.03em;line-height:1;white-space:nowrap;font-variant-numeric:tabular-nums}
.plan-sep{font-size:clamp(14px,1.5vw,18px);color:var(--text-subtle);flex-shrink:0;line-height:1}
.plan-to{font-size:clamp(20px,2.4vw,28px);font-weight:600;letter-spacing:-.03em;line-height:1;color:var(--text-muted);white-space:nowrap;font-variant-numeric:tabular-nums}
/* Chasse fixe pendant que les chiffres montent, sinon ils tremblent.
   Les chiffres tabulaires sont plus larges : la taille descend d'un
   cran pour que « 1 200 € — 3 100 € » tienne encore sur une ligne. */
.plan-amount{font-size:clamp(23px,3vw,33px);font-weight:600;letter-spacing:-.04em;line-height:1;white-space:nowrap;font-variant-numeric:tabular-nums}
.plan-desc{font-size:var(--fs-caption);color:var(--text-muted);margin-top:5px;line-height:1.5}
.plan-spots{display:inline-flex;align-items:center;gap:5px;font-size:var(--fs-caption);font-weight:600;color:var(--accent-text);padding:4px 9px;background:var(--accent-glow);border:1px solid var(--accent);border-radius:6px;margin-bottom:14px}
.plan-spots-num{font-size:12px;font-weight:600;line-height:1}
.plan-divider{border:none;border-top:1px dashed var(--border-strong);margin:16px 0}
.plan-features{list-style:none;padding:0;margin:0 0 20px;display:flex;flex-direction:column;gap:8px;flex:1}
.plan-feature{display:flex;align-items:flex-start;gap:8px;font-size:var(--fs-caption);color:var(--text-muted);line-height:1.4}
.plan-feature-icon{width:16px;height:16px;border-radius:50%;background:var(--success-glow);border:1px solid var(--success);display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:1px}
.plan-feature-icon svg{width:8px;height:8px;stroke:var(--success);stroke-width:2.5;fill:none}
.plan-cta{display:block;text-align:center;margin-top:auto}

/* ── CTA ── */
.cta-section{padding:clamp(32px,5vh,64px) 0 clamp(64px,10vh,120px);text-align:center;position:relative;z-index:1}
.cta-inner{
  max-width:580px;margin:0 auto;
  background:var(--accent-glow);border:1px solid var(--accent);border-radius:16px;
  padding:clamp(32px,4vw,52px);
}
.cta-title{font-size:clamp(20px,3vw,30px);font-weight:600;letter-spacing:-.02em;margin-bottom:12px}
/* Mesuré : sur un panneau teinté (or ou vert à ~13 %), le gris secondaire
   tombe juste sous AA en sombre — 4.48:1 et 4.1:1. Sur ces fonds-là, le
   texte secondaire prend l'encre pleine. */
.cta-sub{font-size:14px;color:var(--text);line-height:1.65;margin-bottom:28px}
.cta-btns{display:flex;gap:12px;justify-content:center;flex-wrap:wrap}

/* ── AMBIANCE ──
   Le shader WebGL plein écran a été retiré : violet/rose/jaune à 72 %
   d'opacité, il écrasait la page et rendait le mode clair illisible, pour
   un coût d'un requestAnimationFrame permanent. Même profondeur d'encre
   que l'accueil, en CSS, sans frais de GPU. */
.ambience{position:fixed;inset:0;z-index:0;pointer-events:none;overflow:hidden}
.amb-depth{position:absolute;inset:0;background:radial-gradient(ellipse 120% 80% at 70% -10%,var(--surface) 0%,rgb(from var(--surface) r g b / 0) 62%)}
.amb-streak{
  position:absolute;top:-6vh;right:-18vw;width:min(1100px,90vw);height:150px;
  background:radial-gradient(ellipse at 50% 50%,var(--accent-glow) 0%,rgb(from var(--accent-glow) r g b / 0) 72%);
  filter:blur(28px);transform:rotate(-28deg);
}
</style>

<div class="ambience" aria-hidden="true" role="presentation">
  <div class="amb-depth"></div>
  <div class="amb-streak"></div>
</div>
<Header cta="Devis gratuit" ctaHref="/devis" />

<main id="main-content" tabindex="-1" style="position:relative;z-index:1">
  <div class="wrap" style="max-width:1040px">

    <!-- HERO -->
    <div class="prix-hero">
      <div class="prix-pill"><span class="prix-pill-dot"></span><span data-i18n="trf-pill">Tarifs 2026</span></div>
