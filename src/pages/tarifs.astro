    </div>

    <!-- FORMULES -->
    <div class="plans-section">
      <p class="section-tag" data-i18n="trf-plans-tag">Choisissez votre formule</p>
      <h2 class="section-title" data-i18n="trf-plans-h">La formule<br>adaptée à votre profil.</h2>

      <div class="plans-grid">

        <!-- Refonte de site -->
        <div class="plan-card">
          <p class="plan-name" data-i18n="trf-p4-name">Refonte de site</p>
          <div>
