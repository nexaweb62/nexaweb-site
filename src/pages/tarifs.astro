<script is:inline>
(function(){
'use strict';

/* ── L'ÉCHÉANCIER SUIT LE VISITEUR JUSQU'AU DEVIS ───────────────────
   Le choix « en une fois / en 3 fois / en 4 fois » est un basculement
   purement CSS : trois radios et des :has(). Rien ne le transportait
   plus loin, et la page Devis l'ignorait donc complètement.

   On l'écrit dans l'adresse des trois boutons de formule. Sans
   JavaScript le lien marche toujours, simplement sans le paramètre :
   la page Devis retombe alors sur le comptant, son état par défaut.

   On reconstruit l'adresse au lieu d'y coller « &paiement=… » : un
   second choix ajouterait sinon un second paramètre, et le dernier
   gagnerait — « ?formule=vitrine&paiement=3&paiement=4 ». */
(function echeancier(){
  var seg = document.querySelector('.paie-seg');
  if(!seg) return;
  var liens = [].slice.call(document.querySelectorAll('.plan-cta[href^="/devis"]'));
  if(!liens.length) return;
  liens.forEach(function(a){ a.dataset.base = a.getAttribute('href'); });

  function choix(){
    var r = seg.querySelector('.paie-radio:checked');
    if(!r) return 'comptant';
    return r.id === 'paie-3' ? '3' : r.id === 'paie-4' ? '4' : 'comptant';
  }
  function peindre(){
    var p = choix();
    liens.forEach(function(a){
      var u = new URL(a.dataset.base, location.origin);
      if(p === 'comptant') u.searchParams.delete('paiement');
      else u.searchParams.set('paiement', p);
      a.setAttribute('href', u.pathname + u.search);
    });
  }
  seg.addEventListener('change', peindre);
  peindre();
})();

/* ── Vitrine Pro : spots restants depuis Supabase ── */
function initSpots(){
  if(!window.sb)return;
  window.sb.from('nw_config').select('value').eq('key','vitrine_pro_spots').single()
    .then(function(r){
      if(r.error||!r.data)return;
      var n=parseInt(r.data.value,10);
      if(isNaN(n))return;
      var card=document.getElementById('plan-vitrine');
      if(!card)return;
      if(n<=0){card.remove();return;}
      var el=document.getElementById('vp-spots-num');
      if(el)el.textContent=n;
      var launchNum=document.getElementById('launch-num');
      if(launchNum)launchNum.textContent=n;
    });
}
setTimeout(initSpots,500);

/* ── TILT CARDS ── */
(function(){
  var LIMIT=15,SCALE=1.05,PERSP=1200;
  document.querySelectorAll('.plan-card').forEach(function(card){
    /* inject spotlight */
    var sp=document.createElement('div');
    sp.className='plan-spotlight';
    sp.setAttribute('aria-hidden','true');   /* décor : jamais annoncé, jamais compté comme contenu */
    card.appendChild(sp);

    card.addEventListener('pointerenter',function(){
      sp.style.opacity='1';
    });
    card.addEventListener('pointermove',function(e){
      var r=card.getBoundingClientRect();
      var px=(e.clientX-r.left)/r.width;
      var py=(e.clientY-r.top)/r.height;
      /* effect="evade" → dir=-1 */
      var xRot=((py-.5)*LIMIT*2*-1).toFixed(2);
      var yRot=((px-.5)*LIMIT*2).toFixed(2);
      card.style.transform='perspective('+PERSP+'px) rotateX('+xRot+'deg) rotateY('+yRot+'deg) scale3d('+SCALE+','+SCALE+','+SCALE+')';
      sp.style.setProperty('--sx',(px*100)+'%');
      sp.style.setProperty('--sy',(py*100)+'%');
    });
    card.addEventListener('pointerleave',function(){
      card.style.transform='perspective('+PERSP+'px) rotateX(0deg) rotateY(0deg) scale3d(1,1,1)';
      sp.style.opacity='0';
    });
  });
})();
})();
</script>
