          </div>
          <div class="plan-spots">
            <span class="plan-spots-num" id="vp-spots-num">3</span>
            <span data-i18n="trf-spots">places restantes</span>
          </div>
          <hr class="plan-divider">
          <ul class="plan-features">
            <li class="plan-feature">
              <span class="plan-feature-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg></span>
              <span data-i18n="trf-p2-f1">Site vitrine complet (jusqu'à 5 pages)</span>
            </li>
            <li class="plan-feature">
              <span class="plan-feature-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg></span>
              <span data-i18n="trf-p2-f2">Design sur mesure</span>
            </li>
            <li class="plan-feature">
              <span class="plan-feature-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg></span>
              <span data-i18n="trf-p2-f3">Responsive mobile &amp; tablette</span>
            </li>
            <li class="plan-feature">
              <span class="plan-feature-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg></span>
              <span data-i18n="trf-p2-f4">SEO de base inclus</span>
            </li>
            <li class="plan-feature">
              <span class="plan-feature-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg></span>
              <span data-i18n="trf-p2-f5">Formulaire de contact</span>
            </li>
            <li class="plan-feature">
              <span class="plan-feature-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg></span>
              <span data-i18n="trf-p2-f6">1 mois de support inclus</span>
            </li>
          </ul>
          <a href="/devis?formule=vitrine" class="btn plan-cta" data-plan="vitrine" data-i18n="trf-p2-cta">Démarrer mon projet</a>
        </div>

        <!-- Entreprise -->
        <div class="plan-card">
          <p class="plan-name" data-i18n="trf-p3-name">Entreprise</p>
          <div>
            <div class="plan-range">
              <span class="plan-from" data-i18n="trf-p3-from">1 200 €</span>
              <span class="plan-sep">—</span>
              <span class="plan-to" data-i18n="trf-p3-to">3 100 €</span>
            </div>
            <p class="plan-desc" data-i18n="trf-p3-desc">Site professionnel ou e-commerce</p>
          </div>
          <hr class="plan-divider">
          <ul class="plan-features">
            <li class="plan-feature">
              <span class="plan-feature-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg></span>
              <span data-i18n="trf-p3-f1">Tout du plan Vitrine Pro</span>
            </li>
            <li class="plan-feature">
              <span class="plan-feature-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg></span>
              <span data-i18n="trf-p3-f2">E-commerce ou espace client</span>
            </li>
            <li class="plan-feature">
              <span class="plan-feature-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg></span>
              <span data-i18n="trf-p3-f3">SEO avancé &amp; stratégie de contenu</span>
            </li>
            <li class="plan-feature">
              <span class="plan-feature-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg></span>
              <span data-i18n="trf-p3-f4">Blog &amp; CMS intégré</span>
            </li>
            <li class="plan-feature">
              <span class="plan-feature-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg></span>
              <span data-i18n="trf-p3-f5">Intégrations sur mesure</span>
            </li>
            <li class="plan-feature">
              <span class="plan-feature-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg></span>
              <span data-i18n="trf-p3-f6">Support étendu</span>
            </li>
          </ul>
          <a href="/devis?formule=entreprise" class="btn-g plan-cta" data-plan="entreprise" data-i18n="trf-p3-cta">Obtenir un devis</a>
        </div>

      </div>
    </div>

    <!-- CTA -->
    <div class="cta-section">
      <div class="cta-inner">
        <h2 class="cta-title" data-i18n="trf-cta-h">Obtenez votre devis en 2 minutes</h2>
        <p class="cta-sub" data-i18n="trf-cta-sub">Décrivez votre projet, on vous répond sous 24 h avec une estimation précise — gratuit et sans engagement.</p>
        <div class="cta-btns">
          <a href="/devis" class="btn" data-i18n="trf-cta-btn1">Demander un devis gratuit →</a>
          <a href="/contact" class="btn-g" data-i18n="trf-cta-btn2">Nous contacter</a>
        </div>
      </div>
    </div>

  </div>
</main>

<Footer />

<script is:inline>
(function(){
'use strict';

/* ── Vitrine Pro : spots restants depuis Supabase ── */
function initSpots(){
  if(!window.sb)return;
  window.sb.from('nw_config').select('value').eq('key','vitrine_pro_spots').single()
    .then(function(r){
      if(r.error||!r.data)return;
      var n=parseInt(r.data.value,10);
      if(isNaN(n))return;
      var card=document.getElementById('plan-vitrine');
      if(!card)return;
      if(n<=0){card.remove();return;}
      var el=document.getElementById('vp-spots-num');
      if(el)el.textContent=n;
      var launchNum=document.getElementById('launch-num');
      if(launchNum)launchNum.textContent=n;
    });
}
setTimeout(initSpots,500);

/* ── TILT CARDS ── */
(function(){
  var LIMIT=15,SCALE=1.05,PERSP=1200;
  document.querySelectorAll('.plan-card').forEach(function(card){
    /* inject spotlight */
    var sp=document.createElement('div');
    sp.className='plan-spotlight';
    sp.setAttribute('aria-hidden','true');   /* décor : jamais annoncé, jamais compté comme contenu */
    card.appendChild(sp);

    card.addEventListener('pointerenter',function(){
      sp.style.opacity='1';
    });
    card.addEventListener('pointermove',function(e){
      var r=card.getBoundingClientRect();
      var px=(e.clientX-r.left)/r.width;
      var py=(e.clientY-r.top)/r.height;
      /* effect="evade" → dir=-1 */
      var xRot=((py-.5)*LIMIT*2*-1).toFixed(2);
      var yRot=((px-.5)*LIMIT*2).toFixed(2);
      card.style.transform='perspective('+PERSP+'px) rotateX('+xRot+'deg) rotateY('+yRot+'deg) scale3d('+SCALE+','+SCALE+','+SCALE+')';
      sp.style.setProperty('--sx',(px*100)+'%');
      sp.style.setProperty('--sy',(py*100)+'%');
    });
    card.addEventListener('pointerleave',function(){
      card.style.transform='perspective('+PERSP+'px) rotateX(0deg) rotateY(0deg) scale3d(1,1,1)';
      sp.style.opacity='0';
    });
  });
})();
})();
</script>
</BaseLayout>
