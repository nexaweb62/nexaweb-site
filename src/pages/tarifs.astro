---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
---
<BaseLayout title="Tarifs — Nexa Web" description="Formule Étudiant dès 100 €, Vitrine Pro à 1 000 € (offre de lancement, places limitées) et Entreprise de 1 200 à 3 100 €. Devis gratuit — Nexa Web, Carvin.">
<style>
/* ── HERO ── */
.prix-hero{padding:clamp(56px,9vh,100px) 0 clamp(32px,5vh,56px);text-align:center;position:relative;z-index:1}
.prix-pill{display:inline-flex;align-items:center;gap:8px;border:1px solid var(--border-strong);border-radius:100px;padding:6px 16px;font-size:11px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--text-muted);margin-bottom:24px}
.prix-pill-dot{width:6px;height:6px;border-radius:50%;background:var(--accent);box-shadow:0 0 8px var(--accent)}
.prix-h1{font-size:clamp(32px,5.5vw,72px);font-weight:700;line-height:1.06;letter-spacing:-.03em;margin-bottom:16px}
.prix-sub{font-size:clamp(15px,1.4vw,17px);color:var(--text-muted);line-height:1.65;max-width:440px;margin:0 auto}

/* ── OFFRE LANCEMENT ── */
.launch-band{
  margin:clamp(32px,5vh,56px) auto 0;
  max-width:780px;
  background:var(--success-glow);
  border:1px solid var(--success);
  border-radius:14px;
  padding:clamp(24px,3vw,36px) clamp(24px,4vw,48px);
  display:flex;align-items:center;gap:24px;
  flex-wrap:wrap;
}
.launch-ico{
  width:56px;height:56px;border-radius:50%;background:var(--success-glow);border:1px solid var(--success);
  display:flex;align-items:center;justify-content:center;flex-shrink:0;
}
.launch-ico svg{width:28px;height:28px;stroke:var(--success);stroke-width:2;fill:none}
.launch-text{flex:1;min-width:200px}
.launch-tag{font-size:10px;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:var(--success);margin-bottom:6px}
.launch-title{font-size:clamp(18px,2.5vw,26px);font-weight:700;letter-spacing:-.02em;line-height:1.1;margin-bottom:6px}
.launch-title strong{color:var(--success)}
.launch-desc{font-size:13px;color:var(--text-muted);line-height:1.6}
.launch-spots{
  display:flex;flex-direction:column;align-items:center;gap:4px;text-align:center;flex-shrink:0;
}
.launch-num{font-size:clamp(32px,5vw,48px);font-weight:700;color:var(--success);line-height:1;letter-spacing:-.03em}
.launch-num-label{font-size:11px;font-weight:600;color:var(--text-muted);letter-spacing:.06em}
@media(max-width:600px){.launch-band{flex-direction:column;text-align:center}.launch-spots{flex-direction:row;gap:12px;justify-content:center}}

/* ── FORMULES ── */
.plans-section{padding:clamp(32px,5vh,56px) 0 clamp(48px,7vh,72px);position:relative;z-index:1}
.plans-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:clamp(32px,5vw,52px)}
@media(max-width:900px){.plans-grid{grid-template-columns:1fr;max-width:480px;margin-left:auto;margin-right:auto}}
@media(max-width:600px){
  .plan-card{padding:14px 14px}
  .plan-name{font-size:10.5px;margin-bottom:8px}
  .plan-from,.plan-to{font-size:20px}
  .plan-amount{font-size:22px}
  .plan-sep{font-size:13px}
  .plan-desc{font-size:10px}
  .plan-feature{font-size:10.5px;gap:6px}
  .plan-feature-icon{width:14px;height:14px}
  .plan-feature-icon svg{width:7px;height:7px}
  .plan-spots{font-size:10px;padding:4px 8px}
  .plan-spots-num{font-size:12px}
  .plan-divider{margin:12px 0}
  .plan-features{gap:7px;margin-bottom:16px}
  .btn,.btn-g{font-size:10px;padding:10px 16px}
}
.plan-card{
  position:relative;display:flex;flex-direction:column;
  background:var(--surface);border:1px solid var(--border-strong);border-radius:16px;
  padding:clamp(18px,2.2vw,26px);transition:border-color .25s,transform .2s ease-out;
  will-change:transform;transform-style:preserve-3d;
}
.plan-card:hover{border-color:var(--accent)}
.plan-spotlight{position:absolute;inset:0;pointer-events:none;z-index:10;opacity:0;transition:opacity .3s;overflow:hidden}
.plan-spotlight::after{content:'';position:absolute;width:200%;height:200%;border-radius:50%;background:radial-gradient(circle,var(--accent-glow) 0%,rgb(from var(--accent-glow) r g b / 0) 40%);transform:translate(-50%,-50%);top:var(--sy,50%);left:var(--sx,50%)}
.plan-card.plan-featured{
  border-color:var(--accent);
  box-shadow:0 0 0 1px var(--accent),var(--shadow-2);
}
.plan-badge{position:absolute;inset-x:0;top:-13px;display:flex;justify-content:center}
.plan-badge span{
  background:var(--accent);
  color:var(--on-accent);font-size:9px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;
  padding:4px 12px;border-radius:100px;box-shadow:var(--shadow-1);
}
.plan-name{font-size:11px;font-weight:600;color:var(--text-muted);margin-bottom:12px}
.plan-range{display:flex;align-items:center;gap:6px;flex-wrap:nowrap}
.plan-from{font-size:clamp(22px,2.6vw,30px);font-weight:700;letter-spacing:-.03em;line-height:1;white-space:nowrap}
.plan-sep{font-size:clamp(14px,1.5vw,18px);color:var(--text-subtle);flex-shrink:0;line-height:1}
.plan-to{font-size:clamp(22px,2.6vw,30px);font-weight:700;letter-spacing:-.03em;line-height:1;color:var(--text-muted);white-space:nowrap}
.plan-amount{font-size:clamp(26px,3vw,36px);font-weight:700;letter-spacing:-.04em;line-height:1;white-space:nowrap}
.plan-desc{font-size:10.5px;color:var(--text-muted);margin-top:5px;line-height:1.5}
.plan-spots{display:inline-flex;align-items:center;gap:5px;font-size:10px;font-weight:600;color:var(--accent-text);padding:4px 9px;background:var(--accent-glow);border:1px solid var(--accent);border-radius:6px;margin-bottom:14px}
.plan-spots-num{font-size:12px;font-weight:700;line-height:1}
.plan-divider{border:none;border-top:1px dashed var(--border-strong);margin:16px 0}
.plan-features{list-style:none;padding:0;margin:0 0 20px;display:flex;flex-direction:column;gap:8px;flex:1}
.plan-feature{display:flex;align-items:flex-start;gap:8px;font-size:11.5px;color:var(--text-muted);line-height:1.4}
.plan-feature-icon{width:16px;height:16px;border-radius:50%;background:var(--success-glow);border:1px solid var(--success);display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:1px}
.plan-feature-icon svg{width:8px;height:8px;stroke:var(--success);stroke-width:2.5;fill:none}
.plan-cta{display:block;text-align:center;margin-top:auto}

/* ── CTA ── */
.cta-section{padding:clamp(32px,5vh,64px) 0 clamp(64px,10vh,120px);text-align:center;position:relative;z-index:1}
.cta-inner{
  max-width:580px;margin:0 auto;
  background:var(--accent-glow);border:1px solid var(--accent);border-radius:16px;
  padding:clamp(32px,4vw,52px);
}
.cta-title{font-size:clamp(20px,3vw,30px);font-weight:700;letter-spacing:-.02em;margin-bottom:12px}
.cta-sub{font-size:14px;color:var(--text-muted);line-height:1.65;margin-bottom:28px}
.cta-btns{display:flex;gap:12px;justify-content:center;flex-wrap:wrap}

/* ── AMBIANCE ──
   Le shader WebGL plein écran a été retiré : violet/rose/jaune à 72 %
   d'opacité, il écrasait la page et rendait le mode clair illisible, pour
   un coût d'un requestAnimationFrame permanent. Même profondeur d'encre
   que l'accueil, en CSS, sans frais de GPU. */
.ambience{position:fixed;inset:0;z-index:0;pointer-events:none;overflow:hidden}
.amb-depth{position:absolute;inset:0;background:radial-gradient(ellipse 120% 80% at 70% -10%,var(--surface) 0%,rgb(from var(--surface) r g b / 0) 62%)}
.amb-streak{
  position:absolute;top:-6vh;right:-18vw;width:min(1100px,90vw);height:150px;
  background:radial-gradient(ellipse at 50% 50%,var(--accent-glow) 0%,rgb(from var(--accent-glow) r g b / 0) 72%);
  filter:blur(28px);transform:rotate(-28deg);
}
</style>

<div class="ambience" aria-hidden="true" role="presentation">
  <div class="amb-depth"></div>
  <div class="amb-streak"></div>
</div>
<Header cta="Devis gratuit" ctaHref="/devis" />

<main style="position:relative;z-index:1">
  <div class="wrap" style="max-width:1040px">

    <!-- HERO -->
    <div class="prix-hero">
      <div class="prix-pill"><span class="prix-pill-dot"></span><span data-i18n="trf-pill">Tarifs 2026</span></div>
      <h1 class="prix-h1" data-i18n="trf-h1">Transparent.<br>Sans surprise.</h1>
      <p class="prix-sub" data-i18n="trf-sub">Un prix juste pour chaque projet. Vous savez exactement ce que vous payez avant de signer.</p>

      <!-- OFFRE LANCEMENT -->
      <div class="launch-band">
        <div class="launch-ico">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
        </div>
        <div class="launch-text">
          <p class="launch-tag" data-i18n="trf-launch-tag">Offre de lancement</p>
          <h2 class="launch-title" data-i18n="trf-launch-h">3 premiers clients à <strong>1 000 €</strong> tout inclus</h2>
          <p class="launch-desc" data-i18n="trf-launch-d">Site vitrine complet, design sur mesure, responsive, SEO de base et 1 mois de support — à prix de lancement. Places très limitées.</p>
        </div>
        <div class="launch-spots">
          <span class="launch-num" id="launch-num">3</span>
          <span class="launch-num-label" data-i18n="trf-spots">places restantes</span>
        </div>
      </div>
    </div>

    <!-- FORMULES -->
    <div class="plans-section">
      <p class="section-tag" data-i18n="trf-plans-tag">Choisissez votre formule</p>
      <h2 class="section-title" data-i18n="trf-plans-h">La formule<br>adaptée à votre profil.</h2>

      <div class="plans-grid">

        <!-- Étudiant -->
        <div class="plan-card">
          <p class="plan-name" data-i18n="trf-p1-name">Étudiant</p>
          <div>
            <div class="plan-range">
              <span class="plan-from" data-i18n="trf-p1-from">100 €</span>
              <span class="plan-sep">—</span>
              <span class="plan-to" data-i18n="trf-p1-to">200 €</span>
            </div>
            <p class="plan-desc" data-i18n="trf-p1-desc">Portfolio ou projet académique</p>
          </div>
          <hr class="plan-divider">
          <ul class="plan-features">
            <li class="plan-feature">
              <span class="plan-feature-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg></span>
              <span data-i18n="trf-p1-f1">Page unique ou portfolio</span>
            </li>
            <li class="plan-feature">
              <span class="plan-feature-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg></span>
              <span data-i18n="trf-p1-f2">Design responsive inclus</span>
            </li>
            <li class="plan-feature">
              <span class="plan-feature-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg></span>
              <span data-i18n="trf-p1-f3">Formulaire de contact</span>
            </li>
            <li class="plan-feature">
              <span class="plan-feature-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg></span>
              <span data-i18n="trf-p1-f4">Livraison rapide 7 jours</span>
            </li>
            <li class="plan-feature">
              <span class="plan-feature-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg></span>
              <span data-i18n="trf-p1-f5">Hébergement guidé</span>
            </li>
          </ul>
          <a href="/devis?plan=etudiant" class="btn-g plan-cta" data-i18n="trf-p1-cta">Demander un devis</a>
        </div>

        <!-- Vitrine Pro — populaire -->
        <div class="plan-card plan-featured" id="plan-vitrine">
          <div class="plan-badge"><span data-i18n="trf-p2-badge">Populaire</span></div>
          <p class="plan-name" data-i18n="trf-p2-name">Vitrine Pro</p>
          <div>
            <div class="plan-range">
              <span class="plan-amount" data-i18n="trf-p2-price">1&nbsp;000&nbsp;€</span>
            </div>
            <p class="plan-desc" data-i18n="trf-p2-desc">Offre de lancement · places limitées</p>
          </div>
          <div class="plan-spots">
            <span class="plan-spots-num" id="vp-spots-num">3</span>
            <span data-i18n="trf-spots">places restantes</span>
          </div>
          <hr class="plan-divider">
          <ul class="plan-features">
            <li class="plan-feature">
              <span class="plan-feature-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg></span>
              <span data-i18n="trf-p2-f1">Site vitrine complet (jusqu'à 5 pages)</span>
            </li>
            <li class="plan-feature">
              <span class="plan-feature-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg></span>
              <span data-i18n="trf-p2-f2">Design sur mesure</span>
            </li>
            <li class="plan-feature">
              <span class="plan-feature-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg></span>
              <span data-i18n="trf-p2-f3">Responsive mobile &amp; tablette</span>
            </li>
            <li class="plan-feature">
              <span class="plan-feature-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg></span>
              <span data-i18n="trf-p2-f4">SEO de base inclus</span>
            </li>
            <li class="plan-feature">
              <span class="plan-feature-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg></span>
              <span data-i18n="trf-p2-f5">Formulaire de contact</span>
            </li>
            <li class="plan-feature">
              <span class="plan-feature-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg></span>
              <span data-i18n="trf-p2-f6">1 mois de support inclus</span>
            </li>
          </ul>
          <a href="/devis?plan=vitrine-pro" class="btn plan-cta" data-i18n="trf-p2-cta">Démarrer mon projet</a>
        </div>

        <!-- Entreprise -->
        <div class="plan-card">
          <p class="plan-name" data-i18n="trf-p3-name">Entreprise</p>
          <div>
            <div class="plan-range">
              <span class="plan-from" data-i18n="trf-p3-from">1 200 €</span>
              <span class="plan-sep">—</span>
              <span class="plan-to" data-i18n="trf-p3-to">3 100 €</span>
            </div>
            <p class="plan-desc" data-i18n="trf-p3-desc">Site professionnel ou e-commerce</p>
          </div>
          <hr class="plan-divider">
          <ul class="plan-features">
            <li class="plan-feature">
              <span class="plan-feature-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg></span>
              <span data-i18n="trf-p3-f1">Tout du plan Vitrine Pro</span>
            </li>
            <li class="plan-feature">
              <span class="plan-feature-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg></span>
              <span data-i18n="trf-p3-f2">E-commerce ou espace client</span>
            </li>
            <li class="plan-feature">
              <span class="plan-feature-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg></span>
              <span data-i18n="trf-p3-f3">SEO avancé &amp; stratégie de contenu</span>
            </li>
            <li class="plan-feature">
              <span class="plan-feature-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg></span>
              <span data-i18n="trf-p3-f4">Blog &amp; CMS intégré</span>
            </li>
            <li class="plan-feature">
              <span class="plan-feature-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg></span>
              <span data-i18n="trf-p3-f5">Intégrations sur mesure</span>
            </li>
            <li class="plan-feature">
              <span class="plan-feature-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg></span>
              <span data-i18n="trf-p3-f6">Support étendu</span>
            </li>
          </ul>
          <a href="/devis?plan=entreprise" class="btn-g plan-cta" data-i18n="trf-p3-cta">Obtenir un devis</a>
        </div>

      </div>
    </div>

    <!-- CTA -->
    <div class="cta-section">
      <div class="cta-inner">
        <h2 class="cta-title" data-i18n="trf-cta-h">Obtenez votre devis en 2 minutes</h2>
        <p class="cta-sub" data-i18n="trf-cta-sub">Décrivez votre projet, on vous répond sous 24 h avec une estimation précise — gratuit et sans engagement.</p>
        <div class="cta-btns">
          <a href="/devis" class="btn" data-i18n="trf-cta-btn1">Demander un devis gratuit →</a>
          <a href="/contact" class="btn-g" data-i18n="trf-cta-btn2">Nous contacter</a>
        </div>
      </div>
    </div>

  </div>
</main>

<Footer />

<script is:inline>
(function(){
'use strict';

/* ── Vitrine Pro : spots restants depuis Supabase ── */
function initSpots(){
  if(!window.sb)return;
  window.sb.from('nw_config').select('value').eq('key','vitrine_pro_spots').single()
    .then(function(r){
      if(r.error||!r.data)return;
      var n=parseInt(r.data.value,10);
      if(isNaN(n))return;
      var card=document.getElementById('plan-vitrine');
      if(!card)return;
      if(n<=0){card.remove();return;}
      var el=document.getElementById('vp-spots-num');
      if(el)el.textContent=n;
      var launchNum=document.getElementById('launch-num');
      if(launchNum)launchNum.textContent=n;
    });
}
setTimeout(initSpots,500);

/* ── TILT CARDS ── */
(function(){
  var LIMIT=15,SCALE=1.05,PERSP=1200;
  document.querySelectorAll('.plan-card').forEach(function(card){
    /* inject spotlight */
    var sp=document.createElement('div');
    sp.className='plan-spotlight';
    card.appendChild(sp);

    card.addEventListener('pointerenter',function(){
      sp.style.opacity='1';
    });
    card.addEventListener('pointermove',function(e){
      var r=card.getBoundingClientRect();
      var px=(e.clientX-r.left)/r.width;
      var py=(e.clientY-r.top)/r.height;
      /* effect="evade" → dir=-1 */
      var xRot=((py-.5)*LIMIT*2*-1).toFixed(2);
      var yRot=((px-.5)*LIMIT*2).toFixed(2);
      card.style.transform='perspective('+PERSP+'px) rotateX('+xRot+'deg) rotateY('+yRot+'deg) scale3d('+SCALE+','+SCALE+','+SCALE+')';
      sp.style.setProperty('--sx',(px*100)+'%');
      sp.style.setProperty('--sy',(py*100)+'%');
    });
    card.addEventListener('pointerleave',function(){
      card.style.transform='perspective('+PERSP+'px) rotateX(0deg) rotateY(0deg) scale3d(1,1,1)';
      sp.style.opacity='0';
    });
  });
})();
})();
</script>
</BaseLayout>
