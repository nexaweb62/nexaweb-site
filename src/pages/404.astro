---
import InteractiveButton from '../components/ui/InteractiveButton.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
---
<BaseLayout title="Page introuvable — Nexa Web">
<style>
/* ── CANVAS BG ── */
#nf-cv{opacity:var(--decor-opacity);position:fixed;inset:0;width:100%;height:100%;pointer-events:none;z-index:0}

/* ── LAYOUT ── */
.nf-page{
  position:relative;z-index:1;
  min-height:calc(100vh - var(--hdr));
  display:flex;flex-direction:column;align-items:center;justify-content:center;
  text-align:center;padding:clamp(48px,8vh,96px) var(--pad-x);
  gap:0;
}

/* ── 404 ── */
.nf-num{
  font-size:clamp(120px,22vw,240px);
  font-weight:600;
  letter-spacing:-.06em;
  line-height:1;
  color:var(--text);
  -webkit-mask-image:linear-gradient(to bottom,black 20%,transparent 80%);
  mask-image:linear-gradient(to bottom,black 20%,transparent 80%);
  user-select:none;
  pointer-events:none;
}

/* ── DESCRIPTION ── */
.nf-desc{
  margin-top:-28px;
  font-size:clamp(13px,1.5vw,16px);
  color:var(--text-muted);
  line-height:1.7;
  max-width:400px;
  margin-bottom:40px;
}

/* ── BUTTONS ── */
.nf-btns{display:flex;gap:12px;flex-wrap:wrap;justify-content:center}
</style>

<canvas id="nf-cv" aria-hidden="true"></canvas>
<Header />

<main id="main-content" tabindex="-1">
  <div class="nf-page">
    <p class="nf-num" aria-hidden="true">404</p>
    <p class="nf-desc">
      La page que vous cherchez a peut-être été déplacée<br>ou n'existe pas.
    </p>
    <div class="nf-btns">
      <InteractiveButton text="Accueil" href="/" class="nf-btn-home" />
      <InteractiveButton text="Explorer" href="/#services" class="nf-btn-explore" />
    </div>
  </div>
</main>

<Footer />

<script is:inline>
/* ── AETHER FLOW background ── */
(function(){
  'use strict';
  var cv=document.getElementById('nf-cv');
  if(!cv)return;
  var ctx=cv.getContext('2d');
  var W,H,pts=[],RAF;
  var mouse={x:null,y:null,r:180};

  function Particle(){
    this.x=Math.random()*W;this.y=Math.random()*H;
    this.vx=(Math.random()*.4)-.2;this.vy=(Math.random()*.4)-.2;
    this.size=Math.random()*1.6+.5;
  }
  Particle.prototype.update=function(){
    if(this.x>W||this.x<0)this.vx=-this.vx;
    if(this.y>H||this.y<0)this.vy=-this.vy;
    if(mouse.x!==null){
      var dx=mouse.x-this.x,dy=mouse.y-this.y,d=Math.sqrt(dx*dx+dy*dy);
      if(d<mouse.r&&d>0){var f=(mouse.r-d)/mouse.r;this.x-=(dx/d)*f*5;this.y-=(dy/d)*f*5;}
    }
    this.x+=this.vx;this.y+=this.vy;
    ctx.beginPath();ctx.arc(this.x,this.y,this.size,0,Math.PI*2);
    ctx.fillStyle=window.nwTokenRgba?window.nwTokenRgba('--accent',.75):'transparent';ctx.fill();
  };

  function connect(){
    var thresh=(W/7)*(H/7);
    for(var a=0;a<pts.length;a++){
      for(var b=a+1;b<pts.length;b++){
        var dx=pts[a].x-pts[b].x,dy=pts[a].y-pts[b].y,d2=dx*dx+dy*dy;
        if(d2<thresh){
          var op=1-(d2/20000),near=false;
          if(mouse.x!==null){var mx=pts[a].x-mouse.x,my=pts[a].y-mouse.y;near=Math.sqrt(mx*mx+my*my)<mouse.r;}
          ctx.strokeStyle=window.nwTokenRgba?window.nwTokenRgba(near?'--text':'--accent',op):'transparent';
          ctx.lineWidth=.8;ctx.beginPath();ctx.moveTo(pts[a].x,pts[a].y);ctx.lineTo(pts[b].x,pts[b].y);ctx.stroke();
        }
      }
    }
  }

  /* Ce décor animait ses particules même sous prefers-reduced-motion.
     Il dessine désormais une seule image figée pour qui le demande. */
  var PRM=window.matchMedia('(prefers-reduced-motion:reduce)');
  function draw(){
    ctx.clearRect(0,0,W,H);
    for(var i=0;i<pts.length;i++)pts[i].update();
    connect();
  }
  function animate(){
    if(PRM.matches){ draw(); return; }
    RAF=requestAnimationFrame(animate);
    draw();
  }

  function init(){
    W=cv.width=window.innerWidth;H=cv.height=window.innerHeight;
    pts=[];var n=Math.min(Math.floor(W*H/9000),140);
    for(var i=0;i<n;i++)pts.push(new Particle());
  }

  window.addEventListener('resize',function(){cancelAnimationFrame(RAF);init();animate();},{passive:true});
  window.addEventListener('mousemove',function(e){mouse.x=e.clientX;mouse.y=e.clientY;},{passive:true});
  window.addEventListener('mouseleave',function(){mouse.x=null;mouse.y=null;});
  document.addEventListener('visibilitychange',function(){if(document.hidden)cancelAnimationFrame(RAF);else animate();});
  init();animate();
})();
</script>
</BaseLayout>
