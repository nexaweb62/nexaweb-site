---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { METIERS } from '../config/metiers';
---

<Base
  title="Page introuvable — Nexa Web"
  description="Cette page n'existe pas ou a été déplacée. Retrouvez l'offre, les tarifs et le formulaire de rappel de Nexa Web depuis l'accueil."
  path="/404"
  noindex
>
  <div class="page-simple">
    <Header />
  </div>

  <main class="container notfound">
    <div>
      <p class="notfound-code" aria-hidden="true">404</p>
      <h1 class="section-title" style="max-width:none;margin-top:18px">Cette page n'existe pas</h1>
      <p class="lede" style="margin-inline:auto">
        Le lien est peut-être ancien : le site a été refait. Voici où se trouve
        ce que vous cherchiez probablement.
      </p>
      <div class="contact-actions">
        <a class="cta" href="/">Retour à l'accueil</a>
        <a class="btn-ghost" href="/#tarifs">Les tarifs</a>
      </div>
      <nav class="metier-liens" aria-label="Pages du site">
        {METIERS.map((m) => <a class="inline-link" href={`/${m.slug}`}>{m.nav}</a>)}
        <a class="inline-link" href="/equipe">L'équipe</a>
        <a class="inline-link" href="/fiche-google-business">Guide fiche Google</a>
      </nav>
    </div>
  </main>

  <Footer />
</Base>
