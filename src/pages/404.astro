---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
---
<BaseLayout title="Page introuvable — Nexa Web">
<style>
/* ── CANVAS BG ── */
#nf-cv{position:fixed;inset:0;width:100%;height:100%;pointer-events:none;z-index:0}

/* ── LAYOUT ── */
.nf-page{
  position:relative;z-index:1;
  min-height:calc(100vh - var(--hdr));
  display:flex;flex-direction:column;align-items:center;justify-content:center;
  text-align:center;padding:clamp(48px,8vh,96px) var(--pad-x);
  gap:0;
}

/* ── 404 ── */
.nf-num{
  font-size:clamp(120px,22vw,240px);
  font-weight:900;
  letter-spacing:-.06em;
  line-height:1;
  color:var(--text);
  -webkit-mask-image:linear-gradient(to bottom,black 20%,transparent 80%);
  mask-image:linear-gradient(to bottom,black 20%,transparent 80%);
  user-select:none;
  pointer-events:none;
}

/* ── DESCRIPTION ── */
.nf-desc{
  margin-top:-28px;
  font-size:clamp(13px,1.5vw,16px);
  color:rgba(var(--text-muted-rgb,232,232,242),.7);
  line-height:1.7;
  max-width:400px;
  margin-bottom:40px;
}

/* ── BUTTONS ── */
.nf-btns{display:flex;gap:12px;flex-wrap:wrap;justify-content:center}

.nf-btn-home{
  display:inline-flex;align-items:center;gap:9px;
  font-size:11px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;
  background:var(--btn-bg);color:var(--btn-text);
  border-radius:3px;padding:13px 26px;
  transition:opacity .2s,transform .2s;
}
.nf-btn-home:hover{opacity:.84;transform:translateY(-1px)}
.nf-btn-home svg{width:15px;height:15px;stroke:currentColor;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}

.nf-btn-explore{
  display:inline-flex;align-items:center;gap:9px;
  font-size:11px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;
  border:1px solid var(--ghost-border);color:var(--text-muted);
  border-radius:3px;padding:13px 26px;
  transition:border-color .2s,color .2s,transform .2s;
}
.nf-btn-explore:hover{border-color:var(--border-hi);color:var(--text);transform:translateY(-1px)}
.nf-btn-explore svg{width:15px;height:15px;stroke:currentColor;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
</style>

<canvas id="nf-cv" aria-hidden="true"></canvas>
<Header back={false} />

<main>
  <div class="nf-page">
    <p class="nf-num" aria-hidden="true">404</p>
    <p class="nf-desc">
      La page que vous cherchez a peut-être été déplacée<br>ou n'existe pas.
    </p>
    <div class="nf-btns">
      <a href="/" class="nf-btn-home">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
        Accueil
      </a>
      <a href="/#services" class="nf-btn-explore">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
        Explorer
      </a>
    </div>
  </div>
</main>

<Footer />

<script is:inline>
/* ── AETHER FLOW background ── */
(function(){
  'use strict';
  var cv=document.getElementById('nf-cv');
  if(!cv)return;
  var ctx=cv.getContext('2d');
  var W,H,pts=[],RAF;
  var mouse={x:null,y:null,r:180};

  function Particle(){
    this.x=Math.random()*W;this.y=Math.random()*H;
    this.vx=(Math.random()*.4)-.2;this.vy=(Math.random()*.4)-.2;
    this.size=Math.random()*1.6+.5;
  }
  Particle.prototype.update=function(){
    if(this.x>W||this.x<0)this.vx=-this.vx;
    if(this.y>H||this.y<0)this.vy=-this.vy;
    if(mouse.x!==null){
      var dx=mouse.x-this.x,dy=mouse.y-this.y,d=Math.sqrt(dx*dx+dy*dy);
      if(d<mouse.r&&d>0){var f=(mouse.r-d)/mouse.r;this.x-=(dx/d)*f*5;this.y-=(dy/d)*f*5;}
    }
    this.x+=this.vx;this.y+=this.vy;
    ctx.beginPath();ctx.arc(this.x,this.y,this.size,0,Math.PI*2);
    ctx.fillStyle='rgba(191,128,255,.75)';ctx.fill();
  };

  function connect(){
    var thresh=(W/7)*(H/7);
    for(var a=0;a<pts.length;a++){
      for(var b=a+1;b<pts.length;b++){
        var dx=pts[a].x-pts[b].x,dy=pts[a].y-pts[b].y,d2=dx*dx+dy*dy;
        if(d2<thresh){
          var op=1-(d2/20000),near=false;
          if(mouse.x!==null){var mx=pts[a].x-mouse.x,my=pts[a].y-mouse.y;near=Math.sqrt(mx*mx+my*my)<mouse.r;}
          ctx.strokeStyle=near?('rgba(255,255,255,'+op+')'): ('rgba(200,150,255,'+op+')');
          ctx.lineWidth=.8;ctx.beginPath();ctx.moveTo(pts[a].x,pts[a].y);ctx.lineTo(pts[b].x,pts[b].y);ctx.stroke();
        }
      }
    }
  }

  function animate(){
    RAF=requestAnimationFrame(animate);
    ctx.clearRect(0,0,W,H);
    for(var i=0;i<pts.length;i++)pts[i].update();
    connect();
  }

  function init(){
    W=cv.width=window.innerWidth;H=cv.height=window.innerHeight;
    pts=[];var n=Math.min(Math.floor(W*H/9000),140);
    for(var i=0;i<n;i++)pts.push(new Particle());
  }

  window.addEventListener('resize',function(){cancelAnimationFrame(RAF);init();animate();},{passive:true});
  window.addEventListener('mousemove',function(e){mouse.x=e.clientX;mouse.y=e.clientY;},{passive:true});
  window.addEventListener('mouseleave',function(){mouse.x=null;mouse.y=null;});
  document.addEventListener('visibilitychange',function(){if(document.hidden)cancelAnimationFrame(RAF);else animate();});
  init();animate();
})();
</script>
</BaseLayout>
