---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
---
<BaseLayout title="Page introuvable — Nexa Web">
<style>
.nf-page{
  min-height:calc(100vh - var(--hdr));
  display:flex;flex-direction:column;align-items:center;justify-content:center;
  text-align:center;padding:clamp(48px,8vh,96px) var(--pad-x);
  position:relative;z-index:1;
  gap:0;
}

.nf-num{
  font-size:clamp(120px,20vw,220px);
  font-weight:900;
  letter-spacing:-.06em;
  line-height:1;
  color:var(--text);
  -webkit-mask-image:linear-gradient(to bottom,black 20%,transparent 80%);
  mask-image:linear-gradient(to bottom,black 20%,transparent 80%);
  user-select:none;
}

.nf-desc{
  margin-top:-24px;
  font-size:clamp(14px,1.5vw,17px);
  color:var(--text-muted);
  line-height:1.65;
  max-width:380px;
  margin-bottom:36px;
}

.nf-btns{display:flex;gap:12px;flex-wrap:wrap;justify-content:center}

.nf-btn-home{
  display:inline-flex;align-items:center;gap:8px;
  font-size:11px;font-weight:700;letter-spacing:.10em;text-transform:uppercase;
  background:var(--btn-bg);color:var(--btn-text);
  border-radius:2px;padding:12px 24px;
  transition:opacity .2s,transform .2s;
}
.nf-btn-home:hover{opacity:.82;transform:translateY(-1px)}
.nf-btn-home svg{width:14px;height:14px;stroke:currentColor;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}

.nf-btn-explore{
  display:inline-flex;align-items:center;gap:8px;
  font-size:11px;font-weight:700;letter-spacing:.10em;text-transform:uppercase;
  border:1px solid var(--ghost-border);color:var(--text);
  border-radius:2px;padding:12px 24px;
  transition:border-color .2s,opacity .2s;
}
.nf-btn-explore:hover{border-color:var(--text-muted)}
.nf-btn-explore svg{width:14px;height:14px;stroke:currentColor;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}

#neon-bg{position:fixed;inset:0;z-index:0;pointer-events:none;opacity:.18}
</style>

<canvas id="neon-bg" aria-hidden="true"></canvas>
<Header />

<main>
  <div class="nf-page">
    <p class="nf-num" aria-hidden="true">404</p>
    <p class="nf-desc">
      La page que vous cherchez a peut-être été déplacée<br>ou n'existe pas.
    </p>
    <div class="nf-btns">
      <a href="/" class="nf-btn-home">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
        Accueil
      </a>
      <a href="/#services" class="nf-btn-explore">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
        Explorer
      </a>
    </div>
  </div>
</main>

<Footer />

<script>
(function(){
  const c=document.getElementById('neon-bg');
  if(!c)return;
  const g=c.getContext('2d');
  let W=0,H=0;
  const tubes=[];
  function resize(){W=c.width=innerWidth;H=c.height=innerHeight}
  function rand(a,b){return a+Math.random()*(b-a)}
  function mkTube(){
    const pts=[];for(let i=0;i<Math.floor(rand(4,8));i++)pts.push({x:rand(0,W),y:rand(0,H)});
    return{pts,color:`hsl(${rand(250,290)},80%,60%)`,w:rand(.5,1.5),t:0,sp:rand(.002,.005),alpha:rand(.3,.7)};
  }
  function init(){resize();tubes.length=0;for(let i=0;i<10;i++)tubes.push(mkTube())}
  function catmull(pts,t){
    const n=pts.length,seg=Math.min(Math.floor(t*(n-1)),n-2),lt=(t*(n-1))-seg;
    const p0=pts[Math.max(seg-1,0)],p1=pts[seg],p2=pts[Math.min(seg+1,n-1)],p3=pts[Math.min(seg+2,n-1)];
    const t2=lt*lt,t3=t2*lt;
    return{x:.5*((2*p1.x)+(-p0.x+p2.x)*lt+(2*p0.x-5*p1.x+4*p2.x-p3.x)*t2+(-p0.x+3*p1.x-3*p2.x+p3.x)*t3),
           y:.5*((2*p1.y)+(-p0.y+p2.y)*lt+(2*p0.y-5*p1.y+4*p2.y-p3.y)*t2+(-p0.y+3*p1.y-3*p2.y+p3.y)*t3)};
  }
  function draw(){
    g.clearRect(0,0,W,H);
    for(const tb of tubes){
      tb.t=(tb.t+tb.sp)%1;
      g.beginPath();
      for(let i=0;i<=60;i++){const p=catmull(tb.pts,i/60);i===0?g.moveTo(p.x,p.y):g.lineTo(p.x,p.y)}
      g.strokeStyle=tb.color;g.lineWidth=tb.w;g.globalAlpha=tb.alpha*.25;g.stroke();
      const head=catmull(tb.pts,tb.t);
      const gl=g.createRadialGradient(head.x,head.y,0,head.x,head.y,20);
      gl.addColorStop(0,tb.color);gl.addColorStop(1,'transparent');
      g.beginPath();g.arc(head.x,head.y,20,0,Math.PI*2);g.fillStyle=gl;g.globalAlpha=tb.alpha*.55;g.fill();
      g.globalAlpha=1;
    }
    requestAnimationFrame(draw);
  }
  window.addEventListener('resize',()=>{resize();init()},{passive:true});
  init();draw();
})();
</script>
</BaseLayout>
