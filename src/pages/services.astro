---
import InteractiveButton from '../components/ui/InteractiveButton.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import GarantieBadge from '../components/GarantieBadge.astro';
import { REFONTE, VITRINE, ENTREPRISE, prix } from '../data/formules';
import '../styles/global.css';

/* Les trois temps de la méthode : un nom, une phrase, trois actions. */
const ETAPES = [
  { n: '01', cle: 'sv-m1', nom: 'Conception',
    phrase: 'Une identité, pas un template.',
    lignes: [
      { t: 'Découvrir', d: 'Votre métier, vos clients, ce qui vous distingue.' },
      { t: 'Dessiner',  d: 'Une maquette complète, pensée pour votre activité.' },
      { t: 'Valider',   d: '14 jours, 2 séries de retouches, satisfait ou remboursé.' },
    ] },
  { n: '02', cle: 'sv-m2', nom: 'Développement',
    phrase: 'Rapide sur mobile. Simple à gérer.',
    lignes: [
      { t: 'Construire', d: 'Un site écrit à la main, sans surcouche inutile.' },
      { t: 'Optimiser',  d: 'Images, polices, scripts : chaque kilo-octet compte.' },
      { t: 'Tester',     d: 'Sur téléphone, tablette et ordinateur, avant la mise en ligne.' },
    ] },
  { n: '03', cle: 'sv-m3', nom: 'Visibilité',
    phrase: 'Trouvé là où vos clients cherchent.',
    lignes: [
      { t: 'Référencer', d: 'Structure, balises et fiche locale soignées dès le départ.' },
      { t: 'Mesurer',    d: 'Ce que les visiteurs cherchent, et ce qu’ils trouvent.' },
      { t: 'Améliorer',  d: 'Des ajustements réguliers plutôt qu’une refonte de plus.' },
    ] },
];

/* Les prestations, telles qu'elles existent déjà sur le site, avec leur
   prix de départ et leur délai — UNIQUEMENT ceux qui sont déjà écrits
   ailleurs. Aucun n'est estimé ici.
     prix   src/data/formules.ts : VITRINE.prix (l. 33), REFONTE.prixDepart
            (l. 23), ENTREPRISE.prixDepart (l. 39). La boutique en ligne
            relève de la formule Entreprise : « Site professionnel ou
            e-commerce » et « E-commerce ou espace client » (tarifs.astro,
            l. 491 et 503).
     délai  « Livraison en 2 à 4 semaines » : site-vitrine.astro l. 76 et
            ecommerce.astro l. 81 ; refonte : REFONTE.delaiSemaines
            (formules.ts l. 25, repris par refonte.astro l. 81).
   Le référencement et le design n'ont ni prix ni délai écrits : la case
   dit « sur devis ». */
const LIVRAISON_SITE = { min: 2, max: 4 };   // site-vitrine.astro l. 76, ecommerce.astro l. 81
const PRESTATIONS = [
  { cle: 'sv-p1', nom: 'Site vitrine',        href: '/site-vitrine',
    prix: VITRINE.prix,            formule: { cle: 'sv-tab-f-vitrine',    nom: 'Formule Vitrine Pro, prix de lancement' },
    delai: LIVRAISON_SITE },
  { cle: 'sv-p2', nom: 'Boutique en ligne',   href: '/ecommerce',
    prix: ENTREPRISE.prixDepart,   formule: { cle: 'sv-tab-f-entreprise', nom: 'Formule Entreprise' },
    delai: LIVRAISON_SITE },
  { cle: 'sv-p3', nom: 'Refonte de site',     href: '/refonte',
    prix: REFONTE.prixDepart,      formule: { cle: 'sv-tab-f-refonte',    nom: 'Formule Refonte' },
    delai: { min: REFONTE.delaiSemaines, max: REFONTE.delaiSemaines } },
  { cle: 'sv-p4', nom: 'Référencement local', href: '/seo' },
  { cle: 'sv-p5', nom: 'Design UI/UX',        href: '/design-uiux' },
];
---
<BaseLayout
  title="Services — Nexa Web"
  description="Conception, développement et référencement de sites sur mesure. Prix affiché, délai fixé dès le premier appel. Nexa Web, Carvin, Hauts-de-France."
>
<style>
/* ── CADRE ── */
.sv{overflow-x:clip}
.sv-mono{font-family:var(--font);font-weight:500;}

/* ── HERO ── */
.sv-hero{padding:clamp(56px,10vh,120px) 0 clamp(40px,6vh,80px)}
.sv-titre{
  font-size:clamp(46px,9vw,104px);line-height:.92;letter-spacing:-.014em;
  margin:0 0 clamp(24px,4vh,40px);
}
.sv-titre span{display:block}
.sv-intro{font-size:clamp(15px,1.5vw,18px);line-height:1.7;color:var(--text-muted);max-width:52ch;margin:0}

/* ── SECTIONS ── */
.sv-sec{padding:clamp(48px,8vh,104px) 0}
.sv-sec-h{font-size:clamp(24px,3.6vw,38px);font-weight:var(--w-semi);
  letter-spacing:-.009em;line-height:1.12;margin:0 0 clamp(28px,4vh,48px)}

/* ── 01 · AVANT / APRÈS ── */
.sv-duo{display:grid;grid-template-columns:1fr 1fr;gap:clamp(16px,2.4vw,28px)}
@media(max-width:760px){.sv-duo{grid-template-columns:1fr}}
.sv-carte{
  border:1px solid var(--border);border-radius:var(--radius-block);
  padding:clamp(22px,3vw,34px);background:var(--surface);
  transition:border-color .3s var(--ease-out),transform .3s var(--ease-out);
}
.sv-carte:hover{border-color:var(--accent);transform:translateY(-3px)}
.sv-carte-lbl{
  font-family:var(--font);
  font-size:13px;letter-spacing:.01em;
  color:var(--text-subtle);margin:0 0 14px;font-weight:500;}
.sv-carte.sv-cible .sv-carte-lbl{color:var(--accent-text)}
.sv-carte.sv-cible{border-color:rgb(from var(--accent) r g b / .55)}
.sv-carte-h{font-size:clamp(18px,2.2vw,24px);font-weight:var(--w-semi);
  letter-spacing:-.007em;margin:0 0 10px}
.sv-carte-p{font-size:14px;line-height:1.7;margin:0;color:var(--text-muted)}
.sv-carte.sv-avant .sv-carte-h{color:var(--text-muted)}

/* ── 02 · LA MÉTHODE, CARTES EMPILÉES ── */
/* Les raccourcis sont des plaques (.plq dans le balisage) en petite
   coupe. Plus de capitales espacées en chasse fixe : c'était l'étiquette
   « technique » que portent tous les sites générés. Le texte du site,
   en casse normale, dit la même chose. */

.sv-pile{display:flex;flex-direction:column}
.sv-etape{border-top:1px solid var(--border)}
.sv-etape:last-child{border-bottom:1px solid var(--border)}
.sv-corps{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.6fr);gap:clamp(20px,4vw,56px);
  padding:clamp(24px,3.4vw,40px) 0}
@media(max-width:860px){.sv-corps{grid-template-columns:1fr}}
.sv-et-h{font-size:clamp(26px,3.4vw,40px);line-height:1.05;letter-spacing:-.010em;margin:0 0 14px}
.sv-et-n{color:var(--accent-text);font-variant-numeric:tabular-nums}
.sv-droite{display:flex;flex-direction:column}
.sv-phrase{font-size:clamp(17px,2vw,22px);font-weight:400;line-height:1.4;
  letter-spacing:-.015em;margin:0 0 22px}
.sv-ln{display:grid;grid-template-columns:118px 1fr;gap:14px;
  padding:14px 0;border-top:1px solid var(--border)}
.sv-ln:last-child{border-bottom:1px solid var(--border)}
.sv-ln dt{
  font-family:var(--font);
  font-size:13px;letter-spacing:.01em;color:var(--accent-text);
  padding-top:2px;font-weight:500;}
.sv-ln dd{margin:0;font-size:13px;line-height:1.65;color:var(--text-muted)}
@media(max-width:480px){.sv-ln{grid-template-columns:1fr;gap:5px}}

/* ── SOMMAIRE FIXE ── */
.sv-somm{display:none}
@media(min-width:1500px){
  .sv-somm{
    display:block;position:fixed;right:40px;top:50%;transform:translateY(-50%);
    z-index:60;pointer-events:auto;
  }
  .sv-somm-t{
    font-family:var(--font);
    font-size:13px;letter-spacing:.01em;
    color:var(--text-subtle);margin:0 0 14px;font-weight:500;}
  .sv-somm ol{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:11px}
  .sv-somm a{
    display:flex;align-items:center;gap:10px;font-size:11px;letter-spacing:.06em;
    color:var(--text-subtle);transition:color var(--dur-micro) var(--ease-out);
  }
  .sv-somm a::before{
    content:"";width:14px;height:1px;background:var(--border-strong);
    transition:width .45s var(--ease-out),background-color .45s var(--ease-out);
  }
  .sv-somm a:hover{color:var(--text)}
  .sv-somm a.ici{color:var(--accent-text)}
  .sv-somm a.ici::before{width:34px;background:var(--accent)}
}

/* ── LES PRESTATIONS, EN TABLEAU ──
   Prestation, prix de départ, délai, page dédiée : quatre colonnes au
   bureau. Sous 700 px, chaque rangée devient un bloc et chaque cellule
   porte son intitulé (.sv-tab-lib, masqué au bureau, où l'en-tête le
   donne) : rien ne défile à l'horizontale. Les rôles ARIA écrits dans
   le balisage gardent la sémantique de tableau quand le CSS change le
   display des cellules (Safari la perdait). */
.sv-tab{width:100%;border-collapse:collapse;font-family:var(--font);text-align:left}
.sv-tab thead th{
  padding:0 var(--sp-4) var(--sp-3) 0;border-bottom:1px solid var(--border-strong);
  font-size:13px;line-height:1.35;font-weight:var(--w-semi);color:var(--text-muted);
  vertical-align:bottom;white-space:nowrap}
.sv-tab tbody th,.sv-tab td{
  padding:var(--sp-5) var(--sp-4) var(--sp-5) 0;border-bottom:1px solid var(--border);
  vertical-align:top}
.sv-tab tbody th{
  width:32%;font-family:var(--font);font-size:clamp(17px,1.7vw,21px);line-height:1.25;
  font-weight:500;letter-spacing:-.007em;color:var(--text)}
.sv-tab td:nth-child(2){width:28%}
.sv-tab td:nth-child(3){width:22%}
.sv-tab td:last-child{padding-right:0}
.sv-tab-lib{display:none}
/* Chiffres alignés sur les montants et les délais seulement : dans
   cette police, tnum élargit aussi la virgule et le point du texte. */
.sv-tab-val{display:block;font-size:17px;line-height:1.35;font-weight:var(--w-semi);color:var(--text);
  font-variant-numeric:tabular-nums}
.sv-tab-del{font-weight:var(--w-reg)}
.sv-tab-note{display:block;margin-top:2px;font-size:13px;line-height:1.4;color:var(--text-muted)}
.sv-tab-devis{display:block;font-size:15px;line-height:1.35;color:var(--text-muted)}
.sv-tab-lien{font-size:15px;line-height:1.35;color:var(--text);
  text-decoration:underline;text-decoration-thickness:1px;text-underline-offset:4px;
  text-decoration-color:var(--border-strong);
  transition:color var(--dur-micro) var(--ease-out),text-decoration-color var(--dur-micro) var(--ease-out)}
@media (hover:hover) and (pointer:fine){
  .sv-tab-lien:hover{color:var(--accent-text);text-decoration-color:currentColor}
}
.sv-tab-cap{caption-side:bottom;padding-top:var(--sp-4);text-align:left;
  font-size:13px;line-height:1.5;color:var(--text-muted);max-width:68ch}
@media (max-width:699.98px){
  .sv-tab,.sv-tab tbody,.sv-tab tr,.sv-tab th,.sv-tab td{display:block;width:auto}
  /* Le tableau devient une colonne : la légende, premier enfant du
     balisage, repasse sous les rangées. */
  .sv-tab{display:flex;flex-direction:column}
  .sv-tab caption{display:block;order:2}
  .sv-tab thead{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap}
  .sv-tab tbody tr{padding:var(--sp-5) 0;border-bottom:1px solid var(--border)}
  .sv-tab tbody tr:first-child{border-top:1px solid var(--border-strong)}
  .sv-tab tbody th,.sv-tab td,.sv-tab td:nth-child(2),.sv-tab td:nth-child(3){width:auto;padding:0;border:0}
  .sv-tab tbody th{margin-bottom:var(--sp-3)}
  .sv-tab td{display:grid;grid-template-columns:7.5rem minmax(0,1fr);column-gap:var(--sp-3);
    padding:var(--sp-1) 0}
  .sv-tab-lib{display:block;grid-row:span 2;font-size:14px;line-height:1.5;color:var(--text-muted)}
  .sv-tab-val,.sv-tab-devis{grid-column:2}
  .sv-tab-note{grid-column:2}
  .sv-tab td:last-child{display:block;padding-top:var(--sp-3)}
}
.sv-suite{
  display:inline-flex;align-items:center;gap:10px;margin-top:clamp(24px,4vh,40px);
  font-family:var(--font);
  font-size:13px;letter-spacing:.01em;color:var(--text-subtle);font-weight:500;}
.sv-suite a{color:var(--accent-text);text-decoration:underline;text-underline-offset:4px}

/* ── FIN ── */
.sv-fin{padding:clamp(56px,10vh,128px) 0 clamp(64px,12vh,140px);text-align:center}
.sv-fin-h{font-size:clamp(32px,6vw,70px);line-height:1.02;letter-spacing:-.012em;margin:0 0 clamp(28px,4vh,44px)}

/* ── APPARITION AU DÉFILEMENT ──
   Posée en JavaScript, comme partout ailleurs : sans lui, rien n'est
   caché. */
.sv-rv{opacity:0;transform:translateY(24px);
  transition:opacity .8s ease,transform .8s cubic-bezier(.19,1,.22,1)}
.sv-rv.sv-vu{opacity:1;transform:none}
@media (prefers-reduced-motion:reduce){
  .sv-rv,.sv-rv.sv-vu{opacity:1!important;transform:none!important;transition:none}
}
/* En anglais, la virgule des milliers prend la chasse d'un chiffre en
   chiffres tabulaires (« €1 , 200 ») : chiffres proportionnels. */
:global(html[lang='en']) .sv-tab-val{font-variant-numeric:normal}
</style>

<Header backBtn={true} />

<main id="main-content" tabindex="-1" class="sv">

  <!-- SOMMAIRE -->
  <nav class="sv-somm" aria-label="Sur cette page" data-i18n-aria="svc-somm">
    <p class="sv-somm-t" data-i18n="sv-somm">Sur cette page</p>
    <ol>
      <li><a href="#sv-changement" data-i18n="sv-somm-1">Le changement</a></li>
      <li><a href="#sv-methode" data-i18n="sv-somm-2">Notre méthode</a></li>
      <li><a href="#sv-prestations" data-i18n="sv-somm-3">Prestations</a></li>
    </ol>
  </nav>

  <!-- HERO -->
  <section class="sv-hero">
    <div class="wrap">
      <h1 class="sv-titre">
        <span class="sv-l1" data-i18n="sv-t1">Créer, mettre en ligne,</span>
        <span class="sv-l2" data-i18n="sv-t2">faire trouver.</span>
      </h1>
      <p class="sv-intro" data-i18n="sv-intro">On conçoit, on développe et on met en ligne des sites qui attirent des clients. Prix affiché, délai fixé dès le premier appel.</p>
    </div>
  </section>

  <!-- 01 · LE CHANGEMENT -->
  <section class="sv-sec" id="sv-changement" aria-labelledby="sv-h1">
    <div class="wrap">
      <h2 class="sv-sec-h sv-rv" id="sv-h1" data-i18n="sv-s1-h">Ce qui change avec un nouveau site</h2>
      <div class="sv-duo">
        <div class="sv-carte sv-avant sv-rv">
          <p class="sv-carte-lbl" data-i18n="sv-av-lbl">Aujourd'hui</p>
          <h3 class="sv-carte-h" data-i18n="sv-av-h">Un site invisible</h3>
          <p class="sv-carte-p" data-i18n="sv-av-p">Introuvable sur Google, lent sur mobile, design daté. Les clients comparent et partent chez le concurrent.</p>
        </div>
        <div class="sv-carte sv-cible sv-rv">
          <p class="sv-carte-lbl" data-i18n="sv-ap-lbl">Objectif</p>
          <h3 class="sv-carte-h" data-i18n="sv-ap-h">Un site qui travaille pour vous</h3>
          <p class="sv-carte-p" data-i18n="sv-ap-p">Trouvé localement, rapide, rassurant. Les demandes de devis arrivent pendant que vous travaillez.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 02 · LA MÉTHODE -->
  <section class="sv-sec" id="sv-methode" aria-labelledby="sv-h2">
    <div class="wrap">
      <h2 class="sv-sec-h sv-rv" id="sv-h2" data-i18n="sv-s2-h">Du premier appel à la mise en ligne</h2>

      <div class="sv-pile">
        {ETAPES.map((e, i) => (
          <article class="sv-etape" id={`sv-et-${i}`} data-etape={i}>
            <div class="sv-corps">
              <div>
                <h3 class="sv-et-h"><span class="sv-et-n">{e.n}</span> <span data-i18n={e.cle + '-n'}>{e.nom}</span></h3>
              </div>
              <div class="sv-droite">
                <p class="sv-phrase" data-i18n={e.cle + '-phrase'}>{e.phrase}</p>
                <dl style="margin:0">
                  {e.lignes.map((l, j) => (
                    <div class="sv-ln">
                      <dt data-i18n={`${e.cle}-l${j + 1}-t`}>{l.t}</dt>
                      <dd data-i18n={`${e.cle}-l${j + 1}-d`}>{l.d}</dd>
                    </div>
                  ))}
                </dl>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- PRESTATIONS -->
  <section class="sv-sec" id="sv-prestations" aria-labelledby="sv-h3">
    <div class="wrap">
      <h2 class="sv-sec-h sv-rv" id="sv-h3" data-i18n="sv-s3-h">Ce que nous faisons</h2>
      <table class="sv-tab sv-rv" role="table" aria-labelledby="sv-h3">
        <caption class="sv-tab-cap" data-i18n="sv-tab-cap">Prix de départ des formules de la page Tarifs, délais écrits sur la page de chaque prestation. « Sur devis » : aucun chiffre n'est fixé d'avance.</caption>
        <thead role="rowgroup">
          <tr role="row">
            <th scope="col" role="columnheader" data-i18n="sv-tab-th-p">Prestation</th>
            <th scope="col" role="columnheader" data-i18n="sv-tab-th-prix">À partir de</th>
            <th scope="col" role="columnheader" data-i18n="sv-tab-th-delai">Délai</th>
            <th scope="col" role="columnheader" data-i18n="sv-tab-th-page">Page dédiée</th>
          </tr>
        </thead>
        <tbody role="rowgroup">
          {PRESTATIONS.map(p => (
            <tr role="row">
              <th scope="row" role="rowheader"><span data-i18n={p.cle}>{p.nom}</span></th>
              <td role="cell">
                <span class="sv-tab-lib" aria-hidden="true" data-i18n="sv-tab-th-prix">À partir de</span>
                {p.prix
                  ? <><span class="sv-tab-val" data-i18n-prix>{prix(p.prix)}</span><span class="sv-tab-note" data-i18n={p.formule.cle}>{p.formule.nom}</span></>
                  : <span class="sv-tab-devis" data-i18n="sv-tab-devis">Sur devis</span>}
              </td>
              <td role="cell">
                <span class="sv-tab-lib" aria-hidden="true" data-i18n="sv-tab-th-delai">Délai</span>
                {p.delai
                  ? <span class="sv-tab-val sv-tab-del">{p.delai.min === p.delai.max
                      ? <>{p.delai.min} <span data-i18n="sv-tab-sem">semaines</span></>
                      : <>{p.delai.min} <span data-i18n="sv-tab-a">à</span> {p.delai.max} <span data-i18n="sv-tab-sem">semaines</span></>}</span>
                  : <span class="sv-tab-devis" data-i18n="sv-tab-devis">Sur devis</span>}
              </td>
              <td role="cell"><a class="sv-tab-lien" href={p.href}><span data-i18n="sv-tab-voir">Voir la page</span><span class="sr-only"> — <span data-i18n={p.cle}>{p.nom}</span></span></a></td>
            </tr>
          ))}
        </tbody>
      </table>
      <p class="sv-suite sv-rv">
        <span data-i18n="sv-suite">Étape suivante</span> —
        <a href="/tarifs" data-i18n="sv-suite-l">Voir les tarifs</a>
      </p>
      <div class="sv-rv" style="margin-top:clamp(22px,3vh,34px)"><GarantieBadge /></div>
    </div>
  </section>

  <!-- FIN -->
  <section class="sv-fin">
    <div class="wrap">
      <h2 class="sv-fin-h sv-rv" data-i18n="sv-fin-h">Parlons de votre site.</h2>
      <InteractiveButton text="Démarrer un projet" href="/devis" variant="gold" class="sv-rv" data-i18n="sv-fin-cta" />
    </div>
  </section>

</main>

<Footer />

<script is:inline>
/* ── LA PAGE SERVICES ─────────────────────────────────────────────────
   Deux mécanismes : les blocs qui montent, et le sommaire qui suit la
   section en cours. */
(function(){
  'use strict';
  var doux = window.matchMedia('(prefers-reduced-motion:reduce)').matches;


  /* ── Les blocs montent quand ils entrent ── */
  var blocs = [].slice.call(document.querySelectorAll('.sv-rv'));
  if(doux){
    blocs.forEach(function(b){ b.classList.add('sv-vu'); });
  }else{
    var io = new IntersectionObserver(function(es){
      es.forEach(function(e){
        if(!e.isIntersecting) return;
        e.target.classList.add('sv-vu');
        io.unobserve(e.target);
      });
    }, { threshold:0.2 });
    blocs.forEach(function(b){ io.observe(b); });
  }

  /* ── Le sommaire suit la section visible ── */
  var liens = [].slice.call(document.querySelectorAll('.sv-somm a'));
  var sections = liens.map(function(a){ return document.querySelector(a.getAttribute('href')); });
  function sommaire(){
    var milieu = window.innerHeight * 0.4, actif = -1;
    for(var i = 0; i < sections.length; i++){
      if(!sections[i]) continue;
      var r = sections[i].getBoundingClientRect();
      if(r.top <= milieu && r.bottom > milieu) actif = i;
    }
    liens.forEach(function(a, i){ a.classList.toggle('ici', i === actif); });
  }

  var attente = false;
  function auScroll(){
    if(attente) return;
    attente = true;
    requestAnimationFrame(function(){ attente = false; sommaire(); });
  }
  if(!doux) window.addEventListener('scroll', auScroll, { passive:true });
  window.addEventListener('resize', auScroll, { passive:true });
  auScroll();

  /* ── Les raccourcis et le sommaire : défilement doux ── */
  function versId(id){
    var el = document.getElementById(id);
    if(!el) return;
    el.scrollIntoView({ behavior: doux ? 'auto' : 'smooth', block:'start' });
  }
  liens.forEach(function(a){
    a.addEventListener('click', function(e){
      e.preventDefault();
      versId(a.getAttribute('href').slice(1));
    });
  });
})();
</script>
</BaseLayout>
