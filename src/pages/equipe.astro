---
import InteractiveButton from '../components/ui/InteractiveButton.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
---
<BaseLayout title="L'Équipe — Nexa Web" description="Imad et Ahmed, les deux fondateurs de Nexa Web, agence web à Carvin (Hauts-de-France) : ce sont eux qui font votre site.">
<style>
/* Scroll reveal */
.r{opacity:0;transform:translateY(28px);filter:blur(5px);transition:opacity .72s cubic-bezier(.16,1,.3,1),transform .72s cubic-bezier(.16,1,.3,1),filter .72s cubic-bezier(.16,1,.3,1)}
.r.v{opacity:1;transform:none;filter:none}
.r.d1{transition-delay:.09s}.r.d2{transition-delay:.18s}.r.d3{transition-delay:.27s}
@media(max-width:768px){.r{transform:translateY(18px);filter:none}}
@media(prefers-reduced-motion:reduce){.r{opacity:1;transform:none;filter:none;transition:none}}

/* Type : le titre prend l'échelle commune (.h-xl, global.css) */
.body-text{font-size:var(--fs-body);font-weight:400;line-height:1.6;color:var(--text-muted)}

/* Hero */
.s-eq-hero{padding-top:var(--hdr)}
.eq-hero-in{padding:clamp(60px,10vh,130px) 0 clamp(48px,8vh,100px)}

/* Team cards */
.s-team{padding:clamp(80px,12vw,160px) 0}
.team-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:20px;max-width:920px;margin:0 auto}
/* La photo AU-DESSUS du nom, plus derrière : aucun texte ni voile posé
   sur le visage. La carte contient la photo, puis le texte sur la
   surface de la page. */
.tc-inner{position:relative;display:flex;flex-direction:column;width:100%;height:100%;border-radius:var(--radius-block);overflow:hidden;cursor:default;background:var(--surface);border:1px solid var(--border);transition:transform .52s cubic-bezier(.16,1,.3,1),box-shadow .52s cubic-bezier(.16,1,.3,1)}
.tc-photo{position:relative;aspect-ratio:4/5;overflow:hidden}
.tc-inner:hover{transform:scale(1.035)}
.tc-bg{position:absolute;inset:0;background-size:cover;background-position:center 18%;transition:transform .52s cubic-bezier(.16,1,.3,1)}
.tc-inner:hover .tc-bg{transform:scale(1.08)}
/* Les 22 px qui separaient ce bouton du texte au-dessus vivaient dans
   l'ancien .tc-btn : mesure, l'ecart etait retombe a 0. */
.tc-btn{margin-top:22px;align-self:stretch}
.tc-content{display:flex;flex-direction:column;flex:1;padding:24px 24px 28px;color:var(--text)}
.tc-role{font-size:15px;font-weight:400;letter-spacing:0;color:var(--text-muted);margin-bottom:6px}
.tc-name{margin:0}
.tc-title{font-size:var(--fs-body);font-weight:400;color:var(--text-muted);margin-top:6px;letter-spacing:0}
.tc-content .tc-btn{margin-top:auto;padding-top:0}
.tc-content .tc-title{margin-bottom:22px}
@media(max-width:540px){.team-grid{grid-template-columns:1fr}}

/* CTA */
.s-eq-cta{text-align:center}
.eq-cta-in{padding:clamp(60px,10vw,120px) 0}
.eq-cta-hl{margin-bottom:32px}

/* Photos d'équipe — AVIF/WebP avec repli JPEG, produites par
   `npm run build:images`. Les JPEG d'origine pesaient 55 à 583 Ko pour
   moins de 600 px de large. */
.tc-bg[data-photo="1"]{background-image:url("/img/gen/vignette-membre1-399.jpg")}
.tc-bg[data-photo="2"]{background-image:url("/img/gen/vignette-membre2-567.jpg")}
@supports (background-image:image-set(url('a.avif') type('image/avif'))){
  .tc-bg[data-photo="1"]{background-image:image-set(url("/img/gen/vignette-membre1-399.avif") type("image/avif"),url("/img/gen/vignette-membre1-399.webp") type("image/webp"),url("/img/gen/vignette-membre1-399.jpg") type("image/jpeg"))}
  .tc-bg[data-photo="2"]{background-image:image-set(url("/img/gen/vignette-membre2-567.avif") type("image/avif"),url("/img/gen/vignette-membre2-567.webp") type("image/webp"),url("/img/gen/vignette-membre2-567.jpg") type("image/jpeg"))}
  }
</style>

<Header />

<main id="main-content" tabindex="-1">
  <!-- HERO -->
  <section class="s-eq-hero" aria-labelledby="eq-hero-h">
    <div class="wrap">
      <div class="eq-hero-in">
        <h1 class="h-xl r d1" id="eq-hero-h" data-i18n="eq-h">Imad et Ahmed,<br>les fondateurs de Nexa&nbsp;Web</h1>
        <p class="body-text r d2" style="margin-top:26px;max-width:520px" data-i18n="eq-sub">Deux fondateurs, deux métiers : le développement et le design. C'est nous qui faisons votre site, du premier appel à la mise en ligne.</p>
      </div>
    </div>
  </section>

  <!-- TEAM CARDS -->
  <section class="s-team sec-seam" aria-labelledby="team-h">
    <div class="wrap">
      <div class="team-grid">

        <!-- Membre 1 -->
        <div class="team-card r">
          <div class="tc-inner" style="box-shadow:var(--shadow-2)">
            <div class="tc-photo"><div class="tc-bg" data-photo="1" style="background-position:center 15%"></div></div>
            <div class="tc-content">
              <p class="tc-role" data-i18n="eq-role">Co-fondateur</p>
              <h2 class="tc-name h-md">Imad Torchi</h2>
              <p class="tc-title" data-i18n="eq-title1">Développe les sites</p>
              <InteractiveButton text="Prendre contact" href="/contact" class="tc-btn" data-i18n="eq-contact" />
            </div>
          </div>
        </div>

        <!-- Membre 2 -->
        <div class="team-card r d1">
          <div class="tc-inner" style="box-shadow:var(--shadow-2)">
            <div class="tc-photo"><div class="tc-bg" data-photo="2" style="background-position:center 12%"></div></div>
            <div class="tc-content">
              <p class="tc-role" data-i18n="eq-role">Co-fondateur</p>
              <h2 class="tc-name h-md">Ahmed Chteoui</h2>
              <p class="tc-title" data-i18n="eq-title2">Dessine les maquettes</p>
              <InteractiveButton text="Prendre contact" href="/contact" class="tc-btn" data-i18n="eq-contact" />
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="s-eq-cta sec-seam" aria-labelledby="eq-cta-h">
    <div class="wrap">
      <div class="eq-cta-in r">
        <h2 class="eq-cta-hl h-lg r d1" id="eq-cta-h" data-i18n="eq-cta-h">Demander un devis</h2>
        <div class="r d2">
          <InteractiveButton text="Demander un devis" href="/devis" variant="gold" data-i18n="eq-cta-btn" />
        </div>
      </div>
    </div>
  </section>
</main>

<Footer />

<script>
(function(){
  'use strict';
  /* Scroll reveal */
  var io = new IntersectionObserver(function(entries){
    entries.forEach(function(en){ if(en.isIntersecting){ en.target.classList.add('v'); io.unobserve(en.target); } });
  },{threshold:0.12});
  document.querySelectorAll('.r').forEach(function(el){ io.observe(el); });

  /* Card hover glow */
  document.querySelectorAll('.tc-inner').forEach(function(card){
    var base = card.style.boxShadow;
    card.addEventListener('mouseenter', function(){ card.style.boxShadow = base.replace('0.5)','0.7)'); });
    card.addEventListener('mouseleave', function(){ card.style.boxShadow = base; });
  });
})();
</script>
</BaseLayout>
