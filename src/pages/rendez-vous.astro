---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
---
<BaseLayout title="Rendez-vous — Nexa Web" description="Réservez une consultation gratuite de 30 min avec Nexa Web. Visio ou téléphone. Zéro engagement.">
<style>
main{position:relative;z-index:1;padding-top:var(--hdr);overflow:hidden}
.rdv-hero{position:relative;z-index:2}

/* ── Hero ── */
.rdv-hero{text-align:center;padding:clamp(64px,11vh,130px) var(--pad-x) clamp(48px,7vh,80px)}
.rdv-label{display:inline-block;font-size:var(--fs-caption);font-weight:600;letter-spacing:0;color:var(--accent-text);border:1px solid var(--accent);border-radius:100px;padding:5px 16px;margin-bottom:26px;background:var(--accent-glow)}
.rdv-title{font-size:clamp(2.4rem,5.5vw,5rem);font-weight:600;line-height:.93;letter-spacing:-.04em;margin-bottom:20px;text-wrap:balance}
.rdv-title em{font-style:italic;color:var(--text-muted)}
.rdv-sub{font-size:clamp(.88rem,1.3vw,1.05rem);color:var(--text-muted);font-weight:300;line-height:1.65;max-width:480px;margin:0 auto 32px}
.rdv-badges{display:flex;align-items:center;justify-content:center;flex-wrap:wrap;gap:10px}
.rdv-badge{display:inline-flex;align-items:center;gap:7px;border:1px solid var(--border-strong);border-radius:100px;padding:7px 16px;font-size:var(--fs-caption);font-weight:500;color:var(--text-muted);letter-spacing:0}
.rdv-badge svg{width:13px;height:13px;stroke:var(--accent);fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;flex-shrink:0}

/* ── Calendly section ── */
.rdv-section{max-width:900px;margin:0 auto;padding:0 var(--pad-x) clamp(80px,12vh,140px)}
.calendly-inline-widget{min-width:320px;height:700px;border-radius:16px;overflow:hidden}
@media(max-width:600px){.calendly-inline-widget{height:580px}}
</style>

<Header />

<main id="main-content" tabindex="-1">
  <!-- L'ORBITE — le fond de cette page. SVG et CSS, zéro WebGL.
       Des anneaux d'or concentriques, deux arcs qui tournent en sens
       contraires, quatre repères cardinaux et une bille qui fait le tour
       en 18 secondes : une horloge, ce qui a du sens pour une page de
       prise de rendez-vous. -->
  <div class="orbit" aria-hidden="true">
    <span class="halo"></span>
    <svg viewBox="0 0 800 800" role="presentation" focusable="false">
      <defs>
        <linearGradient id="arcg" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0%" stop-color="var(--gold-deep)" stop-opacity="0"/>
          <stop offset="45%" stop-color="var(--gold)" stop-opacity=".85"/>
          <stop offset="100%" stop-color="var(--gold-hi)" stop-opacity="0"/>
        </linearGradient>
      </defs>
      <circle class="ring thin" cx="400" cy="400" r="368"/>
      <circle class="ring"      cx="400" cy="400" r="286"/>
      <circle class="ring thin" cx="400" cy="400" r="208"/>
      <circle class="ring"      cx="400" cy="400" r="128"/>
      <g class="spin">
        <path class="arc" d="M400 32 A368 368 0 0 1 720 212"/>
        <path class="arc" d="M400 768 A368 368 0 0 1 80 588"/>
      </g>
      <g class="spin rev">
        <path class="arc" d="M400 114 A286 286 0 0 1 651 262"/>
      </g>
      <g class="spin">
        <line class="tick" x1="400" y1="20"  x2="400" y2="44"/>
        <line class="tick" x1="780" y1="400" x2="756" y2="400"/>
        <line class="tick" x1="400" y1="780" x2="400" y2="756"/>
        <line class="tick" x1="20"  y1="400" x2="44"  y2="400"/>
      </g>
      <g class="beadwrap">
        <circle class="beadglow" cx="400" cy="114" r="13"/>
        <circle class="bead"     cx="400" cy="114" r="4.2"/>
      </g>
    </svg>
  </div>
  <!-- HERO -->
  <div class="rdv-hero">
    <span class="rdv-label" data-i18n="rdv-label">Consultation gratuite</span>
    <h1 class="rdv-title" data-i18n="rdv-title">Prenons<br><em>rendez-vous.</em></h1>
    <p class="rdv-sub" data-i18n="rdv-sub">30 minutes pour cadrer votre projet. Visio ou téléphone, à votre convenance. Zéro engagement.</p>
    <div class="rdv-badges">
      <span class="rdv-badge"><svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg><span data-i18n="rdv-badge1">100 % gratuit</span></span>
      <span class="rdv-badge"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg><span data-i18n="rdv-badge2">30 minutes</span></span>
      <span class="rdv-badge"><svg viewBox="0 0 24 24" aria-hidden="true"><polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2" ry="2"/></svg><span data-i18n="rdv-badge3">Visio ou téléphone</span></span>
      <span class="rdv-badge"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg><span data-i18n="rdv-badge4">Zéro engagement</span></span>
    </div>
  </div>

  <!-- Calendly -->
  <div class="rdv-section">
    <!-- L'URL est composée en JS à partir des tokens : le widget suit le
         thème et aucune couleur n'est écrite en dur dans le balisage. -->
    <div class="calendly-inline-widget" id="calendly"
         data-cal-base="https://calendly.com/contact-nexaweb62/30min"
         style="min-width:320px;height:700px"></div>
  </div>
</main>

<Footer />

<script is:inline>
/* Le widget Calendly prend ses couleurs dans l'URL : on la compose à partir
   des tokens, et on la recompose à chaque bascule de thème. */
(function(){
  var el = document.getElementById('calendly');
  if(!el) return;
  function hex(name){
    var v = (window.nwToken ? window.nwToken(name) : '').replace('#','');
    return v.length === 3 ? v[0]+v[0]+v[1]+v[1]+v[2]+v[2] : v;
  }
  function build(){
    var lang = 'fr';
    try{ lang = localStorage.getItem('nw-lang') || 'fr'; }catch(e){}
    el.setAttribute('data-url', el.dataset.calBase
      + '?background_color=' + hex('--bg')
      + '&text_color='       + hex('--text')
      + '&primary_color='    + hex('--accent')
      + '&locale=' + lang);
  }
  build();
  var s = document.createElement('script');
  s.src = 'https://assets.calendly.com/assets/external/widget.js';
  s.async = true;
  document.body.appendChild(s);

  // Rebascule : Calendly ne relit pas l'URL tout seul, on réinitialise l'iframe.
  document.addEventListener('nw-theme', function(){
    build();
    var f = el.querySelector('iframe');
    if(f) f.src = el.getAttribute('data-url');
  });
})();
</script>

</BaseLayout>
