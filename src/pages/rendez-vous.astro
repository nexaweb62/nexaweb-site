---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
---
<BaseLayout title="Rendez-vous — Nexa Web" description="Réservez une consultation gratuite de 30 min avec Nexa Web. Visio ou téléphone. Zéro engagement.">
<style>
#neon-canvas{position:fixed;inset:0;width:100%;height:100%;z-index:0;pointer-events:none;opacity:.48}
main{position:relative;z-index:1;padding-top:var(--hdr)}

/* ── Hero ── */
.rdv-hero{text-align:center;padding:clamp(64px,11vh,130px) var(--pad-x) clamp(48px,7vh,80px)}
.rdv-label{display:inline-block;font-size:9.5px;font-weight:700;letter-spacing:.22em;text-transform:uppercase;color:var(--accent);border:1px solid var(--accent-ring);border-radius:100px;padding:5px 16px;margin-bottom:26px;background:var(--accent-dim)}
.rdv-title{font-size:clamp(2.4rem,5.5vw,5rem);font-weight:900;line-height:.93;letter-spacing:-.04em;margin-bottom:20px;text-wrap:balance}
.rdv-title em{font-style:italic;color:var(--text-muted)}
.rdv-sub{font-size:clamp(.88rem,1.3vw,1.05rem);color:var(--text-muted);font-weight:300;line-height:1.65;max-width:480px;margin:0 auto 32px}
.rdv-badges{display:flex;align-items:center;justify-content:center;flex-wrap:wrap;gap:10px}
.rdv-badge{display:inline-flex;align-items:center;gap:7px;border:1px solid var(--border-hi);border-radius:100px;padding:7px 16px;font-size:11px;font-weight:500;color:var(--text-muted);letter-spacing:.04em}
.rdv-badge svg{width:13px;height:13px;stroke:var(--accent);fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;flex-shrink:0}

/* ── Card wrapper ── */
.rdv-section{max-width:900px;margin:0 auto;padding:0 var(--pad-x) clamp(80px,12vh,140px)}
.rdv-card{background:rgba(16,16,30,.84);border:1px solid var(--border);border-radius:16px;overflow:hidden;backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);box-shadow:0 0 0 1px var(--accent-ring),0 32px 80px rgba(139,92,246,.12)}
.rdv-card-hdr{display:flex;align-items:center;justify-content:space-between;padding:18px 24px;border-bottom:1px solid var(--border);flex-shrink:0}
.rdv-card-title{font-size:11px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--text-muted)}
.rdv-live{display:flex;align-items:center;gap:7px;font-size:11px;font-weight:500;color:#22c55e}
.rdv-live::before{content:'';width:7px;height:7px;border-radius:50%;background:#22c55e;animation:pulse-dot 2s ease-in-out infinite}
@keyframes pulse-dot{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.5;transform:scale(.75)}}

/* ── Step 1 : picker ── */
.bk-body{position:relative;padding-right:192px;min-height:320px}
@media(max-width:600px){.bk-body{padding-right:0}}

/* Calendar area */
.bk-cal-area{padding:24px 28px}
.cal-nav{display:flex;align-items:center;justify-content:space-between;margin-bottom:16px}
.cal-lbl{font-size:13px;font-weight:700;letter-spacing:.02em;text-transform:capitalize;color:var(--text)}
.cal-nav-btn{background:none;border:1px solid var(--border-hi);border-radius:6px;width:30px;height:30px;display:flex;align-items:center;justify-content:center;cursor:pointer;color:var(--text-muted);padding:0;transition:border-color .15s,color .15s;flex-shrink:0}
.cal-nav-btn:hover:not(:disabled){border-color:var(--accent);color:var(--accent)}
.cal-nav-btn:disabled{opacity:.3;cursor:default;pointer-events:none}
.cal-nav-btn svg{width:14px;height:14px;stroke:currentColor;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
.cal-head{display:grid;grid-template-columns:repeat(7,1fr);text-align:center;margin-bottom:4px}
.cal-head span{font-size:10px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;color:var(--text-dim);padding:4px 0}
.cal-days{display:grid;grid-template-columns:repeat(7,1fr);gap:2px}
.cal-day{aspect-ratio:1;display:flex;align-items:center;justify-content:center;font-size:12.5px;border-radius:8px;cursor:pointer;position:relative;user-select:none;transition:background .12s,color .12s;color:var(--text)}
.cal-day.other-month{visibility:hidden;pointer-events:none}
.cal-day.disabled{color:var(--text-dim);opacity:.3;cursor:default;pointer-events:none}
.cal-day:not(.disabled):not(.other-month):hover{background:var(--accent-dim);color:var(--accent)}
.cal-day.today::after{content:'';position:absolute;bottom:3px;left:50%;transform:translateX(-50%);width:4px;height:4px;border-radius:50%;background:currentColor}
.cal-day.selected{background:var(--accent)!important;color:#fff!important;font-weight:700}
.cal-day.selected.today::after{background:#fff!important}

/* Slots sidebar */
.bk-slots{position:absolute;right:0;top:0;bottom:0;width:192px;border-left:1px solid var(--border);overflow-y:auto}
.bk-slots-inner{display:flex;flex-direction:column;gap:8px;padding:24px 16px}
@media(max-width:600px){
  .bk-slots{position:static;width:100%;height:220px;border-left:none;border-top:1px solid var(--border)}
}
.slot-btn{width:100%;background:none;border:1px solid var(--border-hi);border-radius:6px;padding:8px 12px;font-size:13px;font-weight:500;color:var(--text-muted);cursor:pointer;transition:border-color .12s,color .12s,background .12s;text-align:center;font-family:var(--font)}
.slot-btn:hover:not(:disabled){border-color:var(--accent);color:var(--accent);background:var(--accent-dim)}
.slot-btn.selected{background:var(--accent)!important;border-color:var(--accent)!important;color:#fff!important;font-weight:700}
.slot-btn:disabled{opacity:.3;cursor:default;pointer-events:none}

/* Footer step 1 */
.bk-footer{border-top:1px solid var(--border);padding:16px 24px;display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap}
.bk-footer-sel{display:flex;align-items:center;gap:8px;font-size:13px}
.bk-footer-sel svg{stroke:#22c55e;fill:none;stroke-width:2.5;stroke-linecap:round;stroke-linejoin:round;flex-shrink:0}
.bk-footer-ph{font-size:13px;color:var(--text-dim)}
.bk-continue-btn{display:inline-flex;align-items:center;gap:7px;background:var(--accent);color:#fff;border:none;border-radius:7px;padding:11px 22px;font-size:12.5px;font-weight:700;cursor:pointer;transition:opacity .15s;font-family:var(--font);letter-spacing:.04em}
.bk-continue-btn:hover:not(:disabled){opacity:.88}
.bk-continue-btn:disabled{opacity:.38;cursor:not-allowed;pointer-events:none}
.bk-continue-btn svg{stroke:currentColor;fill:none;stroke-width:2.5;stroke-linecap:round;stroke-linejoin:round}

/* ── Step 2 : form ── */
.bk-step2-inner{padding:28px}
.bk-back-btn{background:none;border:none;cursor:pointer;font-size:12px;color:var(--text-dim);display:inline-flex;align-items:center;gap:6px;padding:0;margin-bottom:20px;transition:color .15s;font-family:var(--font)}
.bk-back-btn:hover{color:var(--text)}
.bk-back-btn svg{stroke:currentColor;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
.bk-chip{display:inline-flex;align-items:center;gap:8px;background:var(--accent-dim);border:1px solid var(--accent-ring);border-radius:8px;padding:10px 16px;font-size:12.5px;font-weight:700;color:var(--accent);margin-bottom:24px}
.bk-chip svg{stroke:currentColor;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;flex-shrink:0}
.bk-field{margin-bottom:14px}
.bk-row{display:grid;grid-template-columns:1fr 1fr;gap:12px}
@media(max-width:480px){.bk-row{grid-template-columns:1fr}}
.bk-label{display:block;font-size:9.5px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--text-dim);margin-bottom:7px}
.bk-input{width:100%;background:rgba(255,255,255,.04);border:1px solid var(--border-hi);border-radius:6px;padding:11px 14px;font-size:13px;font-weight:300;color:var(--text);outline:none;transition:border-color .2s;font-family:var(--font);box-sizing:border-box}
.bk-input::placeholder{color:var(--text-dim)}
.bk-input:focus{border-color:var(--accent)}
textarea.bk-input{resize:vertical;min-height:90px}
.bk-submit{width:100%;margin-top:8px;padding:13px;font-weight:700;font-size:13px;cursor:pointer;border-radius:8px;border:none;background:var(--accent);color:#fff;transition:opacity .2s;font-family:var(--font);display:flex;align-items:center;justify-content:center;gap:8px}
.bk-submit:hover:not(:disabled){opacity:.9}
.bk-submit:disabled{opacity:.4;cursor:not-allowed}
.bk-submit svg{stroke:currentColor;fill:none;stroke-width:2.5;stroke-linecap:round;stroke-linejoin:round}
.bk-note{display:flex;align-items:center;gap:7px;font-size:11px;color:var(--text-dim);margin-top:14px}
.bk-note svg{stroke:var(--accent);fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;flex-shrink:0}

/* ── Success ── */
.bk-success{padding:64px 32px;text-align:center;flex-direction:column;align-items:center;gap:18px}
.bk-suc-icon{width:60px;height:60px;border-radius:50%;background:var(--accent-dim);border:1.5px solid var(--accent-ring);display:flex;align-items:center;justify-content:center;flex-shrink:0}
.bk-suc-icon svg{stroke:var(--accent);fill:none;stroke-width:2.5;stroke-linecap:round;stroke-linejoin:round}
.bk-suc-title{font-size:1.35rem;font-weight:900;letter-spacing:-.02em}
.bk-suc-sub{font-size:.875rem;color:var(--text-muted);line-height:1.75;max-width:400px}
.bk-suc-date{font-size:13px;font-weight:700;color:var(--accent);background:var(--accent-dim);border:1px solid var(--accent-ring);border-radius:8px;padding:10px 22px;display:inline-flex;align-items:center;gap:8px}
.bk-suc-date svg{stroke:var(--accent);fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
.bk-suc-btns{display:flex;gap:12px;flex-wrap:wrap;justify-content:center;margin-top:4px}
.bk-gcal{display:inline-flex;align-items:center;gap:8px;font-size:12px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;padding:11px 22px;border-radius:7px;background:var(--accent);color:#fff;text-decoration:none;transition:opacity .2s}
.bk-gcal:hover{opacity:.88}
.bk-gcal svg{stroke:currentColor;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;flex-shrink:0}

/* ── Light mode ── */
@media(prefers-color-scheme:light){:root:not([data-theme="dark"]) .rdv-card{background:rgba(255,255,255,.95);box-shadow:0 0 0 1px var(--accent-ring),0 24px 60px rgba(139,92,246,.09)}}
:root[data-theme="light"] .rdv-card{background:rgba(255,255,255,.95);box-shadow:0 0 0 1px var(--accent-ring),0 24px 60px rgba(139,92,246,.09)}
@media(prefers-color-scheme:light){:root:not([data-theme="dark"]) .bk-input{background:var(--bg-card)}}
:root[data-theme="light"] .bk-input{background:var(--bg-card)}
</style>

<Header />
<canvas id="neon-canvas" aria-hidden="true"></canvas>

<main>
  <!-- HERO -->
  <div class="rdv-hero">
    <span class="rdv-label" data-i18n="rdv-label">Consultation gratuite</span>
    <h1 class="rdv-title" data-i18n="rdv-title">Prenons<br><em>rendez-vous.</em></h1>
    <p class="rdv-sub" data-i18n="rdv-sub">30 minutes pour cadrer votre projet. Visio ou téléphone, à votre convenance. Zéro engagement.</p>
    <div class="rdv-badges">
      <span class="rdv-badge"><svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg><span data-i18n="rdv-badge1">100 % gratuit</span></span>
      <span class="rdv-badge"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg><span data-i18n="rdv-badge2">30 minutes</span></span>
      <span class="rdv-badge"><svg viewBox="0 0 24 24" aria-hidden="true"><polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2" ry="2"/></svg><span data-i18n="rdv-badge3">Visio ou téléphone</span></span>
      <span class="rdv-badge"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg><span data-i18n="rdv-badge4">Zéro engagement</span></span>
    </div>
  </div>

  <!-- CARD -->
  <div class="rdv-section">
    <div class="rdv-card">
      <div class="rdv-card-hdr">
        <span class="rdv-card-title">Choisissez un créneau</span>
        <span class="rdv-live">Disponible</span>
      </div>

      <!-- ═══ STEP 1 : date + heure ═══ -->
      <div id="bk-step1">
        <div class="bk-body">

          <!-- Calendrier -->
          <div class="bk-cal-area">
            <div class="cal-nav">
              <button class="cal-nav-btn" id="cal-prev" aria-label="Mois précédent">
                <svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
              </button>
              <span class="cal-lbl" id="cal-lbl"></span>
              <button class="cal-nav-btn" id="cal-next" aria-label="Mois suivant">
                <svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
              </button>
            </div>
            <div class="cal-head">
              <span>Lun</span><span>Mar</span><span>Mer</span><span>Jeu</span><span>Ven</span><span>Sam</span><span>Dim</span>
            </div>
            <div class="cal-days" id="cal-days"></div>
          </div>

          <!-- Créneaux -->
          <div class="bk-slots">
            <div class="bk-slots-inner" id="bk-slots-inner"></div>
          </div>
        </div>

        <!-- Footer step 1 -->
        <div class="bk-footer">
          <div id="bk-footer-txt">
            <span class="bk-footer-ph">Sélectionnez une date et un horaire.</span>
          </div>
          <button class="bk-continue-btn" id="bk-continue" disabled>
            Continuer
            <svg viewBox="0 0 24 24" width="13" height="13" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </button>
        </div>
      </div>

      <!-- ═══ STEP 2 : formulaire ═══ -->
      <div id="bk-step2" style="display:none">
        <div class="bk-step2-inner">
          <button class="bk-back-btn" id="bk-back" type="button">
            <svg viewBox="0 0 24 24" width="13" height="13" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
            Modifier le créneau
          </button>

          <div class="bk-chip">
            <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            <span id="bk-chip-txt"></span>
          </div>

          <form id="rdv-form" novalidate>
            <div class="bk-row">
              <div class="bk-field">
                <label class="bk-label" for="rdv-prenom">Prénom <span style="color:var(--accent)">*</span></label>
                <input class="bk-input" id="rdv-prenom" type="text" placeholder="Jean" autocomplete="given-name" required>
              </div>
              <div class="bk-field">
                <label class="bk-label" for="rdv-nom">Nom <span style="color:var(--accent)">*</span></label>
                <input class="bk-input" id="rdv-nom" type="text" placeholder="Dupont" autocomplete="family-name" required>
              </div>
            </div>
            <div class="bk-row">
              <div class="bk-field">
                <label class="bk-label" for="rdv-email">E-mail <span style="color:var(--accent)">*</span></label>
                <input class="bk-input" id="rdv-email" type="email" placeholder="jean@mail.fr" autocomplete="email" required>
              </div>
              <div class="bk-field">
                <label class="bk-label" for="rdv-tel">Téléphone</label>
                <input class="bk-input" id="rdv-tel" type="tel" placeholder="+33 6 …" autocomplete="tel">
              </div>
            </div>
            <div class="bk-field">
              <label class="bk-label" for="rdv-sujet">Type de projet</label>
              <select class="bk-input" id="rdv-sujet">
                <option value="">Sélectionner…</option>
                <option value="vitrine">Site vitrine</option>
                <option value="portfolio">Portfolio</option>
                <option value="ecommerce">Boutique e-commerce</option>
                <option value="app">Application web</option>
                <option value="refonte">Refonte de site existant</option>
                <option value="autre">Autre</option>
              </select>
            </div>
            <div class="bk-field">
              <label class="bk-label" for="rdv-message">Message (optionnel)</label>
              <textarea class="bk-input" id="rdv-message" placeholder="Décrivez votre projet en quelques mots…" rows="3"></textarea>
            </div>
            <button type="submit" class="bk-submit" id="rdv-submit">
              <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
              Confirmer le rendez-vous
            </button>
            <p class="bk-note">
              <svg viewBox="0 0 24 24" width="13" height="13" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              Consultation 100 % gratuite · Confirmation par e-mail sous 2 h
            </p>
          </form>
        </div>
      </div>

      <!-- ═══ SUCCESS ═══ -->
      <div id="bk-success" class="bk-success" style="display:none" role="alert" aria-live="polite">
        <div class="bk-suc-icon">
          <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
        </div>
        <h2 class="bk-suc-title">Rendez-vous confirmé !</h2>
        <p class="bk-suc-sub">Merci <strong id="suc-prenom"></strong>. Votre consultation est réservée. Nous vous enverrons un e-mail de confirmation avec le lien visio.</p>
        <div class="bk-suc-date">
          <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          <span id="suc-date"></span>
        </div>
        <div class="bk-suc-btns">
          <a href="#" id="gcal-btn" target="_blank" rel="noopener" class="bk-gcal">
            <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            Ajouter à Google Agenda
          </a>
          <a href="/" class="btn-g">Retour à l'accueil</a>
        </div>
      </div>

    </div>
  </div>
</main>

<Footer />

<script is:inline src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<script is:inline src="/supabase-client.js"></script>

<script>
(function(){
  'use strict';

  /* ── Constants ── */
  var SLOTS=['09:00','09:30','10:00','10:30','11:00','11:30','12:00','12:30','13:00','13:30','14:00','14:30','15:00','15:30','16:00','16:30','17:00','17:30'];
  var FRM=['Janvier','Février','Mars','Avril','Mai','Juin','Juillet','Août','Septembre','Octobre','Novembre','Décembre'];
  var FRG=['janvier','février','mars','avril','mai','juin','juillet','août','septembre','octobre','novembre','décembre'];
  var FRWD=['lundi','mardi','mercredi','jeudi','vendredi','samedi','dimanche'];

  /* ── State ── */
  var today=new Date();today.setHours(0,0,0,0);
  var viewY=today.getFullYear(),viewM=today.getMonth();
  var selDate=null,selTime=null;

  /* ── Helpers ── */
  function wd(d){return(d.getDay()+6)%7;}
  function isWknd(d){return d.getDay()===0||d.getDay()===6;}
  function sameDay(a,b){return a&&b&&a.getFullYear()===b.getFullYear()&&a.getMonth()===b.getMonth()&&a.getDate()===b.getDate();}
  function p2(n){return String(n).padStart(2,'0');}
  function dISO(d){return d.getFullYear()+'-'+p2(d.getMonth()+1)+'-'+p2(d.getDate());}
  function dGcal(d){return d.getFullYear()+p2(d.getMonth()+1)+p2(d.getDate());}
  function fmtFr(d){var w=FRWD[wd(d)];return w[0].toUpperCase()+w.slice(1)+' '+d.getDate()+' '+FRG[d.getMonth()]+' '+d.getFullYear();}
  function addMins(t,m){var p=t.split(':'),tot=+p[0]*60+ +p[1]+m;return p2(Math.floor(tot/60))+':'+p2(tot%60);}

  /* ── DOM refs ── */
  var calDaysEl=document.getElementById('cal-days');
  var calLblEl=document.getElementById('cal-lbl');
  var prevBtn=document.getElementById('cal-prev');
  var nextBtn=document.getElementById('cal-next');
  var slotsEl=document.getElementById('bk-slots-inner');
  var footerTxtEl=document.getElementById('bk-footer-txt');
  var contBtn=document.getElementById('bk-continue');
  var step1El=document.getElementById('bk-step1');
  var step2El=document.getElementById('bk-step2');
  var successEl=document.getElementById('bk-success');
  var chipTxtEl=document.getElementById('bk-chip-txt');

  /* ── Calendar ── */
  function renderCal(){
    calLblEl.textContent=FRM[viewM]+' '+viewY;
    var tf=new Date(today.getFullYear(),today.getMonth(),1);
    var vf=new Date(viewY,viewM,1);
    var mf=new Date(today.getFullYear(),today.getMonth()+3,1);
    prevBtn.disabled=vf<=tf;
    nextBtn.disabled=vf>=mf;
    var fw=wd(vf);
    var ld=new Date(viewY,viewM+1,0).getDate();
    var h='';
    for(var i=0;i<fw;i++)h+='<div class="cal-day other-month"></div>';
    for(var d=1;d<=ld;d++){
      var dt=new Date(viewY,viewM,d);
      var dis=dt<today||isWknd(dt);
      var cls='cal-day'+(sameDay(dt,today)?' today':'')+(sameDay(dt,selDate)?' selected':'')+(dis?' disabled':'');
      var ds=viewY+'-'+p2(viewM+1)+'-'+p2(d);
      h+='<div class="'+cls+'"'+(dis?'':' data-date="'+ds+'"')+'>'+d+'</div>';
    }
    calDaysEl.innerHTML=h;
    calDaysEl.querySelectorAll('.cal-day[data-date]').forEach(function(el){
      el.addEventListener('click',function(){
        var p=el.dataset.date.split('-');
        selDate=new Date(+p[0],+p[1]-1,+p[2]);
        renderCal();renderSlots();updateFooter();
      });
    });
  }

  /* ── Slots ── */
  function renderSlots(){
    var now=new Date();
    var isT=sameDay(selDate,today);
    var h='';
    SLOTS.forEach(function(t){
      var dis=false;
      if(isT){
        var p=t.split(':'),s=new Date(today);
        s.setHours(+p[0],+p[1],0,0);
        dis=s<=new Date(now.getTime()+60*60000);
      }
      var sel=t===selTime;
      h+='<button class="slot-btn'+(sel?' selected':'')+(dis?' disabled':'')+'"'+(dis?' disabled':' data-time="'+t+'"')+'>'+t+'</button>';
    });
    slotsEl.innerHTML=h;
    slotsEl.querySelectorAll('.slot-btn[data-time]').forEach(function(btn){
      btn.addEventListener('click',function(){
        selTime=btn.dataset.time;
        renderSlots();updateFooter();
      });
    });
  }

  /* ── Footer ── */
  function updateFooter(){
    if(selDate&&selTime){
      footerTxtEl.innerHTML='<div class="bk-footer-sel"><svg viewBox="0 0 24 24" width="16" height="16" style="stroke:#22c55e;fill:none;stroke-width:2.5;stroke-linecap:round;stroke-linejoin:round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg><span>Votre réunion est prévue le <strong>'+fmtFr(selDate)+'</strong> à <strong>'+selTime+'</strong>.</span></div>';
    }else{
      footerTxtEl.innerHTML='<span class="bk-footer-ph">Sélectionnez une date et un horaire.</span>';
    }
    contBtn.disabled=!(selDate&&selTime);
  }

  /* ── Navigation ── */
  prevBtn.addEventListener('click',function(){
    if(viewM===0){viewM=11;viewY--;}else viewM--;
    renderCal();
  });
  nextBtn.addEventListener('click',function(){
    if(viewM===11){viewM=0;viewY++;}else viewM++;
    renderCal();
  });

  /* ── Step 1 → 2 ── */
  contBtn.addEventListener('click',function(){
    step1El.style.display='none';
    step2El.style.display='block';
    chipTxtEl.textContent=fmtFr(selDate)+' · '+selTime;
  });
  document.getElementById('bk-back').addEventListener('click',function(){
    step2El.style.display='none';
    step1El.style.display='block';
  });

  /* ── Form submit ── */
  document.getElementById('rdv-form').addEventListener('submit',async function(e){
    e.preventDefault();
    var prenom=document.getElementById('rdv-prenom').value.trim();
    var nom=document.getElementById('rdv-nom').value.trim();
    var email=document.getElementById('rdv-email').value.trim();
    var tel=document.getElementById('rdv-tel').value.trim();
    var sujet=document.getElementById('rdv-sujet').value;
    var msg=document.getElementById('rdv-message').value.trim();
    if(!prenom||!nom||!email)return;

    var subBtn=document.getElementById('rdv-submit');
    subBtn.disabled=true;
    subBtn.querySelector('svg').style.display='none';
    subBtn.querySelector('svg').insertAdjacentHTML('afterend','');
    subBtn.textContent='Envoi en cours…';

    if(!window.sb){
      alert('Erreur de connexion. Contactez-nous à contact.nexaweb62@gmail.com');
      subBtn.disabled=false;
      subBtn.textContent='Confirmer le rendez-vous';
      return;
    }
    try{
      var ins=await window.sb.from('rendez_vous').insert({
        date:dISO(selDate),heure:selTime,
        prenom,nom,email,
        telephone:tel||null,sujet:sujet||null,message:msg||null
      });
      if(ins.error)throw ins.error;
      try{await window.sb.functions.invoke('send-rdv-email',{body:{prenom,nom,email,telephone:tel,sujet,message:msg,date:dISO(selDate),heure:selTime}});}
      catch(e){console.warn('[rdv] email:',e);}
      showSuccess(prenom,selDate,selTime,sujet,msg);
    }catch(err){
      console.error('[rdv]',err);
      alert('Erreur lors de la réservation. Contactez-nous à contact.nexaweb62@gmail.com');
      subBtn.disabled=false;
      subBtn.textContent='Confirmer le rendez-vous';
    }
  });

  /* ── Success ── */
  function showSuccess(prenom,date,time,sujet,msg){
    step2El.style.display='none';
    successEl.style.display='flex';
    document.getElementById('suc-prenom').textContent=prenom;
    document.getElementById('suc-date').textContent=fmtFr(date)+' à '+time;
    var gcDate=dGcal(date);
    var hh=time.split(':')[0],mm=time.split(':')[1];
    var end=addMins(time,30);
    var gcUrl='https://calendar.google.com/calendar/render?action=TEMPLATE'
      +'&text='+encodeURIComponent('Consultation Nexa Web (30 min)')
      +'&dates='+gcDate+'T'+hh+mm+'00/'+gcDate+'T'+end.replace(':','')+'00'
      +'&details='+encodeURIComponent('Consultation gratuite Nexa Web.\nSujet : '+(sujet||'Non précisé')+(msg?'\n\n'+msg:''))
      +'&location='+encodeURIComponent('Visio — lien envoyé par e-mail');
    document.getElementById('gcal-btn').href=gcUrl;
  }

  /* ── Init ── */
  renderCal();
  renderSlots();
  updateFooter();
})();
</script>

<script is:inline type="module">
(async function(){
  var canvas=document.getElementById('neon-canvas');
  try{
    var mod=await import('https://cdn.jsdelivr.net/npm/threejs-components@0.0.19/build/cursors/tubes1.min.js');
    mod.default(canvas,{tubes:{colors:['#8B5CF6','#6366f1','#a78bfa'],lights:{intensity:180,colors:['#8B5CF6','#60aed5','#ff008a','#53bc28']}}});
  }catch(e){console.warn('Neon:',e);}
})();
</script>
