# En-têtes servis par Cloudflare Workers Static Assets, qui lit ce fichier à
# la racine du dossier servi — Astro le recopie depuis public/ dans dist/.
# Astro versionne ce qu'il produit sous /_astro/ : le nom du fichier
# change à chaque modification, on peut donc le garder un an sans risque
# de servir une version périmée.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Les images générées portent leur largeur dans leur nom et ne changent
# jamais à nom égal.
/img/gen/*
  Cache-Control: public, max-age=31536000, immutable

/logos/*
  Cache-Control: public, max-age=31536000, immutable

# Les polices ne changent pas : un an. Si un fichier de /fonts devait être
# remplacé, il change de NOM (bluu-next-bold-2.woff2…), sinon les
# visiteurs déjà venus garderaient l'ancien pendant un an.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Le moteur de l'or liquide porte sa version dans son nom, comme les
# fichiers ci-dessus : à nom égal, c'est le même fichier.
/vendor/*
  Cache-Control: public, max-age=31536000, immutable

# Les scripts de public/ ne sont PAS versionnés : ils gardent leur nom
# d'une version à l'autre. Un cache long y figerait du code corrigé chez
# les visiteurs déjà venus. Une heure, puis revalidation.
# Ils sont nommés un par un, et non attrapés par « /*.js » : dans ce
# fichier l'astérisque traverse les barres obliques, donc « /*.js »
# attraperait aussi /_astro/*.js et /vendor/*.js, et l'ordre de priorité
# entre deux règles qui se recouvrent n'est pas une chose à supposer.
/finition.js
  Cache-Control: public, max-age=3600, must-revalidate
/i18n.js
  Cache-Control: public, max-age=3600, must-revalidate
/motion.js
  Cache-Control: public, max-age=3600, must-revalidate
/scroll-fx.js
  Cache-Control: public, max-age=3600, must-revalidate
/supabase-client.js
  Cache-Control: public, max-age=3600, must-revalidate

# Le HTML est toujours revalidé : c'est lui qui pointe vers les fichiers
# versionnés. Cloudflare le garde en périphérie, le navigateur demande.
#
# EN-TÊTES DE SÉCURITÉ. Ce fichier ne couvre QUE les fichiers statiques :
# une page rendue par le Worker (/devis, /admin, /api/*, /devis/confirme)
# ne passe jamais par lui. Ces mêmes valeurs y sont donc posées par
# src/middleware.ts, depuis src/lib/securite/entetes.ts — qui explique
# chacune. Les deux doivent rester identiques : npm run check:securite
# les compare et échoue s'ils divergent.
# Chaque en-tête tient sur UNE ligne : ce format n'a pas de continuation.
/*
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), usb=(), browsing-topics=()
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Content-Security-Policy: base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://challenges.cloudflare.com https://js.hcaptcha.com https://*.hcaptcha.com https://assets.calendly.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://assets.calendly.com https://*.hcaptcha.com; img-src 'self' data: blob: https:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://abbplzlczwpqmyelopxo.supabase.co wss://abbplzlczwpqmyelopxo.supabase.co https://*.hcaptcha.com https://*.spline.design https://www.gstatic.com https://unpkg.com https://cdn.jsdelivr.net; frame-src https://calendly.com https://*.calendly.com https://challenges.cloudflare.com https://*.hcaptcha.com; worker-src 'self' blob:; media-src 'self' blob: data:; manifest-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'
