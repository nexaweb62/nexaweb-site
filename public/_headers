# En-têtes servis par Cloudflare Workers Static Assets.
# Astro versionne ce qu'il produit sous /_astro/ : le nom du fichier
# change à chaque modification, on peut donc le garder un an sans risque
# de servir une version périmée.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Les images générées portent leur largeur dans leur nom et ne changent
# jamais à nom égal.
/img/gen/*
  Cache-Control: public, max-age=31536000, immutable

/logos/*
  Cache-Control: public, max-age=31536000, immutable

# Le moteur de l'or liquide porte sa version dans son nom, comme les
# fichiers ci-dessus : à nom égal, c'est le même fichier.
/vendor/*
  Cache-Control: public, max-age=31536000, immutable

# Les scripts de public/ ne sont PAS versionnés : ils gardent leur nom
# d'une version à l'autre. Un cache long y figerait du code corrigé chez
# les visiteurs déjà venus. Une heure, puis revalidation.
# Ils sont nommés un par un, et non attrapés par « /*.js » : dans ce
# fichier l'astérisque traverse les barres obliques, donc « /*.js »
# attraperait aussi /_astro/*.js et /vendor/*.js, et l'ordre de priorité
# entre deux règles qui se recouvrent n'est pas une chose à supposer.
/finition.js
  Cache-Control: public, max-age=3600, must-revalidate
/i18n.js
  Cache-Control: public, max-age=3600, must-revalidate
/liquide.js
  Cache-Control: public, max-age=3600, must-revalidate
/motion.js
  Cache-Control: public, max-age=3600, must-revalidate
/scroll-fx.js
  Cache-Control: public, max-age=3600, must-revalidate
/supabase-client.js
  Cache-Control: public, max-age=3600, must-revalidate

# Le HTML est toujours revalidé : c'est lui qui pointe vers les fichiers
# versionnés. Cloudflare le garde en périphérie, le navigateur demande.
/*
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
