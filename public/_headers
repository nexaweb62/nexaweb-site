# En-têtes servis par Cloudflare Workers Static Assets.
# Astro versionne ce qu'il produit sous /_astro/ : le nom du fichier
# change à chaque modification, on peut donc le garder un an sans risque
# de servir une version périmée.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Les images générées portent leur largeur dans leur nom et ne changent
# jamais à nom égal.
/img/gen/*
  Cache-Control: public, max-age=31536000, immutable

/logos/*
  Cache-Control: public, max-age=31536000, immutable

# Les scripts de public/ ne sont PAS versionnés : i18n.js, motion.js,
# scroll-fx.js et finition.js gardent leur nom d'une version à l'autre.
# Un cache long y figerait du code corrigé chez les visiteurs déjà venus.
# Une heure, puis revalidation.
/*.js
  Cache-Control: public, max-age=3600, must-revalidate

# Le HTML est toujours revalidé : c'est lui qui pointe vers les fichiers
# versionnés. Cloudflare le garde en périphérie, le navigateur demande.
/*
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
