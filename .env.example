# ─────────────────────────────────────────────────────────────────────
# TABLEAU DE BORD INTERNE — variables d'environnement
#
# Ce fichier est un MODELE, versionné. Il ne contient aucune valeur
# réelle. Les vraies valeurs vivent :
#   · en production  → secrets Cloudflare du Worker « nexaweb-site »
#   · en local       → dans .dev.vars, qui est dans .gitignore
#
# Rien de tout cela ne doit atteindre le navigateur. Toutes ces
# variables ne sont lues que depuis src/middleware.ts, src/lib/admin/*
# et les routes non prérendues — jamais depuis un script client.
# ─────────────────────────────────────────────────────────────────────

# ── Qui peut entrer ──────────────────────────────────────────────────
# Liste blanche, séparée par des virgules. C'est la SEULE source de
# vérité : elle est relue à chaque requête, donc retirer une adresse
# ferme l'accès immédiatement, sans attendre l'expiration du cookie.
# Une liste vide ou absente n'ouvre à personne.
ADMIN_EMAILS=ahmoudchteoui@gmail.com,imadtorchi6@gmail.com

# ── Signature du cookie de session ───────────────────────────────────
# 32 octets aléatoires au minimum. Le changer invalide toutes les
# sessions en cours — c'est le moyen de déconnecter tout le monde.
#   openssl rand -base64 48
ADMIN_SESSION_SECRET=

# ── Client OAuth dédié à l'admin ─────────────────────────────────────
# Console Google Cloud → API et services → Identifiants → ID client OAuth
# → Application Web. URI de redirection autorisé, exactement :
#   https://nexaaweb.com/admin/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ── Compte de service, lecture seule sur la feuille ──────────────────
# L'adresse se termine par .iam.gserviceaccount.com. C'est elle qu'il
# faut inviter en LECTURE sur la feuille — ne jamais rendre la feuille
# publique.
GOOGLE_SA_EMAIL=

# La clé privée du fichier JSON du compte de service, champ
# « private_key ». Elle contient des sauts de ligne : les coller tels
# quels ou échappés en \n fonctionne, le code normalise les deux.
# Elle commence par -----BEGIN PRIVATE KEY-----
GOOGLE_SA_PRIVATE_KEY=

# ── La feuille ───────────────────────────────────────────────────────
# « Nexa_Web_Prospection_semaine » — l'identifiant est le segment entre
# /d/ et /edit dans son URL.
SHEET_ID=1cqr42IttF4k9FC65BEuVklgJoYP_HYU1xB78gF4yr5k

# ─────────────────────────────────────────────────────────────────────
# FORMULAIRE DE DEVIS — protections anti-spam
# ─────────────────────────────────────────────────────────────────────

# ── Liste noire ──────────────────────────────────────────────────────
# E-mails, domaines et numéros mélangés, séparés par des virgules. Une
# demande qui correspond est ignorée EN SILENCE : la personne voit le
# message de succès habituel, et rien n'arrive dans votre boîte.
# Un domaine bloque aussi ses sous-domaines.
BLOCKLIST=general@orvanes.tech,orvanes.tech,0754540766

# ── Signature du lien de confirmation ────────────────────────────────
# La demande voyage CHIFFRÉE dans le lien : aucune table, rien à
# nettoyer. Changer cette clé invalide tous les liens en attente.
#   openssl rand -base64 48
DEVIS_TOKEN_SECRET=

# ── Cloudflare Turnstile ─────────────────────────────────────────────
# Tableau de bord Cloudflare → Turnstile → Add site (domaine nexaaweb.com).
# La clé de SITE est publique : elle s'affiche dans le HTML, c'est son rôle.
# La clé SECRÈTE ne quitte jamais le serveur.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Envoi des e-mails ────────────────────────────────────────────────
# La même clé Resend que celle déjà configurée côté Supabase.
RESEND_API_KEY=

# Où arrive la notification, APRÈS confirmation par la personne.
CONTACT_EMAIL=contact@nexaaweb.com

# ── Supabase (facultatif) ────────────────────────────────────────────
# La demande confirmée est aussi écrite dans la table demandes_devis.
# Ces deux valeurs sont PUBLIQUES et déjà dans le site ; les laisser
# vides fait retomber sur celles du projet.
SUPABASE_URL=
SUPABASE_ANON_KEY=
