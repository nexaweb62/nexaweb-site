{
  "name": "shining-shell",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check:colors": "node scripts/check-colors.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check": "npm run check:colors && npm run check:contrast",
    "build:assets": "node scripts/build-assets.mjs",
    "build:images": "node scripts/build-images.mjs",
    "check:contrast:rendered": "node scripts/check-contrast-rendered.mjs",
    "build:logos": "node scripts/build-logos.mjs && mkdir -p public/logos && cp src/assets/logos/*.svg public/logos/",
    "check:seams": "node scripts/check-seams.mjs",
    "check:glass": "node scripts/check-glass.mjs",
    "check:anim": "node scripts/check-anim.mjs"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.4",
    "@radix-ui/react-slot": "^1.3.3",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@splinetool/react-spline": "^4.1.0",
    "@splinetool/runtime": "^1.12.98",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "astro": "^7.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^13.1.1",
    "react": "~19.2.8",
    "react-dom": "~19.2.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "sharp": "^0.35.3",
    "playwright-core": "^1.56.0"
  }
}
